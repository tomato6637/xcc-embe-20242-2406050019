                  <mchp:prerequisite component="MPLAB X IDE" version="[5.20-"/>
               </mchp:extension>
            </environment>
            <description>&lt;p&gt;Industry's first and lowest power Arm(R) Cortex(R)-M23 featuring chip-level security and ARM(R) TrustZone(R) Technology, c...</description>
            <book name="https://www.microchip.com/en-us/product/ATSAML11E16A"
                  title="Device page for ATSAML11E16A"/>
            <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ApplicationNotes/ApplicationNotes/AN4383-32-bit-Microcontroller-Wafer-Level-Chip-Scale-Package-DS00004383.pdf"
                  title="32-bit Microcontroller Wafer-Level Chip-Scale Package (WLCSP)"/>
            <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ApplicationNotes/ApplicationNotes/AN4495-MPLAB-Harmony-v3-Project-Migration-DS00004495.pdf"
                  title="MPLAB Harmony v3 Project Migration"/>
            <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ProductDocuments/LegacyCollaterals/Atmel-42449-SAM-System-SYSTEM-Driver_ApplicationNote_AT11378.pdf"
                  title="AN_42449 - AT11378: SAM L21 System (SYSTEM) Driver"/>
            <feature type="ADC" n="10" m="12"/>
            <feature type="SPI" n="3"/>
            <feature type="USART" n="3"/>
            <feature type="IOs" n="25"/>
            <feature type="QFN" n="32"/>
            <feature type="QFP" n="32"/>
            <feature type="CSP" n="32"/>
            <feature type="AnalogOther" n="2" name="Analog Comparator"/>
         </device>
