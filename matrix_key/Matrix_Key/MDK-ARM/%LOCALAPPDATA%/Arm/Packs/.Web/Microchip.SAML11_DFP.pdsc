<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.57/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>SAML11_DFP</name>
   <description overview="./OVERVIEW.md">Microchip SAML11 Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="4.6.350" date="2026-08-13">
                - Added TrustZone partition configuration headers.
                - Added CMSIS-Solution project templates.
                - Adds ARMCC scatter/linker script.
                - CMSIS System Initialization is now included as default. Define DISABLE_CMSIS_INIT to not include.
                - Interrupt handler in startup_(device).c changed: SVCall_Handler changed -&gt; SVC_Handler and NonMaskableInt_Handler -&gt; NMI_Handler.
                - Improved CMSIS-SVD (device XML description) consistency.
                - Updated python debug scripts.
            </release>
      <release version="4.5.268" date="2023-05-23">
                - Fixed OPAMP PLIB register configuration code.
                - Set DSU_DID__FAMILY to Ultra Low Power.
                - Updated debug and programming scripts.
            </release>
      <release version="4.4.149" date="2022-03-17">
                - Headers minor version increased to v2.1.0.
                - Changed integer constant literal macros from _Ux_ to _UNITxx_ (where xx is 32, 16 or 8) (MISRA C2012:R12.2).
            </release>
      <release version="4.3.139" date="2021-08-02">Added fuses header file. Updated MPLAB X debug scripts. Added RXN and DXN bits to USER_WORD_1.</release>
      <release version="4.2.130" date="2021-01-28">Added User ID write and security bit programming for MPLAB X. Added instance headers. Updated default value of USER_WORD_0. Added value groups for PMUXE and PMUXO. Removed TRAM.PERMSW and TRAM.PERMR registers.</release>
      <release version="4.1.119" date="2020-10-20">Re-release 4.1 to fix version history.</release>
      <release version="4.1.118" date="2020-10-08">Fix the issue of program/debug error when chip is secured.</release>
      <release version="4.0.115" date="2020-08-29">Added read device ID. Updated XC32 linker-script TrustZone macro names to BOOTPROT_SIZE, AS_SIZE, RS_SIZE, ANSC_SIZE, and DS_SIZE.</release>
      <release version="3.2.86" date="2020-04-28">Update MSP, PSP, PRIMASK and CONTROL registers for Secure mode for MPLAB X. Updated &#x3BC;Vision support files. Updated MPLAB X debug scripts.</release>
      <release version="3.1.75" date="2020-02-12">Updated XOSC32K startup time value-group for OSC32KCTRL module. Added value-groups for SERCOM module. Updated XC32 content. Updated MPLAB X debug scripts.</release>
      <release version="3.0.48" date="2019-10-08">Updated captions and registers in CCL, EIC, GCLK, OPAMP, OSC32KCTRL, OSCCTRL, RTC, SERCOM and SUPC. Added XC32 content. Updated programming and debugging scripts.</release>
      <release version="2.0.33" date="2019-04-29">Fixes. Succeeds Atmel.SAML11_DFP 1.0.91.</release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>SAML11</keyword>
      <keyword>Microcontrollers and Processors</keyword>
      <keyword>32-bit Microcontrollers</keyword>
      <keyword>Automotive Recommended</keyword>
   </keywords>
   <requirements>
      <packages>
         <package vendor="ARM" name="CMSIS"/>
      </packages>
   </requirements>
   <devices>
      <family Dfamily="SAML11" Dvendor="Microchip:3">
         <debugvars version="1.0.0" configfile="keil/Debug/dbgconf/saml11.dbgconf">
            __var CE_Keyword0 = 0xFFFFFFFF;
            __var CE_Keyword1 = 0xFFFFFFFF;
            __var CE_Keyword2 = 0xFFFFFFFF;
            __var CE_Keyword3 = 0xFFFFFFFF;

            __var AIRCR_Addr = 0xE000ED0C;
            __var DHCSR_Addr = 0xE000EDF0;
            __var DEMCR_Addr = 0xE000EDFC;
            __var DCRSR_Addr = 0xE000EDF4;
            __var DCRDR_Addr = 0xE000EDF8;
            __var DSU_BASE_ADDR = 0x41002100;
            __var DSU_STATUSA_ADDR = 0x41002101;
            __var DSU_STATUSB_ADDR = 0x41002102;
            __var DSU_BCC0_ADDR = 0x41002120;
            __var DSU_BCC1_ADDR = 0x41002124;
            __var DSU_STATUSB_DAL_BIT = 0x3;
            __var CRSTEXTBIT = 0x2;
            __var BREXTBIT = 0x20;
            __var DEBUGGER_CMD_EXIT = 0x444247AA;
            __var DEBUGGER_CMD_IMODE = 0x44424755;
            __var NVMCTRL_ADDR_Addr = 0x4100401C;
            __var NVMCTRL_CTRLA_Addr = 0x41004000;
            __var NVMCTRL_STATUS_Addr = 0x41004018;

            __var RAM_BUFFER = 0x20000000;
        </debugvars>
         <sequences>
            <sequence name="ResetSystem">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetHardware">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetProcessor">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetAndHalt">
               <block>
                    Sequence("ResetToPark");
                    Sequence("ReleaseBREXT");
                    Write32(0xe0001028, 0x00000412);
                    Write32(0xe0001020, 0x00000000);
                    Write32(0xe0001030, 0x00400000);
                    Write32(0xe0001038, 0x00000413);
                    Write32(DEMCR_Addr, 0x01000000);
                    Write32(DHCSR_Addr, 0xa05f0001); // run target
                    DAP_Delay(420000);
                </block>
               <control while="Read32(DHCSR_Addr) &amp; 0x01000000" timeout="500000"/>
               <block>
                    Write32(DEMCR_Addr, 0x00000000);
                </block>
            </sequence>
            <sequence name="DebugPortSetup">
               <block>
                    __var isSWJ = ((__protocol &amp; 0x00010000) != 0);
                    __var protType = __protocol &amp; 0x0000FFFF;
                </block>
               <!-- JTAG Protocol -->
               <control if="protType == 1">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);

                            // Execute SWJ-DP Switch Sequence SWD to JTAG (0xE73C)
                            // Change if SWJ-DP uses deprecated switch code (0xAEAE)
                            DAP_SWJ_Sequence(16, 0xE73C);

                            // Ensure JTAG interface is reset
                            DAP_SWJ_Sequence(6, 0x3F);
                        </block>
                  </control>
                  <block>
                        // JTAG "Soft" Reset
                        DAP_JTAG_Sequence(6, 1, 0x3F);
                        DAP_JTAG_Sequence(1, 0, 0x01);
                    </block>
               </control>
               <!-- SWD Protocol -->
               <control if="protType == 2">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);

                            // Execute SWJ-DP Switch Sequence JTAG to SWD (0xE79E)
                            // Change if SWJ-DP uses deprecated switch code (0xEDB6)
                            DAP_SWJ_Sequence(16, 0xE79E);

                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3, 0x00); // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <control if="!isSWJ">
                     <block>
                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3, 0x00); // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <block>
                        // Read DPIDR to enable SWD interface (SW-DPv1 and SW-DPv2)
                        ReadDP(0x0);
                    </block>
               </control>
            </sequence>
            <sequence name="ClearRAMExecuteNever">
               <block>
                    __var USER_WORD_1_ADDR = 0x804004;
                    __var user_word_1 = Read32(USER_WORD_1_ADDR);
                    __var NVMCTRL_OFFSET = 0x0;
                </block>
               <control if="3 &amp; Read8(DSU_STATUSB_ADDR) != 1">
                  <block>
                        NVMCTRL_OFFSET = 0x1000;
                    </block>
               </control>
               <control if="(user_word_1 &amp; 0x800) != 0">
                  <block>
                        Message(0, "RAM execution is disabled, enabling it......");
                        Write32(USER_WORD_1_ADDR, user_word_1 &amp; 0xFFFFF7FF); // clear idau_rxn bit
                        Write32(NVMCTRL_CTRLA_Addr + NVMCTRL_OFFSET, 0xA504);
                    </block>
                  <control while="(Read16(NVMCTRL_STATUS_Addr + NVMCTRL_OFFSET) &amp; 0x4) == 0"
                           timeout="1000000"/>
               </control>
            </sequence>
            <sequence name="DebugPortStart">
               <block>
                    Sequence("DebugPortConnect");
                    Sequence("ResetAndHalt");
                    Sequence("ClearRAMExecuteNever");
                </block>
            </sequence>
            <sequence name="DebugPortConnect">
               <block>
                    __var SW_DP_ABORT = 0x0;
                    __var DP_CTRL_STAT = 0x4;
                    __var DP_SELECT = 0x8;
                    __var powered_down = 0;

                    // Switch to DP Register Bank
                    WriteDP(DP_SELECT, 0x00000000);

                    // Read DP CTRL/STAT Register and check if CSYSPWRUPACK and CDBGPWRUPACK bits are set
                    powered_down = ((ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000);
                </block>
               <control if="powered_down">
                  <block>
                        // Request Debug/System Power-Up
                        WriteDP(DP_CTRL_STAT, 0x50000000);
                    </block>
                  <!-- Wait for Power-Up Request to be acknowledged -->
                  <control while="(ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000"
                           timeout="1000000"/>
                  <!-- JTAG Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 1">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            // Additionally clear STICKYORUN, STICKYCMP, and STICKYERR bits by writing '1'
                            WriteDP(DP_CTRL_STAT, 0x50000F32);
                        </block>
                  </control>
                  <!-- SWD Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 2">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            WriteDP(DP_CTRL_STAT, 0x50000F00);

                            // Clear WDATAERR, STICKYORUN, STICKYCMP, and STICKYERR bits of CTRL/STAT Register by write to ABORT register
                            WriteDP(SW_DP_ABORT, 0x0000001E);
                        </block>
                  </control>
                  <block>
                        // clear AP register cache
                        ReadAP(0);
                        // clear DSU addr
                        Read32(DSU_BASE_ADDR);
                    </block>
               </control>
            </sequence>
            <sequence name="DebugCoreStop">
               <block>
                    Sequence("ResetAndHalt");
                    Write32(DHCSR_Addr, 0xa05f0001); // run target
                </block>
            </sequence>
            <sequence name="ResetExtension">
               <block>
                    __var nReset = 0x80;
                    __var SWCLK_TCK = 0x01;
                    DAP_SWJ_Pins(0, nReset, 1000);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(nReset, nReset, 1000);

                    Sequence("DebugPortSetup");
                    Sequence("DebugPortConnect"); // ensure connect after reset extension
                </block>
               <control if="(__connection &amp; 0xF) == 0">
                  <block>
                        Message(0, "Failed to connect debugger after reset extension");
                    </block>
               </control>
            </sequence>
            <sequence name="ExitResetExtension">
               <block>
                    __var statusa = Read8(DSU_STATUSA_ADDR);
                    __var reply = 0;
                </block>
               <control if="(statusa &amp; CRSTEXTBIT) == 0">
                  <block>
                        Message (0, "Device - could not enter reset extension");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write8(DSU_STATUSA_ADDR, CRSTEXTBIT);
                    DAP_Delay(5000);
                </block>
               <control if="Read8(DSU_STATUSB_ADDR) &amp; 0x80">
                  <block>
                        reply = Read32(DSU_BCC1_ADDR);
                    </block>
                  <control if="reply != 0">
                     <block>
                            Message(0, "User page validation failed with error code 0x%08X", reply);
                            __Result = -1;
                        </block>
                  </control>
               </control>
               <block>
                    Write32(DSU_BCC0_ADDR, DEBUGGER_CMD_EXIT);
                </block>
               <control while="(Read8(DSU_STATUSB_ADDR) &amp; 0x80) == 0" timeout="500000"/>
               <block>
                    reply = Read32(DSU_BCC1_ADDR);
                </block>
               <control if="reply == 0xEC000022">
                  <block>
                        Message(0, "Chip is locked");
                        __Result = -1;
                    </block>
               </control>
               <control if="reply != 0xEC000039">
                  <block>
                        Message(0, "Boot validation failed with error code 0x%08X", reply);
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write32(DHCSR_Addr, 0xA05F0003); // Halt target
                    __var dal = 3 &amp; Read8(DSU_STATUSB_ADDR);
                    Message(0, "DAL value: %X", dal);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="ResetToPark">
               <block>
                    Sequence("ResetExtension");
                    Sequence("ExitResetExtension");
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="ReleaseBREXT">
               <block>
                    Write8(DSU_STATUSA_ADDR, BREXTBIT);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashInit"/>
            <sequence name="FlashUninit"/>
            <sequence name="FlashEraseSector">
               <control if="!(0x804000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x804100) &amp;&amp; !(0x80C000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x80C100)">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                        __var NVMCTRL_OFFSET = 0x0;
                    </block>
                  <control if="3 &amp; Read8(DSU_STATUSB_ADDR) != 1">
                     <block>
                            NVMCTRL_OFFSET = 0x1000;
                        </block>
                  </control>
                  <block>
                        Write32(NVMCTRL_ADDR_Addr + NVMCTRL_OFFSET, __FlashAddr);
                        Write32(NVMCTRL_CTRLA_Addr + NVMCTRL_OFFSET, 0xA502);
                    </block>
                  <control while="(Read16(NVMCTRL_STATUS_Addr + NVMCTRL_OFFSET) &amp; 0x4) == 0"
                           timeout="1000000"/>
               </control>
            </sequence>
            <sequence name="FlashEraseChip">
               <block>
                    Sequence("ResetExtension");
                    __var statusa = Read8(DSU_STATUSA_ADDR);
                </block>
               <control if="(statusa &amp; CRSTEXTBIT) == 0">
                  <block>
                        Message (0, "Device - could not enter reset extension");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write8(DSU_STATUSA_ADDR, CRSTEXTBIT);
                    DAP_Delay(5000);
                    Write32(DSU_BCC0_ADDR, DEBUGGER_CMD_IMODE);
                    __var reply = Read32(DSU_BCC1_ADDR);
                </block>
               <control if="reply != 0xec000020">
                  <block>
                        Message(0, "Chip erase failed to enter command loop.");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write32(DSU_BCC0_ADDR, 0x444247E2);
                </block>
               <control while="Read32(DSU_BCC1_ADDR) != 0xec000024" timeout="10000000"/>
               <control if="Read32(DSU_BCC1_ADDR) != 0xec000024">
                  <block>
                        Message(0, "chip erase failed because bootrom did not accept chip erase command");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Message(0, "Write key: 0x%08X", CE_Keyword0);
                    Write32(DSU_BCC0_ADDR, CE_Keyword0);
                </block>
               <control while="Read8(DSU_STATUSB_ADDR) &amp; 0x40 != 0" timeout="10000000"/>
               <block>
                    Message(0, "Write key: 0x%08X", CE_Keyword1);
                    Write32(DSU_BCC0_ADDR, CE_Keyword1);
                </block>
               <control while="Read8(DSU_STATUSB_ADDR) &amp; 0x40 != 0" timeout="10000000"/>
               <block>
                    Message(0, "Write key: 0x%08X", CE_Keyword2);
                    Write32(DSU_BCC0_ADDR, CE_Keyword2);
                </block>
               <control while="Read8(DSU_STATUSB_ADDR) &amp; 0x40 != 0" timeout="10000000"/>
               <block>
                    Message(0, "Write key: 0x%08X", CE_Keyword3);
                    Write32(DSU_BCC0_ADDR, CE_Keyword3);
                </block>
               <control while="Read8(DSU_STATUSB_ADDR) &amp; 0x40 != 0" timeout="10000000"/>
               <control while="Read32(DSU_BCC1_ADDR) != 0xec000021" timeout="10000000"/>
               <control if="Read32(DSU_BCC1_ADDR) != 0xec000021">
                  <block>
                        Message(0, "chip erase failed : error code 0x%08X", reply);
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Sequence("ResetToPark");
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashEraseDone"/>
            <sequence name="FlashProgramPage">
               <block>
                    __var write_size = __FlashLen;
                    __var offset = 0;
                    __var page_size = 64;
                    __var addr = __FlashAddr;
                    __var NVMCTRL_OFFSET = 0x0;
                    Message(0, "Program Page: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                    write_size = (__FlashLen + 3) &amp; ~3;
                    Write8(RAM_BUFFER, 0);
                    FlashWriteBuffer(RAM_BUFFER, 0, write_size, (32 | 1));
                    BufferRead(0, 0x0, RAM_BUFFER, write_size, (32 | 1));
                </block>
               <control if="3 &amp; Read8(DSU_STATUSB_ADDR) != 1">
                  <block>
                        NVMCTRL_OFFSET = 0x1000;
                    </block>
               </control>
               <control if="0x804000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x804100 || 0x80C000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x80C100">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                        
                        Write32(NVMCTRL_ADDR_Addr + NVMCTRL_OFFSET, __FlashAddr);
                        Write32(NVMCTRL_CTRLA_Addr + NVMCTRL_OFFSET, 0xA502);
                    </block>
                  <control while="(Read16(NVMCTRL_STATUS_Addr + NVMCTRL_OFFSET) &amp; 0x4) == 0"
                           timeout="1000000"/>
               </control>
               <control while="offset &lt; write_size">
                  <block>
                        BufferWrite(0, offset, addr, write_size &lt; page_size ? write_size : page_size, (32 | 1));
                        Write32(NVMCTRL_CTRLA_Addr + NVMCTRL_OFFSET, 0xA504);
                        addr = addr + page_size;
                        offset = offset + page_size;
                    </block>
                  <control while="(Read16(NVMCTRL_STATUS_Addr + NVMCTRL_OFFSET) &amp; 0x4) == 0"
                           timeout="1000000"/>
               </control>
            </sequence>
            <sequence name="FlashProgramDone"/>
         </sequences>
         <environment name="microchip">
            <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                            schemaVersion="1.0"
                            xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
               <mchp:prerequisite component="MPLAB X IDE" version="[5.10-"/>
               <mchp:prerequisite component="MPLAB X IPE" version="[5.10-"/>
            </mchp:extension>
         </environment>
         <book name="https://onlinedocs.microchip.com/g/GUID-57D3515A-D13A-4FB6-B2E6-46A8E304CC60"
               title="SAM L10/L11 Family Data Sheet"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ProductDocuments/DataSheets/SAM-L10-L11-Family-Data-Sheet-DS60001513.pdf"
               title="SAM L10/L11 Family Data Sheet"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/Atmel-42413-SMART-ARM-Read-While-Write-EEPROM-AT03974_Application-Note.pdf"
               title="AT03974: Read While Write EEPROM"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/AN2812-Low-Power-Touch-Design-00002812B.pdf"
               title="Low-Power Touch Design"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ProductDocuments/LegacyCollaterals/Atmel-42448-SAM-Configurable-Custom-Logic-CCL-Driver_AT10942_ApplicationNote.pdf"
               title="AN_42448 - AT10942: SAM Configurable Custom Logic (CCL) Driver"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ProductDocuments/LegacyCollaterals/Atmel-42452-SAM-System-Clock-Management-Driver-SYSTEMCLOCK_AT11389_ApplicationNote.pdf"
               title="AN_42452 - AT11389: SAM System Clock Management (SYSTEM CLOCK) Driver"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/Production-Programming-of-Microchip-AVR-SAM-MCU-00002468D.pdf"
               title="Production Programming of Microchip AVR and SAM Microcontrollers"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/00002587A.pdf"
               title="EMI, EMC, EFT, and ESD Circuit Design Consideration for 32-bit Microcontrollers Application Note"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/AN2699-UART-Bootloader-for-SAM-L10-L11-DS00002699B.pdf"
               title="UART Bootloader SAM L10 and L11"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/AppnoteSourceCode/UARTBootloaderforSAML10SAML11.zip"
               title="SAML10L11 UART Bootloader"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/Getting-Started-with-SAML10L11-Xplained-Pro-DS00002722A.pdf"
               title="AN2722 - Getting Started With SAM L10 / L11 Xplained Pro Application Note"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/CPU-Usage-Demonstration-Using-DMAC-for-SAML10-AN-DS00002775A.pdf"
               title="CPU Usage Demonstration Using DMAC for SAM L10 MCUs Application Note"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/SAM-L10SAM-L11-OpAmp-As-ADC-Gain-Amplifier-DS00002794A-US.pdf"
               title="OPAMP as ADC Gain Amplifier for SAM L10 MCUs Application Notes"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/ApplicationNotes/SAML11_Ultra_Low-Power_SecureLoRa_Demonstration_DS00002835B.pdf"
               title="SAML11 Ultra Low-Power Secure LoRa Application Note"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ApplicationNotes/AppnoteSourceCode/AN2835SourceCode.zip"
