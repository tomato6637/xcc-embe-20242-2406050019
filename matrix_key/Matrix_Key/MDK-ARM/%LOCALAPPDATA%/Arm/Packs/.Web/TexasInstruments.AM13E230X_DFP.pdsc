<?xml version="1.0" encoding="utf-8"?>

<package schemaVersion="1.4" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>TexasInstruments</vendor>
    <name>AM13E230X_DFP</name>
    <description>Device Family Pack for Texas Instruments AM13E230X Series</description>
    <url>https://software-dl.ti.com/msp430/esd/MSPM0-CMSIS/AM13E230X/latest/exports/</url>
    <supportContact>https://e2e.ti.com/support/microcontrollers/</supportContact>
    <license>01_Pack/license.txt</license>

    <releases>
        <release version="1.0.0" date="2026-07-07">
        Initial release of AM13E230X series device family pack.
        New device support:
            * AM13E23019
            * AM13E23018
            * AM13E23017
        </release>
    </releases>

    <keywords>
        <!-- keywords for indexing -->
        <keyword>Texas Instruments</keyword>
        <keyword>AM13</keyword>
        <keyword>AM13E230</keyword>
        <keyword>AM13E23019</keyword>
        <keyword>AM13E23018</keyword>
        <keyword>AM13E23017</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package Texas Instruments</keyword>
      </keywords>

    <!-- devices section (mandatory for Device Family Packs) -->
    <devices>
        <family Dfamily="AM13E230X Series" Dvendor="Texas Instruments:16">
            <processor Dcore="Cortex-M33" DcoreVersion="r0p0" Dfpu="1" Dmpu="1" Ddsp="1" Dclock="200000000" Dendian="Little-endian"/>
            <debugconfig default="swd" clock="5000000" swj="1"/>
            <book name="https://developer.arm.com/documentation/100235/latest/" title="Cortex-M33 Generic User Guide"/>
            <description>
 <!-- TODO -->
            </description>
            <!-- debug sequences -->

            <!-- features common for the whole family -->
            <feature type="NVIC" n="47" name="Nested Vectored Interrupt Controller (NVIC)"/>
            <feature type="DMA" n="12" name="Direct Memory Access (DMA)"/>
            <feature type="Other" n="1" name="32-bit Trigonometric Math Unit (TMU)"/>
            <feature type="Other" n="1" name="Neural-Network Processing Unit (NPU)"/>
            <feature type="ClockOther" name="Internal 32MHz oscillator with +-1% accuracy (SYSOSC)"/>
            <feature type="ClockOther" name="Internal 32kHz oscillator (LFOSC)"/>
            <feature type="PowerMode" n="11" name="RUN0, SLEEP, STOP, STANDBY0, STANDBY1, SHUTDOWN"/>
            <feature type="VCC" n="1.62" m="3.6"/>
            <feature type="Temp" n="-40" m="125" name="Extended Operating Temperature Range"/>
            <feature type="WDT" n="1" name="Window-watchdog timer"/>
            <feature type="AnalogOther" n="1" name="Configurable 1.65V or 2.5V internal shared voltage reference (VREF)"/>
            <debug   svd="03_SVD/AM13E230x.svd"/>

            <device Dname="AM13E23019">
                <memory name="Flash_Bank0" access="rx"  start="0x00000000" size="0x00040000" startup="1" default="1"/>
                <memory name="Flash_Bank1" access="rx"  start="0x00040000" size="0x00040000" default="0"/>
                <memory name="RAM_S"       access="rwx" start="0x20000000" size="0x00018000" default="1"/>
                <memory name="RAM_C"       access="rwx" start="0x00C18000" size="0x00008000" default="0"/>
                <algorithm name="02_Flash_Programming/AM13E23019_Main_Bank0.FLM" start="0x00000000" size="0x00040000" default="1"/>
                <algorithm name="02_Flash_Programming/AM13E23019_Main_Bank1.FLM" start="0x00040000" size="0x00040000" default="1"/>
                <algorithm name="02_Flash_Programming/AM13E23019_Non_Main.FLM" start="0x60100000" size="0x00002000" default="0"/>
            </device>
            <device Dname="AM13E23018">
                <memory name="Flash_Bank0" access="rx"  start="0x00000000" size="0x00020000" startup="1" default="1"/>
                <memory name="Flash_Bank1" access="rx"  start="0x00040000" size="0x00020000" default="0"/>
                <memory name="RAM_S"       access="rwx" start="0x20000000" size="0x00018000" default="1"/>
                <memory name="RAM_C"       access="rwx" start="0x00C18000" size="0x00008000" default="0"/>
                <algorithm name="02_Flash_Programming/AM13E23018_Main_Bank0.FLM" start="0x00000000" size="0x00020000" default="1"/>
                <algorithm name="02_Flash_Programming/AM13E23018_Main_Bank1.FLM" start="0x00040000" size="0x00020000" default="1"/>
                <algorithm name="02_Flash_Programming/AM13E23018_Non_Main.FLM" start="0x60100000" size="0x00002000" default="0"/>
            </device>
            <device Dname="AM13E23017">
                <memory name="Flash_Bank0" access="rx"  start="0x00000000" size="0x00010000" startup="1" default="1"/>
                <memory name="Flash_Bank1" access="rx"  start="0x00040000" size="0x00010000" default="0"/>
                <memory name="RAM_S"       access="rwx" start="0x20000000" size="0x00010000" default="1"/>
                <algorithm name="02_Flash_Programming/AM13E23017_Main_Bank0.FLM" start="0x00000000" size="0x00010000" default="1"/>
                <algorithm name="02_Flash_Programming/AM13E23017_Main_Bank1.FLM" start="0x00040000" size="0x00010000" default="1"/>
                <algorithm name="02_Flash_Programming/AM13E23017_Non_Main.FLM" start="0x60100000" size="0x00002000" default="0"/>
            </device>
        </family>
    </devices>

</package>
