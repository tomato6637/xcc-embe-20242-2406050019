<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.46"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.46/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>PIC32CX-SG61_DFP</name>
   <description overview="./OVERVIEW.md">Microchip PIC32CX-SG61 Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="1.3.171" date="2026-02-27">
                - Added CMSIS flash loaders.
                - Added ARMCC scatter/linker script.
                - CMSIS System Initialization is now included as default. Define DISABLE_CMSIS_INIT to not include.
                - DEVXML-7483 Interrupt handler in startup_(device).c changed: SVCall_Handler changed -&gt; SVC_Handler and NonMaskableInt_Handler -&gt; NMI_Handler.
                - MHD-4523 Enabled setting Debug Access Level with PicKit and IDC 4/5.
                - DEVXML-7079 Misc. XC32 linker script fixes (stale CMCC configuration, TCM configuration).
			</release>
      <release version="1.2.124" date="2023-10-05">
                - Changed license of header files to Apache-2.0.
                - Fixed endian and peripheral sizes in the SVD files.
                - Added interrupt captions in the SVD files.
            </release>
      <release version="1.1.122" date="2023-03-30">
                - Peripherals bitfields improvement for PDEC, SDHC, NVMCTRL.
                - PERIPHERALS segment removal (correction).
        </release>
      <release version="1.0.17" date="2022-11-29">
                - Initial release.
                - Headers minor version increased to v2.1.0.
                - Changed integer constant literal macros from _Ux_ to _UNITxx_ (where xx is 32, 16 or 8) (MISRA C2012:R12.2).
            </release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>PIC32CX-SG61</keyword>
   </keywords>
   <requirements>
      <packages>
         <package vendor="ARM" name="CMSIS"/>
      </packages>
   </requirements>
