                  title="Device page for PIC32CX1025SG61128"/>
            <book name="https://www.microchip.com/en-us/product/PIC32CX1025SG61128#Documentation"
                  title="Datasheet"/>
            <book name="https://developer.arm.com/documentation/dui0553"
                  title="Cortex-M4 Devices Generic User Guide"/>
            <feature type="NVIC" n="137"/>
            <feature type="DMA" n="32"/>
            <feature type="RNG" n="2"/>
            <feature type="ExtInt" n="16"/>
            <feature type="ADC" n="15"/>
            <feature type="WDT" n="1"/>
            <feature type="MPSerial" n="8"/>
            <feature type="CAN" n="2"/>
            <feature type="RTC" n="1"/>
            <feature type="Timer" n="8"/>
            <feature type="PWM" n="5"/>
            <feature type="I2S" n="1"/>
