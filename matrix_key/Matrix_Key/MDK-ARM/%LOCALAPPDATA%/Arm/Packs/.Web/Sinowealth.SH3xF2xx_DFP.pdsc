          <memory     name="Main"     access="rx"      start="0x00000000"  size="0x40000"    startup="1"   default="1"/>        
          <memory     name="E2PROM"   access="rx"      start="0x0FFF0000"  size="0x3000"     startup="1"   default="1"/>        
          <memory     name="Custom"   access="rx"      start="0x0FFFE800"  size="0x800"      startup="1"   default="1"/>        
          <memory     name="SRAM"     access="rwx"     start="0x20000000"  size="0x2000"     uninit ="0"   default="1"/>
          <memory     name="CRAM"     access="rwx"     start="0x10000000"  size="0x4000"     uninit ="0"   default="1"/>
          
       		<algorithm  name="Flash/SH32F2053.FLM"      start="0x00000000"  size="0x10000000"    RAMstart="0x20000000"  RAMsize="0x2000"  default="1"/>
          
          <environment name="iar">
         		<file category="linkerfile" name="Device/SH3xF2xx_SA0/Source/IAR/sh32f2053_iar.icf"/>
         	</environment>  

					<description>
SH32F2053:
- Cortex-M3                  
- Up to 120MHz                  
- Flash Size:256KB, SRAM:8KB, CRAM:16KB, EEPROM:12KB, OTP:2KB
- 3 x ADC(8CHs), 1 x MACP, 2 x MCM, 4 x GPT, 1 x QEI 
- 3 x OP, 3 x CMP                  
- 4 x Timer, 3 x UART, 2 x SPI, 1 x TWI, 16 x EXTI, 1 x CRC
- 8 channel DMA                     
- Up to 58 GPIOs
				 </description>				

				</device>
		  
