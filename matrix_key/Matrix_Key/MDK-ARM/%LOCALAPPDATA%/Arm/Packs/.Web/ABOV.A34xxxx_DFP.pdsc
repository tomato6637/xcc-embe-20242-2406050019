          </variant>
          <variant Dvariant="A34M420VLN">
            <compile define="EXTRN_VARIANT_A34M420VLN"/>
            <feature type="QFP" n="100" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A34M420RLN">
            <compile define="EXTRN_VARIANT_A34M420RLN"/>
            <feature type="QFP" n="64" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>
      </subFamily>

<!-- Subfamily : A34L71x Series -->
      <subFamily DsubFamily="A34L71x Series">
        <processor Dclock="48000000"/>
        <compile header="ProductConfig/A34L71x/Config/a34l71x.h" Pdefine="EXTRN_SUBFAMILY_A34L71x"/>
        <debug svd="ProductConfig/A34L71x/SVD/a34l71x.svd"/>

        <book name="https://www.abovsemi.com/document/viewer.php?file=1727393892.pdf&amp;d_it_id=1727393892&amp;fileName=STD10-UM_A34L716_Eng.pdf"
              title="A34L71x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1727393362.pdf&amp;d_it_id=1727393362&amp;fileName=STD10-DS_A34L716_Eng.pdf"
              title="A34L71x Data Sheet"/>

        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="1.8" m="3.6"/>
        <feature type="IntRC" n="32000000" name="HSI (High-Speed Internal Oscillator)"/>
        <feature type="IntRC" n="40000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="86" name="NVIC"/>
        <feature type="Timer" n="8" m="16" name="Timer Module with 16bit resolution"/>
        <feature type="Timer" n="1" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="XTAL" n="4000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="XTAL" n="32768" m="32768" name="LSE (Low-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="DMA" n="7" name="High-Speed DMA"/>
        <feature type="MemoryOther" n="1" name="32KB Data Flash Memory"/>
        <feature type="Other" n="1" name="CRC"/>

<!-- Device : A34L716 -->
        <device Dname="A34L716">
          <description>
256KB Code Flash and below H/W modules vary depending on package type.
  - IOs, ADC, DAC, I2C, SPI, UART, USART and LPUART.
  - For more information, refer ordering information in user manual.
          </description>
          <memory id="IRAM1" start="0x20000000" size="0x6000" init="0" default="1" />
          <memory id="IROM1" start="0x00000000" size="0x40000" startup="1" default="1" />
          <algorithm name="ProductConfig/A34L71x/FPA/FLM/a34l71x_code.flm" start="0x00000000" size="0x40000" default="1" />

<!-- Variants -->
          <variant Dvariant="A34L716VLN">
            <compile define="EXTRN_VARIANT_A34L716VLN"/>
            <feature type="QFP" n="100" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A34L716RLN">
            <compile define="EXTRN_VARIANT_A34L716RLN"/>
            <feature type="QFP" n="64" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A34L716JYN">
            <compile define="EXTRN_VARIANT_A34L716JYN"/>
            <feature type="QFN" n="56" name="Quad Flat No-Lead Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>
      </subFamily>

<!-- Subfamily : A34G43x Series -->
      <subFamily DsubFamily="A34G43x Series">
        <processor Dclock="200000000"/>
        <compile header="ProductConfig/A34G43x/Config/a34g43x.h" Pdefine="EXTRN_SUBFAMILY_A34G43x"/>
        <debug svd="ProductConfig/A34G43x/SVD/a34g43x.svd"/>

        <book name="https://www.abovsemi.com/document/viewer.php?file=1767944538.pdf&amp;d_it_id=1767944538&amp;fileName=STD10-UM_A34G43x_Eng.pdf"
              title="A34G43x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1767943214.pdf&amp;d_it_id=1767943214&amp;fileName=STD10-DS_A34G43x_Eng.pdf"
              title="A34G43x Data Sheet"/>

        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="1.8" m="3.6"/>
        <feature type="IntRC" n="16000000" name="HSI (High-Speed Internal Oscillator)"/>
        <feature type="IntRC" n="500000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="86" name="NVIC"/>
        <feature type="Timer" n="10" m="16" name="Timer Module with 16bit resolution"/>
        <feature type="Timer" n="2" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="XTAL" n="4000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="XTAL" n="32768" m="32768" name="LSE (Low-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="DMA" n="16" name="High-Speed DMA"/>
        <feature type="MemoryOther" n="1" name="32KB Data Flash Memory"/>
        <feature type="Other" n="1" name="CRC"/>

<!-- Device : A34G43A -->
        <device Dname="A34G43A">
          <description>
2048KB Code Flash and below H/W modules vary depending on package type.
  - IOs, ADC, DAC, I2C, SPI, UART and QSPI.
  - For more information, refer ordering information in user manual.
          </description>
          <memory id="IRAM1" start="0x20000000" size="0x40000" init="0" default="1" />
          <memory id="IROM1" start="0x00000000" size="0x200000" startup="1" default="1" />
          <algorithm name="ProductConfig/A34G43x/FPA/FLM/a34g43x_code.flm" start="0x00000000" size="0x40000" default="1" />

<!-- Variants -->
          <variant Dvariant="A34G43AYLN">
            <compile define="EXTRN_VARIANT_A34G43AYLN"/>
            <feature type="QFP" n="120" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A34G43AVLN">
            <compile define="EXTRN_VARIANT_A34G43AVLN"/>
            <feature type="QFP" n="100" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A34G43ARLN">
            <compile define="EXTRN_VARIANT_A34G43ARLN"/>
            <feature type="QFP" n="64" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>

<!-- Device : A34G430 -->
