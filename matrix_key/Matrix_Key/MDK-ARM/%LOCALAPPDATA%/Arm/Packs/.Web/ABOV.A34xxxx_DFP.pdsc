    </family>
  </devices>


<!-- ############## Definition of Conditions  -->
<conditions>
<!-- Condition for Cross compiler -->
<condition id="ARMCC Compiler">
  <require Tcompiler="ARMCC" Toptions="AC5"/>
</condition>

<!-- Condition for Family -->
<condition id="A34xxxx">
  <description> ABOV A34xxxx Family Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A34*"/>
</condition>

<!-- Condition for SubFamily -->
<condition id="A34M41x">
  <description> ABOV A34M41x Series Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A34M41[864]*"/>
</condition>
<condition id="A34M42x">
  <description> ABOV A34M42x Series Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A34M42[0]*"/>
</condition>
<condition id="A34L71x">
  <description> ABOV A34L71x Series Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A34L71[6]*"/>
</condition>
<condition id="A34G43x">
  <description> ABOV A34G43x Series Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A34G43[0A]*"/>
</condition>

<!-- Condition for Family + CMSIS -->
<condition id="A34xxxx CMSIS">
  <description> ABOV A34xxxx Family Device and CMSIS-Core </description>
  <require condition="A34xxxx"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>

<!-- Condition for SubFamily + CMSIS -->
<condition id="A34M41x CMSIS">
  <description> ABOV A34M41x Series Device and CMSIS-Core </description>
  <require condition="A34M41x"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>
<condition id="A34M42x CMSIS">
  <description> ABOV A34M42x Series Device and CMSIS-Core </description>
  <require condition="A34M42x"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>
<condition id="A34L71x CMSIS">
  <description> ABOV A34L71x Series Device and CMSIS-Core </description>
  <require condition="A34L71x"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>
<condition id="A34G43x CMSIS">
  <description> ABOV A34G43x Series Device and CMSIS-Core </description>
  <require condition="A34G43x"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>

<!-- Condition for Family + Compiler -->
<!-- Condition for SubFamily + Compiler is not needed because only ARMCC is required for PACK -->
<condition id="A34xxxx ARMCC">
  <description> ABOV A34xxxx Family with ARMCC Compiler </description>
  <require condition="A34xxxx"/>
  <require condition="ARMCC Compiler"/>
</condition>

<!-- Condition for common components -->
<condition id="A34xxxx CMSIS CStartup">
  <description> Common components for A34xxxx family </description>
  <require condition="A34xxxx CMSIS"/>
  <require Cbundle="Platform" Cclass="Device" Cgroup="Startup"/>
</condition>
<condition id="A34xxxx Serial">
  <description> Common debug for A34xxxx family </description>
  <require condition="A34xxxx CMSIS CStartup"/>
  <accept Cbundle="Platform" Cclass="Device" Cgroup="Driver" Csub="HAL"/>
</condition>
</conditions>


<!-- ############## Definitions of Components -->
<components>
  <bundle Cbundle="Platform" Cclass="Device" isDefaultVariant="true" Cversion="1.0.0">
    <description> ABOV Solutions delivered thru. "Platform" </description>
    <doc></doc>

<!-- Component : Startup -->
    <component Cgroup="Startup" condition="A34xxxx CMSIS">
      <description> System Startup for A34xxxx family </description>
      <RTE_Components_h>
        #define RTE_DEVICE_STARTUP_A34XXXX    /* Device Startup for A34XXXX */
      </RTE_Components_h>

      <files>
        <file category="include" name="Framework/CMSIS/Device/ABOV/Include/"/>
        <file category="header" name="Framework/CMSIS/Device/ABOV/Include/system_a34xxxx.h"/>
        <file category="source" condition="A34xxxx ARMCC" name="Framework/CMSIS/Device/ABOV/Source/startup_a34xxxx.c"/>
        <file category="source" condition="A34xxxx ARMCC" name="Framework/CMSIS/Device/ABOV/Source/system_a34xxxx.c"/>
      </files>
    </component>

<!-- Component : HAL -->
    <component Cgroup="Driver" Csub="HAL" condition="A34xxxx CMSIS CStartup">
      <description> HAL </description>
      <RTE_Components_h>
        #define RTE_DEVICE_DRIVER_HAL
      </RTE_Components_h>
      <files>
        <file category="include" name="Platform/HAL/Include/"/>
        <file category="include" name="Platform/HAL/HPL/Include/"/>

        <file category="source" name="Platform/HAL/SCU/hal_scu.c"/>
        <file category="source" name="Platform/HAL/SCU/hal_scu_clk.c"/>
        <file category="source" name="Platform/HAL/PCU/hal_pcu.c"/>
        <file category="source" name="Platform/HAL/UART/hal_uart.c"/>
        <file category="source" name="Platform/HAL/HPL/DMA/hpl_dma.c"/>
        <file category="source" name="Platform/HAL/HPL/NMI/hpl_nmi.c"/>
      </files>
    </component>
  </bundle>

<!-- Component : Utility -->
  <component Cclass="Utility" Cgroup="Debug" Csub="Serial" Cversion="1.0.0" condition="A34xxxx Serial">
    <description> Utility Serial Debug Driver </description>
    <RTE_Components_h>
      #define RTE_UTILITY_DEBUG_COMMON
