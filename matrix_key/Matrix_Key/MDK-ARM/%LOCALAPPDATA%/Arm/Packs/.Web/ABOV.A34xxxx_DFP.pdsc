<?xml version="1.0" encoding="UTF-8"?>

<package schemaVersion="1.7.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>ABOV</vendor>
  <url>https://www.abov.co.kr/data/mds/PACK/</url>
  <name>A34xxxx_DFP</name>
  <supportContact>abov_fae@abov.co.kr</supportContact>
  <description>Package Descriptor about A34xxxx-Device support, Driver and Example</description>
  
  <releases>
    <release version="1.0.13" date="2026-07-29">
      * Changes
        - Supported Chipsets.
          * Cortex-M0+  : A31xxxx Series
            - A31C11x
    </release>
    <release version="1.0.12" date="2026-05-08">
      * Changes
        - Supported Chipsets.
          * Cortex-M0+  : A31xxxx Series
            - A31C14x
            - A31C21x
    </release>
  </releases>
  
<!-- keywords for indexing -->
  <keywords>
    <keyword>ABOV</keyword>
    <keyword>Device Family Package ABOV</keyword>
    <keyword>Cortex-M4F</keyword>
    <keyword>A34xxxx</keyword>
    <keyword>A34M41x</keyword>
    <keyword>A34M42x</keyword>
    <keyword>A34L71x</keyword>
    <keyword>A34G43x</keyword>
    <keyword>A34M418</keyword>
    <keyword>A34M416</keyword>
    <keyword>A34M414</keyword>
    <keyword>A34M420</keyword>
    <keyword>A34L716</keyword>
    <keyword>A34G43A</keyword>
    <keyword>A34G430</keyword>
  </keywords>


<!-- ############## Definition of Devies -->
  <devices>
    <family Dfamily="A34xxxx Family" Dvendor="ABOV Semiconductor:126">
      <processor Dcore="Cortex-M4" DcoreVersion="r0p0" Dfpu="1" Dmpu="0" Dendian="Little-endian"/>
      <book name="https://developer.arm.com/documentation/dui0553/b" title="Cortex-M4F Generic User Guide"/>
      <description>
A34xxxx is a 32bit microcontroller family based on Cortex-M4F and combines ARM Cortex architecture and various peripherals available in platform.
It also provides low-power, real-time performance, advanced architecture and high performance and is also a good approach for cost-sensitive application especially.
      </description>
      <book name="Document/Doxygen/AUDK32.chm" title="ABOV Unified Development Kit 32bit (AUDK32)"/>
      <book name="https://abov.atlassian.net/wiki/spaces/AUDK32/pages/2070675457/CMSIS-Pack" title="AUDK32 CMSIS-Pack User Guide"/>

<!-- Subfamily : A34M41x Series -->
      <subFamily DsubFamily="A34M41x Series">
        <processor Dclock="120000000"/>
        <compile header="ProductConfig/A34M41x/Config/a34m41x.h" Pdefine="EXTRN_SUBFAMILY_A34M41x"/>
        <debug svd="ProductConfig/A34M41x/SVD/a34m41x.svd"/>
        
        <book name="https://www.abovsemi.com/document/viewer.php?file=1566810203.pdf&amp;d_it_id=1566810203&amp;fileName=UM_A34M41x_Eng.pdf"
              title="A34M41x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1566809888.pdf&amp;d_it_id=1566809888&amp;fileName=DS_A34M41x_Eng.pdf"
              title="A34M41x Data Sheet"/>

        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="2.7" m="5.5"/>
        <feature type="IntRC" n="32000000" name="HSI (High-Speed Internal Oscillator)"/> 
        <feature type="IntRC" n="500000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="86" name="NVIC"/>
        <feature type="Timer" n="10" m="16" name="Timer Module with 16bit resolution"/>
        <feature type="Timer" n="2" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="PWM" n="2" m="16" name="Pulse Width Modulation"/>
        <feature type="XTAL" n="4000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="XTAL" n="32768" m="32768" name="LSE (Low-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="DMA" n="16" name="High-Speed DMA"/>
        <feature type="RNG" n="1" name="True Random Number Generator"/>
        <feature type="MemoryOther" n="1" name="32KB Data Flash Memory"/>
        <feature type="AnalogOther" n="4" name="CMP (Comparator)"/>
        <feature type="AnalogOther" n="3" name="PGA (Programmable Gain Amplifier)"/>
        <feature type="Other" n="1" name="CRC"/>
        <feature type="Other" n="1" name="Quadrature Encoder Interface"/>

<!-- Device : A34M418 -->
        <device Dname="A34M418">
          <description>
512KB Code Flash and below H/W modules vary depending on package type.
  - IOs, ADC, I2C, SPI and UART
  - For more information, refer ordering information in user manual.          
          </description>
          <memory id="IRAM1" start="0x20000000" size="0x10000" init="0" default="1" />
          <memory id="IROM1" start="0x00000000" size="0x80000" startup="1" default="1" />
          <algorithm name="ProductConfig/A34M41x/FPA/FLM/a34m41x_code.flm" start="0x00000000" size="0x10000" default="1" />
          
<!-- Variants -->
          <variant Dvariant="A34M418YLN">
            <compile define="EXTRN_VARIANT_A34M418YLN"/>
            <feature type="QFP" n="120" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A34M418VLN">
            <compile define="EXTRN_VARIANT_A34M418VLN"/>
            <feature type="QFP" n="100" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A34M418RLN">
            <compile define="EXTRN_VARIANT_A34M418RLN"/>
            <feature type="QFP" n="64" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>

<!-- Device : A34M416 -->
        <device Dname="A34M416">
          <description>
256KB Code Flash and below H/W modules vary depending on package type.
  - IOs, ADC, I2C, SPI and UART
  - For more information, refer ordering information in user manual.          
          </description>
          <memory id="IRAM1" start="0x20000000" size="0x10000" init="0" default="1" />
          <memory id="IROM1" start="0x00000000" size="0x40000" startup="1" default="1" />
          <algorithm name="ProductConfig/A34M41x/FPA/FLM/a34m41x_code.flm" start="0x00000000" size="0x10000" default="1" />
          
<!-- Variants -->
          <variant Dvariant="A34M416VLN">
            <compile define="EXTRN_VARIANT_A34M416VLN"/>
            <feature type="QFP" n="100" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>     
          <variant Dvariant="A34M416RLN">
            <compile define="EXTRN_VARIANT_A34M416RLN"/>
            <feature type="QFP" n="64" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>

<!-- Device : A34M414 -->
        <device Dname="A34M414">
          <description>
128KB Code Flash and below H/W modules vary depending on package type.
  - IOs, ADC, I2C, SPI and UART
  - For more information, refer ordering information in user manual.          
          </description>
          <memory id="IRAM1" start="0x20000000" size="0x8000" init="0" default="1" />
          <memory id="IROM1" start="0x00000000" size="0x20000" startup="1" default="1" />
          <algorithm name="ProductConfig/A34M41x/FPA/FLM/a34m41x_code.flm" start="0x00000000" size="0x10000" default="1" />
          
<!-- Variants -->
          <variant Dvariant="A34M414VLN">
            <compile define="EXTRN_VARIANT_A34M414VLN"/>
            <feature type="QFP" n="100" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>     
          <variant Dvariant="A34M414RLN">
            <compile define="EXTRN_VARIANT_A34M414RLN"/>
            <feature type="QFP" n="64" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>
      </subFamily>    

<!-- Subfamily : A34M42x Series -->
      <subFamily DsubFamily="A34M42x Series">
        <processor Dclock="140000000"/>
        <compile header="ProductConfig/A34M42x/Config/a34m42x.h" Pdefine="EXTRN_SUBFAMILY_A34M42x"/>
        <debug svd="ProductConfig/A34M42x/SVD/a34m42x.svd"/>

        <book name="https://www.abovsemi.com/document/viewer.php?file=1712280836.pdf&amp;d_it_id=1712280836&amp;fileName=STD10-UM_A34M420_Eng.pdf"
              title="A34M42x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1709514018.pdf&amp;d_it_id=1709514018&amp;fileName=STD10-DS_A34M420_Eng.pdf"
              title="A34M42x Data Sheet"/>

        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="2.5" m="5.5"/>
        <feature type="IntRC" n="32000000" name="HSI (High-Speed Internal Oscillator)"/>
        <feature type="IntRC" n="500000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="86" name="NVIC"/>
        <feature type="Timer" n="10" m="16" name="Timer Module with 16bit resolution"/>
        <feature type="Timer" n="2" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="PWM" n="2" m="16" name="Pulse Width Modulation"/>
        <feature type="XTAL" n="4000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="XTAL" n="32768" m="32768" name="LSE (Low-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="DMA" n="16" name="High-Speed DMA"/>
        <feature type="RNG" n="1" name="True Random Number Generator"/>
        <feature type="MemoryOther" n="1" name="32KB Data Flash Memory"/>
        <feature type="Other" n="1" name="CRC"/>

<!-- Device : A34M420 -->
        <device Dname="A34M420">
          <description>
1024KB Code Flash and below H/W modules vary depending on package type.
  - IOs, ADC, I2C, SPI and UART
  - For more information, refer ordering information in user manual.
          </description>
          <memory id="IRAM1" start="0x20000000" size="0x10000" init="0" default="1" />
          <memory id="IROM1" start="0x00000000" size="0x100000" startup="1" default="1" />
          <algorithm name="ProductConfig/A34M42x/FPA/FLM/a34m42x_code.flm" start="0x00000000" size="0x10000" default="1" />

<!-- Variants -->
          <variant Dvariant="A34M420YLN">
            <compile define="EXTRN_VARIANT_A34M420YLN"/>
