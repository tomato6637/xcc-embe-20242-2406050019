<?xml version="1.0"?>
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.4" xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>FMD</vendor>
    <name>FT32F4xx_DFP</name>
    <description>FremontMicro FT32F4 Series Device Support, Drivers and Examples</description>
    <url>https://www.fremontmicro.com/upload/tools/pack/</url>
    <releases>
        <release version="1.0.3" date="2026-08-18">1. Changed the selection, adding FT32F407RE.
2. Fixed existing bugs.
3. Updated SVD files.</release><release version="1.0.2" date="2026-05-20">1.Update the maximum clock setting's flash lantency to 9.
2.Fixed the issue of setting register bits in some ADC functions.</release><release version="1.0.1" date="2026-04-17">1. Fixed DMA channel priority configuration issue
2. Fixed FS Device data endpoint PID alternation issue
3. Fixed FS Device ZLP packet sending issue
4. Fixed FS Host EP0 endpoint packet splitting function
5. Recalibrated SVD files</release><release version="1.0.0" date="2025-10-28">First Release version of FT32F4 Device Family Pack.</release>
    </releases>
    <keywords>
        <!-- keywords for indexing -->
        <keyword>FMD</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package FremontMicro</keyword>
        <keyword>FT32F4</keyword>
        
    </keywords>
    <devices>
        <family Dfamily="FT32F4 Series" Dvendor="FMD:169">
            <processor Dcore="Cortex-M4" DcoreVersion="r0p1" Dfpu="1" Dmpu="1" Dendian="Little-endian"/>
            <book name="Documents/Cortex-M4 Devices Generic User Guide.pdf" title="Cortex-M4 Generic User Guide"/>
            <description>
The FT32F4 family incorporates high-speed embedded memories and an extensive range of enhanced I/Os and peripherals connected to two APB buses, three AHB buses and a 32-bit multi-AHB bus matrix.
- 64-Kbyte of CCM (core coupled memory) data RAM
- On-the-go USB with PHY
- Timer with quadrature (incremental) encoder input
- 5 V-tolerant I/Os
- True random number generator
- RTC: subsecond accuracy, hardware calendar
- 96-bit unique ID
			</description>
            <feature type="WDT" n="2"/>
            <feature type="RTC" n="32768"/>
            <feature type="CAN" n="4"/>
            <feature type="USBD" n="2"/>
            <feature type="VCC" n="1.80" m="3.60"/>
            <feature type="Temp" n="-40" m="85"/>
            <feature type="Temp" n="-40" m="105"/>
            <!-- ************************  Subfamily 'FT32F405'  **************************** -->
            <subFamily DsubFamily="FT32F405">
                <processor Dclock="210000000"/>
                <debug svd="SVD/FT32F405x.svd"/>
                <!--book name="Documents/DATASHEET.pdf" title="FT32F4"/-->
                <feature type="Timer" n="18" m="16"/>
                <feature type="DAC" n="2" m="12"/>
                <feature type="SPI" n="3" m="48000000"/>
                <feature type="I2C" n="3"/>
                <feature type="USART" n="4" m="10500000"/>
                <feature type="UART" n="3" m="10500000"/>
                <feature type="USBOTG" n="2"/>
                <feature type="SDIO" n="1" m="8" name="Secure Digital IO"/>
                <!--feature type="AUDIO"  n="1"/>
				<feature type="EQEP"   n="1"/>
				<feature type="ECAP"   n="1"/-->
                <!-- *************************  Device 'FT32F405REA2'  ***************************** -->
                <device Dname="FT32F405REA2">
                    <memory id="IROM1" start="0x08000000" size="0x00080000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00020000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x10000000" size="0x00010000" init="0" default="0"/>
                    <algorithm name="Flash/FT32F4xx_512.FLM" start="0x08000000" size="0x00080000" default="1"/>
                    <algorithm name="Flash/FT32F4xx_OPT.FLM" start="0x1FFF0800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="51"/>
                    <feature type="ADC" n="16" m="12"/>
					<!--feature type="LQFP"  n="64"/-->
                </device>
                <!-- *************************  Device 'FT32F405VEA2'  ***************************** -->
                <device Dname="FT32F405VEA2">
                    <memory id="IROM1" start="0x08000000" size="0x00080000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00020000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x10000000" size="0x00010000" init="0" default="0"/>
                    <algorithm name="Flash/FT32F4xx_512.FLM" start="0x08000000" size="0x00080000" default="1"/>
                    <algorithm name="Flash/FT32F4xx_OPT.FLM" start="0x1FFF0800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="82"/>
                    <feature type="ADC" n="24" m="12"/>
					<!--feature type="LQFP"  n="100"/-->
                </device><!-- *************************  Device 'FT32F405RDA2'  ***************************** --><device Dname="FT32F405RDA2">
                    <memory id="IROM1" start="0x08000000" size="0x00060000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00020000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x10000000" size="0x00010000" init="0" default="0"/>
                    <algorithm name="Flash/FT32F4xx_384.FLM" start="0x08000000" size="0x00060000" default="1"/>
                    <algorithm name="Flash/FT32F4xx_OPT.FLM" start="0x1FFF0800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="82"/>
                    <feature type="ADC" n="24" m="12"/>
					<!--feature type="LQFP"  n="100"/-->
                </device>
			</subFamily>
            <!-- ************************  Subfamily 'FT32F407'  **************************** -->
            <subFamily DsubFamily="FT32F407">
                <processor Dclock="210000000"/>
                <debug svd="SVD/FT32F407x.svd"/>
                <!--book name="Documents/DATASHEET.pdf" title="FT32F4"/-->
                <feature type="Timer" n="18" m="16"/>
                <feature type="DAC" n="2" m="12"/>
                <feature type="SPI" n="3" m="48000000"/>
				<feature type="I2S" n="2"/>
				<!--feature type="QSPI"   n="1"/-->
				<feature type="I2C" n="3"/>
                <feature type="USART" n="4" m="10500000"/>
                <feature type="UART" n="2" m="10500000"/>
                <feature type="USBOTG" n="3"/>
                <feature type="SDIO" n="1" m="8" name="Secure Digital IO"/>
                <!--feature type="AUDIO"  n="1"/>
				<feature type="EQEP"   n="1"/>
				<feature type="ECAP"   n="1"/-->
                <!-- *************************  Device 'FT32F407VEA2'  ***************************** -->
                <device Dname="FT32F407VEA2">
                    <memory id="IROM1" start="0x08000000" size="0x00080000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00020000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x10000000" size="0x00010000" init="0" default="0"/>
                    <algorithm name="Flash/FT32F4xx_512.FLM" start="0x08000000" size="0x00080000" default="1"/>
                    <algorithm name="Flash/FT32F4xx_OPT.FLM" start="0x1FFF0800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="82"/>
                    <feature type="ADC" n="24" m="12"/>
					<!--feature type="LQFP"  n="100"/-->
                </device>
                <!-- *************************  Device 'FT32F407VDA2'  ***************************** -->
                <device Dname="FT32F407VDA2">
                    <memory id="IROM1" start="0x08000000" size="0x00060000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00020000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x10000000" size="0x00010000" init="0" default="0"/>
                    <algorithm name="Flash/FT32F4xx_384.FLM" start="0x08000000" size="0x00060000" default="1"/>
                    <algorithm name="Flash/FT32F4xx_OPT.FLM" start="0x1FFF0800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="82"/>
                    <feature type="ADC" n="24" m="12"/>
					<!--feature type="LQFP"    n="100"/-->
                </device><!-- *************************  Device 'FT32F407REA2'  ***************************** --><device Dname="FT32F407REA2">
                    <memory id="IROM1" start="0x08000000" size="0x00080000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00020000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x10000000" size="0x00010000" init="0" default="0"/>
                    <algorithm name="Flash/FT32F4xx_512.FLM" start="0x08000000" size="0x00080000" default="1"/>
                    <algorithm name="Flash/FT32F4xx_OPT.FLM" start="0x1FFF0800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="51"/>
                    <feature type="ADC" n="16" m="12"/>
					<!--feature type="LQFP"  n="64"/-->
                </device>
            </subFamily>
        </family>
    </devices>
    <!--FT32F4xx conditions-->
    <conditions>
        <!-- conditions selecting Compiler -->
        <condition id="Compiler ARMCC">
            <require Tcompiler="ARMCC"/>
        </condition>
        <!--FT32F405xx Device Conditions-->
        <condition id="FT32F405xx">
            <description>FremontMicro FT32F405xx Series devices</description>
            <require Dvendor="FMD:169" Dname="FT32F405*"/>
        </condition>
        <!--FT32F407xx Device Conditions-->
        <condition id="FT32F407xx">
            <description>FremontMicro FT32F407xx Series devices</description>
            <require Dvendor="FMD:169" Dname="FT32F407*"/>
        </condition>
        <!--FT32F40x ARMCC Conditions -->
        <condition id="FT32F40x ARMCC">
            <description>filter for FT32F40x Device and the ARM compiler</description>
            <accept condition="FT32F405xx"/>
            <accept condition="FT32F407xx"/>
            <require Tcompiler="ARMCC"/>
        </condition>
        <!--FT32F4xx CMSIS Conditions -->
        <condition id="FT32F4xx CMSIS">
            <description>FremontMicro FT32F4xx Device with CMSIS</description>
            <accept condition="FT32F405xx"/>
            <accept condition="FT32F407xx"/>
            <require Cclass="CMSIS" Cgroup="CORE"/>
        </condition>		
        <!--FT32F4xx STDPERIPH Conditions -->
        <condition id="FT32F4xx STDPERIPH">
            <description>FremontMicro FT32F4xx with Standard Peripherals Drivers Framework</description>
            <require condition="FT32F4xx CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
        </condition>
        <!--FT32F4xx STDPERIPH RCM Conditions-->
        <condition id="FT32F4xx STDPERIPH RCC">
            <description>FMD Semiconductor FT32F4xx with Standard Peripherals Drivers Framework and RCC</description>
            <require condition="FT32F4xx CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="RCC"/>
        </condition>
    </conditions>
    <!--FT32F4xx Standard Peripherals Drivers-->
    <components>
        <!--Startup-->
        <component Cclass="Device" Cgroup="Startup" Cversion="1.0.3" condition="FT32F4xx CMSIS">
            <description>System Startup for FremontMicro FT32F4xx device series</description>
			<RTE_Components_h>
		      #define RTE_DEVICE_STARTUP_FT32F4XX    /* Device Startup for FT32F4 */
		    </RTE_Components_h>
            <files>
                <!--  include folder -->
                <file category="include" name="Device/FT32F4xx/Include"/><file category="include" name="Device/CMSIS"/>
                
                <!-- startup files -->
                <file category="source" name="Device/FT32F4xx/source/arm/startup_ft32f407xe.s" attr="config" version="1.0.3" condition="FT32F40x ARMCC"/><file category="source" name="Device/FT32F4xx/source/arm/ft32f407xe_opt.s" attr="config" version="1.0.3" condition="FT32F40x ARMCC"/>
                <!-- system file -->
                <file category="source" name="Device/FT32F4xx/source/system_ft32f4xx.c" attr="config" version="1.0.3"/>
                <!-- device configuration required by drivers at the moment -->
            </files>
        </component>
        <!-- START: FremontMicro Standard Peripherals Drivers -->
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework" Cversion="1.0.3" condition="FT32F4xx STDPERIPH">
            <description>Standard Peripherals Drivers Framework</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_FRAMEWORK</RTE_Components_h>
            <files>
                <file category="include" name="StdPeriph_Driver/inc/"/>
                <file category="header" name="StdPeriph_Driver/inc/ft32f4xx_misc.h"/>
                <file category="source" name="StdPeriph_Driver/src/ft32f4xx_misc.c"/>
				
                
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="ADC" Cversion="1.0.3" condition="FT32F4xx STDPERIPH RCC">
            <description>Analog-to-digital converter (ADC) driver for FT32F4xx</description>
            <RTE_Components_h>#define RTE_DEVICE_ADC</RTE_Components_h>
            <files>
                <file category="header" name="StdPeriph_Driver/inc/ft32f4xx_adc.h"/>
                <file category="source" name="StdPeriph_Driver/src/ft32f4xx_adc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="COMP" Cversion="1.0.3" condition="FT32F4xx STDPERIPH ">
         <description>Comparator (COMP) driver for FT32F4xx</description>
         <RTE_Components_h>
           #define RTE_DEVICE_COMP
         </RTE_Components_h>
         <files>
           <file category="header" name="StdPeriph_Driver/inc/ft32f4xx_comp.h"/>
           <file category="source" name="StdPeriph_Driver/src/ft32f4xx_comp.c"/>
         </files>
        </component>
		<component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="CRC" Cversion="1.0.3" condition="FT32F4xx STDPERIPH">
