            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="CRS" Cversion="1.0.3" condition="FT32F4xx STDPERIPH">
            <description>CRS driver for FT32F4xx</description>
            <RTE_Components_h>#define RTE_DEVICE_CRS</RTE_Components_h>
