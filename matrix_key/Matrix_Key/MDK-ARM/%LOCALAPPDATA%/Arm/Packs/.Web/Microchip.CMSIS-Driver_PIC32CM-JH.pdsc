    </condition>
    <condition id="Require GCC or CLANG compiler">
      <accept Tcompiler="GCC"/>
      <accept Tcompiler="CLANG"/>
    </condition>
    <condition id="Require IAR compiler">
      <accept Tcompiler="IAR"/>
    </condition>
    <condition id="Require XC compiler">
      <accept Tcompiler="XC"/>
