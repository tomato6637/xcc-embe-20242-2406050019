                  name="armcc/armcc/samv71q21rt_ebi_cs1.sct"
                  version="1.3.0"
                  attr="template"
                  select="samv71q21rt_ebi_cs1"/>
            <file condition="ARMCC Exe"
                  category="linkerScript"
                  name="armcc/armcc/samv71q21rt_ebi_cs2.sct"
                  version="1.3.0"
                  attr="template"
                  select="samv71q21rt_ebi_cs2"/>
            <file condition="ARMCC Exe"
