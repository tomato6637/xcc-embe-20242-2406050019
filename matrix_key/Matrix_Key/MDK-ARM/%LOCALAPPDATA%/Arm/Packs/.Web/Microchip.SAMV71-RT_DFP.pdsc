                  </mchp:hwtool>
                  <mchp:hwtool type="mplab.pluginboardsupport">
                     <mchp:file name="hwtools/mplab/PluginBoardSupport.xml"/>
                  </mchp:hwtool>
                  <mchp:prerequisite component="MPLAB X IDE" version="[5.50-"/>
                  <mchp:prerequisite component="MPLAB XC32" version="[4.10-"/>
               </mchp:extension>
            </environment>
            <description>Cortex-M7 Microcontroller, 2.0MB Flash, 640KB SRAM, 300 MHz</description>
         </device>
      </family>
