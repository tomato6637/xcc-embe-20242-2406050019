<?xml version="1.0" encoding="UTF-8"?>

<package schemaVersion="1.7.31" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.31/schema/PACK.xsd">
  <vendor>Megawin</vendor>
  <name>CM0Plus_DFP</name>
  <description>Megawin ARM Cortex-M0+ MG32L Series Device Support</description>
  <url>https://www.megawin.com.tw/files/Download/megawinDFP/</url>
  <supportContact>sales@megawin.com.tw</supportContact>
  <!-- optional license file -->
  <!-- 
  <license>
  </license>
  -->
  <releases>
    <release version="1.4.0" date="2026-07-27">  
	        - Add MG32L003 SVD files
    </release>	
    <release version="1.3.0" date="2023-12-27">  
	        - Add MG32L003F8P6
			- Add MG32L003K8T6
    </release>	
    <release version="1.2.1" date="2023-12-21">  
			- Modify MG32L003F8U6 feature
    </release>		
    <release version="1.2.0" date="2023-11-29">  
			- Update files
	</release>	
    <release version="1.1.1" date="2023-10-02">  
			- Modify description			
	</release>					
    <release version="1.1.0" date="2023-07-13">  
			- Remove MG32L003F6P6, MG32L003K6U6, MG32L003K6T6, MG32L003F8P6, MG32L003K8T6
			- Add MG32L003F8U6
	</release>				
    <release version="1.0.0" date="2023-04-25">  
			- First create version.
	</release>	
  </releases>
  <keywords>
    <!-- keywords for indexing -->
    <keyword>Megawin</keyword>
    <keyword>CM0Plus</keyword>
    <keyword>MG32L003</keyword>
  </keywords>
  <!-- devices section (mandatory for Device Family Packs) -->
  <!-- 
	Megawin -+
					 |
					 + MG32x Series (MG32L003F8U6/K8U6)
 	-->
  <devices>
    <family Dfamily="MG32L003 Series" Dvendor="Megawin:70">
      <processor Dcore="Cortex-M0+" DcoreVersion="r0p2" Dfpu="NO_FPU" Dmpu="NO_MPU" Dendian="Little-endian" Dclock="24000000" />
      <!-- <book name="Documentation/xxx.pdf" title="Cortex-M0+ Generic User Guide"/> -->      
      <subFamily DsubFamily="MG32L003">
        <processor Dcore="Cortex-M0+" DcoreVersion="r0p2" Dfpu="NO_FPU" Dmpu="NO_MPU" Dendian="Little-endian" Dclock="24000000" />
        <!-- <book name="Documentation/xxx.pdf" title="Cortex-M3 Generic User Guide"/> -->
        <description>
CPU Operation frequency up to 24MHz
Built-in one 24-bit system tick timer
Flash / SRAM
        </description>                   
      <!-- *************************  Device 'MG32L003F8U6'  ***************************** -->    
        <device Dname="MG32L003F8U6">
          <!-- introduction -->
          <description>
The MG32L003 device family contains an ARM Cortex-M0+ processor.

Features:
- CPU Core (24MHz/SWD)
- Flash Memory (64KB)
- SRAM Memory (4KB)
- GPIO (QFN20 / IO=16)
- Timer 
- RTC
- ADC (12bit SAR ADC with 1Msps)
- UARTx2
- I2Cx1
- SPIx1
- Buzzer
- UID
          </description>
          <compile header="Device/MG32L003/Include/system_mg32l003.h" define="MG32L003F8U6" />     
		  <debug svd="SVD/MG32L003.svd"/>			  
          <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1" />
          <memory id="IRAM1" start="0x20000000" size="0x1000" init="0" default="1" />
          <algorithm name="Flash/MG32L003_64.FLM" start="0x00000000" size="0x10000" default="1" />
        </device>      
      <!-- *************************  Device 'MG32L003K8U6'  ***************************** -->     
        <device Dname="MG32L003K8U6">
          <!-- introduction -->
          <description>
The MG32L003 device family contains an ARM Cortex-M0+ processor.

Features:
- CPU Core (24MHz/SWD)
- Flash Memory (64KB)
- SRAM Memory (4KB)
- GPIO (QFN32 / IO=28)
- Timer 
- RTC
- ADC (12bit SAR ADC with 1Msps)
- UARTx2
- I2Cx1
- SPIx1
- Buzzer
- UID
          </description>
          <compile header="Device/MG32L003/Include/system_mg32l003.h" define="MG32L003K8U6" />  
		  <debug svd="SVD/MG32L003.svd"/>	
          <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1" />
          <memory id="IRAM1" start="0x20000000" size="0x1000" init="0" default="1" />
          <algorithm name="Flash/MG32L003_64.FLM" start="0x00000000" size="0x10000" default="1" />
        </device>      
      <!-- *************************  Device 'MG32L003F8P6'  ***************************** -->     
        <device Dname="MG32L003F8P6">
          <!-- introduction -->
          <description>
The MG32L003 device family contains an ARM Cortex-M0+ processor.

Features:
- CPU Core (24MHz/SWD)
- Flash Memory (64KB)
- SRAM Memory (4KB)
- GPIO (TSSOP20 / IO=16)
- Timer 
- RTC
- ADC (12bit SAR ADC with 1Msps)
- UARTx2
- I2Cx1
- SPIx1
- Buzzer
- UID
          </description>
          <compile header="Device/MG32L003/Include/system_mg32l003.h" define="MG32L003F8P6" />   
		  <debug svd="SVD/MG32L003.svd"/>	
          <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1" />
          <memory id="IRAM1" start="0x20000000" size="0x1000" init="0" default="1" />
          <algorithm name="Flash/MG32L003_64.FLM" start="0x00000000" size="0x10000" default="1" />
        </device>      		
      <!-- *************************  Device 'MG32L003K8T6'  ***************************** -->     
        <device Dname="MG32L003K8T6">
          <!-- introduction -->
          <description>
The MG32L003 device family contains an ARM Cortex-M0+ processor.

Features:
- CPU Core (24MHz/SWD)
- Flash Memory (64KB)
- SRAM Memory (4KB)
- GPIO (LQFP32 / IO=28)
- Timer 
- RTC
- ADC (12bit SAR ADC with 1Msps)
- UARTx2
- I2Cx1
- SPIx1
- Buzzer
- UID
          </description>
          <compile header="Device/MG32L003/Include/system_mg32l003.h" define="MG32L003K8T6" />     
		  <debug svd="SVD/MG32L003.svd"/>			  
          <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1" />
          <memory id="IRAM1" start="0x20000000" size="0x1000" init="0" default="1" />
          <algorithm name="Flash/MG32L003_64.FLM" start="0x00000000" size="0x10000" default="1" />
        </device>      				
      </subFamily> 	  	  	  
    </family>
  </devices>
  <!-- **************************************************************************************** -->
  <!-- conditions section (optional for all Software Packs)-->
  <!-- conditions selecting Devices -->
  <conditions>
    <!-- ************************************************************************** -->
    <condition id="MG32L003 Series">
      <description>Megawin MG32L003 Series devices</description>
      <require Dvendor="Megawin:70" Dname="MG32L003*" />
    </condition>
    <!-- ************************************************************************** -->
    <!-- Device + CMSIS Conditions -->
    <condition id="MG32L003_CMSIS">
      <description>megawin MG32L003 Series Device and CMSIS-Core</description>
	  <require condition="MG32L003 Series"/>
      <require Cclass="CMSIS" Cgroup="CORE" />
    </condition>
    <!-- ************************************************************************** -->
    <!-- Device + Compiler Conditions -->
    <condition id="Cortex_M0Plus_L003_ARMCC">
      <description>megawin MG32L003x Devices and ARMCC Compiler</description>
      <require condition="MG32L003 Series" />
      <require Tcompiler="ARMCC" />
    </condition>
	<!--
    <condition id="Cortex_M0Plus_L003_GCC">
      <description>megawin MG32L003x Devices and ARMCC Compiler</description>
      <require condition="MG32L003 Series" />
      <require Tcompiler="GCC" />
    </condition>	
	-->
    <!-- ************************************************************************** -->
    <!-- (All) Driver condition define -->
    <!-- Driver : MG32L003F6P6/K6U6/K6T6/F8P6/K8U6/K8T6 -->
    <condition id="Cortex_M0Plus_L003_DRIVER">
      <description>Driver files for ARMCC</description>
      <accept Dname="MG32L003F8U6" />
      <accept Dname="MG32L003K8U6" />
	  <accept Dname="MG32L003F8P6" />
	  <accept Dname="MG32L003K8T6" />
    </condition>
  </conditions>
  <!-- ********************************************************************************************************************************* -->
  <!-- component section (optional for all Software Packs)-->
  <components>
    <!-- ******************************************************************************************* -->
    <!-- Startup for MG32L003x -->
    <!-- ******************************************************************************************* -->
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="MG32L003_CMSIS">
      <description>System Startup for Megawin MG32L003 Series</description>
      <RTE_Components_h>
        <!-- the following content goes into file 'RTE_Components.h' -->
        #define RTE_DEVICE_STARTUP_MG32L003    /* Device Startup for MG32F103C9T6 */
        #define USE_STDPERIPH_DRIVER
        #define USE_FULL_ASSERT
      </RTE_Components_h>
      <files>
        <!--  Register include folder -->
        <file category="include" name="Device/MG32L003/Include/" />
        <file category="include" name="Driver/MG32L003/Normal_Peripheral/Include/" />
        <!-- startup files -->
        <!-- ARM Compiler Toolchain -->
        <file category="header" name="Device/MG32L003/Include/system_mg32l003.h" version="1.0.0" />        
		<file category="sourceAsm" condition="Cortex_M0Plus_L003_ARMCC" name="Device/MG32L003/Source/startup_mg32l003.s" attr="config" version="1.0.0" />
        <file category="sourceC" condition="Cortex_M0Plus_L003_ARMCC" name="Device/MG32L003/Source/system_mg32l003.c" attr="config" version="1.0.0" />				
        <!-- GCC Compiler Toolchain -->
		<!--
        <file category="linkerScript" name="Device/MG32x02z/MG32F02A132/linkerScript/MG32F02A132_FLASH.LD"   attr="config" condition="GCC" version="1.0.0"/>
        <file category="sourceAsm"    name="Device/MG32x02z/Common/Startup/startup_MG32x02z_GCC.S"  attr="config" condition="Startup IEC60730=0 GCC" version="1.0.0"/>
        <file category="sourceAsm"    name="Device/MG32x02z/Common/Startup/startup_MG32x02z_GCC2.S" attr="config" condition="Startup IEC60730=1 GCC" version="1.0.0"/>		
		-->
      </files>
    </component>
    <!-- ********************************************************************************** -->
    <!-- ********************************************************************************** -->
    <!-- ********************************************************************************** -->
    <!-- Driver selction (MG32F10x series) -->
    <component Cclass="Driver" Cgroup="Driver-All" Cversion="1.0.0" condition="Cortex_M0Plus_L003_DRIVER">
      <description>Select MG32L003 driver for project</description>
      <RTE_Components_h>
      #define MG32L003_Driver           
      </RTE_Components_h>
      <files>
        <file category="include" name="Driver/MG32L003/Utilities_Common/Include/" version="1.0.1" />
        <file category="include" name="Driver/MG32L003/Normal_Peripheral/Include/" version="1.0.1" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/misc.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_adc.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_awk.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_basetim.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_beep.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_crc.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_flash.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_gpio.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_i2c.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_iwdg.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_lptim.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_lpuart.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_lvd.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_owire.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_pca.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_pwr.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_rcc.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_rtc.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_spi.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_tim.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_uart.c" version="1.0.0" />
        <file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_vc.c" version="1.0.0" />
		<file category="sourceC" name="Driver/MG32L003/Normal_Peripheral/Source/mg32l003_wwdg.c" version="1.0.0" />
      </files>
    </component>	
  </components>
</package>