    <conditions>
        <!-- conditions are dependecy rules that can apply to a component or an individual file -->
        <condition id="Compiler ARM">
            <!-- conditions selecting ARM Compiler -->
            <require Tcompiler="ARMCC"/>
        </condition>
        <condition id="APM32E030">
            <description>Geehy Semiconductor APM32E030 Series devices</description>
            <require Dname="APM32E030??"/>
        </condition>
        <condition id="APM32E030 CMSIS Device">
            <!-- conditions selecting Devices -->
            <description>Geehy Semiconductor APM32E0 Series devices and CMSIS-CORE</description>
            <require Cclass="CMSIS" Cgroup="CORE"/>
            <require Dvendor="Geehy:163" Dname="APM32E0????"/>
        </condition>
        <condition id="APM32E030 STDPERIPH">
            <description>Geehy Semiconductor APM32F1xx with Standard Peripherals Drivers Framework</description>
            <require condition="APM32E030 CMSIS Device"/>
            <require Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="Framework"/>
        </condition>
        <condition id="APM32E030 STDPERIPH RCM">
            <description>Geehy Semiconductor APM32F1xx with Standard Peripherals Drivers Framework and RCM</description>
            <require condition="APM32E030 CMSIS Device"/>
            <require Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="Framework"/>
            <require Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="RCM"/>
        </condition>
    </conditions>
    <components>
        <component Cclass="Device" Cgroup="Startup" Cversion="1.0.3" condition="APM32E030 CMSIS Device">
            <!-- Cversion is necessary -->
            <description>System Startup for Geehy Semiconductor APM32E030 Series</description>
            <files>
                <!-- startup files -->
                <file category="source" name="Device\Device\Geehy\APM32E030\Source\arm\startup_apm32e030.s" attr="config" condition="APM32E030"/>
                <!-- system file -->
                <file category="source" name="Device\Device\Geehy\APM32E030\Source\system_apm32e030.c" attr="config"/>
            </files>
        </component>
        <!-- START: Geehy Semiconductor Standard Peripherals Drivers -->
        <component Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="Framework" Cversion="1.0.2" condition="APM32E030 STDPERIPH">
            <description>Standard Peripherals Drivers Framework</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_FRAMEWORK</RTE_Components_h>
            <files>
                <file category="include" name="Device/APM32E030_StdPeriphDriver/inc/"/>
                <file category="header" name="Device/APM32E030_StdPeriphDriver/inc/apm32e030_misc.h"/>
                <file category="source" name="Device/APM32E030_StdPeriphDriver/src/apm32e030_misc.c"/>
                <file category="header" name="Device/Templates/inc/apm32e030_int.h" attr="template" select="Interrupt Service Routines"/>
                <file category="source" name="Device/Templates/src/apm32e030_int.c" attr="template" select="Interrupt Service Routines"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="ADC" Cversion="1.0.2" condition="APM32E030 STDPERIPH RCM">
            <description>Analog-to-digital converter (ADC) driver for APM32E030</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_ADC </RTE_Components_h>
            <files>
                <file category="header" name="Device/APM32E030_StdPeriphDriver/inc/apm32e030_adc.h"/>
                <file category="source" name="Device/APM32E030_StdPeriphDriver/src/apm32e030_adc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="CRC" Cversion="1.0.2" condition="APM32E030 STDPERIPH">
            <description>CRC calculation unit (CRC) driver for APM32E030</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_CRC      </RTE_Components_h>
            <files>
                <file category="header" name="Device/APM32E030_StdPeriphDriver/inc/apm32e030_crc.h"/>
                <file category="source" name="Device/APM32E030_StdPeriphDriver/src/apm32e030_crc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="DBG" Cversion="1.0.2" condition="APM32E030 STDPERIPH">
            <description>MCU debug component (DBGMCU) driver for APM32E030</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_DBG</RTE_Components_h>
            <files>
                <file category="header" name="Device/APM32E030_StdPeriphDriver/inc/apm32e030_dbg.h"/>
                <file category="source" name="Device/APM32E030_StdPeriphDriver/src/apm32e030_dbg.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="DMA" Cversion="1.0.2" condition="APM32E030 STDPERIPH RCM">
            <description>DMA controller (DMA) driver for APM32E030</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_DMA      </RTE_Components_h>
            <files>
                <file category="header" name="Device/APM32E030_StdPeriphDriver/inc/apm32e030_dma.h"/>
                <file category="source" name="Device/APM32E030_StdPeriphDriver/src/apm32e030_dma.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="EINT" Cversion="1.0.2" condition="APM32E030 STDPERIPH">
            <description>External interrupt/event controller (EINT) driver for APM32E030</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_EINT </RTE_Components_h>
            <files>
                <file category="header" name="Device/APM32E030_StdPeriphDriver/inc/apm32e030_eint.h"/>
                <file category="source" name="Device/APM32E030_StdPeriphDriver/src/apm32e030_eint.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="APM32E030 StdPeriph Drivers" Csub="FMC" Cversion="1.0.2" condition="APM32E030 STDPERIPH">
            <description>Flash memory controller driver for APM32E030</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_FMC     </RTE_Components_h>
