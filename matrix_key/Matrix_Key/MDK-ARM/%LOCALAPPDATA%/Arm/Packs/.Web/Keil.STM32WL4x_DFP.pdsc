<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.7.56" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.56/schema/PACK.xsd">
  <vendor>Keil</vendor>
  <name>STM32WL4x_DFP</name>
  <description overview="Documents/OVERVIEW.md">STMicroelectronics STM32WL4 Series Device Support</description>
  <url>https://www.keil.com/pack/</url>
  <repository type="git">https://github.com/Open-CMSIS-Pack/STM32WL4x_DFP.git</repository>
  <license>LICENSE</license>
  <licenseSets>
    <licenseSet id="all" default="true" gating="true">
      <license title="Apache-2.0 License for CMSIS add-ons" name="LICENSE" spdx="Apache-2.0"/>
    </licenseSet>
  </licenseSets>

  <releases>
    <release version="1.0.0" date="2026-07-31" tag="v1.0.0">
      Prepared for new CMSIS-Toolbox CubeMX integration
      Initial release of STM32WL4 Device Family Pack
    </release>
  </releases>

  <keywords>
    <keyword>ST</keyword>
    <keyword>Device Support</keyword>
    <keyword>Device Family Package STMicroelectronics</keyword>
    <keyword>STM32WL4</keyword>
    <keyword>STM32WL4x</keyword>
  </keywords>

  <devices>
    <family Dfamily="STM32WL4 Series" Dvendor="STMicroelectronics:13">
      <processor Dcore="Cortex-M33" DcoreVersion="r0p0" Dfpu="SP_FPU" Dmpu="MPU" Ddsp="DSP" Dtz="TZ" Dendian="Little-endian" Dclock="100000000"/>
      <description>
 <!-- ************************  todo:check in RM************************ -->
Ultra-low-power STM32U5 MCUs with Arm Cortex-M33 core, MPU, cache, DSP, FPU, 240 DMIPS at 100 MHz.
      </description>

      <book name="https://developer.arm.com/documentation/100235/latest/" title="Arm Cortex-M33 Devices"/>

      <!-- ************************  Subfamily 'STM32WL43'  ************************ -->
      <subFamily DsubFamily="STM32WL43">
        <compile define="STM32WL43"/>
        <debug __ap="1" svd="CMSIS/SVD/STM32WL43.svd"/>
        <memory name="SRAM0_NS" access="rwx"                    start="0x20000000" size="0x00004000"  default="1" init="0" />
        <memory name="SRAM0_S"  access="rwx"                    start="0x30000000" size="0x00004000"  alias="SRAM0_NS" />
        <memory name="SRAM1_NS" access="rwx"                    start="0x20010000" size="0x00010000"  default="1" init="0" />
        <memory name="SRAM1_S"  access="rwx"                    start="0x30010000" size="0x00010000"  alias="SRAM1_NS" />

        <!-- ################################### 512 KB ################################### -->
        <!-- *************************  Device 'STM32WL43CE'  ************************* -->
        <device Dname="STM32WL43CEVx">
          <memory    name="Flash_NS" access="rx"                start="0x08000000" size="0x00080000" default="1" startup="1" />
          <memory    name="Flash_S"  access="rx"                start="0x0C000000" size="0x00080000" alias="Flash_NS" />
          <algorithm name="CMSIS/Flash/STM32WL4x_512K_0800.FLM" start="0x08000000" size="0x00080000" RAMstart="0x20000000" RAMsize="0x00008000" default="1" />
          <algorithm name="CMSIS/Flash/STM32WL4x_512K_0C00.FLM" start="0x0C000000" size="0x00080000" RAMstart="0x20000000" RAMsize="0x00008000" default="1" />
          <feature type="QFP" n="48"/>
        </device>
        <!-- *************************  Device 'STM32WL43RE'  ************************* -->
        <device Dname="STM32WL43REVx">
          <memory    name="Flash_NS" access="rx"                start="0x08000000" size="0x00080000" default="1" startup="1" />
          <memory    name="Flash_S"  access="rx"                start="0x0C000000" size="0x00080000" alias="Flash_NS" />
          <algorithm name="CMSIS/Flash/STM32WL4x_512K_0800.FLM" start="0x08000000" size="0x00080000" RAMstart="0x20000000" RAMsize="0x00008000" default="1" />
          <algorithm name="CMSIS/Flash/STM32WL4x_512K_0C00.FLM" start="0x0C000000" size="0x00080000" RAMstart="0x20000000" RAMsize="0x00008000" default="1" />
          <feature type="QFP" n="68"/>
        </device> 
        <!-- ################################### 256 KB ################################### -->
        <!-- *************************  Device 'STM32WL43CC'  ************************* -->
        <device Dname="STM32WL43CCVx">
          <memory    name="Flash_NS" access="rx"                start="0x08000000" size="0x00040000" default="1" startup="1" />
          <memory    name="Flash_S"  access="rx"                start="0x0C000000" size="0x00040000" alias="Flash_NS" />
          <algorithm name="CMSIS/Flash/STM32WL4x_256K_0800.FLM" start="0x08000000" size="0x00040000" RAMstart="0x20000000" RAMsize="0x00008000" default="1" />
          <algorithm name="CMSIS/Flash/STM32WL4x_256K_0C00.FLM" start="0x0C000000" size="0x00040000" RAMstart="0x30000000" RAMsize="0x00008000" default="1" />
          <feature type="QFP" n="48"/>
        </device>
        <!-- *************************  Device 'STM32WL43RC'  ************************* -->
        <device Dname="STM32WL43RCVx">
          <memory    name="Flash_NS" access="rx"                start="0x08000000" size="0x00040000" default="1" startup="1" />
          <memory    name="Flash_S"  access="rx"                start="0x0C000000" size="0x00040000" alias="Flash_NS" />
          <algorithm name="CMSIS/Flash/STM32WL4x_256K_0800.FLM" start="0x08000000" size="0x00040000" RAMstart="0x20000000" RAMsize="0x00008000" default="1" />
          <algorithm name="CMSIS/Flash/STM32WL4x_256K_0C00.FLM" start="0x0C000000" size="0x00040000" RAMstart="0x30000000" RAMsize="0x00008000" default="1" />
          <feature type="QFP" n="68"/>
        </device>
      </subFamily>

    </family>

  </devices>

  <conditions>
    <!-- Device Conditions -->
    <condition id="STM32WL4">
      <description>STMicroelectronics STM32WL4 Series devices</description>
      <require Dvendor="STMicroelectronics:13" Dname="STM32WL4*"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="STM32WL4 CMSIS">
      <description>STMicroelectronics STM32WL4 Device and CMSIS-CORE</description>
      <require condition="STM32WL4"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>

  </conditions>

  <components>
    <!-- CubeMX Generator -->
    <component generator="CubeMX" Cclass="Device" Cgroup="CubeMX" Cversion="1.0.0" condition="STM32WL4 CMSIS">
      <description>Configuration via STM32CubeMX</description>
      <RTE_Components_h>
        #define RTE_DEVICE_CUBE_MX
        #define CMSIS_device_header "stm32wl4x.h"
      </RTE_Components_h>
      <files>
        <file category="doc" name="https://open-cmsis-pack.github.io/cmsis-toolbox/CubeMX"/>
      </files>
    </component>
  </components>

  <csolution>
    <!-- CubeMX Basic CMSIS Solution template -->
    <template name="CubeMX Basic solution" path="Templates/CubeMX" file="CubeMX.csolution.yml" condition="STM32WL4">
      <description>Create a CubeMX basic solution with project</description>
    </template>

    <!-- CubeMX TrustZone CMSIS Solution template -->
    <template name="CubeMX TrustZone solution" path="Templates/CubeMX_TZ" file="CubeMX_TZ.csolution.yml" condition="STM32WL4">
      <description>Create a CubeMX TrustZone solution with secure and non-secure projects</description>
    </template>
  </csolution>
</package>
