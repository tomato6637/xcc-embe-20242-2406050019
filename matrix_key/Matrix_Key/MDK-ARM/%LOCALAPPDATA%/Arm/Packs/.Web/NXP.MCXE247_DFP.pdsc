  <requirements>
    <packages>
      <package name="CMSIS" vendor="ARM" version="6.1.0"/>
    </packages>
    <languages>
      <language name="C" version="99"/>
    </languages>
  </requirements>
  <devices>
    <family Dfamily="MCXE247" Dvendor="NXP:11">
      <description>MCXE247</description>
      <device Dname="MCXE247">
        <processor Dcore="Cortex-M4" Dfpu="SP_FPU" Dmpu="NO_MPU" Dendian="Little-endian" Dclock="0"/>
        <algorithm name="devices/MCXE247/arm/MCXE247_P1536_4KB_SEC.FLM" start="0x00000000" size="0x00180000" RAMstart="0x1ffe0000" RAMsize="0x0003f000" default="1"/>
        <debug svd="devices/MCXE247/MCXE247.xml"/>
        <environment name="iar">
          <file category="linkerfile" name="devices/MCXE247/iar/MCXE247_flash.icf"/>
        </environment>
        <memory name="FLEX_NVM" start="0x10000000" size="0x080000" access="rx" default="1"/>
        <memory name="FLEX_RAM" start="0x14000000" size="0x1000" access="rw" default="1"/>
        <memory name="PROGRAM_FLASH" start="0x00000000" size="0x180000" access="rx" default="1" startup="1"/>
        <memory name="SRAM_LOWER" start="0x1ffe0000" size="0x020000" access="rw" default="1"/>
        <memory name="SRAM_UPPER" start="0x20000000" size="0x01f000" access="rw" default="1"/>
        <variant Dvariant="MCXE247VLL">
          <compile header="devices/MCXE247/fsl_device_registers.h" define="CPU_MCXE247VLL"/>
        </variant>
        <variant Dvariant="MCXE247VLQ">
          <compile header="devices/MCXE247/fsl_device_registers.h" define="CPU_MCXE247VLQ"/>
        </variant>
      </device>
    </family>
  </devices>
