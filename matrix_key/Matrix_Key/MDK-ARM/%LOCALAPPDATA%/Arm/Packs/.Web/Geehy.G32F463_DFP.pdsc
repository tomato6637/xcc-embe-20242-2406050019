    <!--G32F463 conditions-->
    <conditions>
        <!-- conditions selecting Compiler -->
        <condition id="Compiler ARMCC">
            <require Tcompiler="ARMCC"/>
        </condition>
        <!--G32F462/463/464 Device Conditions-->
        <condition id="G32F463xx">
            <description>Geehy Semiconductor G32F462/463/464 Series devices</description>
            <accept Dvendor="Geehy:163" Dname="G32F462*"/>
            <accept Dvendor="Geehy:163" Dname="G32F463*"/>
            <accept Dvendor="Geehy:163" Dname="G32F464*"/>
        </condition>
        <!--G32F463 ARMCC Conditions -->
        <condition id="G32F463 ARMCC">
            <description>filter for G32F463 Device and the ARM compiler</description>
            <accept condition="G32F463xx"/>
            <require Tcompiler="ARMCC"/>
        </condition>
        <!--G32F463 CMSIS Conditions -->
        <condition id="G32F463 CMSIS">
            <description>Geehy Semiconductor G32F463 Device with CMSIS</description>
            <require condition="G32F463xx"/>
            <require Cclass="CMSIS" Cgroup="CORE"/>
        </condition>
        <!--G32F463 DDL Conditions -->
        <condition id="G32F463 DDL">
            <description>Geehy Semiconductor G32F463 Device and LL</description>
            <require condition="G32F463xx"/>
            <require Cclass="Device" Cgroup="DDL Drivers" Csub="Common"/>
        </condition>
        <condition id="G32F463 LL Common">
            <description>Geehy Semiconductor G32F463 Device and LL</description>
            <require condition="G32F463xx"/>
            <require Cclass="CMSIS" Cgroup="CORE"/>
            <require Cclass="Device" Cgroup="DDL Drivers" Csub="UTILS"/>
            <require Cclass="Device" Cgroup="DDL Drivers" Csub="RCM"/>
            <require Cclass="Device" Cgroup="DDL Drivers" Csub="PMU"/>
        </condition>
    </conditions>
    <!--G32F463 Device Drivers Layer-->
    <components>
        <!--Startup-->
        <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="G32F463 CMSIS">
            <description>System Startup for Geehy Semiconductor G32F463 device series</description>
            <files>
                <!--  include folder -->
                <file category="include" name="Device/CMSIS/Include/"/>
                <file category="include" name="Device/Device/Geehy/G32F4xx/Include/"/>
                <!-- startup files -->
                <file category="source" name="Device/Device/Geehy/G32F4xx/Source/arm/startup_g32f463xx.s" attr="config" version="1.0.0" condition="G32F463 ARMCC"/>
                <!-- system file -->
                <file category="source" name="Device/Device/Geehy/G32F4xx/Source/system_g32f463.c" attr="config" version="1.0.0"/>
                <!-- device configuration required by drivers at the moment -->
            </files>
        </component>
        <!--START: Geehy Semiconductor Device Drivers Layer-->
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="Common" Cversion="1.0.0" condition="G32F463 LL Common">
            <description>Common LL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_COMMON</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/"/>
                <file category="header" name="MDK/Templates_DDL/g32f463_int.h" attr="template" select="Exception Handlers and Peripheral IRQ"/>
                <file category="source" name="MDK/Templates_DDL/g32f463_int.c" attr="template" select="Exception Handlers and Peripheral IRQ"/>
                <file category="header" name="MDK/Templates_DDL/main.h" attr="template" select="'main' module for DLL"/>
                <file category="source" name="MDK/Templates_DDL/main.c" attr="template" select="'main' module for DLL"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="ADC" Cversion="1.0.0" condition="G32F463 DDL">
            <description>Analog-to-digital converter (ADC) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_ADC</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_adc.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_adc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="BZTMR" Cversion="1.0.0" condition="G32F463 DDL">
            <description>Buzzer timer (BZTMR) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_BZTMR</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_bztmr.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_bztmr.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="CRC" Cversion="1.0.0" condition="G32F463 DDL">
            <description>CRC calculation unit (CRC) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_CRC</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_crc.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_crc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="DAC" Cversion="1.0.0" condition="G32F463 DDL">
            <description>Digital-to-analog converter (DAC) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_DAC</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_dac.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_dac.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="DMA" Cversion="1.0.0" condition="G32F463 DDL">
            <description>Direct memory access (DMA) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_DMA</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_dma.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_dma.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="EINT" Cversion="1.0.0" condition="G32F463 DDL">
            <description>External interrupt (EINT) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_EINT</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_eint.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_eint.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="FDCAN" Cversion="1.0.0" condition="G32F463 DDL">
            <description>FDCAN controller (FDCAN) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_FDCAN</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_fdcan.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_fdcan.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="FLASH" Cversion="1.0.0" condition="G32F463 DDL">
            <description>FLASH memory (FLASH) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_FLASH</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_flash.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_flash.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="GPIO" Cversion="1.0.0" condition="G32F463 DDL">
            <description>General-purpose input/output (GPIO) DDL driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_GPIO</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F463_DAL_Driver/Include/g32f463_ddl_gpio.h"/>
                <file category="source" name="Device/G32F463_DAL_Driver/Source/g32f463_ddl_gpio.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="I2C" Cversion="1.0.0" condition="G32F463 DDL">
