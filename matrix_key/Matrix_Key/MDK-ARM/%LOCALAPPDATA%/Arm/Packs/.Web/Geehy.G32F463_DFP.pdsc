<?xml version="1.0"?>
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.2" xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>Geehy</vendor>
    <name>G32F463_DFP</name>
    <description>Geehy Semiconductor G32F463 Series Device Support, Drivers and Examples</description>
    <url>https://global.geehy.com/uploads/tool/</url>
    <supportContact>https://global.geehy.com/design/software</supportContact>
    <license>LICENSE</license>
    <releases>
        <release version="1.0.4" date="2026-10-15"> Add G32F462 and G32F464 device support. </release>
        <release version="1.0.3" date="2026-10-13"> Update SVD and DDL driver. </release>
        <release version="1.0.2" date="2026-09-24"> Update SVD. </release>
        <release version="1.0.1" date="2026-09-23"> Update FDCAN DDL driver. </release>
        <release version="1.0.0" date="2026-09-07"> First Release version of G32F463 Device Family Pack. </release>
    </releases>
    <keywords>
        <!-- keywords for indexing -->
        <keyword>Geehy</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package Geehy Semiconductor</keyword>
        <keyword>G32F4</keyword>
        <keyword>G32</keyword>
    </keywords>
    <devices>
        <family Dfamily="G32F4 Series" Dvendor="Geehy:163">
