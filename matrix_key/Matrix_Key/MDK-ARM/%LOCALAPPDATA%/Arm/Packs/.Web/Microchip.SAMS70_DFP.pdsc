                        <at:template select="Main file (.cpp)"/>
                     </at:component>
                  </at:project>
                  <at:prerequisite context="compiling" Tcompiler="GCC" component="ARM-GCC"/>
                  <at:prerequisite context="compiling" Tcompiler="IAR" component="ARM-IAR"/>
                  <at:prerequisite context="compiling" Tcompiler="ARMCC" component="ARMCC"/>
                  <at:prerequisite component="MPLAB XC32" version="[4.10-"/>
               </at:extension>
            </environment>
            <environment name="microchip">
               <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                               schemaVersion="1.0"
                               xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
                  <mchp:pic name="sams70b/edc/ATSAMS70Q21B.PIC"/>
                  <mchp:xc32 name="sams70b/xc32"/>
                  <mchp:hwtool type="mplab.nmmrs">
                     <mchp:file name="sams70b/hwtools/mplab/16bit.NMMRs.xml"/>
                     <mchp:file name="sams70b/hwtools/mplab/32bit.NMMRs.xml"/>
                     <mchp:file name="sams70b/hwtools/mplab/8bit.NMMRs.xml"/>
                     <mchp:file name="sams70b/hwtools/mplab/arm.32bit.NMMRs.xml"/>
                     <mchp:file name="sams70b/hwtools/mplab/avr.8bit.NMMRs.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="mplab.devicesupport">
                     <mchp:file name="sams70b/hwtools/mplab/mplab.deviceSupport"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="mplab.mpheader">
                     <mchp:file name="sams70b/hwtools/mplab/MPHeader.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="mplab.pluginboardsupport">
                     <mchp:file name="sams70b/hwtools/mplab/PluginBoardSupport.xml"/>
                  </mchp:hwtool>
                  <mchp:prerequisite component="MPLAB X IDE" version="[5.50-"/>
                  <mchp:prerequisite component="MPLAB XC32" version="[4.10-"/>
               </mchp:extension>
            </environment>
            <book name="https://www.microchip.com/en-us/product/ATSAMS70Q21B"
                  title="Device page for ATSAMS70Q21B"/>
            <book name="https://www.microchip.com/en-us/product/ATSAMS70Q21B#Documentation"
                  title="Datasheet"/>
            <book name="https://developer.arm.com/documentation/dui0646"
                  title="Arm Cortex-M7 Devices Generic User Guide"/>
            <feature type="NVIC" n="71"/>
            <feature type="WDT" n="1"/>
            <feature type="Memory" n="131072" name="ITCM"/>
            <feature type="Memory" n="2.097152E6" name="IFLASH"/>
            <feature type="Memory" n="131072" name="DTCM"/>
            <feature type="Memory" n="393216" name="IRAM"/>
            <feature type="VCC" n="1.62" m="3.6"/>
            <feature type="Temp" n="-40" m="105"/>
            <feature type="BGA" n="144"/>
            <feature type="QFP" n="144"/>
         </device>
