    <examples>
        <!--G32A1445EVAL example information-->
        <example name="APM32F445EVAL-Blinky" doc="readme.txt" folder="Boards\Geehy\APM32F445EVAL\Blinky">
            <description>APM32F445EVAL Blinky example</description>
            <board name="APM32F445EVAL" vendor="Geehy"/>
            <project>
                <environment name="uv" load="APM32F445EVAL-Blinky.uvprojx"/>
            </project>
            <attributes>
                <component Cclass="CMSIS" Cgroup="CORE"/>
                <component Cclass="Device" Cgroup="Startup"/>
                <category>Getting Started</category>
                <keyword>LED</keyword>
                <keyword>APM32F445</keyword>
            </attributes>
        </example>
