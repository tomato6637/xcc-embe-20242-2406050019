                <file category="linkerScript" condition="APM32F445_64_ARM" name="Device\Device\Geehy\APM32F445_446\APM32F445\linker\armc\apm32f445_64_ram.sct" attr="config" version="1.0.0"/>
                <file category="linkerScript" condition="APM32F446_128_ARM" name="Device\Device\Geehy\APM32F445_446\APM32F446\linker\armc\apm32f446xG_128_flash.sct" attr="config" version="1.0.0"/>
                <file category="linkerScript" condition="APM32F446_128_ARM" name="Device\Device\Geehy\APM32F445_446\APM32F446\linker\armc\apm32f446_128_ram.sct" attr="config" version="1.0.0"/>
            </files>
