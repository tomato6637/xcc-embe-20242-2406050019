    <conditions>
        <!-- Device Conditions -->
        <condition id="APM32F445_446">
            <description>Geehy APM32F445_446 devices</description>
            <accept Dvendor="Geehy:163" Dname="APM32F44*"/>
        </condition>
        <condition id="APM32F445_64">
            <description>Geehy APM32F445 device with 64K RAM</description>
            <accept Dvendor="Geehy:163" Dname="APM32F445*"/>
        </condition>
        <condition id="APM32F446_128">
            <description>Geehy APM32F446 device with 128K RAM</description>
            <accept Dvendor="Geehy:163" Dname="APM32F446*"/>
        </condition>
        <!-- Device + Compiler Conditions (ARM) -->
        <condition id="APM32F445_ARM">
            <description>Geehy APM32F445 device and ARM compiler</description>
            <require condition="APM32F445_64"/>
            <require Tcompiler="ARMCC" Toptions="AC6"/>
        </condition>
        <condition id="APM32F445_64_ARM">
            <description>Geehy APM32F445 device with 64K RAM and ARM compiler</description>
            <require condition="APM32F445_64"/>
            <require Tcompiler="ARMCC" Toptions="AC6"/>
        </condition>
        <condition id="APM32F446_ARM">
            <description>Geehy APM32F446 device and ARM compiler</description>
            <require condition="APM32F446_128"/>
            <require Tcompiler="ARMCC" Toptions="AC6"/>
        </condition>
        <condition id="APM32F446_128_ARM">
            <description>Geehy APM32F446 device with 128K RAM and ARM compiler</description>
            <require condition="APM32F446_128"/>
            <require Tcompiler="ARMCC" Toptions="AC6"/>
        </condition>
        <!-- Device + CMSIS Conditions -->
        <condition id="APM32F445_446_CMSIS">
            <description>Geehy APM32F445_446 devices and CMSIS-CORE</description>
            <accept condition="APM32F445_446"/>
            <require Cclass="CMSIS" Cgroup="CORE"/>
        </condition>
        <!--G32A1xx Standard Peripherals-->
        <condition id="APM32F445_446 STDPERIPH">
            <description>APM32F445_446 Standard Peripherals</description>
            <require condition="APM32F445_446_CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
        </condition>
        <condition id="APM32F445_446 STDPERIPH CLOCK">
            <description>Geehy Semiconductor APM32F445_446 with Standard Peripherals Drivers Framework and CLOCK</description>
            <require condition="APM32F445_446_CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="CLOCK"/>
        </condition>
        <condition id="APM32F445_446 STDPERIPH LPUART_LIN">
            <description>Geehy Semiconductor APM32F445_446 with Standard Peripherals Drivers Framework and CLOCK and LPUART_LIN</description>
            <require condition="APM32F445_446_CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="CLOCK"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="LPUART"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="LIN"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="DMA"/>
        </condition>
        <condition id="APM32F445_446 STDPERIPH DMA">
            <description>Geehy Semiconductor APM32F445_446 with Standard Peripherals Drivers Framework and CLOCK and DMA</description>
            <require condition="APM32F445_446_CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="CLOCK"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="DMA"/>
        </condition>
    </conditions>
    <components>
        <!-- StartUp -->
        <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="APM32F445_446_CMSIS">
            <description>System Startup for APM32F445_446 Series</description>
            <files>
                <!-- include folders -->
                <file category="header" name="Device\Device\Geehy\APM32F445_446\device.h"/>
