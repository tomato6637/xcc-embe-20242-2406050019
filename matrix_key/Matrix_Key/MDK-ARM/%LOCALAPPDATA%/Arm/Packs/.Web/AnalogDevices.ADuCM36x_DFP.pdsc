			</project>
			<attributes>
				<component Cclass="CMSIS" Cgroup="CORE"/>
				<category>Driver Examples</category>
				<keyword>FlashProtect</keyword>
			</attributes>
		</example>
		<example name="I2C_DMA Master" doc="cces/README_I2C_DMA_Master.txt" folder="Examples/I2C_DMA/Master" version="2.2.0">
			<description>I2C_DMA Master - I2C communication using DMA, optimizing transfer efficiency for master/slave data exchange</description>
