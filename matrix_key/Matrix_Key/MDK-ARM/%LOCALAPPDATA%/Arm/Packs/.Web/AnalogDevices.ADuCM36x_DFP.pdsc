			</attributes>
		</example>
		<example name="PowerDown" doc="cces/README_PowerDown.txt" folder="Examples/PowerDown" version="2.2.0">
			<description>PowerDown - low-power mode / power-down state transitions, wake-up behavior, and power management</description>
			<board name="EVAL-ADICUP360" vendor="Analog Devices"/>
			<project>
				<environment name="uv" load="keil/PowerDown.uvprojx"/>
