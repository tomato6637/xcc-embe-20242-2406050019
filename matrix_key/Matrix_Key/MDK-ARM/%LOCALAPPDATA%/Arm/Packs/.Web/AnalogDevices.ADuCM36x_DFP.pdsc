	<!-- examples section (optional for all Software Packs)-->
	<examples>
		<example name="Blinky_360" doc="cces/Readme_Blinky.txt" folder="Examples/Blinky" version="2.2.0">
			<description>Blinky ADuCM360 - Hello world and GPIO output toggle for LED blinking</description>
			<board name="EVAL-ADICUP360" vendor="Analog Devices"/>
			<project>
				<environment name="cces" load="cces/.project"/>
				<environment name="uv" load="keil/Blinky.uvprojx"/>
				<environment name="iar" load="iar/Blinky.ewp"/>
			</project>
			<attributes>
				<component Cclass="CMSIS" Cgroup="CORE"/>
				<component Cclass="Device" Cgroup="Startup"/>
				<category>Getting Started</category>
			</attributes>
		</example>
		<example name="RTX_Blinky_360" doc="cces/README_RTX_Blinky.txt" folder="Examples/RTX_Blinky" version="2.2.0">
			<description>Simple RTX Kernel based example</description>
			<board name="EVAL-ADuCM360" vendor="Analog Devices"/>
			<project>
				<environment name="uv" load="keil/Blinky.uvprojx"/>
				<environment name="cces" load="cces/.project"/>
				<environment name="iar" load="iar/RTX_Blinky.ewp"/>
			</project>
			<attributes>
				<component Cclass="CMSIS" Cgroup="CORE"/>
				<component Cclass="Device" Cgroup="Startup"/>
				<category>Getting Started</category>
			</attributes>
		</example>
		<example name="Blinky_362" doc="cces/README_Blinky_362.txt" folder="Examples/Blinky_362" version="2.2.0">
			<description>Blinky ADuCM362 - Hello world and GPIO output toggle for LED blinking</description>
			<board name="EVAL-ADuCM362QSPZ" vendor="Analog Devices"/>
			<project>
				<environment name="cces" load="cces/.project"/>
				<environment name="uv" load="keil/Blinky_362.uvprojx"/>
				<environment name="iar" load="iar/Blinky_362.ewp"/>
			</project>
			<attributes>
				<component Cclass="CMSIS" Cgroup="CORE"/>
				<component Cclass="Device" Cgroup="Startup"/>
				<category>Getting Started</category>
			</attributes>
		</example>
		<!-- Basic driver examples -->
		<example name="ADC" doc="cces/README_ADC.txt" folder="Examples/ADC" version="2.2.0">
			<description>ADC example - ADC continuous conversion for analog signal sampling, channel acquisition, and data measurement using on-chip ADC peripheral </description>
			<board name="EVAL-ADICUP360" vendor="Analog Devices"/>
			<project>
				<environment name="uv" load="keil/AdcExample.uvprojx"/>
				<environment name="cces" load="cces/.project"/>
				<environment name="iar" load="iar/AdcExample.ewp"/>
			</project>
			<attributes>
				<component Cclass="CMSIS" Cgroup="CORE"/>
				<component Cclass="Device" Cgroup="Startup"/>
				<category>Driver Examples</category>
				<keyword>ADC</keyword>
			</attributes>
		</example>
		<example name="ADC_DMA" doc="cces/README_ADC_DMA.txt" folder="Examples/ADC_DMA" version="2.2.0">
			<description>ADC_DMA - ADC + DMA data transfer, enabling automatic movement of ADC samples to memory with reduced CPU overhead</description>
			<board name="EVAL-ADICUP360" vendor="Analog Devices"/>
			<project>
				<environment name="uv" load="keil/ADC_DMA.uvprojx"/>
				<environment name="cces" load="cces/.project"/>
				<environment name="iar" load="iar/ADC_DMA.ewp"/>
			</project>
			<attributes>
				<component Cclass="CMSIS" Cgroup="CORE"/>
				<component Cclass="Device" Cgroup="Startup"/>
				<category>Driver Examples</category>
				<keyword>ADC_DMA</keyword>
			</attributes>
		</example>
		<example name="AN1159 I2C" doc="cces/README_AN1159I2C.txt" folder="Examples/AN1159 I2C" version="2.2.0">
			<description>AN1159 I2C - Collection of I2C communication examples including master/slave modes, interrupt-driven transfer, and protocol handling</description>
			<board name="EVAL-ADICUP360" vendor="Analog Devices"/>
			<project>
				<environment name="uv" load="keil/I2C.uvprojx"/>
				<environment name="cces" load="cces/.project"/>
				<environment name="iar" load="iar/I2C.ewp"/>
			</project>
			<attributes>
				<component Cclass="CMSIS" Cgroup="CORE"/>
				<component Cclass="Device" Cgroup="Startup"/>
				<category>Board Examples</category>
				<keyword>I2C</keyword>
			</attributes>
		</example>
		<example name="DAC_DMA" doc="cces/README_DAC_DMA.txt" folder="Examples/DAC_DMA" version="2.2.0">
			<description>DAC_DMA - DAC with DMA for waveform/sample output generation without CPU intervention</description>
			<board name="EVAL-ADICUP360" vendor="Analog Devices"/>
			<project>
				<environment name="uv" load="keil/DAC_DMA.uvprojx"/>
				<environment name="cces" load="cces/.project"/>
				<environment name="iar" load="iar/DAC_DMA.ewp"/>
