		</example>
		<example name="PWM" doc="cces/README_PWM.txt" folder="Examples/PWM" version="2.2.0">
			<description>PWM -  Configures timer peripherals for PWM signal generation with configurable duty cycle and frequency</description>
			<board name="EVAL-ADICUP360" vendor="Analog Devices"/>
			<project>
				<environment name="uv" load="keil/PWM.uvprojx"/>
