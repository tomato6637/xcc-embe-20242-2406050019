          <!-- Set slew rate and drive strength in GPIO_PRT[port]_CFG_OUT register -->
          <block>
            regAddr = GPIO_BASE + (GPIO_PRT_SECTION_SIZE * port) + GPIO_PRT_CFG_OUT_OFFSET;
            reg0 = Read32(regAddr);
            offset = pin;
            reg1 = (reg0 &amp; ~(GPIO_PRT_SLOW_Msk &lt;&lt; offset)) | (pSlew &lt;&lt; offset); // Update value in SLOW[pin] field
            offset = 16 + pin * 2; // Offset of the DRIVE_SEL[pin] field for required pin number,
                                   // where '16' is the offset of DRIVE_SEL[pin] for pin 0 and '2' is the size of DRIVE_SEL[pin]
            reg1 = (reg1 &amp; ~(GPIO_PRT_DRIVE_SEL_Msk &lt;&lt; offset)) | (pStrength &lt;&lt; offset); // Update value in DRIVE_SEL[pin] field
          </block>
          <control if="reg0 != reg1">
            <block>
              Write32(regAddr, reg1);
              confChanged = 1;
            </block>
          </control>
          <control if="confChanged != 0">
            <block>
              Message(0, "Set TRACEDATA[0] to P%u_%u", port, pin);
            </block>
          </control>
        </sequence>
        <!-- Setup Trace Pin P22_1 as TRACEDATA[1] -->
        <sequence name="SetupTracePin_P22_1">
          <block>
            __var port = 22;                          // Port number
            __var pin = 1;                            // Pin number
            __var reg0;
            __var reg1;
            __var offset;
            __var regAddr;
            __var confChanged = 0; // Pin's configuration change flag
          </block>
          <!-- Select pin route connection in HSIOM_PRT[port]_PORT_SEL[0/1] register -->
          <control if="pin &lt; 4">
            <block>
              // Pin[0-3] selection is in HSIOM_PRT[port]_PORT_SEL0 register
              regAddr = HSIOM_BASE + (HSIOM_PRT_SECTION_SIZE * port); // Use HSIOM_PRT[port]_PORT_SEL0
              offset = pin * 8; // Offset of the IO[pin]_SEL field for required pin number,
                                // where 8 = 5 bits for IO[pin]_SEL field + 3 not used bits
            </block>
          </control>
          <control if="pin &gt; 3">
            <block>
              // Pin[4-7] selection is in HSIOM_PRT[port]_PORT_SEL1 register
              regAddr = HSIOM_BASE + (HSIOM_PRT_SECTION_SIZE * port) + HSIOM_PRT_PORT_SEL1_OFFSET; // Use HSIOM_PRT[port]_PORT_SEL1
              offset = (pin &amp; 3) * 8; // Offset of the IO[pin]_SEL field for required pin number,
                                      // where 8 = 5 bits for IO[pin]_SEL field + 3 not used bits
            </block>
          </control>
          <block>
            reg0 = Read32(regAddr);
            reg1 = (reg0 &amp; ~(GPIO_PRT_IO_SEL_Msk &lt;&lt; offset)) | (ioSelVal &lt;&lt; offset); // Update value in IO[pin]_SEL field
          </block>
