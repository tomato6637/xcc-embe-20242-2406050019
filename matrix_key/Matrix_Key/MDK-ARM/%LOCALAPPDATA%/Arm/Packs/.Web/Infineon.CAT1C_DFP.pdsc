    <!-- CYT6BJ: 16768KB Flash (dual-bank), Penta-Core (CM0+ + 4x CM7) -->
    <family Dfamily="CYT6BJ" Dvendor="Infineon:7">
      <processor Pname="Cortex-M0p" Dcore="Cortex-M0+" DcoreVersion="r0p1" Dfpu="NO_FPU" Dmpu="MPU" Dendian="Little-endian" Dclock="100000000" Ddsp="NO_DSP" />
      <processor Pname="Cortex-M7-0" Dcore="Cortex-M7" DcoreVersion="r1p2" Dfpu="DP_FPU" Dmpu="MPU" Dendian="Little-endian" Dclock="320000000" Ddsp="DSP" />
