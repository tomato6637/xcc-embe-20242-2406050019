    <!-- XMC7200D -->
    <family Dfamily="XMC7200D" Dvendor="Infineon:7">
      <processor Pname="Cortex-M0p" Dcore="Cortex-M0+" DcoreVersion="r0p1" Dfpu="NO_FPU" Dmpu="MPU" Dendian="Little-endian" Dclock="50000000" Ddsp="NO_DSP" />
      <processor Pname="Cortex-M7-0" Dcore="Cortex-M7" DcoreVersion="r1p2" Dfpu="DP_FPU" Dmpu="MPU" Dendian="Little-endian" Dclock="350000000" Ddsp="DSP" />
      <processor Pname="Cortex-M7-1" Dcore="Cortex-M7" DcoreVersion="r1p2" Dfpu="DP_FPU" Dmpu="MPU" Dendian="Little-endian" Dclock="350000000" Ddsp="DSP" />
      <debugconfig default="swd" clock="2000000" sdf="Debug/cat1c.sdf" />
      <description>
        XMC7xxx: Tri-core Cortex-M7/M7/M0+ MCU series with programmable digital and analog peripherals.
      </description>
      <book name="README.txt" title="Infineon XMC7xxx DFP user guide" />
      <book name="known_issues.txt" title="Infineon XMC7xxx DFP known issues" />
      <debug Pname="Cortex-M7-1" svd="SVD/cat1c8m.svd" __ap="3" defaultResetSequence="ResetProcessor" />
      <debug Pname="Cortex-M7-0" svd="SVD/cat1c8m.svd" __ap="2" defaultResetSequence="ResetProcessor" />
      <debug Pname="Cortex-M0p" svd="SVD/cat1c8m.svd" __ap="1" defaultResetSequence="ResetSystem" />
      <debugvars configfile="Debug/cat1c_bh.dbgconf" version="1.0">
        // ============================================================================
        // ARM CoreSight: ADIv5 Debug Port (DP)
        // ============================================================================
        __var DP_ABORT                  = 0x0;        // DP Abort Register
        __var DP_CTRL_STAT              = 0x4;        // DP Control/Status Register
        __var DP_SELECT                 = 0x8;        // DP Select Register
        // DP_CTRL_STAT bit groups
        __var DP_CTRL_STAT_PWRUP_REQ    = 0x50000000; // CSYSPWRUPREQ | CDBGPWRUPREQ
        __var DP_CTRL_STAT_PWRUP_ACK    = 0xA0000000; // CSYSPWRUPACK | CDBGPWRUPACK
        __var DP_CTRL_STAT_MASKLANE     = 0x00000F00;
        __var DP_CTRL_STAT_STICKY_CLR   = 0x00000032; // STICKYORUN | STICKYCMP | STICKYERR
        // DP_ABORT clear-sticky
        __var DP_ABORT_STICKY_CLR_ALL   = 0x0000001E; // STKCMPCLR | STKERRCLR | WDERRCLR | ORUNERRCLR

        // ============================================================================
        // Debug sequence timings
        // ============================================================================
        __var __Reset_Finish_Delay      = 600000;     // us to wait after reset for the bootloader to finish (up to 600 ms)

        // ============================================================================
        // Cortex-M System Control Block (SCB)
        // ============================================================================
        __var AIRCR                     = 0xE000ED0C; // Application Interrupt and Reset Control
        __var DHCSR                     = 0xE000EDF0; // Debug Halting Control and Status
        __var DEMCR                     = 0xE000EDFC; // Debug Exception and Monitor Control
        __var VTOR                      = 0xE000ED08; // Vector Table Offset
        __var DCRSR                     = 0xE000EDF4; // Debug Core Register Selector
        __var DCRDR                     = 0xE000EDF8; // Debug Core Register Data
        // SCB.AIRCR fields
        __var AIRCR_VECTKEY             = 0x05FA0000; // Write key (reads as VECTKEYSTAT)
        __var AIRCR_SYSRESETREQ         = 0x00000004;
        __var AIRCR_VECTCLRACTIVE       = 0x00000002;
        // SCB.DHCSR fields
        __var DHCSR_DBGKEY              = 0xA05F0000; // Write key (reads as zero)
        __var DHCSR_C_DEBUGEN           = 0x00000001;
        __var DHCSR_C_HALT              = 0x00000002;
        __var DHCSR_S_REGRDY            = 0x00010000;
        __var DHCSR_S_HALT              = 0x00020000;
        __var DHCSR_S_RESET_ST          = 0x02000000;
        // SCB.DEMCR fields
        __var DEMCR_VC_CORERESET        = 0x00000001;
        // SCB.DCRSR fields
        __var DCRSR_REGWnR              = 0x00010000; // Write transfer (vs. read) selector bit

        // ============================================================================
        // Cortex-M Flash Patch and Breakpoint unit (FPB)
        // ============================================================================
        __var FPB_CTRL                  = 0xE0002000; // Breakpoint Control
        __var FPB_COMP0                 = 0xE0002008; // Breakpoint Comparator (first comparator)
        __var FPB_CTRL_KEY_ENABLE       = 0x00000003; // KEY | ENABLE

        // ============================================================================
        // ARMv7-M NVIC (first 32 IRQs only - all CAT1C cores expose NVIC0)
        // ============================================================================
        __var NVIC_ISER0                = 0xE000E100;
        __var NVIC_ICER0                = 0xE000E180;
        __var NVIC_ICPR0                = 0xE000E280;
        __var NVIC_IPR0                 = 0xE000E400;

        // ============================================================================
        // CoreSight Trace Funnel (CSTF)
        // ============================================================================
        __var CSTFCTL                   = 0xE008C000; // Trace Funnel control register
        __var CSTFCTL_CM7_0_PORTS_Msk   = 0x00000303; // CM7_0 -&gt; CSTF slave ports #0,#1
        __var CSTFCTL_CM7_1_PORTS_Msk   = 0x0000030C; // CM7_1 -&gt; CSTF slave ports #2,#3

        // ============================================================================
        // CAT1C CPUSS - CM0+
        // ============================================================================
        __var CPUSS_CM0_CTL                = 0x40201000; // CM0+ Control Register
        __var CPUSS_CM0_VECTOR_TABLE_BASE  = 0x40201120; // CM0+ Vector Table Base
        __var VTBASE_ADDR_Msk              = 0xFFFF0000; // VECTOR_TABLE_BASE address-field mask

        // ============================================================================
        // CAT1C CPUSS - CM7 cores (per-core power and control registers)
        // ============================================================================
        __var CPUSS_CM7_0_PWR_CTL       = 0x40201200;
        __var CPUSS_CM7_0_CTL           = 0x4020000C;
        __var CPUSS_CM7_1_PWR_CTL       = 0x40201210;
        __var CPUSS_CM7_1_CTL           = 0x4020040C;
        // CPUSS_CM7_x_PWR_CTL fields (power-state machine)
        __var CPUSS_PWR_KEY             = 0x05FA0000; // Write key
        __var CPUSS_PWR_STATE_RESET     = 0x00000000;
        __var CPUSS_PWR_STATE_RETAINED  = 0x00000001;
        __var CPUSS_PWR_STATE_ENABLED   = 0x00000003;
        __var CPUSS_PWR_STATE_Msk       = 0x00000003;
        // CPUSS_CM7_x_CTL fields
        __var CPUSS_CM7_CTL_CPU_WAIT_Msk = 0x00000010;
        __var CPUSS_CM7_CTL_INIT_Msk     = 0x0000001F; // CPU_WAIT + INIT_VTOR/TCM/AHB enables

        // ============================================================================
        // CAT1C CPUSS - clock and system info
        // ============================================================================
        __var CPUSS_CLK_PATH1_SELECT           = 0x40261244; // CLK_HF1 path-select / enable register
        __var PERI_CLK_PATH_SELECT_ENABLED_Msk = 0x80000000; // Path-select ENABLED bit
        __var PERI_CLOCK_CTL_DIV_SEL_Msk       = 0x0000000F; // PERI_CLOCK_CTL.DIV_SEL field
        __var PERI_DIV_CMD_ENABLE_Msk          = 0x80000000; // PERI_DIV_CMD.ENABLE
        __var PERI_DIV_CMD_DISABLE_Msk         = 0x40000000; // PERI_DIV_CMD.DISABLE
        // System info registers
        __var SI_ID                            = 0x17000000; // Silicon ID register
        __var SI_FAMILY_ID                     = 0x1700000C; // Silicon family-id register
        __var FB_VERSION_HI                    = 0x17002004; // Flash-boot version (hi)
        __var FB_VERSION_LO                    = 0x17002018; // Flash-boot version (lo)
        __var CPUSS_PROTECTION                 = 0x402020C4; // Lifecycle/protection state
        // SI_ID / SI_FAMILY_ID field masks
        __var SI_ID_DEVID_Msk                  = 0xFFFF0000;
        __var SI_ID_DEVID_Pos                  = 16;
        __var SI_ID_REV_Msk                    = 0x0000FF00;
        __var SI_ID_REV_Pos                    = 8;
        __var SI_FAMILY_ID_Msk                 = 0x00000FFF;

        // ============================================================================
        // Trace / TPIU configuration
        // ============================================================================
        __var __TPIU_pinlocation        = 1;          // Select one of the possible TPIU pin locations
        __var __TPIU_clocksetup         = 1;          // Enable(1) or Disable(0) setup of trace source clock
        __var __TPIU_clockdivval        = 0;          // Clock divider value for trace clock
        // TraceClock configuration
        __var CPUSS_TRACE_CLOCK_CTL     = 0x40040C00; // Clock control for cpuss.clock_trace_in
        __var CPUSS_TRACE_CLOCK_DIV_CTL = 0x40041000; // Divider control (for 8.0 divider)
        __var CPUSS_TRACE_CLOCK_DIV_CMD = 0x40040000; // Divider command
        __var PERI_CLOCK_CTL_DIV_SEL    = 0x03;       // XMC7200 devices have 4 of 8-bit dividers - use the last available for tracing
        __var PERI_DIV_PA_SEL_Msk       = 0x000003FF; // PA_TYPE_SEL + PA_DIV_SEL fields mask (size)
        __var PERI_DIV_PA_SEL_Pos       = 0x00000010; // PA_TYPE_SEL + PA_DIV_SEL fields offset in PERI_DIV_CMD

        // ============================================================================
        // TPIU pins (HSIOM / GPIO)
        // ============================================================================
        __var HSIOM_BASE                 = 0x40300000;
        __var HSIOM_PRT_SECTION_SIZE     = 0x00000010;
        __var HSIOM_PRT_PORT_SEL1_OFFSET = 4;
        __var GPIO_BASE                  = 0x40310000;
        __var GPIO_PRT_SECTION_SIZE      = 0x00000080;
        __var GPIO_PRT_CFG_OFFSET        = 0x00000044; // Port configuration register
        __var GPIO_PRT_CFG_OUT_OFFSET    = 0x0000004C; // Port output-config register
        __var GPIO_PRT_IO_SEL_Msk        = 0x1F;       // Mask for IO[pin]_SEL field in HSIOM_PRT[port]_PORT_SEL[0/1]
        __var GPIO_PRT_DRIVE_MODE_Msk    = 0xF;        // Mask for IN_EN[pin] and DRIVE_MODE[pin] in GPIO_PRT[port]_CFG
        __var GPIO_PRT_SLOW_Msk          = 0x1;        // Mask for SLOW[pin] in GPIO_PRT[port]_CFG_OUT
        __var GPIO_PRT_DRIVE_SEL_Msk     = 0x3;        // Mask for DRIVE_SEL[pin] in GPIO_PRT[port]_CFG_OUT
        // Trace pin attributes
        __var pMode     = 6;            // DRIVE_MODE[pin]:
                                        //   0x00 - Analog High-Z. Input buffer off
                                        //   0x02 - Resistive Pull-Up. Input buffer off
                                        //   0x03 - Resistive Pull-Down. Input buffer off
                                        //   0x04 - Open Drain, Drives Low. Input buffer off
                                        //   0x05 - Open Drain, Drives High. Input buffer off
                                        //   0x06 - Strong Drive. Input buffer off
                                        //   0x07 - Resistive Pull-Up/Down. Input buffer off
        __var pSlew     = 0;            // pin slew rate
                                        //   0 - Fast slew rate (default)
                                        //   1 - Slow slew rate
        __var pStrength = 1;            // pin drive strength
                                        //   0 - FULL_DRIVE        (max rated spec)
                                        //   1 - ONE_HALF_DRIVE    (1/2 max rated spec, default)
                                        //   2 - ONE_QUARTER_DRIVE (1/4 max rated spec)
                                        //   3 - ONE_EIGHTH_DRIVE  (1/8 max rated spec)
        __var ioSelVal  = 27;           // IO[pin]_SEL value to route 'cpuss.trace_clock' and 'cpuss.trace_data[0-3]' signals
      </debugvars>
      <sequences>
        <sequence name="DebugPortStart">
          <block info="Read DP CTRL/STAT">
            __var powered_down = 0;
            // Switch to DP Register Bank 0. Explicitly set APSEL to current AP selection
            WriteDP(DP_SELECT, __ap &lt;&lt; 24);
            // Read DP CTRL/STAT Register and check if CSYSPWRUPACK and CDBGPWRUPACK bits are set
            powered_down = ((ReadDP(DP_CTRL_STAT) &amp; DP_CTRL_STAT_PWRUP_ACK) != DP_CTRL_STAT_PWRUP_ACK);
          </block>
          <control if="powered_down">
            <block info="Power Up System &amp; Debug">
              // Request Debug/System Power-Up
              // Ignore error here: even though there is polling in the next block, CMSIS-DAP transports read the DP.RDBUFF register
              // right after writing to DP.CTRL_STAT. This can fail in some cases, for example when the device is waking from DeepSleep.
              __errorcontrol = 1;
              WriteDP(DP_CTRL_STAT, DP_CTRL_STAT_PWRUP_REQ);
              __errorcontrol = 0;
            </block>
            <!-- Wait for Power-Up Request to be acknowledged -->
            <control while="(ReadDP(DP_CTRL_STAT) &amp; DP_CTRL_STAT_PWRUP_ACK) != DP_CTRL_STAT_PWRUP_ACK" timeout="1000000" info="Wait for power acknowledged" />
            <!-- CDBGRSTREQ on CAT1C behaves like Power-On Reset. Not desired when starting the Debug Port
            <block info="Debug Reset">
              __errorcontrol = 1;
              // Request Debug Reset
              WriteDP(DP_CTRL_STAT, 0x54000000);
              // CDBGRSTREQ is equivalent to Power-On Reset and fully reboots the device.
              // Depending on the user application the reboot can take up to 600ms.
              DAP_Delay(__Reset_Finish_Delay);
              __errorcontrol = 0;
            </block>
            -->
            <!-- Wait for Debug Reset to be acknowledged, don't issue error on timeout to deal with improperly connected Debug Reset -->
            <!-- <control while="(ReadDP(DP_CTRL_STAT) &amp; 0xA8000000) != 0xA8000000" timeout="300000" info="Wait for Debug Reset Acknowledge"/> -->
            <!-- JTAG Specific Part of sequence -->
            <control if="(__protocol &amp; 0xFFFF) == 1">
              <block info="JTAG: Clear Sticky Bits">
                // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                // Additionally clear STICKYORUN, STICKYCMP, and STICKYERR bits by writing '1'
                WriteDP(DP_CTRL_STAT, DP_CTRL_STAT_PWRUP_REQ | DP_CTRL_STAT_MASKLANE | DP_CTRL_STAT_STICKY_CLR);
              </block>
            </control>
            <!-- SWD Specific Part of sequence -->
            <control if="(__protocol &amp; 0xFFFF) == 2">
              <block info="SWD: Init SWD &amp; Clear Sticky Bits">
                // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                WriteDP(DP_CTRL_STAT, DP_CTRL_STAT_PWRUP_REQ | DP_CTRL_STAT_MASKLANE);
                // Clear WDATAERR, STICKYORUN, STICKYCMP, and STICKYERR bits of CTRL/STAT Register by write to ABORT register
                WriteDP(DP_ABORT, DP_ABORT_STICKY_CLR_ALL);
              </block>
            </control>
          </control>
        </sequence>
        <sequence name="ResetCatchSet" Pname="Cortex-M0p">
          <block>
            __var appValid     = 0;
            __var vtBase       = 0;
            __var resetAddress = 0;

            // Read VT_BASE register
            vtBase = Read32(CPUSS_CM0_VECTOR_TABLE_BASE) &amp; VTBASE_ADDR_Msk;
            appValid = (vtBase != 0) &amp;&amp; (vtBase != VTBASE_ADDR_Msk);
          </block>
          <control if="appValid">
            <block>
              // Get application address at reset vector
              resetAddress = Read32(vtBase + 4);
              appValid = (resetAddress != 0) &amp;&amp; (resetAddress != 0xFFFFFFFF)
            </block>
            <control if="appValid">
              <block info="Valid application found, set BP at app entry">
                // Enable Breakpoint unit using the FPB_CTRL
                Write32(FPB_CTRL, FPB_CTRL_KEY_ENABLE);

                // Map the address bits to the breakpoint compare register
                resetAddress = (resetAddress &amp; 0x1FFFFFFC) | 0xC0000001;

                // Configure the breakpoint compare register
                Write32(FPB_COMP0, resetAddress);
              </block>
            </control>
          </control>
          <control if="!appValid">
            <block info="No valid application found, enable reset vector catch">
              __var value = 0;

              // Enable Reset Vector Catch in DEMCR
              value = Read32(DEMCR);
              Write32(DEMCR, (value | DEMCR_VC_CORERESET));
            </block>
          </control>
          <block>
            // Read DHCSR to clear potentially set DHCSR.S_RESET_ST bit
            Read32(DHCSR);
          </block>
        </sequence>
        <sequence name="ResetCatchClear" Pname="Cortex-M0p">
          <block>
            __var value      = 0;

            // Disable Reset Vector Catch in DEMCR
            value = Read32(DEMCR);
            Write32(DEMCR, (value &amp; (~DEMCR_VC_CORERESET)));

            // Disable the breakpoint compare register
            Write32(FPB_COMP0, 0);
          </block>
        </sequence>
        <!-- HW Reset causes a reboot of the device which also resets debug.
             - Using this as a prereset is OK to potentially wake up the system from DeepSleep.
             - Using this in the middle of the debug session will break the connection unless recovery
               from a connection loss is supported by the debug IDE.
        -->
        <sequence name="ResetHardware">
          <block>
            __var nReset      = 0x80;
            __var canReadPins = 0;
            // Deassert nRESET line
            canReadPins = (DAP_SWJ_Pins(0x00, nReset, 0) != 0xFFFFFFFF);
          </block>
          <!-- Keep reset active for 50 ms -->
          <control while="1" timeout="50000" />
          <control if="canReadPins">
            <!-- Assert nRESET line and wait max. 1s for recovery -->
            <control while="(DAP_SWJ_Pins(nReset, nReset, 0) &amp; nReset) == 0" timeout="1000000" />
          </control>
          <control if="!canReadPins">
            <block>
              // Assert nRESET line
              DAP_SWJ_Pins(nReset, nReset, 0);
            </block>
            <!-- Wait 100ms for recovery if nRESET not readable -->
            <control while="1" timeout="100000" />
          </control>
          <block>
            // Give the bootloader time to finish (can be up to 600ms)
            DAP_Delay(__Reset_Finish_Delay);
          </block>
        </sequence>
        <sequence name="ResetSystem" Pname="Cortex-M0p">
          <block info="Read DEMCR to check VC_CORERESET bit and Halt CPU">
            // Capture VC_CORERESET bit of DEMCR register
            __var VC_CORERESET = (Read32(DEMCR) &amp; DEMCR_VC_CORERESET);

            // Enable debug, and halt the CPU
            Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_HALT | DHCSR_C_DEBUGEN);

          </block>
          <block>
            // Issue software reset using the AIRCR (Application Interrupt and Reset
            // Control Register). Note: do not check for ACK_OK of this operation
            Read32(DHCSR); // Clear DHCSR.S_RESET_ST
            __errorcontrol = 1;
            Write32(AIRCR, AIRCR_VECTKEY | AIRCR_SYSRESETREQ);
            sequence("DAP_poll");
            __errorcontrol = 0;
          </block>
          <!-- Reset Recovery: Wait for CPUSS_CM0_CTL to  bit to clear on read -->
          <control while="(Read32(DHCSR) &amp; DHCSR_S_RESET_ST)" timeout="500000" />
          <control if="(__connection &amp; 3) == 2">
            <block>
              // Prepare MCU for flash operations
              Sequence("PrepareCM0");
              // Force core halt for flash operations
              // This is needed because IDE expects core to be halted after ResetCatchSet execution
              // But core state was changed in PrepareCM0 sequence, thus have to force core halt
              VC_CORERESET=1;
            </block>
          </control>
          <control if="(__connection &amp; 3) == 1">
            <block>
              // Enable CM7 core(s) in order to be able to attach to it
              Sequence("DebuggingReadiness");
            </block>
          </control>
          <!-- Check against halt was requested by VC_CORERESET bit -->
          <control if="VC_CORERESET == 0">
            <block>
              // Clear C_HALT if halt isn't requested.
              Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_DEBUGEN);
            </block>
          </control>
          <control if="VC_CORERESET != 0">
            <block>
              // Set C_HALT if halt is requested.
              Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_HALT | DHCSR_C_DEBUGEN);
            </block>
          </control>
        </sequence>
        <!-- Cortex-M0+ Processor reset via XMC7xxx CPU Sub-System Controller. Cortex-M0+ doesn't have VECTRESET. -->
        <sequence name="ResetProcessor" Pname="Cortex-M0p">
          <block>
            Write32(CPUSS_CM0_CTL, CPUSS_PWR_KEY | CPUSS_PWR_STATE_RESET);  // Reset CM0+
          </block>
          <!-- Reset Recovery: Wait for CPUSS_CM0_CTL to  bit to clear on read -->
          <control while="(Read32(DHCSR) &amp; DHCSR_S_RESET_ST)" timeout="500000" />
          <control if="(__connection &amp; 3) == 1">
            <block>
              // Enable CM7 core(s) in order to be able to attach to it
              Sequence("DebuggingReadiness");
            </block>
          </control>
        </sequence>
        <sequence name="ResetAndHaltCM0">
          <block info="Halt CPU and determine application entry point">
            __ap = 1;
            __var appValid = 0;
            __var vtBase = 0;
            // Enable debug, and halt the CPU
            Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_HALT | DHCSR_C_DEBUGEN);
            // Read VT_BASE register
            vtBase = Read32(CPUSS_CM0_VECTOR_TABLE_BASE) &amp; VTBASE_ADDR_Msk;
            appValid = (vtBase != 0) &amp;&amp; (vtBase != VTBASE_ADDR_Msk);
          </block>
          <control if="appValid">
            <block info="Set BP at app entry and issue a reset">
              //Get application address at reset vector
              __var resetAddress = Read32(vtBase + 4);
            </block>
            <control if="(resetAddress != 0) &amp;&amp; (resetAddress != 0xFFFFFFFF)">
              <block>
                // Enable Breakpoint unit using the FPB_CTRL
                Write32(FPB_CTRL, FPB_CTRL_KEY_ENABLE);
                // Map the address bits to the breakpoint compare register
                resetAddress = (resetAddress &amp; 0x1FFFFFFC) | 0xC0000001;
                // Update the breakpoint compare register
                Write32(FPB_COMP0, resetAddress);
              </block>
            </control>
          </control>
          <block>
            // Issue software reset using the AIRCR (Application Interrupt and Reset
            // Control Register). Note: do not check for ACK_OK of this operation
            Read32(DHCSR); // Clear DHCSR.S_RESET_ST
            __errorcontrol = 1;
            Write32(AIRCR, AIRCR_VECTKEY | AIRCR_SYSRESETREQ);
            __errorcontrol = 0;
            // Give the bootloader time to finish (can be up to 600ms)
            DAP_Delay(__Reset_Finish_Delay);
            sequence("DAP_Handshake");
          </block>
          <!-- Reset Recovery: Wait for CPUSS_CM0_CTL to  bit to clear on read -->
          <control while="(Read32(DHCSR) &amp; DHCSR_S_RESET_ST)" timeout="500000" />
          <block>
            // Set C_HALT if halt isn't requested.
            Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_HALT | DHCSR_C_DEBUGEN);
          </block>
        </sequence>
        <!-- Prepare CM0+ core to serve SROM API calls -->
        <sequence name="PrepareCM0">
          <block>
            __var WFI_LOOP_ADDR = 0x28001000 - 4; // The address space above RAMstart (0x28001000) is used for flashalgo
            __var CM0_SP_ADDR = WFI_LOOP_ADDR;
            Message(0, "Transition of CM0+ core to a safe condition for flash programming ...");
            // Halt CM0+
            __ap = 1;
            Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_HALT | DHCSR_C_DEBUGEN);
          </block>
          <control while="(Read32(DHCSR) &amp; (DHCSR_S_HALT | DHCSR_S_REGRDY)) != (DHCSR_S_HALT | DHCSR_S_REGRDY)" timeout="1000000" info="Wait for core halts" />
          <block>
            // Write endless loop in RAM
            Write32(WFI_LOOP_ADDR, 0xE7FEE7FE);
            // Set VECTCLRACTIVE in AIRCR for CM0+
            Write32(AIRCR, AIRCR_VECTKEY | AIRCR_VECTCLRACTIVE);
            // Write CM0+ xPSR
            Write32(DCRDR, 0x01000000);
            Write32(DCRSR, DCRSR_REGWnR | 16); // xPSR
          </block>
          <control while="(Read32(DHCSR) &amp; DHCSR_S_REGRDY) != DHCSR_S_REGRDY" timeout="1000000" info="Wait for register transfer to complete" />
          <block>
            // Write CM0+ CONTROL, PRIMASK
            Write32(DCRDR, 0x00000000);
            Write32(DCRSR, DCRSR_REGWnR | 20); // CONTROL/PRIMASK
          </block>
          <control while="(Read32(DHCSR) &amp; DHCSR_S_REGRDY) != DHCSR_S_REGRDY" timeout="1000000" info="Wait for register transfer to complete" />
          <block>
            // Write CM0+ PC
            Write32(DCRDR, WFI_LOOP_ADDR | 1);
            Write32(DCRSR, DCRSR_REGWnR | 15); // PC
          </block>
          <control while="(Read32(DHCSR) &amp; DHCSR_S_REGRDY) != DHCSR_S_REGRDY" timeout="1000000" info="Wait for register transfer to complete" />
          <block>
            // Write CM0+ SP
            Write32(DCRDR, CM0_SP_ADDR);
            Write32(DCRSR, DCRSR_REGWnR | 13); // SP
          </block>
          <control while="(Read32(DHCSR) &amp; DHCSR_S_REGRDY) != DHCSR_S_REGRDY" timeout="1000000" info="Wait for register transfer to complete" />
          <block>
            // Write CM0+ VTOR
            Write32(VTOR, 0x00000000);
            // Clear all pending interrupts in CM0+
            Write32(NVIC_ICPR0, 0x0000FFFF);
            // Enable only CM0+ IRQ0/1
            Write32(NVIC_ICER0, 0xFFFFFFFC);
            Write32(NVIC_ISER0, 0x00000003);
            // Set priority of IRQ0=1, IRQ1=0. Need to make sure IRQ1 is triggered even if IRQ0 is pending.
            Write32(NVIC_IPR0, 0x00000040);
            // Release CM0+ from halt state
            Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_DEBUGEN);
          </block>
        </sequence>
        <sequence name="DAP_Handshake">
          <!-- DAP_Handshake: Execute initial handshake sequence depend on selected protocol -->
          <block>
            __var isSWJ      = ((__protocol &amp; 0x00010000) != 0);
            __var protType   = __protocol &amp; 0x0000FFFF;
            __var DPIDR = 0;
            __Result = 0;
          </block>
          <!-- JTAG Protocol -->
          <control if="protType == 1">
            <control if="isSWJ">
              <block atomic="true">
                // Ensure current debug interface is in reset state
                DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                // Execute SWJ-DP Switch Sequence SWD to JTAG (0xE73C)
                // Change if SWJ-DP uses deprecated switch code (0xAEAE)
                DAP_SWJ_Sequence(16, 0xE73C);
              </block>
            </control>
            <block atomic="true">
              // JTAG "Soft" Reset
              DAP_JTAG_Sequence(6, 1, 0x00);                        // Test-Logic-Reset
              // Get IDCODE to make sure that JTAG-DP is available
              DAP_JTAG_Sequence(4, 0, 0x00);                        // 4*Run-Test/Idle
              DAP_JTAG_Sequence(2, 1, 0x00);                        // ~ Select-DR ~ Select-IR
              DAP_JTAG_Sequence(2, 0, 0x00);                        // ~ Capture-IR ~ Shift-IR
              DAP_JTAG_Sequence(8, 0, 0xFE);                        // Shift-IR (IDCODE BYPASS)
              DAP_JTAG_Sequence(5, 1, 0x00);                        // ~ Exit1-IR (IDCODE BYPASS) ~ Update-IR ~ Test-Logic-Reset
              DAP_JTAG_Sequence(4, 0, 0x00);                        // Make sure that we go through Idle state in TAP controller
              DAP_JTAG_Sequence(1, 1, 0x00);                        // Select-DR
              DAP_JTAG_Sequence(2, 0, 0x00);                        // ~ Capture-DR ~ Shift-DR
              DPIDR = DAP_JTAG_Sequence(33, 0, 0x00000000);         // Shift 33-bits data
              DAP_JTAG_Sequence(5, 1, 0x00);                        // ~ Exit1-DR ~ Update-DR ~ ~ Select-DR ~ Select-IR ~ Test-Logic-Reset
              DAP_JTAG_Sequence(4, 0, 0x00);                        // Make sure that we go through Idle state in TAP controller
            </block>
          </control>
          <!-- SWD Protocol -->
          <control if="protType == 2">
            <control if="isSWJ">
              <block atomic="true">
                // Ensure current debug interface is in reset state
                DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                // Execute SWJ-DP Switch Sequence JTAG to SWD (0xE79E)
                // Change if SWJ-DP uses deprecated switch code (0xEDB6)
                DAP_SWJ_Sequence(16, 0xE79E);
                // Enter SWD Line Reset State
                DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); // More than 50 cycles SWDIO/TMS High
                DAP_SWJ_Sequence(3,  0x00);               // At least 2 idle cycles (SWDIO/TMS Low)
              </block>
            </control>
            <control if="!isSWJ">
              <block atomic="true">
                // Enter SWD Line Reset State
                DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); // More than 50 cycles SWDIO/TMS High
                DAP_SWJ_Sequence(3,  0x00);               // At least 2 idle cycles (SWDIO/TMS Low)
              </block>
            </control>
            <block>
              DPIDR = ReadDP(0x0); // Read DPIDR to enable SWD interface (SW-DPv1 and SW-DPv2)
            </block>
          </control>
          <control if="(DPIDR &amp; 0xFFF00FFF) != 0x6BA00477">
            <block>
              __Result = -1; // DAP is unavailable
            </block>
          </control>
        </sequence>
        <sequence name="DAP_poll">
          <!-- DAP_poll: Poll the DAP until it becomes available -->
          <block>
            __Result = -1; // Assume DAP is not available yet
          </block>
          <control while="__Result != 0" timeout="600000">
            <block>
              sequence("DAP_Handshake"); // Poll DP until bootloader allows access to device (can be up to 600ms)
            </block>
          </control>
          <control if="__Result != 0">
            <block>
              Message(1, "The Debug Access Port is unavailable.");
            </block>
          </control>
        </sequence>
        <!-- Enable CM7 clock -->
        <sequence name="EnableCM7Clock">
          <block>
            __var CLK_ROOT_SELECT = Read32(CPUSS_CLK_PATH1_SELECT);
          </block>
          <control if="(CLK_ROOT_SELECT &amp; PERI_CLK_PATH_SELECT_ENABLED_Msk) != PERI_CLK_PATH_SELECT_ENABLED_Msk">
            <block>
              Write32(CPUSS_CLK_PATH1_SELECT, (CLK_ROOT_SELECT | PERI_CLK_PATH_SELECT_ENABLED_Msk));
              Message(0, "CLK_HF1 was enabled.");
            </block>
          </control>
        </sequence>
        <!-- Set power mode of CM7_0 core to ENABLED -->
        <sequence name="PowerUpCM7_0">
          <block>
            __var pwrCtlVal = Read32(CPUSS_CM7_0_PWR_CTL);
          </block>
          <control if="(pwrCtlVal &amp; CPUSS_PWR_STATE_Msk) != CPUSS_PWR_STATE_ENABLED">
            <block>
              // Set power mode of CM7
              Write32(CPUSS_CM7_0_PWR_CTL, CPUSS_PWR_KEY | CPUSS_PWR_STATE_ENABLED);
              Message(0, "The power mode of Cortex-M7_0 core was set to ENABLED.");
              Write32(CPUSS_CM7_0_PWR_CTL, CPUSS_PWR_KEY | CPUSS_PWR_STATE_RETAINED);
              Message(0, "The power mode of Cortex-M7_0 core was set to RESET.");
            </block>
          </control>
          <!-- Set power mode of CM7 to ENABLED. The core will stop at reset vector -->
          <block>
            __var cm7CtlVal = Read32(CPUSS_CM7_0_CTL);
          </block>
          <control if="cm7CtlVal &amp; CPUSS_CM7_CTL_CPU_WAIT_Msk">
            <block>
              // Prepare for vector catch
              __ap = 2;
              Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_HALT | DHCSR_C_DEBUGEN);
              Write32(DEMCR, DEMCR_VC_CORERESET);
              __ap = 1;
              // Deassert CPU_WAIT and enable ITCM, DTCM, AHBPCR, and VTOR
              Write32(CPUSS_CM7_0_CTL, (cm7CtlVal &amp; ~CPUSS_CM7_CTL_INIT_Msk));
              Message(0, "CPU_WAIT of Cortex-M7_0 core was deasserted.");
            </block>
          </control>
        </sequence>
        <!-- Check CM7 clock -->
        <sequence name="CheckCM7Clock">
          <block>
            __var CLK_ROOT_SELECT = Read32(CPUSS_CLK_PATH1_SELECT);
          </block>
          <control if="(CLK_ROOT_SELECT &amp; PERI_CLK_PATH_SELECT_ENABLED_Msk) != PERI_CLK_PATH_SELECT_ENABLED_Msk">
            <block>
              Message(2, "The CM7 core clock source (CLK_HF1) is not enabled by the CM0+ application. Further debugging is not possible.");
            </block>
          </control>
        </sequence>
        <!-- Check power mode of CM7_0 core  -->
        <sequence name="CheckPowerCM7_0">
          <block>
            __var pwrCtlVal = Read32(CPUSS_CM7_0_PWR_CTL);
          </block>
          <control if="((pwrCtlVal &amp; CPUSS_PWR_STATE_Msk) != CPUSS_PWR_STATE_ENABLED) &amp;&amp; ((pwrCtlVal &amp; CPUSS_PWR_STATE_Msk) != CPUSS_PWR_STATE_RETAINED)">
            <block>
              Message(2, "The power mode of Cortex-M7_0 core was NOT ENABLED by the CM0+ application. Further debugging is not possible.");
            </block>
          </control>
        </sequence>
        <!-- Read and print device info -->
        <sequence name="PrintDeviceInfo">
          <block>
            __var siId;
            __var siRev;
            __var siFamily;
            __var fbVerHi;
            __var protection;
            __var v;
            Message(0, "****************************************************");
            // Get Si Id, Family and Rev.
            v = Read32(SI_ID);
            siId = (v &amp; SI_ID_DEVID_Msk) &gt;&gt; SI_ID_DEVID_Pos;
            siRev = (v &amp; SI_ID_REV_Msk) &gt;&gt; SI_ID_REV_Pos;
            v = Read32(SI_FAMILY_ID);
            siFamily = v &amp; SI_FAMILY_ID_Msk;
            Message(0, "** Silicon: 0x%04X, Family: 0x%03X, Rev.: 0x%02X", siId, siFamily, siRev);
            // Get FlashBboot verison
            fbVerHi = Read32(FB_VERSION_HI);
          </block>
          <control if="fbVerHi == 0">
            <block>
              Message(1, "Invalid FlashBoot: High version word of Flash Boot is zero");
            </block>
          </control>
          <control if="fbVerHi != 0">
            <block>
              __var fbVerLo = Read32(FB_VERSION_LO);
              __var b0 = fbVerHi &gt;&gt; 28;
              __var b1 = (fbVerHi &gt;&gt; 24) &amp; 0x0F;
              __var b2 = (fbVerHi &gt;&gt; 16) &amp; 0xFF;
              __var b3 = fbVerHi &amp; 0x0000FFFF;
            </block>
            <control if="b0 &gt; 2">
              <block>
                Message(1, "Unsupported Flash Boot Version - Flash Boot Version [31:28] = 0x%X", b0);
              </block>
            </control>
            <control if="b0 &lt;= 2">
              <control if="b3 != 0x8001">
                <block>
                  Message(1, "Flash Boot is corrupted or non Flash Boot image programmed");
                </block>
              </control>
              <control if="b3 == 0x8001">
                <!-- Versioning scheme #1 -->
                <control if="b0 == 0">
                  <control if="b1 == 1">
                    <block>
                      Message(0, "** Flash Boot version: 1.%02u", b2);
                    </block>
                  </control>
                  <control if="b1 == 2">
                    <control if="b2 &lt; 20">
                      <block>
                        Message(0, "** Flash Boot version: 1.0.0.%u", b2);
                      </block>
                    </control>
                    <control if="(b2 &gt;= 20) &amp;&amp; (b2 &lt; 29)">
                      <block>
                        Message(0, "** Flash Boot version: 1.0.1.%u", b2);
                      </block>
                    </control>
                    <control if="b2 &gt;= 29">
                      <block>
                        Message(0, "** Flash Boot version: 1.20.1.%u", b2);
                      </block>
                    </control>
                  </control>
                </control>
                <!-- Versioning scheme #2 -->
                <control if="b0 == 1">
                  <block>
                    Message(0, "** Flash Boot version: 2.0.0.%u", b2);
                  </block>
                </control>
                <!-- Versioning scheme #3 -->
                <control if="b0 == 2">
                  <block>
                    __var patch = fbVerLo &gt;&gt; 24;
                    __var build = fbVerLo &amp; 0x0000FFFF;
                    Message(0, "** Flash Boot version: %u.%u.%u.%u", b1, b2, patch, build);
                  </block>
                </control>
              </control>
            </control>
          </control>
          <!-- Get life-cycle stage -->
          <control>
            <block>
              protection = Read32(CPUSS_PROTECTION);
            </block>
          </control>
          <!-- Decode life-cycle stage -->
          <control if="protection == 1">
            <block>
              Message(0, "** Chip Protection: VIRGIN");
            </block>
          </control>
          <control if="protection == 2">
            <block>
              Message(0, "** Chip Protection: NORMAL");
            </block>
          </control>
          <control if="protection == 3">
            <block>
              Message(0, "** Chip Protection: SECURE");
            </block>
          </control>
          <control if="protection == 4">
            <block>
              Message(0, "** Chip Protection: DEAD");
            </block>
          </control>
          <control if="(protection == 0) || (protection &gt; 4)">
            <block>
              Message(0, "** Chip Protection: UNKNOWN");
            </block>
          </control>
          <block>
            Message(0, "****************************************************");
          </block>
        </sequence>
        <sequence name="DebugDeviceUnlock" Pname="Cortex-M0p">
          <block>
            // Print device info
            Sequence("PrintDeviceInfo");
          </block>
        </sequence>
        <!-- Set power mode of CM7_1 core to ENABLED -->
        <sequence name="PowerUpCM7_1">
          <block>
            __var pwrCtlVal = Read32(CPUSS_CM7_1_PWR_CTL);
          </block>
          <control if="(pwrCtlVal &amp; CPUSS_PWR_STATE_Msk) != CPUSS_PWR_STATE_ENABLED">
            <block>
              // Set power mode of CM7
              Write32(CPUSS_CM7_1_PWR_CTL, CPUSS_PWR_KEY | CPUSS_PWR_STATE_ENABLED);
              Message(0, "The power mode of Cortex-M7_1 core was set to ENABLED.");
              Write32(CPUSS_CM7_1_PWR_CTL, CPUSS_PWR_KEY | CPUSS_PWR_STATE_RETAINED);
              Message(0, "The power mode of Cortex-M7_1 core was set to RESET.");
            </block>
          </control>
          <!-- Set power mode of CM7 to ENABLED. The core will stop at reset vector -->
          <block>
            __var cm7CtlVal = Read32(CPUSS_CM7_1_CTL);
          </block>
          <control if="cm7CtlVal &amp; CPUSS_CM7_CTL_CPU_WAIT_Msk">
            <block>
              // Prepare for vector catch
              __ap = 3;
              Write32(DHCSR, DHCSR_DBGKEY | DHCSR_C_HALT | DHCSR_C_DEBUGEN);
              Write32(DEMCR, DEMCR_VC_CORERESET);
              __ap = 1;
              // Deassert CPU_WAIT and enable ITCM, DTCM, AHBPCR, and VTOR
              Write32(CPUSS_CM7_1_CTL, (cm7CtlVal &amp; ~CPUSS_CM7_CTL_INIT_Msk));
              Message(0, "CPU_WAIT of Cortex-M7_1 core was deasserted.");
            </block>
          </control>
        </sequence>
        <!-- Make required steps for flash operations -->
        <sequence name="FlashPreparation">
          <control if="__ap == 2">
            <block>
              // Use CM0+ ap for nested sequences
              __ap = 1;
              Sequence("ResetAndHaltCM0");
              Sequence("PrepareCM0");
              Sequence("EnableCM7Clock");
              Sequence("PowerUpCM7_0");
            </block>
          </control>
          <control if="__ap == 3">
            <block>
              // Use CM0+ ap for nested sequences
              __ap = 1;
              Sequence("ResetAndHaltCM0");
              Sequence("PrepareCM0");
              Sequence("EnableCM7Clock");
              Sequence("PowerUpCM7_1");
            </block>
          </control>
        </sequence>
        <!-- Check power mode of CM7_1 core  -->
        <sequence name="CheckPowerCM7_1">
          <block>
            __var pwrCtlVal = Read32(CPUSS_CM7_1_PWR_CTL);
          </block>
          <control if="((pwrCtlVal &amp; CPUSS_PWR_STATE_Msk) != CPUSS_PWR_STATE_ENABLED) &amp;&amp; ((pwrCtlVal &amp; CPUSS_PWR_STATE_Msk) != CPUSS_PWR_STATE_RETAINED)">
            <block>
              Message(2, "The power mode of Cortex-M7_1 core was NOT ENABLED by the CM0+ application. Further debugging is not possible.");
            </block>
          </control>
        </sequence>
        <!-- Make sure that the application on CM0+ has prepared the CM7 core for debugging.  -->
        <sequence name="DebuggingReadiness">
          <control if="__ap == 1">
            <block>
              Sequence("EnableCM7Clock");
              Sequence("PowerUpCM7_0");
              Sequence("PowerUpCM7_1");
            </block>
          </control>
          <control if="__ap == 2">
            <block>
              // Use CM0+ ap for nested sequences
              __ap = 1;
              Sequence("CheckCM7Clock");
              Sequence("CheckPowerCM7_0");
            </block>
          </control>
          <control if="__ap == 3">
            <block>
              // Use CM0+ ap for nested sequences
              __ap = 1;
              Sequence("CheckCM7Clock");
              Sequence("CheckPowerCM7_1");
            </block>
          </control>
        </sequence>
        <sequence name="DebugDeviceUnlock" Pname="Cortex-M7-0">
          <control if="(__connection &amp; 3) == 2">
            <block>
              // Prepare MCU for flash operations
              Sequence("FlashPreparation");
            </block>
          </control>
          <control if="(__connection &amp; 3) == 1">
            <block>
              // Checking core readiness for debugging
              Sequence("DebuggingReadiness");
            </block>
          </control>
          <block>
            // Print device info
            Sequence("PrintDeviceInfo");
          </block>
        </sequence>
        <sequence name="DebugCoreStart" Pname="Cortex-M7-0">
          <block>
            __var value = Read32(DHCSR);
          </block>
          <control if="(value &amp; 0x00000001) == 0">
            <block>
              // Enable Core Debug via DHCSR
              Write32(DHCSR, (value &amp; 0x0000FFFF) | DHCSR_DBGKEY | DHCSR_C_DEBUGEN);
              </block>
          </control>
          <!-- Enable the trace clock and power up the CM7 core(s) to detect trace resources properly during a debug session -->
          <control if="((__connection &amp; 0x00000001) != 0) &amp;&amp; ((__traceout &amp; 0x00000006) != 0)">
            <block>
              Sequence("SetupTraceClock");
              __ap = 1;
              Sequence("EnableCM7Clock");
              Sequence("PowerUpCM7_0");
              Sequence("PowerUpCM7_1");
            </block>
          </control>
        </sequence>
        <sequence name="DebugDeviceUnlock" Pname="Cortex-M7-1">
          <control if="(__connection &amp; 3) == 2">
            <block>
              // Prepare MCU for flash operations
              Sequence("FlashPreparation");
            </block>
          </control>
          <control if="(__connection &amp; 3) == 1">
            <block>
              // Checking core readiness for debugging
              Sequence("DebuggingReadiness");
            </block>
          </control>
          <block>
            // Print device info
            Sequence("PrintDeviceInfo");
          </block>
        </sequence>
        <sequence name="DebugCoreStart" Pname="Cortex-M7-1">
          <block>
            __var value = Read32(DHCSR);
          </block>
          <control if="(value &amp; 0x00000001) == 0">
            <block>
              // Enable Core Debug via DHCSR
              Write32(DHCSR, (value &amp; 0x0000FFFF) | DHCSR_DBGKEY | DHCSR_C_DEBUGEN);
              </block>
          </control>
          <!-- Enable the trace clock and power up the CM7 core(s) to detect trace resources properly during a debug session -->
          <control if="((__connection &amp; 0x00000001) != 0) &amp;&amp; ((__traceout &amp; 0x00000006) != 0)">
            <block>
              Sequence("SetupTraceClock");
              __ap = 1;
              Sequence("EnableCM7Clock");
              Sequence("PowerUpCM7_0");
              Sequence("PowerUpCM7_1");
            </block>
          </control>
        </sequence>
        <!-- Configure trace clock and pins -->
        <sequence name="TraceStart" Pname="Cortex-M7-0">
          <block>
            // Configure Coresight TF(Trace Funnel)
            Write32(CSTFCTL, CSTFCTL_CM7_0_PORTS_Msk);
            // Configure pins
            Sequence("SetupTracePins");
          </block>
        </sequence>
        <sequence name="TraceStart" Pname="Cortex-M7-1">
          <block>
            // Temporary switch to CM7_0 core's AP
            __ap = 2;
            // Configure Coresight TF(Trace Funnel)
            Write32(CSTFCTL, CSTFCTL_CM7_1_PORTS_Msk);
            // Switch back to CM7_1 core's AP
            __ap = 3;
            // Configure pins
            Sequence("SetupTracePins");
          </block>
        </sequence>
        <sequence name="SetupTraceClock">
          <control if="__TPIU_clocksetup != 0">
            <block>
              // Peripheral clock divider index to use for trace clock
              __var ClockDivSel = PERI_CLOCK_CTL_DIV_SEL &amp; PERI_CLOCK_CTL_DIV_SEL_Msk;
              __var ClockDivVal = __TPIU_clockdivval &amp; PERI_DIV_PA_SEL_Msk; // Peripheral clock divider value for trace clock
                                                                                 // Actual divider is (1+ClockDivVal)
              __var ClockCtlVal = Read32(CPUSS_TRACE_CLOCK_CTL);
              __var ClockDivCtlVal = Read32(CPUSS_TRACE_CLOCK_DIV_CTL + (ClockDivSel * 4));
            </block>
            <control if="(ClockCtlVal != ClockDivSel) || (ClockDivCtlVal != ((ClockDivVal &lt;&lt; PERI_DIV_PA_SEL_Pos) | 0x1))">
              <block>
                Message(0, "Setup TPIU clock, divider value is %u", ClockDivVal);
                // DISABLE 8.0 DIV in PERI_DIV_CMD:
                __var ClockDivCmd = PERI_DIV_CMD_DISABLE_Msk | (PERI_DIV_PA_SEL_Msk &lt;&lt; PERI_DIV_PA_SEL_Pos) | ClockDivSel;
                Write32(CPUSS_TRACE_CLOCK_DIV_CMD, ClockDivCmd);
                // Use selected divider (8.0) for cpuss.clock_trace_in
                Write32(CPUSS_TRACE_CLOCK_CTL, ClockDivSel);
                // Set 8.0 DIV = ClockDivVal
                Write32((CPUSS_TRACE_CLOCK_DIV_CTL + (ClockDivSel * 4)), (ClockDivVal &lt;&lt; 8));
                // ENABLE 8.0 DIV
                ClockDivCmd = PERI_DIV_CMD_ENABLE_Msk | (PERI_DIV_PA_SEL_Msk &lt;&lt; PERI_DIV_PA_SEL_Pos) | ClockDivSel;
                Write32(CPUSS_TRACE_CLOCK_DIV_CMD, ClockDivCmd);
              </block>
            </control>
          </control>
        </sequence>
        <!-- Configure pins trace pins if Parallel Trace Port enabled -->
        <sequence name="SetupTracePins">
          <control if="(__traceout &amp; 0x00000002) != 0" info="Parallel Trace Port enabled">
            <control if="__TPIU_pinlocation == 1" info="XMC72_EVK Kit like">
              <block>
                __var tpWidth = (__traceout &amp; 0x003F0000) &gt;&gt; 16;
                sequence("SetupTracePin_P22_4"); // TRACECLK
                sequence("SetupTracePin_P21_5"); // TRACEDATA[0]
              </block>
              <control if="tpWidth &gt; 1">
                <block>
                  sequence("SetupTracePin_P22_1"); // TRACEDATA[1]
                </block>
              </control>
              <control if="tpWidth &gt; 2">
                <block>
                  sequence("SetupTracePin_P22_2"); // TRACEDATA[2]
                  sequence("SetupTracePin_P22_3"); // TRACEDATA[3]
                </block>
              </control>
            </control>
            <control if="__TPIU_pinlocation == 2" info="P18 like">
              <block>
                __var tpWidth = (__traceout &amp; 0x003F0000) &gt;&gt; 16;
                sequence("SetupTracePin_P18_3"); // TRACECLK
                sequence("SetupTracePin_P18_4"); // TRACEDATA[0]
              </block>
              <control if="tpWidth &gt; 1">
                <block>
                  sequence("SetupTracePin_P18_5"); // TRACEDATA[1]
                </block>
              </control>
              <control if="tpWidth &gt; 2">
                <block>
                  sequence("SetupTracePin_P18_6"); // TRACEDATA[2]
                  sequence("SetupTracePin_P18_7"); // TRACEDATA[3]
                </block>
              </control>
            </control>
          </control>
        </sequence>
        <!-- Setup Trace Pin P18_3 as TRACECLK -->
        <sequence name="SetupTracePin_P18_3">
          <block>
            __var port = 18;                          // Port number
            __var pin = 3;                            // Pin number
            __var reg0;
            __var reg1;
            __var offset;
            __var regAddr;
            __var confChanged = 0; // Pin's configuration change flag
          </block>
          <!-- Select pin route connection in HSIOM_PRT[port]_PORT_SEL[0/1] register -->
          <control if="pin &lt; 4">
            <block>
              // Pin[0-3] selection is in HSIOM_PRT[port]_PORT_SEL0 register
              regAddr = HSIOM_BASE + (HSIOM_PRT_SECTION_SIZE * port); // Use HSIOM_PRT[port]_PORT_SEL0
              offset = pin * 8; // Offset of the IO[pin]_SEL field for required pin number,
                                // where 8 = 5 bits for IO[pin]_SEL field + 3 not used bits
            </block>
          </control>
          <control if="pin &gt; 3">
            <block>
              // Pin[4-7] selection is in HSIOM_PRT[port]_PORT_SEL1 register
              regAddr = HSIOM_BASE + (HSIOM_PRT_SECTION_SIZE * port) + HSIOM_PRT_PORT_SEL1_OFFSET; // Use HSIOM_PRT[port]_PORT_SEL1
              offset = (pin &amp; 3) * 8; // Offset of the IO[pin]_SEL field for required pin number,
                                      // where 8 = 5 bits for IO[pin]_SEL field + 3 not used bits
            </block>
          </control>
          <block>
            reg0 = Read32(regAddr);
            reg1 = (reg0 &amp; ~(GPIO_PRT_IO_SEL_Msk &lt;&lt; offset)) | (ioSelVal &lt;&lt; offset); // Update value in IO[pin]_SEL field
          </block>
          <control if="reg0 != reg1">
            <block>
              Write32(regAddr, reg1);
              confChanged = 1;
            </block>
          </control>
          <!-- Disable input buffer and set drive mode in GPIO_PRT[port]_CFG register -->
          <block>
