  <csolution>
    <template name="Blank MCHP Driver Solution" path="Templates/Blank_Solution" file="Blank.csolution.yml" condition="PIC32CZ-CA70">
      <description>MCHP Blank Solution</description>
    </template>
  </csolution>

  <components>

      <component Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="ACC" Cversion="1.0.0" condition="PIC32CZ-CA70">
        <description>Analog Comparator Controller</description>
        <RTE_Components_h>
          #include "plib_acc.h"
        </RTE_Components_h>
        <files>
          <file category="doc" name="Documentation/html/group__acc__interface__gr.html" />
          <file category="header" name="plib/Include/plib_acc.h" />
          <file category="source" name="plib/Source/plib_acc.c" />
          <file category="source" name="plib/Template/configure_acc.c" attr="template" select="ACC Example Template" />
        </files>
      </component>

      <component Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="AFEC" Csub="AFEC0" Cversion="1.0.0" condition="PIC32CZ-CA70">
