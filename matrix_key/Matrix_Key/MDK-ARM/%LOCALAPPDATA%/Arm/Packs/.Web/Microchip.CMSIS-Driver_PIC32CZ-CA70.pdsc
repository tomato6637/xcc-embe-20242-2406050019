      <require Cclass="MCHP-PLIB" Cgroup="UART" Csub="UART1"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_UART2_Req_CA70">
      <description>Requires MCHP-PLIB UART (UART2)</description>
      <require condition="PIC32CZ-CA70"/>
      <require Cclass="MCHP-PLIB" Cgroup="UART" Csub="UART2"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_UART3_Req_CA70">
      <description>Requires MCHP-PLIB UART (UART3)</description>
