<?xml version="1.0" encoding="utf-8"?>
  <package schemaVersion="1.7.37" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
  xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.37/schema/PACK.xsd">
  <vendor>Microchip</vendor>
  <name>CMSIS-Driver_PIC32CZ-CA70</name>
  <description overview="OVERVIEW.md">
    Microchip PIC32CZ-CA70 Series CMSIS Driver Support
  </description>
  <supportContact>https://www.microchip.com/en-us/support</supportContact>
  <url>https://packs.download.microchip.com/</url>
  <license>LICENSE.txt</license>
  <licenseSets>
    <licenseSet id="all" default="true" gating="true">
      <license name="LICENSE.txt" title="Microchip EULA" url="https://www.microchip.com/en-us/about/license-agreement-end-user"/>
    </licenseSet>
  </licenseSets>
  <releases>
    <release version="1.0.0" date="2026-08-31" tag="1.0.0">
      Driver and Plib Support for PIC32CZ-CA70 devices
      Template Project:
      - Blank MCHP Driver Solution
    </release>
  </releases>
  <keywords>
    <keyword>Microchip</keyword>
    <keyword>Software Pack</keyword>
    <keyword>PIC32CZ-CA70</keyword>
  </keywords>
  <taxonomy>
    <description Cclass="CMSIS Driver" doc="CMSIS/Documentation/Driver/html/index.html">
      Unified Device Drivers compliant to CMSIS-Driver Specifications.
    </description>
    <description Cclass="MCHP-PLIB">
      Microchip Peripherals Library (PLIB) Software Component
    </description>
  </taxonomy>
  <conditions>
    <condition id="Tested with Compiler">
      <accept Tcompiler="ARMCC" Toptions="AC6"/>
      <accept Tcompiler="GCC"/>
      <accept Tcompiler="IAR"/>
      <accept Tcompiler="CLANG"/>
      <accept Tcompiler="XC"/>
    </condition>
    <condition id="CM7">
      <description>Cortex-M7 based device</description>
      <require condition="Tested with Compiler"/>
      <accept Dcore="Cortex-M7"/>
    </condition>
    <condition id="Driver_USART0_Req_CA70">
      <description>Requires MCHP-PLIB USART (USART0)</description>
      <require condition="PIC32CZ-CA70"/>
      <require Cclass="MCHP-PLIB" Cgroup="USART" Csub="USART0"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_USART1_Req_CA70">
      <description>Requires MCHP-PLIB USART (USART1)</description>
      <require condition="PIC32CZ-CA70"/>
      <require Cclass="MCHP-PLIB" Cgroup="USART" Csub="USART1"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_USART2_Req_CA70">
      <description>Requires MCHP-PLIB USART (USART2)</description>
      <require condition="PIC32CZ-CA70_100_144"/>
      <require Cclass="MCHP-PLIB" Cgroup="USART" Csub="USART2"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_UART0_Req_CA70">
      <description>Requires MCHP-PLIB UART (UART0)</description>
      <require condition="PIC32CZ-CA70"/>
      <require Cclass="MCHP-PLIB" Cgroup="UART" Csub="UART0"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
