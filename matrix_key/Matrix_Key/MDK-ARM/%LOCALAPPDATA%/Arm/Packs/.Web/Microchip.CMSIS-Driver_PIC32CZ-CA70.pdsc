      <require Cclass="MCHP-PLIB" Cgroup="UART" Csub="UART4"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_SPI0_Req_CA70">
      <description>Requires MCHP-PLIB SPI (SPI0)</description>
      <require condition="PIC32CZ-CA70_100_144"/>
      <require Cclass="MCHP-PLIB" Cgroup="SPI" Csub="SPI0"/>
      <require Cclass="MCHP-PLIB" Cgroup="PIO"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_SPI1_Req_CA70">
      <description>Requires MCHP-PLIB SPI (SPI1)</description>
      <require condition="PIC32CZ-CA70_144"/>
      <require Cclass="MCHP-PLIB" Cgroup="SPI" Csub="SPI1"/>
