    </condition>
    <condition id="Driver_I2C0_Req_CA70">
      <description>Requires MCHP-PLIB TWIHS (TWIHS0)</description>
      <require condition="PIC32CZ-CA70"/>
      <require Cclass="MCHP-PLIB" Cgroup="TWIHS" Csub="TWIHS0"/>
      <require Cclass="MCHP-PLIB" Cgroup="PMC"/>
    </condition>
    <condition id="Driver_I2C1_Req_CA70">
      <description>Requires MCHP-PLIB TWIHS (TWIHS1)</description>
      <require condition="PIC32CZ-CA70"/>
      <require Cclass="MCHP-PLIB" Cgroup="TWIHS" Csub="TWIHS1"/>
