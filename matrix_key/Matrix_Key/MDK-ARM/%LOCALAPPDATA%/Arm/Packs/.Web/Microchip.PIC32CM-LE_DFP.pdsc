<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.57/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>PIC32CM-LE_DFP</name>
   <description overview="./OVERVIEW.md">Microchip PIC32CM-LE Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="1.4.336" date="2026-05-20">
                - CMSIS System Initialization is now included as default. Define DISABLE_CMSIS_INIT to not include.
                - Added ARMCC scatter/linker scripts and startup files.
                - Added Keil CMSIS flash loaders.
                - Added csolution project templates.
                - Added Apache 2.0 license file.
                - Interrupt handlers in startup files renamed: SVCall_Handler to SVC_Handler, NonMaskableInt_Handler to NMI_Handler.
            </release>
      <release version="1.3.280" date="2024-04-15">
                - Updated calculated size of peripheral address blocks in SVD files for some modules.
            </release>
      <release version="1.2.273" date="2023-05-23">
                - Added support for PIC32CM1216LE00032 and PIC32CM1216LE00048
            </release>
      <release version="1.1.162" date="2022-06-03">
                - Improved memory area naming.
            </release>
      <release version="1.0.154" date="2022-03-24">
                - Initial release.
            </release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>PIC32CM-LE</keyword>
      <keyword>Microcontrollers And Processors</keyword>
      <keyword>32-Bit Microcontrollers</keyword>
      <keyword>32</keyword>
      <keyword>Bit</keyword>
      <keyword>Microcontrollers</keyword>
      <keyword>Touch</keyword>
      <keyword>Ultra Low Power</keyword>
      <keyword>UltraLowPower</keyword>
      <keyword>Automotive Recommended</keyword>
      <keyword>Microcontrollers and Processors</keyword>
      <keyword>32-bit Microcontrollers</keyword>
   </keywords>
   <requirements>
      <packages>
         <package vendor="ARM" name="CMSIS"/>
      </packages>
   </requirements>
   <devices>
      <family Dfamily="PIC32CM-LE" Dvendor="Microchip:3">
         <debugvars version="1.0.0" configfile="debug/PIC32CM-LE.dbgconf">
            __var AIRCR_Addr = 0xE000ED0C;
            __var DHCSR_Addr = 0xE000EDF0;
            __var DEMCR_Addr = 0xE000EDFC;
            __var DCRSR_Addr = 0xE000EDF4;
            __var DCRDR_Addr = 0xE000EDF8;
            __var DSU_BASE_ADDR = 0x41002100;
            __var DSU_STATUSA_ADDR = DSU_BASE_ADDR + 0x1;
            __var DSU_STATUSB_ADDR = DSU_BASE_ADDR + 0x2;
            __var DSU_BCC0_ADDR = DSU_BASE_ADDR + 0x20;
            __var DSU_BCC1_ADDR = DSU_BASE_ADDR + 0x24;
            __var DSU_STATUSB_DAL_BIT = 0x3;
            __var CRSTEXTBIT = 0x2;
            __var BREXTBIT = 0x20;
            __var DEBUGGER_CMD_EXIT = 0x444247AA;
            __var DEBUGGER_CMD_IMODE = 0x44424755;
            __var NVMCTRL_ADDR_Addr = 0x4100401C;
            __var NVMCTRL_CTRLA_Addr = 0x41004000;
            __var NVMCTRL_STATUS_Addr = 0x41004018;
        </debugvars>
         <sequences>
            <sequence name="ResetSystem">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetHardware">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetProcessor">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetAndHalt">
               <block>
                    Sequence("ResetToPark");
                    Sequence("ReleaseBREXT");
                </block>
               <control if="__connection &amp; 0xFF00 != 0">
                  <block>
                        Write32(DEMCR_Addr, 0x01000000);
                        Write32(0xe0001028, 0x00000412);
                        Write32(0xe0001020, 0x00000000);
                        Write32(0xe0001030, 0x00400000);
                        Write32(0xe0001038, 0x00000413);
                        Write32(DHCSR_Addr, 0xa05f0001); // run target
                        DAP_Delay(42000);
                    </block>
                  <control while="Read32(DHCSR_Addr) &amp; 0x01000000" timeout="500000"/>
                  <block>
                        Write32(DEMCR_Addr, 0x00000000);
                    </block>
               </control>
            </sequence>
            <sequence name="DebugPortSetup">
               <block>
                    __var isSWJ = ((__protocol &amp; 0x00010000) != 0);
                    __var protType = __protocol &amp; 0x0000FFFF;
                </block>
               <!-- JTAG Protocol -->
               <control if="protType == 1">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);

                            // Execute SWJ-DP Switch Sequence SWD to JTAG (0xE73C)
                            // Change if SWJ-DP uses deprecated switch code (0xAEAE)
                            DAP_SWJ_Sequence(16, 0xE73C);

                            // Ensure JTAG interface is reset
                            DAP_SWJ_Sequence(6, 0x3F);
                        </block>
                  </control>
                  <block>
                        // JTAG "Soft" Reset
                        DAP_JTAG_Sequence(6, 1, 0x3F);
                        DAP_JTAG_Sequence(1, 0, 0x01);
                    </block>
               </control>
               <!-- SWD Protocol -->
               <control if="protType == 2">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);

                            // Execute SWJ-DP Switch Sequence JTAG to SWD (0xE79E)
                            // Change if SWJ-DP uses deprecated switch code (0xEDB6)
                            DAP_SWJ_Sequence(16, 0xE79E);

                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3, 0x00); // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <control if="!isSWJ">
                     <block>
                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3, 0x00); // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <block>
                        // Read DPIDR to enable SWD interface (SW-DPv1 and SW-DPv2)
                        ReadDP(0x0);
                    </block>
               </control>
            </sequence>
            <sequence name="DebugPortStart">
               <block>
                    Sequence("DebugPortConnect");
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="DebugPortConnect">
               <block>
                    __var SW_DP_ABORT = 0x0;
                    __var DP_CTRL_STAT = 0x4;
                    __var DP_SELECT = 0x8;
                    __var powered_down = 0;

                    // Switch to DP Register Bank
                    WriteDP(DP_SELECT, 0x00000000);

                    // Read DP CTRL/STAT Register and check if CSYSPWRUPACK and CDBGPWRUPACK bits are set
                    powered_down = ((ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000);
                </block>
               <control if="powered_down">
                  <block>
                        // Request Debug/System Power-Up
                        WriteDP(DP_CTRL_STAT, 0x50000000);
                    </block>
                  <!-- Wait for Power-Up Request to be acknowledged -->
                  <control while="(ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000"
                           timeout="1000000"/>
                  <!-- JTAG Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 1">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            // Additionally clear STICKYORUN, STICKYCMP, and STICKYERR bits by writing '1'
                            WriteDP(DP_CTRL_STAT, 0x50000F32);
                        </block>
                  </control>
                  <!-- SWD Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 2">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            WriteDP(DP_CTRL_STAT, 0x50000F00);

                            // Clear WDATAERR, STICKYORUN, STICKYCMP, and STICKYERR bits of CTRL/STAT Register by write to ABORT register
                            WriteDP(SW_DP_ABORT, 0x0000001E);
                        </block>
                  </control>
                  <block>
                        // clear AP register cache
                        ReadAP(0);
                        // clear DSU addr
                        Read32(DSU_BASE_ADDR);
                    </block>
               </control>
            </sequence>
            <sequence name="ResetExtension">
               <block>
                    __var nReset = 0x80;
                    __var SWCLK_TCK = 0x01;
                    DAP_SWJ_Pins(0, nReset, 1000);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(nReset, nReset, 1000);

                    Sequence("DebugPortSetup");
                    Sequence("DebugPortConnect"); // ensure connect after reset extension
                </block>
               <control if="(__connection &amp; 0xF) == 0">
                  <block>
                        Message(0, "Failed to connect debugger after reset extension");
                    </block>
               </control>
            </sequence>
            <sequence name="ExitResetExtension">
               <block>
                    __var statusa = Read8(DSU_STATUSA_ADDR);
                </block>
               <control if="(statusa &amp; CRSTEXTBIT) == 0">
                  <block>
                        Message (0, "Device - could not enter reset extension");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write8(DSU_STATUSA_ADDR, CRSTEXTBIT);
                    DAP_Delay(5000);
                </block>
               <control if="(Read8(DSU_STATUSB_ADDR) &amp; 0x80) != 0">
                  <block>
                        __var reply = Read32(DSU_BCC1_ADDR);
                    </block>
                  <control if="reply != 0">
                     <block>
                            Message(0, "User page validation failed with error code 0x%08X", reply);
                            __Result = -1;
                        </block>
                  </control>
               </control>
               <block>
                    Write32(DSU_BCC0_ADDR, DEBUGGER_CMD_EXIT);
                </block>
               <control if="(Read8(DSU_STATUSB_ADDR) &amp; 0x80) != 0">
                  <block>
                        __var reply = Read32(DSU_BCC1_ADDR);
                    </block>
                  <control if="reply == 0xEC000022">
                     <block>
                            Message(0, "Chip is locked");
                            __Result = -1;
                        </block>
                  </control>
                  <control if="reply != 0xEC000039">
                     <block>
                            Message(0, "Boot validation failed with error code 0x%08X", reply);
                            __Result = -1;
                        </block>
                  </control>
               </control>
               <block>
                    Write32(DHCSR_Addr, 0xA05F0003); // Halt target
                    __var dal = 3 &amp; Read8(DSU_STATUSB_ADDR);
                    Message(0, "DAL value: %X", dal);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="ResetToPark">
               <block>
                    Sequence("ResetExtension");
                    Sequence("ExitResetExtension");
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="ReleaseBREXT">
               <block>
                    Write8(DSU_STATUSA_ADDR, BREXTBIT);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashInit"/>
            <sequence name="FlashUninit"/>
            <sequence name="FlashEraseSector">
               <control if="!(0x804000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x804100) &amp;&amp; !(0x80C000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x80C100)">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);

                        Write32(NVMCTRL_ADDR_Addr, __FlashAddr);
                        Write32(NVMCTRL_CTRLA_Addr, 0xA502);
                    </block>
                  <control while="(Read16(NVMCTRL_STATUS_Addr) &amp; 0x4) == 0"
                           timeout="1000000"/>
               </control>
            </sequence>
            <sequence name="FlashEraseChip">
               <block>
                    Sequence("ResetExtension");
                    __var statusa = Read8(DSU_STATUSA_ADDR);
                </block>
               <control if="(statusa &amp; CRSTEXTBIT) == 0">
                  <block>
                        Message (0, "Device - could not enter reset extension");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write8(DSU_STATUSA_ADDR, CRSTEXTBIT);
                    DAP_Delay(5000);
                    Write32(DSU_BCC0_ADDR, DEBUGGER_CMD_IMODE);
                    __var reply = Read32(DSU_BCC1_ADDR);
                </block>
               <control if="reply != 0xec000020">
                  <block>
                        Message(0, "Chip erase failed to enter command loop.");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write32(DSU_BCC0_ADDR, 0x444247E4);
                </block>
               <control while="Read32(DSU_BCC1_ADDR) != 0xec000024" timeout="10000000"/>
               <control if="Read32(DSU_BCC1_ADDR) != 0xec000024">
                  <block>
                        Message(0, "chip erase failed because bootrom did not accept chip erase command");
                        __Result = -1;
                    </block>
               </control>
               <control while="Read32(DSU_BCC1_ADDR) == 0xec000024" timeout="10000000"/>
               <control while="Read32(DSU_BCC1_ADDR) != 0xec000021" timeout="10000000"/>
               <control if="Read32(DSU_BCC1_ADDR) != 0xec000021">
                  <block>
                        Message(0, "chip erase failed : error code 0x%08X", reply);
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Sequence("ResetToPark");
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashEraseDone"/>
            <sequence name="FlashProgramPage">
               <block>
                    __var write_size = __FlashLen;
                    __var offset = 0;
                    __var page_size = 64;
                    __var addr = __FlashAddr;
                    Message(0, "Program Page: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                    write_size = (__FlashLen + 3) &amp; ~3;
                </block>
               <control if="(0x804000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x804100) || (0x80C000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x80C100)">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);

                        Write32(NVMCTRL_ADDR_Addr, __FlashAddr);
                        Write32(NVMCTRL_CTRLA_Addr, 0xA502);
                    </block>
                  <control while="(Read16(NVMCTRL_STATUS_Addr) &amp; 0x4) == 0"
                           timeout="1000000"/>
               </control>
               <control while="offset &lt; write_size">
                  <block>
                        FlashWriteBuffer(addr, offset, page_size, (32 | 1));
                        Write32(NVMCTRL_CTRLA_Addr, 0xA504);
                        addr = addr + page_size;
                        offset = offset + page_size;
                    </block>
                  <control while="(Read16(NVMCTRL_STATUS_Addr) &amp; 0x4) == 0"
                           timeout="1000000"/>
               </control>
            </sequence>
            <sequence name="FlashProgramDone"/>
         </sequences>
         <environment name="microchip">
            <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                            schemaVersion="1.0"
                            xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
               <mchp:prerequisite component="MPLAB X IDE" version="[5.10-"/>
               <mchp:prerequisite component="MPLAB X IPE" version="[5.10-"/>
            </mchp:extension>
         </environment>
         <book name="https://onlinedocs.microchip.com/g/GUID-51879300-6673-4E10-9215-46AA47325161"
               title="PIC32CM LE00/LS00/LS60 Family Data Sheet"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ProductDocuments/DataSheets/PIC32CM-LE00-LS00-LS60-Family-Data-Sheet-DS60001615.pdf"
               title="PIC32CM LE00/LS00/LS60 Family Data Sheet"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ApplicationNotes/ApplicationNotes/00004068C.pdf"
               title="AN4068 - PIC32CM LE00/LS00/LS60 Low-Power Features"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ApplicationNotes/ApplicationNotes/AN5807-SERCOM-USART-on-Microchip-Cortex-Devices-SAM-and-PIC32C-DS00005807.pdf"
               title="SERCOM USART on Microchip Cortex Devices (SAM and PIC32C)"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ProductDocuments/UserGuides/Atmel_START_to_MPLAB_Harmony3_Migration_Guide_DS70005413A.pdf"
               title="Atmel START to MPLAB Harmony v3 Migration Guide"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ProductDocuments/UserGuides/MPLABHarmonyOverview_v111.pdf"
               title="MPLAB Harmony Overview"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/MCU32/ProductDocuments/SupportingCollateral/MPLAB_Harmony_v3_Synchronous_Drivers_and_Their_Usage_in_FreeRTOS-Based_Applications_DS90003290A.pdf"
               title="MPLAB Harmony v3 Synchronous Drivers and Their Usage in FreeRTOS-Based Applications"/>
         <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ProductDocuments/UserGuides/XC32_PICC_UG_DS50002895A.pdf"
               title="MPLAB XC32 C/C++ Compiler User's Guide for PIC32C/SAM MCUs"/>
         <book name="https://developer.arm.com/documentation/dui1095"
               title="Arm Cortex-M23 Devices Generic User Guide"/>
         <memory name="APBA" start="0x40000000" size="0x8000" access="rwp"/>
         <memory name="APBB" start="0x41000000" size="0x10000" access="rwp"/>
         <memory name="APBC" start="0x42000000" size="0x6000" access="rwp"/>
         <memory name="PPB" start="0xE0000000" size="0x100000" access="rwp"/>
         <debugport __dp="0">
            <swd/>
         </debugport>
         <algorithm name="keil/Flash/PIC32CM-LE_UROW.FLM"
                    start="0x00804000"
                    size="0x100"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <algorithm name="keil/Flash/PIC32CM-LE_BOCOR.FLM"
                    start="0x0080C000"
                    size="0x100"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <feature type="NVIC" n="71"/>
         <feature type="RNG" n="2"/>
         <feature type="WDT" n="1"/>
         <feature type="USBD" n="1" name="Full-Speed USB Device"/>
         <feature type="USBH" n="1" name="Full-Speed USB Host"/>
         <feature type="RTC" n="1"/>
         <feature type="Timer" n="3"/>
         <feature type="VCC" n="1.62" m="3.63"/>
         <feature type="Temp" n="-40" m="85"/>
         <device Dname="PIC32CM1216LE00032">
            <processor Dcore="Cortex-M23"
                       Dendian="Little-endian"
                       Dmpu="MPU"
                       Dfpu="NO_FPU"
                       Ddsp="NO_DSP"
                       Dtz="NO_TZ"
                       Dmve="NO_MVE"
                       Dclock="48000000"
                       DcoreVersion="r0p0"/>
            <debugconfig default="swd" clock="2000000"/>
            <compile header="include/pic32c.h" define="__PIC32CM1216LE00032__"/>
            <debug svd="svd/PIC32CM1216LE00032.svd"/>
            <memory name="FLASH"
                    start="0x00000000"
                    size="0x20000"
                    access="rx"
                    default="1"
                    startup="1"/>
            <memory name="DATAFLASH" start="0x00400000" size="0x1000" access="r"/>
            <memory name="HSRAM"
                    start="0x20000000"
                    size="0x4000"
                    default="1"
                    access="rwx"/>
            <algorithm name="keil/Flash/PIC32CM-LE_FLASH_128.FLM"
                       start="0x00000000"
                       size="0x40000"
                       RAMstart="0x20000000"
                       RAMsize="0x2000"
                       default="1"
                       style="Keil"/>
            <algorithm name="keil/Flash/PIC32CM-LE_DATA_FLASH_4.FLM"
                       start="0x00400000"
                       size="0x2000"
                       RAMstart="0x20000000"
                       RAMsize="0x2000"
                       default="1"
                       style="Keil"/>
            <flashinfo name="Internal Flash"
                       start="0x0"
                       blankval="0xFFFFFFFF"
                       pagesize="64"
                       ptime="1000000"
                       etime="1000000">
               <block count="0x200" size="256"/>
               <!--  flash -->
               <gap size="0x3E0000"/>
               <block count="0x10" size="256"/>
               <!--  data flash -->
               <gap size="0x403000"/>
               <block count="0x1" size="256"/>
               <!-- UROW -->
               <gap size="0x7F00"/>
               <block count="0x1" size="256"/>
               <!-- BOCOR -->
            </flashinfo>
            <environment name="atmel">
               <at:extension xmlns:at="http://www.atmel.com/schemas/pack-device-atmel-extension"
                             schemaVersion="1.0"
                             xsi:schemaLocation="http://www.atmel.com/schemas/pack-device-atmel-extension PACK.DEVICE.ATMEL.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/at/1.0/PACK.DEVICE.ATMEL.EXTENSION.xsd-->
                  <at:atdf name="atdf/PIC32CM1216LE00032.atdf"/>
                  <at:variant ordercode="PIC32CM1216LE00032-I/PT"
                              vccmin="1.62"
                              vccmax="3.63"
                              tempmin="-40"
                              tempmax="85"/>
                  <at:variant ordercode="PIC32CM1216LE00032-I/RTB"
                              vccmin="1.62"
                              vccmax="3.63"
                              tempmin="-40"
                              tempmax="85"/>
                  <at:memory name="FLASH"
                             start="0x00000000"
                             size="0x20000"
                             type="flash"
                             pagesize="64"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="AUX0"
                             start="0x00804000"
                             size="0x100"
                             type="fuses"
                             pagesize="64"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="AUX1"
                             start="0x00806000"
                             size="0x100"
                             type="fuses"
                             pagesize="64"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="AUX2"
                             start="0x00808000"
                             size="0x100"
                             type="fuses"
                             pagesize="64"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="AUX3"
                             start="0x0080A000"
                             size="0x100"
                             type="fuses"
                             pagesize="64"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="AUX4"
                             start="0x0080C000"
                             size="0x100"
                             type="fuses"
                             pagesize="64"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="AUX5"
                             start="0x0080E000"
                             size="0x100"
                             type="fuses"
                             pagesize="64"
                             rw="RW"
                             address-space="base"/>
