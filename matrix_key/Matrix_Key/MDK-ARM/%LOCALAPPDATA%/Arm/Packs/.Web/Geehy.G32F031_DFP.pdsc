<?xml version="1.0"?>
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>Geehy</vendor>
    <url>https://global.geehy.com/uploads/tool/</url>
    <supportContact>https://global.geehy.com/design/software</supportContact>
    <name>G32F031_DFP</name>
    <description>Geehy Semiconductor G32F031 Series Device Support</description>
    <releases>
        <release version="1.0.2" date="2026-10-09">Update url.</release>
        <release version="1.0.1" date="2026-06-02"> Update SVD. </release>
        <release version="1.0.0" date="2026-03-30"> First Release version of G32F031 Device Family Pack. </release>
    </releases>
    <keywords>
        <!-- keywords for indexing -->
        <keyword>Geehy</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package Geehy Semiconductor</keyword>
        <keyword>G32F031</keyword>
        <keyword>APM32</keyword>
    </keywords>
    <devices>
        <family Dfamily="G32F0 Series" Dvendor="Geehy:163">
            <processor Dcore="Cortex-M0+" DcoreVersion="r0p1" Dfpu="0" Dmpu="0" Dendian="Little-endian"/>
            <description>Geehy Semiconductor G32F031 Series Device Support, Drivers, Libraries and Examples</description>
            <!-- ******************************  G32F031  ****************************** -->
            <subFamily DsubFamily="G32F031">
                <feature type="VCC" n="1.80" m="5.50"/>
                <feature type="Temp" n="-40" m="105"/>
                <feature type="WDT" n="2"/>
                <feature type="UART" n="2"/>
                <feature type="SPI" n="1"/>
                <feature type="I2C" n="1"/>
                <!-- ******************************  G32F031K8  ****************************** -->
                <device Dname="G32F031K8">
                    <processor Dclock="64000000"/>
                    <compile header="Device/Device/Geehy/G32F031/Include/g32f0xx.h" define="G32F031"/>
                    <debug svd="SVD/G32F031.svd"/>
                    <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x2000" init="0" default="1"/>
                    <algorithm name="Flash/G32F031_64_MFlash.FLM" start="0x00000000" size="0x10000" default="1"/>
                    <feature type="Timer" count="3" name="16-Bit Timer with Input Capture, Output Compare and PWM"/>
                    <feature type="Timer" count="1" name="32-Bit Timer with Input Capture, Output Compare and PWM"/>
                    <feature type="Timer" count="2" name="Watchdog"/>
                    <feature type="A/D" count="1" name="12-bit Analog to Digital Converter"/>
                    <feature type="I/O" count="29" name="Input and Output Ports"/>
                    <feature type="Com" count="1" name="SPI Interface"/>
                    <feature type="Com" count="1" name="I2C Interface"/>
                    <feature type="Com" count="2" name="UART Interface"/>
                </device>
                <!-- ******************************  G32F031G8  ****************************** -->
                <device Dname="G32F031G8">
                    <processor Dclock="64000000"/>
                    <compile header="Device/Device/Geehy/G32F031/Include/g32f0xx.h" define="G32F031"/>
                    <debug svd="SVD/G32F031.svd"/>
                    <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x2000" init="0" default="1"/>
                    <algorithm name="Flash/G32F031_64_MFlash.FLM" start="0x00000000" size="0x10000" default="1"/>
                    <feature type="Timer" count="3" name="16-Bit Timer with Input Capture, Output Compare and PWM"/>
                    <feature type="Timer" count="1" name="32-Bit Timer with Input Capture, Output Compare and PWM"/>
                    <feature type="Timer" count="2" name="Watchdog"/>
                    <feature type="A/D" count="1" name="12-bit Analog to Digital Converter"/>
                    <feature type="I/O" count="29" name="Input and Output Ports"/>
                    <feature type="Com" count="1" name="SPI Interface"/>
                    <feature type="Com" count="1" name="I2C Interface"/>
                    <feature type="Com" count="2" name="UART Interface"/>
                </device>
                <!-- ******************************  G32F031E8  ****************************** -->
                <device Dname="G32F031E8">
                    <processor Dclock="64000000"/>
                    <compile header="Device/Device/Geehy/G32F031/Include/g32f0xx.h" define="G32F031"/>
                    <debug svd="SVD/G32F031.svd"/>
                    <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x2000" init="0" default="1"/>
                    <algorithm name="Flash/G32F031_64_MFlash.FLM" start="0x00000000" size="0x10000" default="1"/>
                    <feature type="Timer" count="3" name="16-Bit Timer with Input Capture, Output Compare and PWM"/>
                    <feature type="Timer" count="1" name="32-Bit Timer with Input Capture, Output Compare and PWM"/>
                    <feature type="Timer" count="2" name="Watchdog"/>
                    <feature type="A/D" count="1" name="12-bit Analog to Digital Converter"/>
                    <feature type="I/O" count="29" name="Input and Output Ports"/>
                    <feature type="Com" count="1" name="SPI Interface"/>
                    <feature type="Com" count="1" name="I2C Interface"/>
                    <feature type="Com" count="2" name="UART Interface"/>
                </device>
            </subFamily>
        </family>
    </devices>
    <conditions>
        <!-- conditions are dependecy rules that can apply to a component or an individual file -->
        <condition id="Compiler ARMCC">
            <require Tcompiler="ARMCC"/>
        </condition>
        <condition id="G32F031">
            <description>Geehy Semiconductor G32F031 Series devices</description>
            <require Dvendor="Geehy:163" Dname="G32F031*"/>
        </condition>
        <condition id="G32F031 ARMCC">
            <description>filter for G32F031 Device and the ARM compiler</description>
            <require condition="G32F031"/>
            <require Tcompiler="ARMCC"/>
        </condition>
        <condition id="G32F031 CMSIS">
            <description>Geehy Semiconductor G32F031 Device with CMSIS</description>
            <require condition="G32F031"/>
            <require Cclass="CMSIS" Cgroup="CORE"/>
            <require Dvendor="Geehy:163" Dname="G32F031*"/>
        </condition>
        <condition id="G32F031 STDPERIPH">
            <description>Geehy Semiconductor G32F031 with Standard Peripherals Drivers Framework</description>
            <require condition="G32F031 CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
        </condition>
        <condition id="G32F031 STDPERIPH RCC">
            <description>Geehy Semiconductor G32F031 with Standard Peripherals Drivers Framework and RCC</description>
            <require condition="G32F031 CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="RCC"/>
        </condition>
    </conditions>
    <components>
        <component Cclass="Device" Cgroup="G32F031 Startup" Cversion="1.0.0" condition="G32F031 CMSIS">
            <!-- Cversion is necessary -->
            <description>System Startup for Geehy Semiconductor G32F031 Series</description>
            <files>
                <!-- include folder -->
                <file category="include" name="Device/CMSIS/Include/"/>
                <file category="include" name="Device/Device/Geehy/G32F031/Include/"/>
                <!-- startup files -->
                <file category="source" name="Device/Device/Geehy/G32F031/Source/arm/startup_g32f031.s" attr="config" version="1.0.0" condition="G32F031 ARMCC"/>
                <!-- system file -->
                <file category="source" name="Device/Device/Geehy/G32F031/Source/system_g32f031.c" attr="config" version="1.0.0"/>
            </files>
        </component>
        <!-- START: Geehy Semiconductor Standard Peripherals Drivers -->
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework" Cversion="1.0.0" condition="G32F031 STDPERIPH">
            <description>Standard Peripherals Drivers Framework</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_FRAMEWORK</RTE_Components_h>
            <files>
                <file category="include" name="Device/G32F031_DAL_Driver/Include/"/>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_cortex.h"/>
                <file category="header" name="Device/Templates/inc/g32f031_int.h" attr="template" select="Interrupt Service Routines"/>
                <file category="source" name="Device/Templates/src/g32f031_int.c" attr="template" select="Interrupt Service Routines"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="ADC" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Analog-to-digital converter (ADC) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_ADC </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_adc.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_adc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="ATMR" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Advanced timer (ATMR) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_ATMR </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_atmr.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_atmr.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="BTMR" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Basic timer (BTMR) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_BTMR </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_btmr.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_btmr.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="COMP0" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Comparator 0 (COMP0) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_COMP0 </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_comp0.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_comp0.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="COMP1" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Comparator 1 (COMP1) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_COMP1 </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_comp1.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_comp1.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="CRC" Cversion="1.0.0" condition="G32F031 STDPERIPH ">
            <description>CRC calculation unit (CRC) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_CRC </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_crc.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_crc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="DIV" Cversion="1.0.0" condition="G32F031 STDPERIPH">
            <description>Division (DIV) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_DIV</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_div.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_div.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="DMA" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>DMA controller (DMA) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_DMA </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_dma.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_dma.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="EINT" Cversion="1.0.0" condition="G32F031 STDPERIPH">
            <description>External interrupt/event controller (EINT) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_EINT </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_eint.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_eint.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="FLASH" Cversion="1.0.0" condition="G32F031 STDPERIPH">
            <description>Flash memory controller driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_FLASH </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_flash.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_flash.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="GPIO" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>General-purpose I/O (GPIO) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_GPIO </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_gpio.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_gpio.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="GTMR" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>General-purpose timer (GTMR) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_GTMR </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_gtmr.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_gtmr.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="I2C" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Inter-integrated circuit (I2C) interface driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_I2C </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_i2c.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_i2c.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="IWDT" Cversion="1.0.0" condition="G32F031 STDPERIPH ">
            <description>Independent watchdog (IWDT) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_IWDT</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_iwdt.h"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="LPTMR" Cversion="1.0.0" condition="G32F031 STDPERIPH ">
            <description>Low power timer (LPTMR) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_LPTMR</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_lptmr.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_lptmr.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="OPA" Cversion="1.0.0" condition="G32F031 STDPERIPH ">
            <description>Operational amplifier (OPA) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_OPA</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_opa.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_opa.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="PMU" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Power controller (PMU) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_PMU</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_pmu.h"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="RCC" Cversion="1.0.0" condition="G32F031 STDPERIPH">
            <description>Reset and clock controller (RCC) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_RCC</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_rcc.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_rcc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="SCU" Cversion="1.0.0" condition="G32F031 STDPERIPH">
            <description>System controller unit (SCU) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_SCU</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_scu.h"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="SPI" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Serial peripheral interface (SPI) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_SPI </RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_spi.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_spi.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="USART" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Universal synchronous asynchronous receiver transmitter (USART) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_USART</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_usart.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_usart.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="UTILS" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Universal Tools interface libraries (UTILS) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_UTILS</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_utils.h"/>
                <file category="source" name="Device/G32F031_DAL_Driver/Source/g32f031_ddl_utils.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="StdPeriph Drivers" Csub="WWDT" Cversion="1.0.0" condition="G32F031 STDPERIPH RCC">
            <description>Window watchdog (WWDT) driver for G32F031</description>
            <RTE_Components_h>#define RTE_DEVICE_STDPERIPH_WWDT</RTE_Components_h>
            <files>
                <file category="header" name="Device/G32F031_DAL_Driver/Include/g32f031_ddl_wwdt.h"/>
            </files>
        </component>
        <!-- END: Geehy Semiconductor Standard Peripherals Drivers -->
    </components>
</package>
