<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package schemaVersion="1.7.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="PACK.xsd">
  <name>FreeRTOS-Plus-TCP</name>

  <description>Thread-safe TCP/IP stack for FreeRTOS, built on the FreeRTOS Kernel with LTS support. Suitable for microcontrollers.</description>

  <vendor>AWS</vendor>

  <license>LICENSE</license>

  <url>https://freertos-cmsis-packs.s3.us-west-2.amazonaws.com/</url>

  <requirements>
    <packages>
      <package name="CMSIS-FreeRTOS" vendor="ARM"/>
    </packages>
  </requirements>

  <releases>
    <release date="2026-05-05" version="6.1.0">Based on the https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/tree/V4.4.1 repository.</release>
    <release date="2025-05-20" version="6.0.0">Based on the https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/tree/V4.2.2 repository.</release>
    <release date="2023-02-23" version="5.0.0">Based on the https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/tree/V3.1.0 repository.</release>
    <release date="2022-07-13" version="4.0.1">Fixes template files not being marked as such. Based on the https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/tree/V2.3.2-LTS-Patch-2 repository.</release>
    <release date="2022-06-16" version="4.0.0">Based on the https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/tree/V2.3.2-LTS-Patch-2 repository.</release>
    <release date="2020-12-15" version="2.3.2-Beta">Based on the https://github.com/FreeRTOS/FreeRTOS-Plus-TCP/tree/V2.3.2 repository.</release>
  </releases>

