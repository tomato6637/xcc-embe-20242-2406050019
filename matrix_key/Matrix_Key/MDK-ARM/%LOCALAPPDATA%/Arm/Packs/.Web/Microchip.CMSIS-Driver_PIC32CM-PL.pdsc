<?xml version="1.0" encoding="utf-8"?>
  <package schemaVersion="1.7.37" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
  xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.37/schema/PACK.xsd">
  <vendor>Microchip</vendor>
  <name>CMSIS-Driver_PIC32CM-PL</name>
  <description overview="OVERVIEW.md">
    Microchip PIC32CM-PL Series CMSIS Driver Support
  </description>
  <supportContact>https://www.microchip.com/en-us/support</supportContact>
  <url>https://packs.download.microchip.com/</url>
  <license>LICENSE.txt</license>
  <licenseSets>
    <licenseSet id="all" default="true" gating="true">
      <license name="LICENSE.txt" title="Apache 2.0 License"/>
    </licenseSet>
  </licenseSets>
  <releases>
    <release version="1.3.4" date="2026-06-19" tag="1.3.4">
      Fixed I2C Instance Issue
    </release>
    <release version="1.3.2" date="2026-06-01" tag="1.3.2">
      Updated OVERVIEW.md file
    </release>
    <release version="1.3.1" date="2026-05-27" tag="1.3.1">
      Added support for newly introduced subset devices of PIC32CM3204PL10xxx and PIC32CM1216PL10xxx.
      Microchip.CMSIS-Driver_PIC32CM-PL pack  has been converted into a software pack by moving all board-specific applications to the Microchip.PIC32CM-PL_Examples pack.
    </release>
    <release version="1.2.0" date="2026-04-30" tag="1.2.0" deprecated="2026-05-27">
      Added User Configurable parameters for CMSIS Driver (USART, SPI, I2C) Header files
    </release>
    <release version="1.1.1" date="2026-04-02" tag="1.1.1" deprecated="2026-05-27">
      Updated Blank MCHP Driver Solution Template Project
    </release>
    <release version="1.1.0" date="2026-04-01" tag="1.1.0" deprecated="2026-05-27">
      Added comprehensive API documentation for peripherals
      Added code snippet to show how the API's work together to configure and control the peripheral
      Example projects:
      - CNANO MCHP FreeRTOS Example
      - CNANO MCHP RTX RTOS Example
    </release>
    <release version="1.0.1" date="2026-01-21" tag="1.0.1" deprecated="2026-05-27">
      Updated Pack Metadata
    </release>
    <release version="1.0.0" date="2026-01-20" tag="1.0.0" deprecated="2026-05-27">
      Driver and Plib Support for devices: PIC32CM6408PL10028, PIC32CM6408PL10032, PIC32CM6408PL10048, PIC32CM6408PL10064
      Example projects:
      - CNANO MCHP Blinky Example
      - CNANO MCHP Driver Example
      Template Project:
      - Blank MCHP Driver Solution
    </release>
  </releases>
  <keywords>
    <keyword>Microchip</keyword>
    <keyword>Software Pack</keyword>
    <keyword>PIC32CM-PL</keyword>
  </keywords>
  <taxonomy>
    <description Cclass="CMSIS Driver" doc="CMSIS/Documentation/Driver/html/index.html">
      Unified Device Drivers compliant to CMSIS-Driver Specifications.
    </description>
    <description Cclass="MCHP-PLIB" doc="ReleaseNotes_PLIB.html">
      Microchip Peripherals Library (PLIB) Software Component
    </description>
  </taxonomy>
  <conditions>
    <condition id="Tested with Compiler">
      <accept Tcompiler="ARMCC" Toptions="AC6"/>
      <accept Tcompiler="GCC"/>
      <accept Tcompiler="IAR"/>
      <accept Tcompiler="CLANG"/>
      <accept Tcompiler="XC"/>
    </condition>
    <condition id="Driver_USART0_Req">
      <description>Requires MCHP-PLIB SERCOM_USART (SERCOM0)</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="SERCOM" Csub="SERCOM_USART0"/>
      <require Cclass="MCHP-PLIB" Cgroup="OSCCTRL"/>
    </condition>
    <condition id="Driver_USART1_Req">
      <description>Requires MCHP-PLIB SERCOM_USART (SERCOM1)</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="SERCOM" Csub="SERCOM_USART1"/>
      <require Cclass="MCHP-PLIB" Cgroup="OSCCTRL"/>
    </condition>
    <condition id="Driver_SPI0_Req">
      <description>Requires MCHP-PLIB SERCOM (SERCOM_SPI0)</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="SERCOM" Csub="SERCOM_SPI0"/>
      <require Cclass="MCHP-PLIB" Cgroup="PORT"/>
      <require Cclass="MCHP-PLIB" Cgroup="OSCCTRL"/>
    </condition>
    <condition id="CLOCK_Req">
      <description>Requirements of Clock files</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="System Interrupt"/>
      <require Cclass="MCHP-PLIB" Cgroup="GCLK"/>
      <require Cclass="MCHP-PLIB" Cgroup="MCLK"/>
    </condition>
    <condition id="Driver_SPI1_Req">
      <description>Requires MCHP-PLIB SERCOM (SERCOM_SPI1)</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="SERCOM" Csub="SERCOM_SPI1"/>
      <require Cclass="MCHP-PLIB" Cgroup="PORT"/>
      <require Cclass="MCHP-PLIB" Cgroup="OSCCTRL"/>
    </condition>
    <condition id="Driver_I2C0_Req">
      <description>Requires MCHP-PLIB SERCOM (SERCOM_I2C0)</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="SERCOM" Csub="SERCOM_I2C0"/>
      <require Cclass="MCHP-PLIB" Cgroup="OSCCTRL"/>
    </condition>
    <condition id="System_Interrupt_Req">
      <description>Requires MCHP-PLIB System Interrupt</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="System Interrupt"/>
    </condition>
    <condition id="Driver_GPIO_Req">
      <description>Requires MCHP-PLIB GPIO</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="PORT"/>
    </condition>
    <condition id="Driver_Flash_Req">
      <description>Requires MCHP-PLIB NVMCTRL</description>
      <require condition="PIC32CM-PL"/>
      <require Cclass="MCHP-PLIB" Cgroup="NVMCTRL"/>
    </condition>
    <condition id="PIC32CM-PL">
      <description>Microchip PIC32CM-PL Devices</description>
      <require Dvendor="Microchip:3" Dfamily="PIC32CM-PL"/>
      <require condition="Tested with Compiler"/>
      <accept Dname="PIC32CM1216PL10028"/>
      <accept Dname="PIC32CM1216PL10032"/>
      <accept Dname="PIC32CM1216PL10048"/>
      <accept Dname="PIC32CM1216PL10064"/>
      <accept Dname="PIC32CM6408PL10028"/>
      <accept Dname="PIC32CM6408PL10032"/>
      <accept Dname="PIC32CM6408PL10048"/>
      <accept Dname="PIC32CM6408PL10064"/>
      <accept Dname="PIC32CM3204PL10020"/>
      <accept Dname="PIC32CM3204PL10028"/>
      <accept Dname="PIC32CM3204PL10032"/>
    </condition>
    <condition id="TC0_NOT_32BIT">
      <description>Accepts MCHP-PLIB TC0 variants except 32-bit</description>
      <require condition="PIC32CM-PL"/>
      <accept Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="TC" Csub="TC0" Cvariant="Timer-8bit"/>
      <accept Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="TC" Csub="TC0" Cvariant="Timer-16bit"/>
      <accept Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="TC" Csub="TC0" Cvariant="Capture-8bit"/>
      <accept Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="TC" Csub="TC0" Cvariant="Capture-16bit"/>
      <accept Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="TC" Csub="TC0" Cvariant="Compare-8bit"/>
      <accept Cvendor="Microchip" Cclass="MCHP-PLIB" Cgroup="TC" Csub="TC0" Cvariant="Compare-16bit"/>
    </condition>
  </conditions>
  <requirements>
    <packages>
      <package vendor="Microchip" name="PIC32CM-PL_DFP" version="1.3.414:1.999.999-0"/>
      <package vendor="ARM" name="CMSIS" version="6.2.0-0"/>
    </packages>
  </requirements>
  <csolution>
    <template name="Blank MCHP Driver Solution" path="Templates/Blank_MCHP_Driver_Solution" file="Blank_MCHP_Driver_Solution.csolution.yml" condition="PIC32CM-PL">
      <description>MCHP Blank Solution</description>
    </template>
  </csolution>

