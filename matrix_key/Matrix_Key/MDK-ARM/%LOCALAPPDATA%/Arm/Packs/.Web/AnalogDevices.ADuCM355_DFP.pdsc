        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="PWR" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>Power Management low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/PwrLib.h" version="2.0.0"/>
