    <example name="M356_4WireZ" doc="ARM/Readme_M356_4WireZ.txt" folder="ADuCM355/examples/ADuCM356Examples/M356_4WireZ">
      <description>Example demonstrating how to configure the ADC for Polling and FIFO mode</description>
      <board name="EVAL-ADuCM355QSPZ" vendor="AnalogDevices"/>
      <project>
        <environment name="uv" load="ARM/M356_4WireZ.uvprojx"/>
        <environment name="iar" load="IAR/M356_4WireZ/M356_4WireZ.ewp"/>
      </project>
      <attributes>
        <component Cclass="CMSIS" Cgroup="CORE"/>
        <component Cclass="Device" Cgroup="Startup"/>
        <component Cclass="Device" Cgroup="Peripheral Libraries"/>
        <category>Not provided</category>
        <keyword>ADuCM356Examples/M356_4WireZ</keyword>
      </attributes>
    </example>
    <example name="M356_BIOZ_2Wire" doc="ARM/Readme_M356_BIOZ_2Wire.txt" folder="ADuCM355/examples/ADuCM356Examples/M356_BIOZ-2Wire">
