            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="RST" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library RST">
            <description>Reset low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/RstLib.h" version="2.0.0"/>
