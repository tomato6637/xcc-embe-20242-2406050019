<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package schemaVersion="1.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
         xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>AnalogDevices</vendor>
    <name>ADuCM355_DFP</name>
    <url>http://download.analog.com/tools/EZBoards/ADuCM355/Releases/</url>
    <description>Analog Devices ADuCM355 Device Support and Examples</description>
    <supportContact>https://www.analog.com/en/support.html</supportContact>
    <license>License\aducm355_dfp-click-thru-SLA.txt</license>

    <releases>
		<release version="2.1.0" date="2026-08-28">
			- IAR ADuCM356 example import bug fixed.
		</release>
		<release version="2.0.0" date="2026-07-30">
			- Pack was built and tested with Keil MDK 6.
			- Pack was built and tested with IAR version 9.70.1.
			- Updated ARM CMSIS Pack to version 6.3.0.
			- Updates for armclangv6 Keil support.
			- Created Blinky LED example for IAR Embedded Workbench and Keil MDK6
			- Built Keil Flash FLM using MDK 6 and ARM CMSIS 6.3.0
			- Built the IAR FlashLoader using IAR v9.70.1 and updated the .out file in the DFP.
			- Added IAR ADuCM355 examples of AnalogDie, Application Examples, DigitalDie to the pack.
			- Added README documentation for all IAR and Keil examples.
			- Updated the Keil examples with Release Configurations and renamed ADuCM355 target setting as Debug.
			- Updated the Keil MDK6 modification for startup files and resolved c90 warnings.
			- Fixed incorrect memset size calculation for Desc initialization in DMA library
			- Fixed operator precedence in RTC status register polling loop
			- Fixed UART baud-rate comment to match configured baud rate.
			- Resolved SVD warnings in ADuCM355.svd and ADuCM356.svd 
        </release>
        <release version="1.0.4" date="2023-09-21">
            ADuCM356 is added.
        </release>
        <release version="1.0.3" date="2020-01-21">
            Examples added.
        </release>
		    <release version="1.0.2" date="2020-01-17">
            Updated license. Updated examples.
        </release>
	      <release version="1.0.1" date="2019-12-05">
            Corrected errors in examples.
        </release>
        <release version="1.0.0" date="2019-11-29">
            Initial Pack (Keil Support).
        </release>
    </releases>

    <requirements>
        <packages>
            <package name="CMSIS" vendor="ARM" version="6.3.0"/>
        </packages>
    </requirements>

    <boards>
        <board vendor="AnalogDevices" name="EVAL-ADuCM355QSPZ" revision="Rev-B"
               orderForm="https://www.analog.com/en/design-center/evaluation-hardware-and-software/evaluation-boards-kits/EVAL-ADuCM355.html#eb-buy">
            <description>Analog Devices ADuCM355 Evaluation Board</description>
            <mountedDevice deviceIndex="0" Dvendor="Analog Devices:1" Dname="ADuCM355"/>
            <compatibleDevice deviceIndex="0" Dvendor="Analog Devices:1" Dfamily="ADuCM355 Series"/>
            <debugInterface adapter="JTAG/SW" connector="20 pin JTAG (0.1 inch connector)"/>
            <debugInterface adapter="USB-SWD/UART-EMUZ" connector="8 pin (proprietary ADI)"/>
        </board>
    </boards>

    <keywords>
        <keyword>Analog Devices</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package Analog Devices</keyword>
        <keyword>ADuCM355</keyword>
        <keyword>ADuCM356</keyword>
    </keywords>


    <devices>

        <family Dfamily="ADuCM355 Series" Dvendor="Analog Devices:1">
            <description>
                The ADuCM355 system on a chip provides the features needed to bias and measure a range of different electrochemical sensors.
            </description>
            <environment name="uv">
                <CMisc>--C99</CMisc>
                <AMisc>--cpreproc --cpreproc_opts=-U__STDC__,-D__ASSEMBLER__</AMisc>
            </environment>
            <!-- ******************************  ADuCM355  ****************************** -->
            <device Dname="ADuCM355">
                <processor Dcore="Cortex-M3" DcoreVersion="r2p1" Dfpu="NO_FPU" Dmpu="NO_MPU" Dtz="NO_TZ"
                           Dendian="Little-endian" Dclock="26000000"/>
                <environment name="iar">
                  <file category="i79file" name="ARM/config/devices/AnalogDevices/ADuCM3xx/ADuCM355.i79" />
                </environment>
                <debug svd="SVD/ADuCM355.svd"/>

                <memory name="IROM1" access="rw" start="0x00000000" size="0x20000" startup="1" default="1"/>
                <!-- Using USER_SRAM_MODE = 2 as default Configuration   -->
                <memory name="dRAM_always_retained_region" access="rw" start="0x20000000" size="0x02000" default="1"/>
                <memory name="dRAM_bank1_retained_region" access="rw" start="0x20002000" size="0x02000" default="1"/>
                <memory name="dRAM_bank2_retained_region" access="rw" start="0x20004000" size="0x04000"/>
                <memory name="dRAM_never_retained_region" access="rw" start="0x20040000" size="0x08000"/>

                <memory name="digital_die_registers" access="prw" start="0x40000000" size="0x45000"/>
                <memory name="afe_die_registers" access="prw" start="0x400C0800" size="0x1C00"/>
                <memory name="uart_registers" access="prw" start="0x40005000" size="0x800"/>

                <algorithm name="Flash/ADuCM355.FLM" start="0x00000000" size="0x20000"
                           default="1"/>

                <compile header="ADuCM355/inc/ADuCM355.h"/>
            </device>
            
            <!-- ******************************  ADuCM356  ****************************** -->
            <device Dname="ADuCM356">
                <processor Dcore="Cortex-M3" DcoreVersion="r2p1" Dfpu="NO_FPU" Dmpu="NO_MPU" Dtz="NO_TZ"
                           Dendian="Little-endian" Dclock="26000000"/>
                <environment name="iar">
                  <file category="i79file" name="ARM/config/devices/AnalogDevices/ADuCM3xx/ADuCM356.i79" />
                </environment>
                <debug svd="SVD/ADuCM356.svd"/>

                <memory name="IROM1" access="rw" start="0x00000000" size="0x40000" startup="1" default="1"/>
                <!-- Using USER_SRAM_MODE = 2 as default Configuration   -->
                <memory name="dRAM_always_retained_region" access="rw" start="0x20000000" size="0x02000" default="1"/>
                <memory name="dRAM_bank1_retained_region" access="rw" start="0x20002000" size="0x02000" default="1"/>
                <memory name="dRAM_bank2_retained_region" access="rw" start="0x20004000" size="0x04000"/>
                <memory name="dRAM_never_retained_region" access="rw" start="0x20040000" size="0x08000"/>

                <memory name="digital_die_registers" access="prw" start="0x40000000" size="0x45000"/>
                <memory name="afe_die_registers" access="prw" start="0x400C0800" size="0x1C00"/>
                <memory name="uart_registers" access="prw" start="0x40005000" size="0x800"/>

                <algorithm name="Flash/ADuCM356.FLM" start="0x00000000" size="0x20000"
                           default="1"/>

                <compile header="ADuCM355/inc/ADuCM355.h"/>
            </device>


        </family>
    </devices>

    <conditions>
        <condition id="ARMCC">
            <description>ARM Toolchain</description>
            <require Tcompiler="ARMCC"/>
        </condition>

        <condition id="ADuCM355">
            <description>ADuCM355 device</description>
            <require Dvendor="Analog Devices:1"/>
            <accept Dname="ADuCM355"/>
            <accept Dname="ADuCM356"/>
        </condition>

        <condition id="IAR">
          <require Tcompiler="IAR"/>
        </condition>

        <condition id="ADuCM355_IAR">
          <description>ADuCM355 IAR</description>
          <require condition="ADuCM355"/>
          <require condition="IAR"/>
        </condition>

        <condition id="ADuCM355_ARM">
            <description>ADuCM355 ARM (Keil)</description>
            <require condition="ADuCM355"/>
            <require condition="ARMCC"/>
        </condition>

        <condition id="ADuCM355 CMSIS Device">
            <description>ADuCM355 CMSIS Device</description>
            <require Cclass="CMSIS" Cgroup="CORE"/>
            <require condition="ADuCM355"/>
        </condition>
        <condition id="ADuCM355 Library">
            <description>Low Level Peripheral Libraries for ADuCM355</description>
            <require condition="ADuCM355"/>
        </condition>

        <condition id="ADuCM355 Library IntLib">
            <description>Low Level Peripheral Libraries for ADuCM355</description>
            <require condition="ADuCM355"/>
            <require Cclass="Device" Cgroup="Peripheral Libraries" Csub="INT" Cvendor="Analog Devices"/>
        </condition>

        <condition id="ADuCM355 Library RST">
            <description>Conditions for ADuCM355 RST Library</description>
            <require condition="ADuCM355"/>
            <require Cclass="Device" Cgroup="Peripheral Libraries" Csub="GPIO" Cvendor="Analog Devices"/>
        </condition>

        <condition id="ADuCM355 Library Retarget">
            <description>Conditions for ADuCM355 Retarget Library</description>
            <require condition="ADuCM355"/>
            <require Cclass="Device" Cgroup="Peripheral Libraries" Csub="UART" Cvendor="Analog Devices"/>
        </condition>

    </conditions>

    <components>
        <component Cclass="Device" Cgroup="Startup" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 CMSIS Device">
            <!-- Cversion is necessary -->
            <description>System Startup for ADuCM355</description>
            <files>
                <!-- additional include path -->
                <file category="include" name="ADuCM355/inc/"/>
                <!-- startup files -->
                <file category="source" name="ADuCM355/common/ARM/startup_ADuCM355.S" version="2.0.0" attr="config"
                      condition="ADuCM355_ARM"/>                      
                <file category="source" name="ADuCM355/common/IAR/startup_ADuCM355.c" version="2.0.0" attr="config" 
                      condition="ADuCM355_IAR"/>
                <!-- system files -->
                <file category="source" name="ADuCM355/common/system_ADuCM355.c" version="2.0.0" attr="config"
                      condition="ADuCM355"/>

                <file category="header" name="ADuCM355/inc/adi_config.h" version="2.0.0" attr="config"
                      condition="ADuCM355"/>
                <!-- linker scripts -->
            </files>
        </component>

        <component Cclass="Device" Cgroup="Retarget UART" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library Retarget">
            <description>Retarget standard library I/O to UART</description>
            <files>
                <file category="source" name="ADuCM355/common/ARM/retarget.c" version="2.0.0"
                      condition="ADuCM355_ARM"/>
                <file category="source" name="ADuCM355/common/IAR/retarget.c" version="2.0.0"
                      condition="ADuCM355_IAR"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="FLASH" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>Flash controller low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/FeeLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/FeeLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="UART" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>UART low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/UrtLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/UrtLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="DMA" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>DMA low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/DmaLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/DmaLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="GPIO" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>GPIO low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/DioLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/DioLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="CLOCK" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>Clock low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/ClkLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/ClkLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="CRC" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>CRC low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/CrcLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/CrcLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="Timer" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>General Purpose Timer low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/GptLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/GptLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="I2C" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>I2C interface low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/I2cLib.h" version="2.0.0"/>
