            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="SPI" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library">
            <description>SPI interface low level library for ADuCM355</description>
            <files>
                <file category="header" name="ADuCM355/common/SpiLib.h" version="2.0.0"/>
                <file category="source" name="ADuCM355/common/SpiLib.c" version="2.0.0"/>
            </files>
        </component>

        <component Cclass="Device" Cgroup="Peripheral Libraries" Csub="INT" Cversion="2.0.0" Cvendor="Analog Devices"
