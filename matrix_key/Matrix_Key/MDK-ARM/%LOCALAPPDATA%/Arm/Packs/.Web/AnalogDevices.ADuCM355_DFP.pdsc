        <component Cclass="Device" Cgroup="AFE" Csub="Operation" Cversion="2.0.0" Cvendor="Analog Devices"
                   condition="ADuCM355 Library IntLib">
            <description>AFE low level library for ADuCM355</description>
            <files>
                 <!-- additional include path -->
                <file category="include" name="ADuCM355/common/ad5940lib/"/>
