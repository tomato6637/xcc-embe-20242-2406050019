        <component Cclass="Device" Cgroup="DDL Drivers" Csub="EINT" Cversion="1.0.1" condition="G32M31xx DDL">
            <description>EINT ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_EINT</RTE_Components_h>
