<?xml version="1.0"?>
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd" schemaVersion="1.7.2">
    <vendor>Geehy</vendor>
    <name>G32M3101_DFP</name>
    <description>Geehy G32M SDK G32M31xx Device Support</description>
    <url>https://global.geehy.com/design/software</url>
    <releases>
        <release version="1.0.6" date="2026-10-19">Update driver.</release>
        <release version="1.0.5" date="2026-10-08">Update driver.</release>
        <release version="1.0.4" date="2026-05-06">Update driver.</release>
        <release version="1.0.3" date="2026-03-27">Update xs information.</release>
        <release version="1.0.2" date="2026-02-03">Update url.</release>
        <release version="1.0.1" date="2025-12-10">Update driver.</release>
        <release version="1.0.0" date="2025-09-15">First Release version of G32M31xx Device Family Pack.</release>
    </releases>
    <keywords>
        <!-- keywords for indexing -->
        <keyword>Geehy</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package</keyword>
        <keyword>G32M31</keyword>
        <keyword>G32M</keyword>
    </keywords>
    <devices>
        <family Dfamily="G32M31 Series" Dvendor="Geehy:163">
            <processor Dcore="Cortex-M0+" DcoreVersion="r0p1" Dfpu="0" Dmpu="0" Dendian="Little-endian"/>
            <description>Geehy Semiconductor' G32M31xx series of mainstream MCUs are 32-bit microprocessors based on ARM Cortex'-M0 core, with a maximum operating frequency of 64MHz.</description>
            <!--******************************  Subfamily 'G32M31xx'  ****************************** -->
            <subFamily DsubFamily="G32M3101">
                <processor Dclock="64000000"/>
                <debug svd="SVD/G32M3101.svd"/>
                <!--******************************  Device 'G32M3101G8'  ****************************** -->
                <device Dname="G32M3101G8">
                    <memory id="IROM1" start="0x00000000" size="0x00010000" default="1" startup="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00002000" init="0" default="1"/>
                    <algorithm name="Flash/G32M3101_64_MFlash.FLM" start="0x00000000" size="0x00010000" default="1"/>
                    <feature type="IOs" n="19"/>
                </device>
                <!--******************************  Device 'G32M3101K8'  ****************************** -->
                <device Dname="G32M3101K8">
                    <memory id="IROM1" start="0x00000000" size="0x00010000" default="1" startup="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00002000" init="0" default="1"/>
                    <algorithm name="Flash/G32M3101_64_MFlash.FLM" start="0x00000000" size="0x00010000" default="1"/>
                    <feature type="IOs" n="24"/>
                </device>
                <!--******************************  Device 'G32M3101E8'  ****************************** -->
                <device Dname="G32M3101E8">
                    <memory id="IROM1" start="0x00000000" size="0x00010000" default="1" startup="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00002000" init="0" default="1"/>
                    <algorithm name="Flash/G32M3101_64_MFlash.FLM" start="0x00000000" size="0x00010000" default="1"/>
                    <feature type="IOs" n="15"/>
                </device>
            </subFamily>
        </family>
    </devices>
    <conditions>
        <!--conditions selecting Compiler -->
        <condition id="Compiler ARMCC">
            <require Tcompiler="ARMCC"/>
        </condition>
        <!-- Device Conditions -->
        <!--G32M31xx Device Conditions-->
        <condition id="G32M31xx">
            <description>Geehy G32M31xx devices</description>
            <accept Dvendor="Geehy:163" Dname="G32M31*"/>
        </condition>
        <condition id="G32M3101">
            <description>Geehy G32M3101 device</description>
            <accept Dvendor="Geehy:163" Dname="G32M3101*"/>
        </condition>
        <!--G32M3101 ARMCC Conditions -->
        <condition id="G32M3101_ARMCC">
            <description>filter for G32M3101 Device and the ARM compiler</description>
            <accept condition="G32M3101"/>
            <require Tcompiler="ARMCC"/>
        </condition>
        <!-- Device + CMSIS Conditions -->
        <condition id="G32M31xx_CMSIS">
            <description>Geehy G32M31xx devices and CMSIS-CORE</description>
            <accept condition="G32M3101"/>
            <require Cclass="CMSIS" Cgroup="CORE"/>
        </condition>
        <!--G32M31xx Standard Peripherals-->
        <condition id="G32M31xx DDL">
            <description>Geehy Semiconductor G32M31xx Device and LL</description>
            <require condition="G32M31xx_CMSIS"/>
            <require Cclass="Device" Cgroup="DDL Drivers" Csub="Common"/>
        </condition>
        <condition id="G32M31xx DDL SCU">
            <description>Geehy Semiconductor G32M31xx Device and LL and SCU</description>
            <require condition="G32M31xx_CMSIS"/>
            <require Cclass="Device" Cgroup="DDL Drivers" Csub="Common"/>
            <require Cclass="Device" Cgroup="DDL Drivers" Csub="SCU"/>
        </condition>
    </conditions>
    <components>
        <!-- StartUp -->
        <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="G32M31xx_CMSIS">
            <description>System Startup for Geehy Semiconductor G32M31xx device series</description>
            <files>
                <!-- include folders -->
                <file category="include" name="Libraries/Device/Geehy/G32M3101/Include"/>
                <file category="include" name="Libraries/CMSIS/Core/Include"/>
                <!-- startup files (ARM specific) -->
                <file category="source" name="Libraries/Device/Geehy/G32M3101/Source/arm/startup_g32m3101xx.s" attr="config" version="1.0.0" condition="G32M3101_ARMCC"/>
                <!-- system files -->
                <file category="source" condition="G32M3101" name="Libraries/Device/Geehy/G32M3101/Source/system_g32m3101.c" attr="config" version="1.0.0"/>
            </files>
        </component>
        <!--G32M3101_PeripheralLibrary-->
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="Common" Cversion="1.0.1" condition="G32M31xx DDL">
            <description>Common ddl driver</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_COMMON</RTE_Components_h>
            <files>
                <file category="include" name="Libraries/G32M3101_DAL_Driver/Include"/>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_cortex.h"/>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_utils.h"/>
                <file category="source" name="Libraries/G32M3101_DAL_Driver/Source/g32m3101_ddl_utils.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="SCU" Cversion="1.0.1" condition="G32M31xx DDL SCU">
            <description>SCU ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_SCU</RTE_Components_h>
            <files>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_bus.h"/>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_scu.h"/>
                <file category="source" name="Libraries/G32M3101_DAL_Driver/Source/g32m3101_ddl_scu.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="COMP" Cversion="1.0.1" condition="G32M31xx DDL SCU">
            <description>COMP ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_COMP</RTE_Components_h>
            <files>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_comp.h"/>
                <file category="source" name="Libraries/G32M3101_DAL_Driver/Source/g32m3101_ddl_comp.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="CRC" Cversion="1.0.1" condition="G32M31xx DDL SCU">
            <description>CRC ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_CRC</RTE_Components_h>
            <files>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_crc.h"/>
                <file category="source" name="Libraries/G32M3101_DAL_Driver/Source/g32m3101_ddl_crc.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="DMA" Cversion="1.0.1" condition="G32M31xx DDL SCU">
            <description>DMA ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_DMA</RTE_Components_h>
            <files>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_dma.h"/>
                <file category="source" name="Libraries/G32M3101_DAL_Driver/Source/g32m3101_ddl_dma.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="IWDT" Cversion="1.0.1" condition="G32M31xx DDL">
            <description>IWDT ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_IWDT</RTE_Components_h>
            <files>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_iwdt.h"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="WWDT" Cversion="1.0.1" condition="G32M31xx DDL">
            <description>WWDT ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_WWDT</RTE_Components_h>
            <files>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_wwdt.h"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="LPTMR" Cversion="1.0.1" condition="G32M31xx DDL SCU">
            <description>LPTMR ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_LPTMR</RTE_Components_h>
            <files>
                <file category="header" name="Libraries/G32M3101_DAL_Driver/Include/g32m3101_ddl_lptmr.h"/>
                <file category="source" name="Libraries/G32M3101_DAL_Driver/Source/g32m3101_ddl_lptmr.c"/>
            </files>
        </component>
        <component Cclass="Device" Cgroup="DDL Drivers" Csub="ATMR" Cversion="1.0.1" condition="G32M31xx DDL SCU">
            <description>ATMR ddl driver for G32M31xx</description>
            <RTE_Components_h>#define RTE_DEVICE_DDL_ATMR</RTE_Components_h>
