  <conditions>
    <!-- Compiler Conditions -->
    <condition id="TMPM4L Compiler">
      <accept condition="Compiler ARMCC"/>
    </condition>

    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
