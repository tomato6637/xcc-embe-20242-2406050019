    <!--APM32F4xx Standard Peripherals Drivers-->
    <components>
        <!--Startup-->
        <component Cclass="Device" Cgroup="Startup" Cversion="1.0.2" condition="APM32F4xx CMSIS">
            <description>System Startup for Geehy Semiconductor APM32F4xx device series</description>
            <files>
                <!--  include folder -->
                <file category="include" name="Device/CMSIS/Include/"/>
                <file category="include" name="Device/Device/Geehy/APM32F4xx/Include/"/>
                <!-- startup files -->
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f405xx.s" attr="config" version="1.0.0" condition="APM32F405 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f407xx.s" attr="config" version="1.0.0" condition="APM32F407 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f415xx.s" attr="config" version="1.0.0" condition="APM32F415 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f417xx.s" attr="config" version="1.0.0" condition="APM32F417 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f411xx.s" attr="config" version="1.0.0" condition="APM32F411 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f423xx.s" attr="config" version="1.0.0" condition="APM32F423 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f425xx.s" attr="config" version="1.0.0" condition="APM32F425 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/arm/startup_apm32f427xx.s" attr="config" version="1.0.0" condition="APM32F427 ARMCC"/>
                <file category="source" name="Device/Device/Geehy/APM32F402_403/Source/arm/startup_apm32f402_403.s" attr="config" version="1.0.0" condition="APM32F402_403 ARMCC"/>
                <!-- system file -->
                <file category="source" name="Device/Device/Geehy/APM32F4xx/Source/system_apm32f4xx.c" attr="config" version="1.0.4"/>
                <!-- device configuration required by drivers at the moment -->
            </files>
        </component>
