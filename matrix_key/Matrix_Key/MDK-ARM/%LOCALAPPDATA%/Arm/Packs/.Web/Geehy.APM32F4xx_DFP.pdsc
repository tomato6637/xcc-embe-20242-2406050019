    <examples>
        <!--APM32F4xx example information-->
        <example name="APM32F407MINI-Blinky" doc="readme.txt" folder="Boards/Geehy/APM32F407MINI/Blinky">
            <description>APM32F407_MINI Blinky example</description>
            <board name="APM32F407MINI" vendor="Geehy"/>
            <project>
                <environment name="uv" load="APM32F407MINI-Blinky.uvprojx"/>
            </project>
            <attributes>
                <component Cclass="CMSIS" Cgroup="CORE"/>
                <component Cclass="Device" Cgroup="Startup"/>
                <category>Getting Started</category>
                <keyword>LED</keyword>
                <keyword>APM32F407</keyword>
            </attributes>
        </example>
