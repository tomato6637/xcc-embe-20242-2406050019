                <feature type="VCC" n="1.80" m="3.60"/>
                <!-- *************************  Device 'APM32F402TB'  ***************************** -->
                <device Dname="APM32F402TB">
                    <memory id="IROM1" start="0x08000000" size="0x00020000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00008000" init="0" default="1"/>
                    <algorithm name="Flash/APM32F402_128.FLM" start="0x08000000" size="0x00100000" default="1"/>
                    <algorithm name="Flash/APM32F402_OPT.FLM" start="0x1FFFF800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="26"/>
                    <feature type="ADC" n="10" m="12"/>
                </device>
                <!-- *************************  Device 'APM32F402CB'  ***************************** -->
                <device Dname="APM32F402CB">
                    <memory id="IROM1" start="0x08000000" size="0x00020000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00008000" init="0" default="1"/>
                    <algorithm name="Flash/APM32F402_128.FLM" start="0x08000000" size="0x00100000" default="1"/>
                    <algorithm name="Flash/APM32F402_OPT.FLM" start="0x1FFFF800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="40"/>
                    <feature type="ADC" n="10" m="12"/>
                </device>
                <!-- *************************  Device 'APM32F402RB'  ***************************** -->
                <device Dname="APM32F402RB">
                    <memory id="IROM1" start="0x08000000" size="0x00020000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00008000" init="0" default="1"/>
                    <algorithm name="Flash/APM32F402_128.FLM" start="0x08000000" size="0x00100000" default="1"/>
                    <algorithm name="Flash/APM32F402_OPT.FLM" start="0x1FFFF800" size="0x00000010" default="0"/>
                    <feature type="IOs" n="51"/>
                    <feature type="ADC" n="16" m="12"/>
                </device>
            </subFamily>
        </family>
    </devices>
    <!--APM32F4xx conditions-->
