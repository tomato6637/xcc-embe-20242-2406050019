    </condition>
    <condition id="allOf.anyOf=allOf=anyOf=driver.lpflexcomm_lpi2c, component.lpi2c_adapter, allOf=component.i3c_adapter, driver.i3c, device=MIMXRT735S.internal_condition">
      <require condition="anyOf.allOf=anyOf=driver.lpflexcomm_lpi2c, component.lpi2c_adapter, allOf=component.i3c_adapter, driver.i3c.internal_condition"/>
      <require condition="device.MIMXRT735S.internal_condition"/>
