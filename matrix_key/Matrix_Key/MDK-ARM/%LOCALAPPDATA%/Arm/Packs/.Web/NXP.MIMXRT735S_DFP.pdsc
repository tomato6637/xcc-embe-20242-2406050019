  <devices>
    <family Dfamily="MIMXRT735S" Dvendor="NXP:11">
      <debugconfig default="swd" clock="5000000" swj="true"/>
      <description>i.MX RT700</description>
      <device Dname="MIMXRT735S">
        <processor Pname="cm33_core0" Dcore="Cortex-M33" Dfpu="SP_FPU" Dmpu="MPU" Dtz="TZ" Ddsp="DSP" Dendian="Little-endian" Dclock="325000000"/>
        <processor Pname="cm33_core1" Dcore="Cortex-M33" Dfpu="SP_FPU" Dmpu="MPU" Dtz="TZ" Ddsp="DSP" Dendian="Little-endian" Dclock="250000000"/>
        <algorithm name="devices/MIMXRT735S/arm/MIMXRT700_EVK_XSPI0.FLM" start="0x28000000" size="0x04000000" RAMstart="0x30020000" RAMsize="0x00008000" default="1" Pname="cm33_core0"/>
        <algorithm name="devices/MIMXRT735S/arm/MIMXRT700_EVK_XSPI0_S.FLM" start="0x38000000" size="0x04000000" RAMstart="0x30020000" RAMsize="0x00008000" default="1" Pname="cm33_core0"/>
        <algorithm name="devices/MIMXRT735S/arm/MIMXRT700_EVK_XSPI1.FLM" start="0x08000000" size="0x04000000" RAMstart="0x30020000" RAMsize="0x00008000" default="1" Pname="cm33_core0"/>
        <algorithm name="devices/MIMXRT735S/arm/MIMXRT700_EVK_XSPI1_S.FLM" start="0x18000000" size="0x04000000" RAMstart="0x30020000" RAMsize="0x00008000" default="1" Pname="cm33_core0"/>
        <algorithm name="devices/MIMXRT735S/arm/MIMXRT700_FRDM_XSPI0.FLM" start="0x28000000" size="0x02000000" RAMstart="0x30020000" RAMsize="0x00008000" default="0" Pname="cm33_core0"/>
        <algorithm name="devices/MIMXRT735S/arm/MIMXRT700_FRDM_XSPI0_S.FLM" start="0x38000000" size="0x02000000" RAMstart="0x30020000" RAMsize="0x00008000" default="0" Pname="cm33_core0"/>
        <debug svd="devices/MIMXRT735S/MIMXRT735S_cm33_core0.xml" Pname="cm33_core0" __dp="0" __ap="0"/>
        <debug svd="devices/MIMXRT735S/MIMXRT735S_cm33_core1.xml" Pname="cm33_core1" __dp="0" __ap="1"/>
        <environment Pname="cm33_core0" name="iar">
          <file category="linkerfile" name="devices/MIMXRT735S/iar/MIMXRT735Sxxxx_cm33_core0_ram.icf" condition="allOf.toolchains=iar, cores=cm33, core_ids=cm33_core0, device_ids=MIMXRT735S.condition_id"/>
          <file category="linkerfile" name="devices/MIMXRT735S/iar/MIMXRT735Sxxxx_cm33_core1_ram.icf" condition="allOf.toolchains=iar, cores=cm33, core_ids=cm33_core1, device_ids=MIMXRT735S.condition_id"/>
        </environment>
        <environment Pname="cm33_core1" name="iar">
          <file category="linkerfile" name="devices/MIMXRT735S/iar/MIMXRT735Sxxxx_cm33_core0_ram.icf" condition="allOf.toolchains=iar, cores=cm33, core_ids=cm33_core0, device_ids=MIMXRT735S.condition_id"/>
          <file category="linkerfile" name="devices/MIMXRT735S/iar/MIMXRT735Sxxxx_cm33_core1_ram.icf" condition="allOf.toolchains=iar, cores=cm33, core_ids=cm33_core1, device_ids=MIMXRT735S.condition_id"/>
        </environment>
        <sequences>
          <sequence name="EnableDebugMailbox">
            <block>__errorcontrol = 1;</block>
            <control if="!(ReadAP(0x0) &amp; 0x40)">
              <block>
                __dp = 0;
                __ap = 0;
                WriteDP(0, 0x0000001F); //Abort last read
                
                __errorcontrol = 0;
                
                __var status=0x55aa;
                Message(0, "RT7xx connect srcipt start");
                
                // Read APIDR
                __dp = 0;
                __ap = 2;
                status = ReadAP(0xFC);
                Message(0, "APIDR: 0x%08X", status);
                
                // Read DPIDR
                __dp = 0;
                __ap = 2;
                status = ReadDP(0x0);
                Message(0, "DPIDR: 0x%08X", status);
                
                // Active DebugMailbox
                __dp = 0;
                __ap = 2;
                WriteAP(0x0, 0x00000021);
                DAP_Delay(100000);
                __errorcontrol = 0x1;
                ReadAP(0x0);
                __errorcontrol = 0x0;
                
                // Enter Debug Session
                __dp = 0;
                __ap = 2;
                WriteAP(0x4, 0x00000007);
                DAP_Delay(100000);
                ReadAP(0x8);
                
                __dp = 0;
                __ap = 0;
                
                Message(0, "RT7xx connect srcipt end");
              </block>
            </control>
            <block>__errorcontrol = 0;</block>
          </sequence>
          <sequence name="enableCPU1">
            <block>
              Message(0, "RT7xx booting CPU1");
              //GlikeyWriteEnable(GLIKEY1, 9U)
              Write32(0x40220c00,0x00060000);//clear bit18
              Write32(0x40220c00,0x00020009);
              Write32(0x40220c00,0x00010009);
              Write32(0x40220c04,0x00290000);
              Write32(0x40220c00,0x00020009);
              Write32(0x40220c04,0x00280000);
              Write32(0x40220c00,0x00000009);
              //arbiter1: enable compute access ....
              Write32(0x40220f80,0x3fffffff);
              Write32(0x40220f84,0x3fffffff);
              
              Write32(0x40003030, 0x2); //SLEEPCON0-&gt;RUNCFG_CLR[1:] = 0
              
              Write32(0x00580000, 0x005C0000); //landing zone
              Write32(0x00580004, 0x00580009); //landing zone
              Write32(0x00580008, 0xE7FEE7FE); //landing zone
              
              //GlikeyClearConfig(GLIKEY4);
              Write32(0x40062c00, 0x00060000);
              
              Write32(0x40061040, 0x1); //CLKCTL3-&gt;PSCCTL0_COMP_SET = 0x1;
              Write32(0x40060070, 0x80000000); //RSTCTL3-&gt;PRSTCTL0_CLR
              
              Write32(0x4006208C, 0x0); //  SYSCON3-&gt;CPU_STATUS = 0
              Message(0, "RT7xx CPU1 booted");
            </block>
          </sequence>
          <sequence name="dpstart">
            <block>
              __var SW_DP_ABORT  = 0x0;
              __var DP_CTRL_STAT = 0x4;
              __var DP_SELECT    = 0x8;
              __var powered_down = 0;
              __var select = 0;
            </block>
            <control if="__ap==1">
              <block>select = 0x01000000;</block>
            </control>
            <block>
              // Switch to DP Register Bank 0
              WriteDP(DP_SELECT, select);
              
              // Read DP CTRL/STAT Register and check if CSYSPWRUPACK and CDBGPWRUPACK bits are set
              powered_down = ((ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000);
            </block>
            <control if="powered_down">
              <block>
                // Request Debug/System Power-Up
                WriteDP(DP_CTRL_STAT, 0x50000000);
              </block>
              <!-- Wait for Power-Up Request to be acknowledged -->
              <control while="(ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000" timeout="1000000"/>
              <!-- JTAG Specific Part of sequence -->
              <control if="(__protocol &amp; 0xFFFF) == 1">
                <block>
                  // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                  // Additionally clear STICKYORUN, STICKYCMP, and STICKYERR bits by writing '1'
                  WriteDP(DP_CTRL_STAT, 0x50000F32);
                  
                  Sequence("EnableDebugMailbox");
                </block>
              </control>
              <!-- SWD Specific Part of sequence -->
              <control if="(__protocol &amp; 0xFFFF) == 2">
                <block>
                  // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                  WriteDP(DP_CTRL_STAT, 0x50000F00);
                  
                  // Clear WDATAERR, STICKYORUN, STICKYCMP, and STICKYERR bits of CTRL/STAT Register by write to ABORT register
                  WriteDP(SW_DP_ABORT, 0x0000001E);
                  
                  Sequence("EnableDebugMailbox");
                </block>
              </control>
            </control>
          </sequence>
          <sequence name="DebugPortStart" Pname="cm33_core0">
            <block>
        __ap = 0;
        Sequence("dpstart");
      </block>
          </sequence>
          <sequence name="DebugPortStart" Pname="cm33_core1">
            <block>
              __ap = 0;
              Sequence("dpstart");
              Sequence("enableCPU1");
              __ap = 1;
              Sequence("dpstart");
            </block>
          </sequence>
          <sequence name="WaitForStopAfterReset" Pname="cm33_core0">
            <block>
              __var SCS_Addr    = 0xE000E000;
              __var DHCSR_Addr  = SCS_Addr + 0xDF0;
              __var DFSR_Addr  = SCS_Addr + 0xD30;
              Sequence("EnableDebugMailbox");
              Write32(DHCSR_Addr, 0xA05F0003);  // Halt the core in case it didn't stop at a breakpiont.
              // Clear watch point
              Write32(0xE0001020, 0x0);
              Write32(0xE0001028, 0x0);
              
              // Clear XPSR to avoid undefined instruction fault caused by IT/ICI
              Write32(0xE000EDF8, 0x01000000);
              Write32(0xE000EDF4, 0x00010010);
              // Set MSPLIM to 0
              Write32(0xE000EDF8, 0x00000000);
              Write32(0xE000EDF4, 0x0001001C);
            </block>
          </sequence>
          <sequence name="ResetHardware" Pname="cm33_core0">
            <block>
              __var nReset      = 0x80;
              __var canReadPins = 0;
              __var SCS_Addr    = 0xE000E000;
              __var DHCSR_Addr  = SCS_Addr + 0xDF0;
              
              // De-assert nRESET line
              canReadPins = (DAP_SWJ_Pins(0x00, nReset, 0) != 0xFFFFFFFF);
            </block>
            <!-- Keep reset active for 50 ms -->
            <control while="1" timeout="50000"/>
            <control if="canReadPins">
              <!-- Assert nRESET line and wait max. 1s for recovery -->
              <control while="(DAP_SWJ_Pins(nReset, nReset, 0) &amp; nReset) == 0" timeout="1000000"/>
            </control>
            <control if="!canReadPins">
              <block>
        // Assert nRESET line
        DAP_SWJ_Pins(nReset, nReset, 0);
      </block>
              <!-- Wait 100ms for recovery if nRESET not readable -->
              <control while="1" timeout="100000"/>
            </control>
            <control if="(__connection &amp; (1 &lt;&lt; 17)) == 0">
              <block>
                DAP_Delay(BootTime);  // Give bootloader time to do what it needs to do
                Sequence("WaitForStopAfterReset");
              </block>
            </control>
          </sequence>
          <sequence name="TraceStart" Pname="cm33_core0">
            <control if="__traceout &amp; 0x1" info="SWO Trace output selected">
              <block>
                __var SWO_IOPCTL_ADDR = 0x4006400C;
                __var PSCCTL0_SET_ADDR = 0x40061040;
                __var PRSTCTL0_CLR_ADDR = 0x40060070;
                __var TPIUFCLKSEL_ADDR = 0x40001560;
                __var TPIUCLKDIV_ADDR = 0x40001564;
                __var TRACECLKEN_ADDR = 0x40001044; //CLKCTL0_PSCCTL1_SET
                __var divider = 0;
                
                Message(0, "Configure Trace clock");
                Write32(TPIUFCLKSEL_ADDR, 0x4 | traceClkSrc);   // Enable and configure trace clock
                divider = Read32(TPIUCLKDIV_ADDR);
                Write32(TPIUCLKDIV_ADDR, 0x20000000); //Reset divider
                Write32(TPIUCLKDIV_ADDR, traceClkDiv-1);
              </block>
              <control while="(Read32(TPIUCLKDIV_ADDR) &amp; 0x80000000) ==0" timeout="50000"/>
              <block>
                Write32(TRACECLKEN_ADDR, 0x1C);
                //Enable the clock for the IOPCTL1 block
                Write32(PSCCTL0_SET_ADDR, 0x1000000);
                //Clear reset of the IOPCTL1 block
                Write32(PRSTCTL0_CLR_ADDR, 0x1);
                //Configure SWO pin
                Write32(SWO_IOPCTL_ADDR, 0x5U);
              </block>
            </control>
          </sequence>
          <sequence name="ResetSystem" Pname="cm33_core0">
            <block>
              __dp = 0;
              __ap = 0;
              // System Control Space (SCS) offset as defined in Armv6-M/Armv7-M.
              __var SCS_Addr   = 0xE000E000;
              __var AIRCR_Addr = SCS_Addr + 0xD0C;
              __var DHCSR_Addr = SCS_Addr + 0xDF0;
              __var DEMCR_Addr = SCS_Addr + 0xDFC;
              __var tmp;
              //Halt the core
              Write32(DHCSR_Addr, 0xA05F0003);
              //clear VECTOR CATCH and set TRCENA
              tmp = Read32(DEMCR_Addr);
              Write32(DEMCR_Addr, tmp | 0x1000000);
              // Set watch point at SYSTEM_STICK_CALIB access
              Write32(0xE0001020, 0x50002094);
              Write32(0xE0001028, 0x00000814);
              __errorcontrol = 1;
              // Execute SYSRESETREQ via AIRCR
              Write32(AIRCR_Addr, 0x05FA0004);
              DAP_Delay(BootTime);  // Give bootloader time to do what it needs to do
              WriteDP(0x0, 0x0000001E); // Clear WDATAERR, STICKYORUN, STICKYCMP, and STICKYERR bits
              Sequence("WaitForStopAfterReset");
              __errorcontrol = 0;
            </block>
          </sequence>
          <sequence name="ResetSystem" Pname="cm33_core1" disable="1">
            <block>Message(0, "CPU1 doesn't support reset system");</block>
          </sequence>
        </sequences>
        <debugvars configfile="devices/MIMXRT735S/arm/MIMXRT7xx.dbgconf">
          // Debug Access Variables, can be modified by user via copies of DBGCONF files as created by uVision. Also see sub-family level.
          __var Dbg_CR                = 0x00000000;           // DBG_CR
          __var BootTime              = 50000;                // 50 milliseconds
          __var traceClkSrc           = 0;                    // Trace clock source
          __var traceClkDiv           = 2;                    // Trace clock divider by
        </debugvars>
        <memory name="BootROM" start="0x03000000" size="0x040000" access="rx" default="1"/>
        <memory name="BootROM_alias" start="0x13000000" size="0x040000" access="rx" alias="BootROM"/>
        <memory name="SRAM_CMPT" start="0x00080000" size="0x380000" access="rw" default="1"/>
        <memory name="SRAM_CMPT_alias1" start="0x10080000" size="0x380000" access="rw" alias="SRAM_CMPT"/>
        <memory name="SRAM_CMPT_alias2" start="0x20080000" size="0x380000" access="rw" alias="SRAM_CMPT"/>
        <memory name="SRAM_CMPT_alias3" start="0x30080000" size="0x380000" access="rw" alias="SRAM_CMPT"/>
        <memory name="SRAM_HIFI1" start="0x00600000" size="0x080000" access="rw" default="1"/>
        <memory name="SRAM_HIFI1_alias1" start="0x10600000" size="0x080000" access="rw" alias="SRAM_HIFI1"/>
        <memory name="SRAM_HIFI1_alias2" start="0x20600000" size="0x080000" access="rw" alias="SRAM_HIFI1"/>
        <memory name="SRAM_HIFI1_alias3" start="0x30600000" size="0x080000" access="rw" alias="SRAM_HIFI1"/>
        <memory name="SRAM_SENSE" start="0x00580000" size="0x080000" access="rw" default="1"/>
        <memory name="SRAM_SENSE_alias1" start="0x10580000" size="0x080000" access="rw" alias="SRAM_SENSE"/>
        <memory name="SRAM_SENSE_alias2" start="0x20580000" size="0x080000" access="rw" alias="SRAM_SENSE"/>
        <memory name="SRAM_SENSE_alias3" start="0x30580000" size="0x080000" access="rw" alias="SRAM_SENSE"/>
        <memory name="SRAM_SHARED" start="0x00000000" size="0x080000" access="rw" default="1"/>
        <memory name="SRAM_SHARED_alias1" start="0x10000000" size="0x080000" access="rw" alias="SRAM_SHARED"/>
        <memory name="SRAM_SHARED_alias2" start="0x20000000" size="0x080000" access="rw" alias="SRAM_SHARED"/>
        <memory name="SRAM_SHARED_alias3" start="0x30000000" size="0x080000" access="rw" alias="SRAM_SHARED"/>
        <variant Dvariant="MIMXRT735SGFOB">
          <compile Pname="cm33_core0" header="devices/MIMXRT735S/fsl_device_registers.h" define="CPU_MIMXRT735SGFOB_cm33_core0"/>
          <compile Pname="cm33_core1" header="devices/MIMXRT735S/fsl_device_registers.h" define="CPU_MIMXRT735SGFOB_cm33_core1"/>
        </variant>
        <variant Dvariant="MIMXRT735SGAWBR">
          <compile Pname="cm33_core0" header="devices/MIMXRT735S/fsl_device_registers.h" define="CPU_MIMXRT735SGAWBR_cm33_core0"/>
          <compile Pname="cm33_core1" header="devices/MIMXRT735S/fsl_device_registers.h" define="CPU_MIMXRT735SGAWBR_cm33_core1"/>
        </variant>
      </device>
    </family>
  </devices>
  <conditions>
    <condition id="device.MIMXRT735S.internal_condition">
      <accept Dname="MIMXRT735SGAWBR" Dvendor="NXP:11"/>
      <accept Dname="MIMXRT735SGFOB" Dvendor="NXP:11"/>
      <accept Dname="MIMXRT735SGVKB" Dvendor="NXP:11"/>
    </condition>
    <condition id="cmake_toolchain.condition_id">
      <require condition="allOf.device=MIMXRT735S.internal_condition"/>
    </condition>
