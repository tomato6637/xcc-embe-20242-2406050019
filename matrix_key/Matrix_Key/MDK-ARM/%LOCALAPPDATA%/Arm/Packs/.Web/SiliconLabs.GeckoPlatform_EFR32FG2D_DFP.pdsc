<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.7.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>SiliconLabs</vendor>
  <url>https://www.silabs.com/documents/public/cmsis-packs/</url>
  <name>GeckoPlatform_EFR32FG2D_DFP</name>
  <description>Silicon Labs EFR32FG2D Flex Gecko Series Device Support.</description>
  <license>License/license.md</license>

  <releases>
    <release version="2025.12.1" date="2025-02-20">
      New device families for EFR32FG2D and new modules for BGM27 and New OPNs for Socs EFR32FG25.
    </release>
  </releases>

  <keywords>
    <!-- keywords for indexing -->
    <keyword>Silicon Labs</keyword>
    <keyword>Device Support</keyword>
    <keyword>Device Family Package Silicon Labs</keyword>
    <keyword>EFR32FG2D</keyword>
    <keyword>EFR32</keyword>
    <keyword>Flex Gecko</keyword>
    <keyword>Gecko</keyword>
  </keywords>

  <devices>
    <family Dfamily="EFR32FG2D Series" Dvendor="Silicon Labs:21">
      <processor Dcore="Cortex-M33" DcoreVersion="r0p0" Dfpu="NO_FPU" Dmpu="NO_MPU" Dtz="NO_TZ" Ddsp="NO_DSP" Dendian="Little-endian" Dclock="38400000"/>
      <book name="Documents/cortex_m33_dgug.pdf"      title="Cortex-M33 Generic User Guide"/>
      <description>
32-bit ARM Cortex-M33 core with 80 MHz maximum operating frequency.
      </description>

      <subFamily DsubFamily="EFR32FG2DA010">
        <!-- *************************  Device 'EFR32FG2DA010F256IM40'  ***************************** -->
        <device Dname="EFR32FG2DA010F256IM40">
          <compile header="Device/SiliconLabs/EFR32FG2D/Include/em_device.h"  define="EFR32FG2DA010F256IM40"/>
          <debug      svd="SVD/EFR32FG2D/EFR32FG2DA010F256IM40.svd"/>
          <memory     id="IROM1"                start="0x08000000"  size="0x00040000"  startup="1"   default="1"/>
          <memory     id="IRAM1"                start="0x20000000"  size="0x00008000"  init   ="0"   default="1"/>
          <algorithm  name="Flash/GECKOS2C3.FLM"  start="0x08000000"  size="0x00040000"  RAMstart="0x20000000" RAMsize="0x10000" default="1" style="Keil"/>
          <algorithm  name="Flash/FlashGECKOS2C3.flash"  start="0x08000000"  size="0x00040000"  default="0"  style="IAR"/>
        </device>

        <!-- *************************  Device 'EFR32FG2DA010F256IM48'  ***************************** -->
        <device Dname="EFR32FG2DA010F256IM48">
          <compile header="Device/SiliconLabs/EFR32FG2D/Include/em_device.h"  define="EFR32FG2DA010F256IM48"/>
          <debug      svd="SVD/EFR32FG2D/EFR32FG2DA010F256IM48.svd"/>
          <memory     id="IROM1"                start="0x08000000"  size="0x00040000"  startup="1"   default="1"/>
          <memory     id="IRAM1"                start="0x20000000"  size="0x00008000"  init   ="0"   default="1"/>
          <algorithm  name="Flash/GECKOS2C3.FLM"  start="0x08000000"  size="0x00040000"  RAMstart="0x20000000" RAMsize="0x10000" default="1" style="Keil"/>
          <algorithm  name="Flash/FlashGECKOS2C3.flash"  start="0x08000000"  size="0x00040000"  default="0"  style="IAR"/>
        </device>

      </subFamily>

      <subFamily DsubFamily="EFR32FG2DA020">
        <!-- *************************  Device 'EFR32FG2DA020F256IM48'  ***************************** -->
        <device Dname="EFR32FG2DA020F256IM48">
          <compile header="Device/SiliconLabs/EFR32FG2D/Include/em_device.h"  define="EFR32FG2DA020F256IM48"/>
          <debug      svd="SVD/EFR32FG2D/EFR32FG2DA020F256IM48.svd"/>
          <memory     id="IROM1"                start="0x08000000"  size="0x00040000"  startup="1"   default="1"/>
          <memory     id="IRAM1"                start="0x20000000"  size="0x00008000"  init   ="0"   default="1"/>
          <algorithm  name="Flash/GECKOS2C3.FLM"  start="0x08000000"  size="0x00040000"  RAMstart="0x20000000" RAMsize="0x10000" default="1" style="Keil"/>
          <algorithm  name="Flash/FlashGECKOS2C3.flash"  start="0x08000000"  size="0x00040000"  default="0"  style="IAR"/>
        </device>

      </subFamily>

      <subFamily DsubFamily="EFR32FG2DB010">
        <!-- *************************  Device 'EFR32FG2DB010F512IM40'  ***************************** -->
        <device Dname="EFR32FG2DB010F512IM40">
          <compile header="Device/SiliconLabs/EFR32FG2D/Include/em_device.h"  define="EFR32FG2DB010F512IM40"/>
          <debug      svd="SVD/EFR32FG2D/EFR32FG2DB010F512IM40.svd"/>
          <memory     id="IROM1"                start="0x08000000"  size="0x00080000"  startup="1"   default="1"/>
          <memory     id="IRAM1"                start="0x20000000"  size="0x00010000"  init   ="0"   default="1"/>
          <algorithm  name="Flash/GECKOS2C3.FLM"  start="0x08000000"  size="0x00080000"  RAMstart="0x20000000" RAMsize="0x10000" default="1" style="Keil"/>
          <algorithm  name="Flash/FlashGECKOS2C3.flash"  start="0x08000000"  size="0x00080000"  default="0"  style="IAR"/>
        </device>

        <!-- *************************  Device 'EFR32FG2DB010F512IM48'  ***************************** -->
        <device Dname="EFR32FG2DB010F512IM48">
          <compile header="Device/SiliconLabs/EFR32FG2D/Include/em_device.h"  define="EFR32FG2DB010F512IM48"/>
          <debug      svd="SVD/EFR32FG2D/EFR32FG2DB010F512IM48.svd"/>
          <memory     id="IROM1"                start="0x08000000"  size="0x00080000"  startup="1"   default="1"/>
          <memory     id="IRAM1"                start="0x20000000"  size="0x00010000"  init   ="0"   default="1"/>
          <algorithm  name="Flash/GECKOS2C3.FLM"  start="0x08000000"  size="0x00080000"  RAMstart="0x20000000" RAMsize="0x10000" default="1" style="Keil"/>
          <algorithm  name="Flash/FlashGECKOS2C3.flash"  start="0x08000000"  size="0x00080000"  default="0"  style="IAR"/>
        </device>

      </subFamily>

      <subFamily DsubFamily="EFR32FG2DB020">
        <!-- *************************  Device 'EFR32FG2DB020F512IM48'  ***************************** -->
        <device Dname="EFR32FG2DB020F512IM48">
          <compile header="Device/SiliconLabs/EFR32FG2D/Include/em_device.h"  define="EFR32FG2DB020F512IM48"/>
          <debug      svd="SVD/EFR32FG2D/EFR32FG2DB020F512IM48.svd"/>
          <memory     id="IROM1"                start="0x08000000"  size="0x00080000"  startup="1"   default="1"/>
          <memory     id="IRAM1"                start="0x20000000"  size="0x00010000"  init   ="0"   default="1"/>
          <algorithm  name="Flash/GECKOS2C3.FLM"  start="0x08000000"  size="0x00080000"  RAMstart="0x20000000" RAMsize="0x10000" default="1" style="Keil"/>
          <algorithm  name="Flash/FlashGECKOS2C3.flash"  start="0x08000000"  size="0x00080000"  default="0"  style="IAR"/>
        </device>

      </subFamily>

    </family>
  </devices>

  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler GCC">
      <require Tcompiler="GCC"/>
    </condition>
    <condition id="Compiler IAR">
      <require Tcompiler="IAR"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="EFR32FG2D">
      <description>Silicon Labs EFR32FG2D device series</description>
      <require Dvendor="Silicon Labs:21" Dname="EFR32FG2D*"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
  </conditions>

  <components>
    <component Cclass="Device" Cgroup="Startup" Cversion="2025.12.1" condition="EFR32FG2D">
      <description>System Startup for Silicon Labs EFR32FG2D device series</description>
      <files>
        <!-- include folder -->
        <file category="include" name="Device/SiliconLabs/EFR32FG2D/Include/"/>
        <file category="header"  name="Device/SiliconLabs/EFR32FG2D/Include/em_device.h"/>
        <!-- system file -->
        <file category="source"  name="Device/SiliconLabs/EFR32FG2D/Source/system_efr32fg2d.c" attr="config" version="2025.12.1"/>
      </files>
    </component>
  </components>
</package>
