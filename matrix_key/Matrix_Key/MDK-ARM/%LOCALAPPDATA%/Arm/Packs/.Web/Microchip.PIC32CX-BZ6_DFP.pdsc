         <memory name="SYSTEM_CM4F_SYSTEM_REGISTERS"
                 start="0xE0000000"
                 size="0x1fff4000"
                 access="rwp"/>
         <debugport __dp="0">
            <swd/>
         </debugport>
         <trace>
            <serialwire/>
         </trace>
         <algorithm name="keil/Flash/PIC32CX-BZ6_BFM.FLM"
                    start="0x800000"
                    size="0x10000"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <algorithm name="keil/Flash/PIC32CX-BZ6_CFM.FLM"
                    start="0x810000"
                    size="0x1000"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <algorithm name="keil/Flash/PIC32CX-BZ6_PFM.FLM"
                    start="0x1000000"
                    size="0x200000"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <feature type="NVIC" n="58"/>
         <feature type="WDT" n="1"/>
         <feature type="USBD" n="1" name="Full-Speed USB Device"/>
         <feature type="USBH" n="1" name="Full-Speed USB Host"/>
         <feature type="CAN" n="2"/>
         <feature type="ETH" n="1"/>
         <feature type="RTC" n="1"/>
         <feature type="Timer" n="10"/>
         <feature type="PWM" n="3"/>
         <feature type="VCC" n="1.62" m="3.63"/>
         <device Dname="PIC32CX2051BZ62132">
            <processor Dcore="Cortex-M4"
                       Dendian="Little-endian"
                       Dmpu="MPU"
                       Dfpu="SP_FPU"
                       Ddsp="NO_DSP"
                       Dtz="NO_TZ"
                       Dmve="NO_MVE"
                       Dclock="128000000"
                       DcoreVersion="r0p1"/>
            <debugconfig default="swd" clock="2000000"/>
            <compile header="PIC32CX2051BZ62132/include/pic32c.h"
                     define="__PIC32CX2051BZ62132__"/>
            <debug svd="PIC32CX2051BZ62132/svd/PIC32CX2051BZ62132.svd"/>
            <flashinfo name="BFM"
                       start="0x800000"
                       blankval="0xFFFFFFFF"
                       pagesize="0x1000"
                       ptime="1000000"
                       etime="1000000">
               <block count="0x10" size="0x1000"/>
            </flashinfo>
            <flashinfo name="CFM"
                       start="0x810000"
                       blankval="0xFFFFFFFF"
                       pagesize="0x1000"
                       ptime="1000000"
                       etime="1000000">
               <block count="0x1" size="0x1000"/>
            </flashinfo>
            <flashinfo name="PFM"
                       start="0x1000000"
                       blankval="0xFFFFFFFF"
                       pagesize="0x1000"
                       ptime="1000000"
                       etime="1000000">
               <block count="0x200" size="0x1000"/>
            </flashinfo>
            <environment name="atmel">
               <at:extension xmlns:at="http://www.atmel.com/schemas/pack-device-atmel-extension"
                             schemaVersion="1.0"
                             xsi:schemaLocation="http://www.atmel.com/schemas/pack-device-atmel-extension PACK.DEVICE.ATMEL.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/at/1.0/PACK.DEVICE.ATMEL.EXTENSION.xsd-->
                  <at:atdf name="PIC32CX2051BZ62132/atdf/PIC32CX2051BZ62132.atdf"/>
