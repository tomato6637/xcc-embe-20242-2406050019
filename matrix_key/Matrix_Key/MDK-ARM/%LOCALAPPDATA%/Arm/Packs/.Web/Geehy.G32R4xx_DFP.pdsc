    <boards>
        <!--G32R4xx board information-->
        <board vendor="Geehy" name="G32R430TINY" revision="Ver 1.0">
            <description>Geehy G32R430 Development Board</description>
            <mountedDevice deviceIndex="0" Dvendor="Geehy:163" Dname="G32R430CB"/>
            <compatibleDevice deviceIndex="0" Dvendor="Geehy:163" DsubFamily="G32R430CB"/>
