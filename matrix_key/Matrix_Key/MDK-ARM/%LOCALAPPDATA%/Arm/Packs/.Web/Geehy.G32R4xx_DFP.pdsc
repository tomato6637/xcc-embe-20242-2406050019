<?xml version="1.0"?>
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>Geehy</vendor>
    <name>G32R4xx_DFP</name>
    <description>Geehy Semiconductor G32R4 Series Device Support, Drivers and Examples</description>
    <url>https://global.geehy.com/uploads/tool/</url>
    <supportContact>https://global.geehy.com/design/software</supportContact>
    <releases>
        <release version="1.0.5" date="2026-10-09">Update url.</release>
        <release version="1.0.4" date="2026-07-27">
            - Added DBGMCU debug configuration (.dbgconf/.ini) and DebugCoreStart sequence
            - Updated G32R430_128.FLM for default HSI and FLASH_TMCR time base
            - Added DebugPortSetup sequence (SWD Dormant-to-SWD wakeup / Selection Alert)
        </release>
        <release version="1.0.3" date="2026-04-21">Updated GPIO device drivers.</release>
        <release version="1.0.2" date="2026-01-20">Updated Flash and RCM device drivers.</release>
        <release version="1.0.1" date="2025-12-30">Fixed naming issues for some COMP and ADC16 registers.</release>
        <release version="1.0.0" date="2025-11-30">First Release version of G32R4 Device Family Pack.</release>
    </releases>
    <keywords>
        <!-- keywords for indexing -->
        <keyword>Geehy</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package Geehy Semiconductor</keyword>
        <keyword>G32R4</keyword>
        <keyword>G32R</keyword>
    </keywords>
    <devices>
        <family Dfamily="G32R4 Series" Dvendor="Geehy:163">
            <processor Dcore="Cortex-M52" DcoreVersion="r0p1" Dfpu="NO_FPU" Dmpu="MPU" Dmve="NO_MVE" Dcdecp="0x08" Dpacbti="PACBTI" Dtz="NO_TZ" Dclock="160000000" Dendian="Little-endian"/>
            <description>G32R430 features a Cortex-M52 core running at up to 128MHz, supporting high-performance computing, along with 128KB Flash, 16KB DTCM, and 32KB ITCM for fast access and storage, as well as TMU sine/cosine acceleration to optimize mathematical operations.

Peripheral features:

- High-Speed ADCs: Two 16-bit ADCs and one 12-bit ADC for versatile analog signal sampling.

- DACs: Two 10-bit digital-to-analog converters for precise analog output.

- Timers: One 16-bit advanced timer, three 16-bit general-purpose timers, and a low-power timer for flexible timing control.

- RTC: Real-time clock for timekeeping and scheduling functions.

- Communication Interfaces: Two USARTs, one SPI, and one I2C for device connectivity.

- Comparators: Four high-precision analog comparators for level detection and control.</description>
            <feature type="WDT" n="2"/>
            <feature type="RTC" n="32768"/>
            <feature type="ADC12" n="1"/>
            <feature type="ADC16" n="2"/>
            <feature type="VCC" n="2.00" m="3.60"/>
            <feature type="Temp" n="-40" m="105"/>
            <!-- ************************  Subfamily 'G32R430'  **************************** -->
            <subFamily DsubFamily="G32R430">
                <processor Dclock="128000000"/>
                <debug svd="SVD/G32R430xx.svd"/>
                <sequences>
                    <!-- G32R430 POR: SWD DP is dormant; wake via ADIv5.2 Selection Alert before DP access -->
                    <sequence name="DebugPortSetup">
                        <block>
                            __var isSWJ    = ((__protocol &amp; 0x00010000) != 0);
                            __var protType = __protocol &amp; 0x0000FFFF;
                        </block>
                        <!-- JTAG Protocol -->
                        <control if="protType == 1">
                            <control if="isSWJ">
                                <block atomic="1">
                                    DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                                    DAP_SWJ_Sequence(16, 0xE73C);
                                    DAP_SWJ_Sequence(6, 0x3F);
                                </block>
                            </control>
                            <block atomic="1">
                                DAP_JTAG_Sequence(6, 1, 0x3F);
                                DAP_JTAG_Sequence(1, 0, 0x01);
                            </block>
                        </control>
                        <!-- SWD Protocol: always Dormant-to-SWD (chip default after power-on) -->
                        <control if="protType == 2">
                            <block atomic="1">
                                // Line reset
                                DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                                // Select Dormant State (from JTAG); safe if already dormant
                                DAP_SWJ_Sequence(31, 0x33BBBBBA);
                                // Selection Alert (8 high + 128-bit alert)
                                DAP_SWJ_Sequence(8,  0xFF);
                                DAP_SWJ_Sequence(64, 0x86852D956209F392);
                                DAP_SWJ_Sequence(64, 0x19BC0EA2E3DDAFE9);
                                // 4 cycles LOW + SWD Activation Code 0x1A
                                DAP_SWJ_Sequence(12, 0x1A0);
                                // Line reset + idle
                                DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                                DAP_SWJ_Sequence(3,  0x00);
                            </block>
                            <block>
                                // Read DPIDR to enable SWD interface
                                ReadDP(0x0);
                            </block>
                        </control>
                    </sequence>
                    <sequence name="DebugCoreStart">
                        <block info="DbgMCU registers">
                            Write32(0x4000580C, DbgMCU_APB);   // DBGMCU_APB: Peripheral Freeze when core halted
                        </block>
                    </sequence>
                </sequences>
                <debugvars configfile="Debug/G32R430.dbgconf">

                    __var DbgMCU_APB = 0x00000000;   // DBGMCU_APB: All Peripherals Operate as in Normal Mode

                </debugvars>
                <book name="Documents/DATASHEET.pdf" title="G32R4"/>
                <feature type="Timer" n="4" m="16"/>
                <feature type="DAC" n="2" m="12"/>
                <feature type="SPI" n="1" m="37500000"/>
                <feature type="USART" n="2" m="10500000"/>
                <feature type="TS" n="1"/>
                <feature type="COMP" n="4"/>
                <feature type="VCC" n="1.80" m="3.60"/>
                <!-- *************************  Device 'G32R430RB'  ***************************** --><device Dname="G32R430RB">
                    <memory id="IROM1" start="0x08000000" size="0x00020000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00004000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x00000000" size="0x00008000" init="0" default="1"/>
                    <algorithm name="Flash/G32R430_128.FLM" start="0x08000000" size="0x00020000" default="1"/>
                    <algorithm name="Flash/G32R430_OPT.FLM" start="0x1FFF0000" size="0x0000000C" default="0"/>
                    <feature type="IOs" n="54"/>
                </device><!-- *************************  Device 'G32R430UB'  ***************************** --><device Dname="G32R430UB">
                    <memory id="IROM1" start="0x08000000" size="0x00020000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00004000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x00000000" size="0x00008000" init="0" default="1"/>
                    <algorithm name="Flash/G32R430_128.FLM" start="0x08000000" size="0x00020000" default="1"/>
                    <algorithm name="Flash/G32R430_OPT.FLM" start="0x1FFF0000" size="0x0000000C" default="0"/>
                    <feature type="IOs" n="54"/>
                </device><!-- *************************  Device 'G32R430CB'  ***************************** -->
                <device Dname="G32R430CB">
                    <memory id="IROM1" start="0x08000000" size="0x00020000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00004000" init="0" default="1"/>
                    <memory id="IRAM2" start="0x00000000" size="0x00008000" init="0" default="1"/>
                    <algorithm name="Flash/G32R430_128.FLM" start="0x08000000" size="0x00020000" default="1"/>
                    <algorithm name="Flash/G32R430_OPT.FLM" start="0x1FFF0000" size="0x0000000C" default="0"/>
                    <feature type="IOs" n="41"/>
                </device>
                <!-- *************************  Device 'G32R430KB'  ***************************** -->
                <device Dname="G32R430KB">
                    <memory id="IROM1" start="0x08000000" size="0x00020000" startup="1" default="1"/>
                    <memory id="IRAM1" start="0x20000000" size="0x00004000" default="1" init="0"/>
                    <memory id="IRAM2" start="0x00000000" size="0x00008000" default="1" init="0"/>
                    <algorithm name="Flash/G32R430_128.FLM" start="0x08000000" size="0x00020000" default="1"/>
                    <algorithm name="Flash/G32R430_OPT.FLM" start="0x1FFF0000" size="0x0000000C" default="0"/>
                    <feature type="IOs" n="28"/>
                </device>
            </subFamily>
        </family>
    </devices>
    <!--G32R4xx conditions-->
    <conditions>
        <!-- conditions selecting Compiler -->
        <condition id="Compiler ARMCC">
            <require Tcompiler="ARMCC"/>
        </condition>
        <!--G32R430xx Device Conditions-->
        <condition id="G32R430xx">
            <description>Geehy Semiconductor G32R430xx Series devices</description>
            <require Dvendor="Geehy:163" Dname="G32R430*"/>
        </condition>
        <!--G32R430 ARMCC Conditions -->
        <condition id="G32R430 ARMCC">
            <description>filter for G32R430 Device and the ARM compiler</description>
            <accept condition="G32R430xx"/>
            <require Tcompiler="ARMCC"/>
        </condition>
        <!--G32R4xx CMSIS Conditions -->
        <condition id="G32R4xx CMSIS">
            <description>Geehy Semiconductor G32R4xx Device with CMSIS</description>
            <accept condition="G32R430xx"/>
            <require Cclass="CMSIS" Cgroup="CORE"/>
        </condition>
        <!--G32R4xx STDPERIPH Conditions -->
        <condition id="G32R4xx STDPERIPH">
            <description>Geehy Semiconductor G32R4xx with Standard Peripherals Drivers Framework</description>
            <require condition="G32R4xx CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
        </condition>
        <!--G32R4xx STDPERIPH RCM Conditions-->
        <condition id="G32R4xx STDPERIPH RCM">
            <description>Geehy Semiconductor G32R430 with Standard Peripherals Drivers Framework and RCM</description>
            <require condition="G32R4xx CMSIS"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="RCM"/>
        </condition>
    </conditions>
    <!--G32R4xx Standard Peripherals Drivers-->
