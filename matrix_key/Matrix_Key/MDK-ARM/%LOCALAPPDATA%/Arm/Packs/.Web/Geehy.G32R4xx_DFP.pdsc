            <feature type="RS232" n="1"/>
            <feature type="Button" n="1" name="Reset, KEY1"/>
            <feature type="LED" n="2" name="LEDs directly connected to port pins"/>
        </board>
    </boards>
    <examples>
        <!--G32R4xx example information-->
        <example name="G32R430TINY-Blinky" doc="readme.txt" folder="Boards/Geehy/G32R430TINY/Blinky">
            <description>G32R430_TINY Blinky example</description>
            <board name="G32R430TINY" vendor="Geehy"/>
            <project>
                <environment name="uv" load="G32R430TINY-Blinky.uvprojx"/>
            </project>
            <attributes>
                <component Cclass="CMSIS" Cgroup="CORE"/>
                <component Cclass="Device" Cgroup="Startup"/>
                <category>Getting Started</category>
                <keyword>LED</keyword>
                <keyword>G32R430</keyword>
            </attributes>
        </example>
    </examples>
</package>
