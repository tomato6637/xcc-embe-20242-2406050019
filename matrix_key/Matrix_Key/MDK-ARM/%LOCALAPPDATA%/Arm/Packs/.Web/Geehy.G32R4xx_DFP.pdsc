                <file category="source" name="Device/Device/Geehy/G32R4xx/Source/startup_g32r430xx.c" attr="config" version="1.0.0" condition="G32R430 ARMCC"/>
                <!-- system file -->
                <file category="source" name="Device/Device/Geehy/G32R4xx/Source/system_g32r4xx.c" attr="config" version="1.0.0"/>
                <!-- device configuration required by drivers at the moment -->
