<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.57/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>PIC32CK-SG_DFP</name>
   <description overview="./OVERVIEW.md">Microchip PIC32CK-SG Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="1.10.278" date="2026-09-08">
        - Added an explicit .noinit (NOLOAD) output section to the GCC linker scripts and ARM Compiler (armcc) scatter files for all devices, so that variables placed in .noinit no longer cause objcopy binary output to be padded with the address gap between flash and RAM (DEVXML-8441).
      </release>
      <release version="1.9.276" date="2026-09-07">
        - Removed unused placeholder interrupt vector entries (ADC Reserved2-5, CAN0/CAN1 Reserved6/7, ETH, HSM Error/RX/TX, and index 154 Reserved) from PIC32CK-SG00 devices, which do not implement CAN, Ethernet, or Hardware Security Module peripherals.
        - Removed non-existent QOS4 bitfield from the DMA CTRLB register.
        - Split the shared CCL LUTCTRL INSEL bitfield into per-input INSEL0, INSEL1, and INSEL2 value groups.
        - Corrected ARM Cortex-M33 core module register definitions: removed MMFSR, BFSR, and UFSR (now represented only via CFSR), removed unimplemented auxiliary and peripheral ID registers, and corrected Debug Authentication Status Register bitfield and value-group naming.
        - Removed unimplemented Battery Backup Power Switch (BBPS), secondary I/O bank (VDDIOB) BOR, and eMMC/SD Host Controller extended-capability bitfields.
        - Corrected missing ADC and EIC pin signals, incorrect ADC channel-configuration bitfield masks, and removed nonexistent bitfields for PIC32CK1012SG00048.
        - Fixed missing source ATDF files for PIC32CK1012SG00 devices, correcting their generated XC32 configuration data.
        - Renamed TZ1_CE_Keyword0-3 debug variables to CE_Keyword0-3 in the PDSC and Keil debug configuration.
        - Updated header macros to use explicit (uint32_t) casts in value-to-mask assignments.
      </release>
      <release version="1.8.265" date="2026-08-19">
        - Fixed overlapping and missing bitfields in the CoreDebug DHCSR register for Cortex-M33 devices.
        - Removed incorrectly generated non-secure FPU instance header (fpu_ns.h).
        - Added additional linker script variants for alternative memory configurations (PFM flash, CMCC data RAM, EBI chip select, HSRAM retention).
        - Added Keil MDK-ARM toolchain support (flash loaders, debug configuration, and CMSIS-Toolbox csolution/cproject project templates).
      </release>
      <release version="1.7.233" date="2026-02-09">
        - Added CMSIS flash loaders.
        - Added TrustZone project template.
      </release>
      <release version="1.6.199" date="2025-07-15">
        - Enabled ICD4/5 and ICE4 to also support PIC32CK1012SG01048, PIC32CK1012SG01064, PIC32CK1012SG01100.
        </release>
      <release version="1.5.191" date="2025-04-23">
        - Added PIC32CK1012SG00048, PIC32CK1012SG01048, PIC32CK1012SG00064, PIC32CK1012SG01064, PIC32CK1012SG00100, and PIC32CK1012SG01100.
      </release>
      <release version="1.4.190" date="2025-04-15">
          - Added ARMCC scatter/linker script.
          - Added PIC32CK1025SG00144, and PIC32CK1025SG01144.
          - Removed USBHS module descriptor.
          - Added BSDAP module descriptor.
      </release>
      <release version="1.3.168" date="2024-04-23">
        - Added missing FUSE bitfield for EBI security attribute (MH3-91330).
      </release>
      <release version="1.2.161" date="2023-11-28">
          - Defined STIR register
          - Updated FUCFG11 and FUCFG12 registers bitfield for PIC32CK_SG FUSES.
          - Updated header file license to Apache 2.0.
      </release>
      <release version="1.1.156" date="2023-08-02">
          - Updated linkerscripts VECTOR_REGION to boot_rom.
          - Fixed interrupt naming for reserved vectors.
      </release>
      <release version="1.0.141" date="2023-04-05">Initial release.</release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>PIC32CK-SG</keyword>
      <keyword>Microcontrollers And Processors</keyword>
      <keyword>32-Bit Microcontrollers</keyword>
      <keyword>Security</keyword>
      <keyword>Connectivity</keyword>
      <keyword>Touch</keyword>
      <keyword>Automotive Recommended</keyword>
      <keyword>32-bit Microcontrollers</keyword>
   </keywords>
   <requirements>
      <packages>
         <package vendor="ARM" name="CMSIS"/>
      </packages>
   </requirements>
   <devices>
      <family Dfamily="PIC32CK-SG" Dvendor="Microchip:3">
         <debugvars version="1.0.0" configfile="keil/Debug/dbgconf/pic32cksg_gc.dbgconf">
            __var CE_Keyword0 = 0xFFFFFFFF;
            __var CE_Keyword1 = 0xFFFFFFFF;
            __var CE_Keyword2 = 0xFFFFFFFF;
            __var CE_Keyword3 = 0xFFFFFFFF;

            __var DHCSR_Addr = 0xE000EDF0;
            __var DEMCR_Addr = 0xE000EDFC;
            __var DSU_BASE_ADDR = 0x44000000;
            __var DSU_STATUSA_ADDR = 0x44000100;
            __var DSU_STATUSB_ADDR = 0x44000104;
            __var DSU_DAL_ADDR = 0x44000124;
            __var DSU_BCC0_ADDR = 0x44000110;
            __var DSU_BCC1_ADDR = 0x44000114;
            __var DSU_STATUSB_BCCD1_BIT = 0x2;
            __var DSU_STATUSB_BCCD0_BIT = 0x1;
            __var CRSTEXTBIT = 0x300;
            __var BREXTBIT = 0x30000; //BREXT bit in DSU STATUSA
            __var BOOTROM_STATUS_INITCHECK_OK = 0x3;
            __var BOOTROM_STATUS_BOOTOK = 0x4;
            __var BOOTROM_STATUS_OK = 0x9;
            __var BOOTROM_STATUS_CMD_VALID = 0x5;
            __var BOOTROM_STATUS_CHALLENGE = 0xB;

            __var FCW_BASE_ADDR = 0x44004000;
            __var FCW_CTRLA_ADDR = 0x44004000;
            __var FCW_CTRLB_ADDR = 0x44004004;
            __var FCW_INTFLAG_ADDR = 0x44004014;
            __var FCW_STATUS_ADDR = 0x44004018;
            __var FCW_KEY_ADDR = 0x4400401c;
            __var FCW_ADDR = 0x44004020;
            __var FCW_SRC_ADDR = 0x44004024;
            __var FCW_INTFLAG_CLEAR = 0x000030FF;

            __var FCW_LBWP_ADDR = 0x4400406C;
            __var FCW_UBWP_ADDR = 0x44004070;
            __var FCW_CWP_ADDR = 0x44004078;

            __var INTERACTIVE_CMD_PREFIX = 0x44424700;
            __var DEBUGGER_CMD_EXIT  = 0x444247AA;
            __var DEBUGGER_CMD_IMODE = 0x44424755;

            __var FCW_KEY_MSB = 0x91C32C00;
            __var FCW_KEY_WRKEY = 0x1;
            __var FCW_KEY_CFGKEY = 0x4;

            __var CMD_CE_ALL = 0xE2;

            __var ROW_SIZE = 1024;
            __var RAM_BUFFER = 0x20010000;

            __var DWT_COMP0_Addr = 0xE0001020;
            __var DWT_FUNCTION0_Addr = 0xE0001028;
            __var DWT_COMP1_Addr = 0xE0001030;
            __var DWT_FUNCTION1_Addr = 0xE0001038;

            __var CFG_MEM_ADDR = 0x0A000000;
            __var CFG_MEM_SIZE = 0x10000;
            __var BOOT_MEM_ADDR = 0x08000000;
            __var BOOT_MEM_SIZE = 0x20000;
        </debugvars>
         <sequences>
            <sequence name="ResetSystem">
               <block>
                    Sequence("DebugReset");
                </block>
            </sequence>
            <sequence name="ResetHardware">
               <block>
                    Sequence("DebugReset");
                </block>
            </sequence>
            <sequence name="ResetProcessor">
               <block>
                    Sequence("DebugReset");
                </block>
            </sequence>
            <sequence name="ResetCatchClear">
               <block>
                    Sequence("DisableDWT");
                </block>
            </sequence>
            <sequence name="EnableDWT">
               <block>
                    Write32(DEMCR_Addr, 0x01000000);                 // enable DWT
                    Write32(DWT_FUNCTION0_Addr, 0x00000412);         // DWT_FUNCTION0: DATAVSIZE - 2, ACTION - Debug Event, MATCH - Instrucion Address
                    Write32(DWT_FUNCTION1_Addr, 0x00000413);         // DWT_FUNCTION1: DATAVSIZE - 2, ACTION - Trigger only, MATCH - Instrucion Address Limit
                    Write32(DWT_COMP0_Addr,     0x08000000);         // DWT_COMP0: QS1 BFM starts here
                    Write32(DWT_COMP1_Addr,     0x0C400000);         // DWT_COMP1: Ending at much higher address just to support larger PFM size
                </block>
            </sequence>
            <sequence name="DisableDWT">
               <block>
                    Write32(DWT_FUNCTION0_Addr, 0x00000000);         // Clear DWT_FUNCTION0
                    Write32(DWT_FUNCTION1_Addr, 0x00000000);         // Clear DWT_FUNCTION1
                    Write32(DEMCR_Addr, 0x0);                        // disable DWT
                </block>
            </sequence>
            <sequence name="DebugReset">
               <block>
                    Sequence("ResetToPark");
                    Write32(DHCSR_Addr, 0xA05F0003);
                    Sequence("EnableDWT");
                    Sequence("ReleaseBREXT");
                </block>
            </sequence>
            <sequence name="DebugPortSetup">
               <block>
                    __var isSWJ    = ((__protocol &amp; 0x00010000) != 0);
                    __var protType = __protocol &amp; 0x0000FFFF;
                </block>
               <!-- JTAG Protocol -->
               <control if="protType == 1">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                        
                            // Execute SWJ-DP Switch Sequence SWD to JTAG (0xE73C)
                            // Change if SWJ-DP uses deprecated switch code (0xAEAE)
                            DAP_SWJ_Sequence(16, 0xE73C);
                        
                            // Ensure JTAG interface is reset
                            DAP_SWJ_Sequence(6, 0x3F);
                        </block>
                  </control>
                  <block>
                        // JTAG "Soft" Reset
                        DAP_JTAG_Sequence(6, 1, 0x3F);
                        DAP_JTAG_Sequence(1, 0, 0x01);
                    </block>
               </control>
               <!-- SWD Protocol -->
               <control if="protType == 2">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                        
                            // Execute SWJ-DP Switch Sequence JTAG to SWD (0xE79E)
                            // Change if SWJ-DP uses deprecated switch code (0xEDB6)
                            DAP_SWJ_Sequence(16, 0xE79E);
                        
                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3,  0x00);                // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <control if="!isSWJ">
                     <block>
                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3,  0x00);                // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <block>
                        // Read DPIDR to enable SWD interface (SW-DPv1 and SW-DPv2)
                        ReadDP(0x0);
                    </block>
               </control>
            </sequence>
            <sequence name="DebugPortStart">
               <block>
                    Sequence("DebugPortConnect");
                    Sequence("ResetToPark");
                    Write32(DHCSR_Addr, 0xA05F0003);
                </block>
            </sequence>
            <sequence name="DebugPortStop"/>
            <sequence name="DebugCoreStart"/>
            <sequence name="DebugCoreStop">
               <control if="Read32(0x08000004) != 0xFFFFFFFF">
                  <block>
                        Sequence("ResetToPark");
                        sequence("ReleaseBREXT");
                        Write32(DHCSR_Addr, 0xA05F0000);
                    </block>
               </control>
            </sequence>
            <sequence name="DebugPortConnect">
               <block>
                    __var SW_DP_ABORT  = 0x0;
                    __var DP_CTRL_STAT = 0x4;
                    __var DP_SELECT    = 0x8;
                    __var powered_down = 0;

                    // Switch to DP Register Bank 
                    WriteDP(DP_SELECT, 0x00000000);
                    
                    // Read DP CTRL/STAT Register and check if CSYSPWRUPACK and CDBGPWRUPACK bits are set
                    powered_down = ((ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000);
                </block>
               <control if="powered_down">
                  <block>
                        // Request Debug/System Power-Up
                        WriteDP(DP_CTRL_STAT, 0x50000000);
                    </block>
                  <!-- Wait for Power-Up Request to be acknowledged -->
                  <control while="(ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000"
                           timeout="1000000"/>
                  <!-- JTAG Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 1">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            // Additionally clear STICKYORUN, STICKYCMP, and STICKYERR bits by writing '1'
                            WriteDP(DP_CTRL_STAT, 0x50000F32);
                        </block>
                  </control>
                  <!-- SWD Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 2">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            WriteDP(DP_CTRL_STAT, 0x50000F00);
                        
                            // Clear WDATAERR, STICKYORUN, STICKYCMP, and STICKYERR bits of CTRL/STAT Register by write to ABORT register
                            WriteDP(SW_DP_ABORT, 0x0000001E);
                        </block>
                  </control>
                  <block>
                        // clear AP register cache
                        ReadAP(0);
                    </block>
               </control>
            </sequence>
            <sequence name="ResetExtension">
               <block>
                    __var nReset      = 0x80;
                    __var SWCLK_TCK   = 0x01;
                    DAP_SWJ_Pins(0, nReset, 1000);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(SWCLK_TCK, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 100);
                    DAP_SWJ_Pins(nReset, nReset, 1000);
                    
                    Sequence("DebugPortSetup");
                    Sequence("DebugPortConnect"); // ensure connect after reset extension
                </block>
               <control if="(__connection &amp; 0xF) == 0">
                  <block>
                        Message(0, "Failed to connect debugger after reset extension");
                    </block>
               </control>
            </sequence>
            <sequence name="ExitResetExtension">
               <block>
                    __var statusa = Read32(DSU_STATUSA_ADDR);
                </block>
               <control if="(statusa &amp; CRSTEXTBIT) == 0">
                  <block>
                        Message (0, "Device - could not enter reset extension");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write32(DSU_STATUSA_ADDR, CRSTEXTBIT);
                    Sequence("WaitBootROMStatusInitCheckOK");
                    Write32(DSU_BCC0_ADDR, DEBUGGER_CMD_EXIT);
                    Sequence("WaitBootROMStatusBootOK");
                    __var dal = Read32(DSU_DAL_ADDR);
                    dal = 3 &amp; dal;
                    Message(0, "DAL value: %X", dal);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="ResetToPark">
               <block>
                    Sequence("ResetExtension");
                    Sequence("ExitResetExtension");
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="ReleaseBREXT">
               <block>
                    Write32(DSU_STATUSA_ADDR, BREXTBIT);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="NVMBusy">
               <control while="(Read32(FCW_STATUS_ADDR) &amp; 0x00000001) != 0"
                        timeout="1000000"/>
               <block>
                    __var fcw_err_status = Read32(FCW_STATUS_ADDR);
                </block>
               <control if="fcw_err_status &amp; 0x0000217E">
                  <block>
                        Message(0, "FCW Error Status: 0x%08X", fcw_err_status);
                        __Result = -1;
                    </block>
               </control>
               <block>
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="EnterIMode">
               <block>
                    __var statusa = Read32(DSU_STATUSA_ADDR);
                </block>
               <control if="(statusa &amp; CRSTEXTBIT) == 0">
                  <block>
                        Message (0, "Device - could not enter reset extension");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write32(DSU_STATUSA_ADDR, CRSTEXTBIT);
                    Sequence("WaitBootROMStatusInitCheckOK");
                    Write32(DSU_BCC0_ADDR, DEBUGGER_CMD_IMODE);
                    Message(0, "EXEC BOOTROM Command: %08X", DEBUGGER_CMD_IMODE);
                    Sequence("WaitBootROMStatusCommandValid");
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="WaitBootROMStatusBootOK">
               <block>
                    __var reply = 0;
                </block>
               <control while="reply != BOOTROM_STATUS_BOOTOK" timeout="5000000">
                  <control while="(Read32(DSU_STATUSB_ADDR) &amp; DSU_STATUSB_BCCD1_BIT) == 0"
                           timeout="100000"/>
                  <block>
                        reply = Read32(DSU_BCC1_ADDR);
                    </block>
               </control>
               <control if="reply != BOOTROM_STATUS_BOOTOK">
                  <block>
                        Message(0, "Timeout waiting for BOOTROM BOOTOK");
                    </block>
               </control>
            </sequence>
            <sequence name="WaitBootROMStatusInitCheckOK">
               <block>
                    __var reply = 0;
                </block>
               <control while="reply != BOOTROM_STATUS_INITCHECK_OK" timeout="5000000">
                  <control while="(Read32(DSU_STATUSB_ADDR) &amp; DSU_STATUSB_BCCD1_BIT) == 0"
                           timeout="100000"/>
                  <block>
                        reply = Read32(DSU_BCC1_ADDR);
                    </block>
               </control>
               <control if="reply != BOOTROM_STATUS_INITCHECK_OK">
                  <block>
                        Message(0, "Timeout waiting for BOOTROM INITCHECK OK");
                    </block>
               </control>
            </sequence>
            <sequence name="WaitBootROMStatusChallenge">
               <block>
                    __var reply = 0;
                </block>
               <control while="reply != BOOTROM_STATUS_CHALLENGE" timeout="5000000">
                  <control while="(Read32(DSU_STATUSB_ADDR) &amp; DSU_STATUSB_BCCD1_BIT) == 0"
                           timeout="100000"/>
                  <block>
                        reply = Read32(DSU_BCC1_ADDR);
                    </block>
               </control>
               <control if="reply != BOOTROM_STATUS_CHALLENGE">
                  <block>
                        Message(0, "Timeout waiting for BOOTROM CHALLENGE");
                    </block>
               </control>
            </sequence>
            <sequence name="WaitBootROMStatusCommandValid">
               <block>
                    __var reply = 0;
                </block>
               <control while="reply != BOOTROM_STATUS_CMD_VALID" timeout="5000000">
                  <control while="(Read32(DSU_STATUSB_ADDR) &amp; DSU_STATUSB_BCCD1_BIT) == 0"
                           timeout="100000"/>
                  <block>
                        reply = Read32(DSU_BCC1_ADDR);
                    </block>
               </control>
               <control if="reply != BOOTROM_STATUS_CMD_VALID">
                  <block>
                        Message(0, "Timeout waiting for BOOTROM CMD VALID");
                    </block>
               </control>
            </sequence>
            <sequence name="WaitBootROMStatusOK">
               <block>
                    __var reply = 0;
                </block>
               <control while="reply != BOOTROM_STATUS_OK" timeout="5000000">
                  <control while="(Read32(DSU_STATUSB_ADDR) &amp; DSU_STATUSB_BCCD1_BIT) == 0"
                           timeout="100000"/>
                  <block>
                        reply = Read32(DSU_BCC1_ADDR);
                    </block>
               </control>
               <control if="reply != BOOTROM_STATUS_OK">
                  <block>
                        Message(0, "Timeout waiting for BOOTROM OK");
                    </block>
               </control>
            </sequence>
            <sequence name="FlashInit"/>
            <sequence name="FlashUninit"/>
            <sequence name="FlashEraseSector">
               <control if="!(CFG_MEM_ADDR &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= CFG_MEM_ADDR + CFG_MEM_SIZE)">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                        Write32(FCW_INTFLAG_ADDR, FCW_INTFLAG_CLEAR);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_CFGKEY));
                        Write32(FCW_LBWP_ADDR, 0x0);
                        Write32(FCW_INTFLAG_ADDR, FCW_INTFLAG_CLEAR);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_CFGKEY));
                        Write32(FCW_UBWP_ADDR, 0x0);

                        Write32(FCW_ADDR, __FlashAddr);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_WRKEY));
                        Write32(FCW_CTRLA_ADDR, 0x4);
                    </block>
                  <control while="(Read32(FCW_STATUS_ADDR) &amp; 0x1) != 0" timeout="1000000"/>
               </control>
            </sequence>
            <sequence name="FlashEraseChip">
               <block>
                    Sequence("ResetExtension");
                    Sequence("EnterIMode");
                    __var cmd = INTERACTIVE_CMD_PREFIX | CMD_CE_ALL;
                    Write32(DSU_BCC0_ADDR, cmd);
                    Message(0, "EXEC BOOTROM Command: %08X", cmd);
                    Sequence("WaitBootROMStatusCommandValid");
                </block>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x2) != 0">
                  <block>
                        __var challenge0 = Read32(DSU_BCC1_ADDR);
                        Message(0, "Receive Challenge: %08X", challenge0);
                        BufferSet(0, 0x0, 0x1, 4, challenge0);
                        DAP_Delay(1000);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x2) != 0">
                  <block>
                        __var challenge1 = Read32(DSU_BCC1_ADDR);
                        Message(0, "Receive Challenge: %08X", challenge1);
                        BufferSet(0, 0x4, 0x1, 4, challenge1);
                        DAP_Delay(1000);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x2) != 0">
                  <block>
                        __var challenge2 = Read32(DSU_BCC1_ADDR);
                        Message(0, "Receive Challenge: %08X", challenge2);
                        BufferSet(0, 0x8, 0x1, 4, challenge2);
                        DAP_Delay(1000);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x2) != 0">
                  <block>
                        __var challenge3 = Read32(DSU_BCC1_ADDR);
                        Message(0, "Receive Challenge: %08X", challenge3);
                        BufferSet(0, 0xC, 0x1, 4, challenge3);
                        DAP_Delay(1000);
                    </block>
               </control>
               <block> 
                    // set key to buffer
                    BufferSet(1, 0x0, 0x1, 4, CE_Keyword0);
                    BufferSet(1, 0x4, 0x1, 4, CE_Keyword1);
                    BufferSet(1, 0x8, 0x1, 4, CE_Keyword2);
                    BufferSet(1, 0xC, 0x1, 4, CE_Keyword3);

                    // print key to buffer
                    BufferStreamOut(1, 0x0, 0x10, "key.bin", 0x00, 0);
                    // add command to buffer
                    BufferSet(0, 0x10, 0x1, 4, cmd);
                    // print challenge message to buffer
                    BufferStreamOut(0, 0x0, 0x14, "msg.bin", 0x00, 0);

                    RunApplication("$S/keil/Utilities/hmac/hmac.exe", "key.bin msg.bin output.bin", "$P", 10000000);
                    BufferStreamIn(2, 0x0, 32, "output.bin", 0, 10000000);

                    __var respond0 = BufferGet(2, 0x0, 4);
                    __var respond1 = BufferGet(2, 0x4, 4);
                    __var respond2 = BufferGet(2, 0x8, 4);
                    __var respond3 = BufferGet(2, 0xC, 4);
                    __var respond4 = BufferGet(2, 0x10, 4);
                    __var respond5 = BufferGet(2, 0x14, 4);
                    __var respond6 = BufferGet(2, 0x18, 4);
                    __var respond7 = BufferGet(2, 0x1C, 4);
                </block>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond0);
                        Write32(DSU_BCC0_ADDR, respond0);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond1);
                        Write32(DSU_BCC0_ADDR, respond1);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond2);
                        Write32(DSU_BCC0_ADDR, respond2);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond3);
                        Write32(DSU_BCC0_ADDR, respond3);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond4);
                        Write32(DSU_BCC0_ADDR, respond4);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond5);
                        Write32(DSU_BCC0_ADDR, respond5);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond6);
                        Write32(DSU_BCC0_ADDR, respond6);
                    </block>
               </control>
               <control if="(Read32(DSU_STATUSB_ADDR) &amp; 0x1) == 0">
                  <block>
                        Message(0, "Write Respond: %08X", respond7);
                        Write32(DSU_BCC0_ADDR, respond7);
                    </block>
               </control>
               <block>
                    Sequence("WaitBootROMStatusCommandValid");
                    Sequence("WaitBootROMStatusOK");
                    Sequence("ResetToPark");
                    Write32(DHCSR_Addr, 0xA05F0003);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashEraseDone"/>
            <sequence name="FlashProgramPage">
               <block>
                    __var write_size = __FlashLen;
                    __var offset = 0;
                    Message(0, "Program Page: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                    write_size = (__FlashLen + 3) &amp; ~3;
                    Write32(FCW_INTFLAG_ADDR, FCW_INTFLAG_CLEAR);
                </block>
               <control if="CFG_MEM_ADDR &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= CFG_MEM_ADDR + CFG_MEM_SIZE">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                        Write32(FCW_INTFLAG_ADDR, FCW_INTFLAG_CLEAR);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_CFGKEY));
                        Write32(FCW_LBWP_ADDR, 0x0);
                        Write32(FCW_INTFLAG_ADDR, FCW_INTFLAG_CLEAR);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_CFGKEY));
                        Write32(FCW_UBWP_ADDR, 0x0);

                        Write32(FCW_ADDR, __FlashAddr);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_WRKEY));
                        Write32(FCW_CTRLA_ADDR, 0x4);
                    </block>
                  <control while="(Read32(FCW_STATUS_ADDR) &amp; 0x1) != 0" timeout="1000000"/>
                  <block>
                        __var fcw_cfm_val = Read32(FCW_CWP_ADDR);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_CFGKEY));
                        Write32(FCW_CWP_ADDR, (fcw_cfm_val &amp; 0xFFFFF000));
                    </block>
               </control>
               <control if="BOOT_MEM_ADDR &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= BOOT_MEM_ADDR + BOOT_MEM_SIZE">
                  <block>
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_CFGKEY));
                        Write32(FCW_LBWP_ADDR, 0x0);
                        Write32(FCW_UBWP_ADDR, 0x0);
                    </block>
               </control>
               <block>
                    Write8(RAM_BUFFER, 0);
                    FlashWriteBuffer(RAM_BUFFER, 0, write_size, (32 | 1));
                </block>
               <control while="offset &lt; write_size">
                  <block>
                        Write32(FCW_ADDR, __FlashAddr + offset);
                        Write32(FCW_SRC_ADDR, RAM_BUFFER + offset);
                        Write32(FCW_KEY_ADDR, (FCW_KEY_MSB | FCW_KEY_WRKEY));
                        Write32(FCW_CTRLA_ADDR, 0x3);
                        offset = offset + ROW_SIZE;
                    </block>
                  <control while="(Read32(FCW_STATUS_ADDR) &amp; 0x1) != 0" timeout="40000"/>
               </control>
               <block>
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashProgramDone"/>
         </sequences>
