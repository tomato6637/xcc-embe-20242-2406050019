   <examples>
      <example name="Trustzone"
               folder="templates/projects/trustzone-default"
               doc="README.txt">
         <description>Basic trustzone example containing a secure and a non-secure project</description>
         <project>
            <environment name="mplab"
                         folder="mplab"
                         load=".vscode/${projectName}-non_secure.mplab.json"/>
            <environment name="mplab"
                         folder="mplab"
                         load=".vscode/${projectName}-secure.mplab.json"/>
         </project>
      </example>
   </examples>
