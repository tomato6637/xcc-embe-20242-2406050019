<!-- ############## Definition of Conditions  -->
<conditions>
<!-- Condition for Cross compiler -->
<condition id="ARMCC Compiler">
  <require Tcompiler="ARMCC" Toptions="AC5"/>
</condition>

<!-- Condition for Family -->
<condition id="A33xxxx">
  <description> ABOV A33xxxx Family Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A33*"/>
</condition>

<!-- Condition for SubFamily -->
<condition id="A33G52x">
  <description> ABOV A33G52x Series Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A33G52[764]*"/>
</condition>
<condition id="A33M11x">
  <description> ABOV A33M11x Series Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A33M11[64]*"/>
</condition>
<condition id="A33G53x">
  <description> ABOV A33G53x Series Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A33G53[89]*"/>
</condition>

<!-- Condition for Family + CMSIS -->
<condition id="A33xxxx CMSIS">
  <description> ABOV A33xxxx Family Device and CMSIS-Core </description>
  <require condition="A33xxxx"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>

<!-- Condition for SubFamily + CMSIS -->
<condition id="A33G52x CMSIS">
  <description> ABOV A33G52x Series Device and CMSIS-Core </description>
  <require condition="A33G52x"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>
<condition id="A33M11x CMSIS">
  <description> ABOV A33M11x Series Device and CMSIS-Core </description>
  <require condition="A33M11x"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>
<condition id="A33G53x CMSIS">
  <description> ABOV A33G53x Series Device and CMSIS-Core </description>
  <require condition="A33G53x"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>

<!-- Condition for Family + Compiler -->
<!-- Condition for SubFamily + Compiler is not needed because only ARMCC is required for PACK -->
<condition id="A33xxxx ARMCC">
  <description> ABOV A33xxxx Family with ARMCC Compiler </description>
  <require condition="A33xxxx"/>
  <require condition="ARMCC Compiler"/>
</condition>

<!-- Condition for common components -->
<condition id="A33xxxx CMSIS CStartup">
  <description> Common components for A33xxxx family </description>
  <require condition="A33xxxx CMSIS"/>
  <require Cbundle="Platform" Cclass="Device" Cgroup="Startup"/>
</condition>
<condition id="A33xxxx Serial">
  <description> Common debug for A33xxxx family </description>
  <require condition="A33xxxx CMSIS CStartup"/>
  <accept Cbundle="Platform" Cclass="Device" Cgroup="Driver" Csub="HAL"/>
</condition>
</conditions>


<!-- ############## Definitions of Components -->
<components>
  <bundle Cbundle="Platform" Cclass="Device" isDefaultVariant="true" Cversion="1.0.0">
    <description> ABOV Solutions delivered thru. "Platform" </description>
    <doc></doc>

<!-- Component : Startup -->
    <component Cgroup="Startup" condition="A33xxxx CMSIS">
      <description> System Startup for A33xxxx family </description>
      <RTE_Components_h>
        #define RTE_DEVICE_STARTUP_A33XXXX    /* Device Startup for A33XXXX */
      </RTE_Components_h>

      <files>
        <file category="include" name="Framework/CMSIS/Device/ABOV/Include/"/>
        <file category="header" name="Framework/CMSIS/Device/ABOV/Include/system_a33xxxx.h"/>
        <file category="source" condition="A33xxxx ARMCC" name="Framework/CMSIS/Device/ABOV/Source/startup_a33xxxx.c"/>
        <file category="source" condition="A33xxxx ARMCC" name="Framework/CMSIS/Device/ABOV/Source/system_a33xxxx.c"/>
      </files>
    </component>

<!-- Component : HAL -->
    <component Cgroup="Driver" Csub="HAL" condition="A33xxxx CMSIS CStartup">
      <description> HAL </description>
      <RTE_Components_h>
        #define RTE_DEVICE_DRIVER_HAL
      </RTE_Components_h>
      <files>
        <file category="include" name="Platform/HAL/Include/"/>
        <file category="include" name="Platform/HAL/HPL/Include/"/>

        <file category="source" name="Platform/HAL/SCU/hal_scu.c"/>
        <file category="source" name="Platform/HAL/SCU/hal_scu_clk.c"/>
        <file category="source" name="Platform/HAL/PCU/hal_pcu.c"/>
        <file category="source" name="Platform/HAL/UART/hal_uart.c"/>
        <file category="source" name="Platform/HAL/HPL/DMA/hpl_dma.c"/>
        <file category="source" name="Platform/HAL/HPL/NMI/hpl_nmi.c"/>
      </files>
    </component>
  </bundle>

<!-- Component : Utility -->
  <component Cclass="Utility" Cgroup="Debug" Csub="Serial" Cversion="1.0.0" condition="A33xxxx Serial">
    <description> Utility Serial Debug Driver </description>
    <RTE_Components_h>
      #define RTE_UTILITY_DEBUG_COMMON
    </RTE_Components_h>
    <files>
      <file category="include" name="Platform/Library/ABOV/Debug/Include/"/>
      
