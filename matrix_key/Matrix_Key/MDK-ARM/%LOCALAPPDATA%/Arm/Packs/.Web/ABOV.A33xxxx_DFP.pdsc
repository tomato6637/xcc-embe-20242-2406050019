        <book name="https://www.abovsemi.com/document/viewer.php?file=1704963275.pdf&amp;d_it_id=1704963275&amp;fileName=STD10-UM_A33G53x_Eng.pdf"
              title="A33G53x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1706161683.pdf&amp;d_it_id=1706161683&amp;fileName=STD10-DS_A33G53x_Eng.pdf"
              title="A33G53x Data Sheet"/>

        <memory id="IRAM1" start="0x20000000" size="0x6000" init="0" default="1"/>
        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="3.0" m="5.5"/>
        <feature type="IntRC" n="16000000" name="HSI (High-Speed Internal Oscillator)"/>
        <feature type="IntRC" n="1000000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="64" name="NVIC"/>
        <feature type="Timer" n="10" m="16" name="Timer Module with 16bit resolution"/>
        <feature type="Timer" n="1" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="PWM" n="8" m="16" name="Pulse Width Modulation"/>
        <feature type="I2C" n="2" name="High-Speed I2C"/>
        <feature type="SPI" n="2" m="2000000" name="SPI Interface"/>
        <feature type="XTAL" n="4000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="XTAL" n="32768" m="32768" name="LSE (Low-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="UART" n="4" m="38400" name="UART Interface"/>
        <feature type="MemoryOther" n="1" name="32KB Data Flash Memory"/>

