          </variant>
          <variant Dvariant="A33G524RMN">
            <compile define="EXTRN_VARIANT_A33G524RMN"/>
            <feature type="QFP" n="64" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>
      </subFamily>    
      
<!-- Subfamily : A33M11x Series -->
      <subFamily DsubFamily="A33M11x Series">
        <processor Dclock="96000000"/>
        <compile header="ProductConfig/A33M11x/Config/a33m11x.h" Pdefine="EXTRN_SUBFAMILY_A33M11x"/>
        <debug svd="ProductConfig/A33M11x/SVD/a33m11x.svd"/>
        
        <book name="https://www.abovsemi.com/document/viewer.php?file=1594089147.pdf&amp;d_it_id=1594089147&amp;fileName=UM_A33M11x_Eng.pdf"
              title="A33M11x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1594088924.pdf&amp;d_it_id=1594088924&amp;fileName=DS_A33M11x_Eng.pdf"
              title="A33M11x Data Sheet"/>

        <memory id="IRAM1" start="0x20000000" size="0x4000" init="0" default="1"/>
        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="2.5" m="5.5"/>
        <feature type="IntRC" n="32000000" name="HSI (High-Speed Internal Oscillator)"/>
        <feature type="IntRC" n="500000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="86" name="NVIC"/>
        <feature type="Timer" n="8" m="16" name="Timer Module with 16bit resolution"/> 
        <feature type="Timer" n="1" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="PWM" n="2" m="16" name="Pulse Width Modulation"/>
        <feature type="I2C" n="2" name="High-Speed I2C"/>
        <feature type="SPI" n="2" m="24000000" name="SPI Interface"/>
        <feature type="XTAL" n="4000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="DMA" n="8" name="High-Speed DMA"/>
        <feature type="MemoryOther" n="1" name="32KB Data Flash Memory"/>
        <feature type="AnalogOther" n="1" name="CMP (Comparator)"/> 
        <feature type="AnalogOther" n="4" name="PGA (Programmable Gain Amplifier)"/>
        <feature type="Other" n="1" name="CRC"/>

<!-- Device : A33M116 -->
