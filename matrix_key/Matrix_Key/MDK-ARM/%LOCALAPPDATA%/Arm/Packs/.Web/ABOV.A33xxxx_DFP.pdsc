<examples>
<!-- Blinky GPIO-LED Example -->
  <example name="GPIO-LED Blinking" doc="Source/GpioLedBlinking/REF_Example.docx" folder="Example/">
    <description> GPIO-LED Blinking Example </description>
    <board name="STK-A33G527-VQN-A" vendor="ABOV"/>
    <project>
      <environment name="uv" load="Build/ARM/STK/stk.uvprojx"/>
    </project>
    <attributes>
      <component Cclass="CMSIS" Cgroup="CORE"/>
      <component Cclass="Device" Cgroup="Startup"/>
      <component Cclass="CMSIS" Cgroup="RTOS"/>
      <category> Getting Start with STK </category>
    </attributes>
  </example>
  
