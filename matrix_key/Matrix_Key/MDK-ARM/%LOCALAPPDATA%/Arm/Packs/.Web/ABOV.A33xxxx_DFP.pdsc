<?xml version="1.0" encoding="UTF-8"?>

<package schemaVersion="1.7.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>ABOV</vendor>
  <url>https://www.abov.co.kr/data/mds/PACK/</url>
  <name>A33xxxx_DFP</name>
  <supportContact>abov_fae@abov.co.kr</supportContact>
  <description>Package Descriptor about A33xxxx-Device support, Driver and Example</description>
  
  <releases>
    <release version="1.0.13" date="2026-07-29">
      * Changes
        - Supported Chipsets.
          * Cortex-M0+  : A31xxxx Series
            - A31C11x
    </release>
    <release version="1.0.12" date="2026-05-08">
      * Changes
        - Supported Chipsets.
          * Cortex-M0+  : A31xxxx Series
            - A31C14x
            - A31C21x
    </release>
  </releases>
  
<!-- keywords for indexing -->
  <keywords>
    <keyword>ABOV</keyword>
    <keyword>Device Family Package ABOV</keyword>
    <keyword>Cortex-M3</keyword>
    <keyword>A33xxxx</keyword>
    <keyword>A33G52x</keyword>
    <keyword>A33M11x</keyword>
    <keyword>A33G53x</keyword>
    <keyword>A33G527</keyword>
    <keyword>A33G526</keyword>
    <keyword>A33G524</keyword>
    <keyword>A33M116</keyword>
    <keyword>A33M114</keyword>
    <keyword>A33G538</keyword>
    <keyword>A33G539</keyword>
  </keywords>


<!-- ############## Definition of Devies -->
  <devices>
    <family Dfamily="A33xxxx Family" Dvendor="ABOV Semiconductor:126">
      <processor Dcore="Cortex-M3" DcoreVersion="r0p0" Dfpu="0" Dmpu="0" Dendian="Little-endian"/>
      <book name="https://developer.arm.com/documentation/dui0552/a" title="Cortex-M3 Generic User Guide"/>
      <description>
A33xxxx is a 32bit microcontroller family based on Cortex-M3 and combines ARM Cortex architecture and various peripherals available in platform.
It also provides low-power, real-time performance, advanced architecture and high performance and is also a good approach for cost-sensitive application especially.
      </description>
      <book name="Document/Doxygen/AUDK32.chm" title="ABOV Unified Development Kit 32bit (AUDK32)"/>
      <book name="https://abov.atlassian.net/wiki/spaces/AUDK32/pages/2070675457/CMSIS-Pack" title="AUDK32 CMSIS-Pack User Guide"/>

<!-- Subfamily : A33G52x Series -->
      <subFamily DsubFamily="A33G52x Series">
        <processor Dclock="75000000"/>
        <compile header="ProductConfig/A33G52x/Config/a33g52x.h" Pdefine="EXTRN_SUBFAMILY_A33G52x"/>
        <debug svd="ProductConfig/A33G52x/SVD/a33g52x.svd"/>
        
        <book name="https://www.abovsemi.com/document/viewer.php?file=1566811111.pdf&amp;d_it_id=1566811111&amp;fileName=UM_A33G52x_Eng.pdf"
              title="A33G52x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1566811682.pdf&amp;d_it_id=1566811682&amp;fileName=DS_A33G52x_Eng.pdf"
              title="A33G52x Data Sheet"/>

        <memory id="IRAM1" start="0x20000000" size="0x6000" init="0" default="1"/>
        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="3.0" m="5.5"/>
        <feature type="IntRC" n="16000000" name="HSI (High-Speed Internal Oscillator)"/>
        <feature type="IntRC" n="1000000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="64" name="NVIC"/>
        <feature type="Timer" n="10" m="16" name="Timer Module with 16bit resolution"/>
        <feature type="Timer" n="1" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="PWM" n="8" m="16" name="Pulse Width Modulation"/>
        <feature type="I2C" n="2" name="High-Speed I2C"/>
        <feature type="SPI" n="2" m="2000000" name="SPI Interface"/>
        <feature type="XTAL" n="4000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="XTAL" n="32768" m="32768" name="LSE (Low-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="UART" n="4" m="38400" name="UART Interface"/>
        <feature type="MemoryOther" n="1" name="32KB Data Flash Memory"/>

<!-- Device : A33G527 -->
        <device Dname="A33G527">
          <description>
384KB Code Flash and below H/W modules vary depending on package type.
  - IOs and ADC
  - For more information, refer ordering information in user manual.          
          </description>
          <memory id="IROM1" start="0x00000000" size="0x60000" startup="1" default="1"/>
          <algorithm name="ProductConfig/A33G52x/FPA/FLM/a33g52x_code.flm" start="0x00000000" size="0x60000" default="1" />
          
<!-- Variants -->
          <variant Dvariant="A33G527VQN">
            <compile define="EXTRN_VARIANT_A33G527VQN"/>
            <feature type="QFP" n="100" name="Metric Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A33G527VLN">
            <compile define="EXTRN_VARIANT_A33G527VLN"/>
            <feature type="QFP" n="100" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A33G527RLN">
            <compile define="EXTRN_VARIANT_A33G527RLN"/>
            <feature type="QFP" n="64" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>

<!-- Device : A33G526 -->
        <device Dname="A33G526">
          <description>
256KB Code Flash and below H/W modules vary depending on package type.
  - IOs and ADC
