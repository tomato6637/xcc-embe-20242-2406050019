          </variant>
          <variant Dvariant="A33G526VLN">
            <compile define="EXTRN_VARIANT_A33G526VLN"/>
            <feature type="QFP" n="100" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A33G526MMN">
            <compile define="EXTRN_VARIANT_A33G526MMN"/>
            <feature type="QFP" n="80" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A33G526MLN">
            <compile define="EXTRN_VARIANT_A33G526MLN"/>
            <feature type="QFP" n="80" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A33G526RLN">
            <compile define="EXTRN_VARIANT_A33G526RLN"/>
            <feature type="QFP" n="64" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A33G526RMN">
            <compile define="EXTRN_VARIANT_A33G526RMN"/>
            <feature type="QFP" n="64" name="Low-Profile QFP Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
        </device>
        
<!-- Device : A33G524 -->
        <device Dname="A33G524">
          <description>
128KB Code Flash and below H/W modules vary depending on package type.
  - IOs and ADC
  - For more information, refer ordering information in user manual.          
          </description>
          <memory id="IROM1" start="0x00000000" size="0x20000" startup="1" default="1"/>
