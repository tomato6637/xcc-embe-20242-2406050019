  <name>A31xxxx_DFP</name>
  <supportContact>abov_fae@abov.co.kr</supportContact>
  <description>Package Descriptor about A31xxxx-Device support, Driver and Example</description>
  
  <releases>
    <release version="1.0.13" date="2026-07-29">
      * Changes
        - Supported Chipsets.
          * Cortex-M0+  : A31xxxx Series
            - A31C11x
    </release>
    <release version="1.0.12" date="2026-05-08">
      * Changes
        - Supported Chipsets.
          * Cortex-M0+  : A31xxxx Series
            - A31C14x
            - A31C21x
    </release>
  </releases>
  
