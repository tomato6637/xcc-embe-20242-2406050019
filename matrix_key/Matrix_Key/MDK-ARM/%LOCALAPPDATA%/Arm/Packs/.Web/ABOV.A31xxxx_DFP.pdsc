<!-- ############## Definition of Conditions  -->
<conditions>
<!-- Condition for Cross compiler -->
<condition id="ARMCC Compiler">
  <require Tcompiler="ARMCC" Toptions="AC5"/>
</condition>

<!-- Condition for Family -->
<condition id="A31xxxx">
  <description> ABOV A31xxxx Family Devices </description>
  <require Dvendor="ABOV Semiconductor:126"  Dname="A31*"/>
</condition>

<!-- Condition for SubFamily -->
<condition id="A31G21x">
  <description> ABOV A31G21x Series Devices </description>
