<!-- ############## Definition of Devies -->
  <devices>
    <family Dfamily="A31xxxx Family" Dvendor="ABOV Semiconductor:126">
      <processor Dcore="Cortex-M0+" DcoreVersion="r0p0" Dfpu="0" Dmpu="0" Dendian="Little-endian"/>
      <book name="https://developer.arm.com/documentation/dui0662/b" title="Cortex-M0 Plus Generic User Guide"/>
      <description>
A31xxxx is a 32bit microcontroller family based on Cortex-M0+ and combines ARM Cortex architecture and various peripherals available in platform.
It also provides low-power, real-time performance, advanced architecture and high performance and is also a good approach for cost-sensitive application especially.
      </description>
      <book name="Document/Doxygen/AUDK32.chm" title="ABOV Unified Development Kit 32bit (AUDK32)"/>
      <book name="https://abov.atlassian.net/wiki/spaces/AUDK32/pages/2070675457/CMSIS-Pack" title="AUDK32 CMSIS-Pack User Guide"/>

<!-- Subfamily : A31G21x Series-->
      <subFamily DsubFamily="A31G21x Series">
        <processor Dclock="48000000"/>
        <compile header="ProductConfig/A31G21x/Config/a31g21x.h" Pdefine="EXTRN_SUBFAMILY_A31G21x"/>
        <debug svd="ProductConfig/A31G21x/SVD/a31g21x.svd"/>
        
        <book name="https://www.abovsemi.com/document/viewer.php?file=1669189573.pdf&amp;d_it_id=1669189573&amp;fileName=UM_A31G21x_Eng.pdf"
              title="A31G21x User Manual"/>
        <book name="https://www.abovsemi.com/document/viewer.php?file=1669189398.pdf&amp;d_it_id=1669189398&amp;fileName=DS_A31G21x_Eng.pdf"
              title="A31G21x Data Sheet"/>

        <memory id="IRAM1" start="0x20000000" size="0x1800" init="0" default="1"/>
        <feature type="PowerMode" n="3" name="Run, Sleep, Deep-Sleep"/>
        <feature type="VCC" n="1.8" m="5.5"/>
        <feature type="IntRC" n="32000000" name="HSI (High-Speed Internal Oscillator)"/>
        <feature type="IntRC" n="500000" name="LSI (Low-Speed Internal Oscillator)"/>
        <feature type="NVIC" n="32" name="NVIC"/>
        <feature type="Timer" n="4" m="16" name="Timer Module with 16bit resolution"/>
        <feature type="Timer" n="2" m="32" name="Timer Module with 32bit resolution"/>
        <feature type="WDT" n="1"/>
        <feature type="PWM" n="6" m="16" name="Pulse Width Modulation"/>
        <feature type="I2C" n="2" name="High-Speed I2C"/>
        <feature type="XTAL" n="2000000" m="16000000" name="HSE (High-Speed External Oscillator)"/>
        <feature type="XTAL" n="32768" m="32768" name="LSE (Low-Speed External Oscillator)"/>
        <feature type="PLL" n="1" name="Internal PLL"/>
        <feature type="DMA" n="4" name="High-Speed DMA"/>
        <feature type="UART" n="2" m="115200" name="UART Interface"/>
        <feature type="DAC" n="1" m="5"/>
        <feature type="Touch" n="24" name="Capacitive Touch Inputs"/>
        <feature type="Other" n="2" name="LED driver and CRC"/>

<!-- Device : A31G213 -->
        <device Dname="A31G213">
          <description>
64KB Code Flash and below H/W modules vary depending on package type.
  - IOs, SPI, ADC and USART
  - For more information, refer ordering information in user manual.          
          </description>
          <memory id="IROM1" start="0x00000000" size="0x10000" startup="1" default="1"/>
          <algorithm name="ProductConfig/A31G21x/FPA/FLM/a31g21x_code.flm" start="0x00000000" size="0x10000" default="1" />
          
<!-- Variants -->
          <variant Dvariant="A31G213CLN">
            <compile define="EXTRN_VARIANT_A31G213CLN"/>
            <feature type="QFP" n="48" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A31G213SQN">
            <compile define="EXTRN_VARIANT_A31G213SQN"/>
            <feature type="QFP" n="44" name="Metric Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A31G213KNN">
            <compile define="EXTRN_VARIANT_A31G213KNN"/>
            <feature type="QFP" n="32" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A31G213GRN">
            <compile define="EXTRN_VARIANT_A31G213GRN"/>
            <feature type="SOP" n="28" name="Thin Shrink Small Outline Package"/>
            <feature type="Temp" n="-40" m="85" name="Commercial Operating Temperature Range"/>
          </variant>
          <variant Dvariant="A31G213CL2N">
            <compile define="EXTRN_VARIANT_A31G213CL2N"/>
            <feature type="QFP" n="48" name="Low-profile Quad Flat Package"/>
            <feature type="Temp" n="-40" m="105" name="Industrial Operating Temperature Range"/>
