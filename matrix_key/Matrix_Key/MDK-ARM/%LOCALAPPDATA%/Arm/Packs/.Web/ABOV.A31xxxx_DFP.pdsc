<!-- Condition for Family + CMSIS -->
<condition id="A31xxxx CMSIS">
  <description> ABOV A31xxxx Family Device and CMSIS-Core </description>
  <require condition="A31xxxx"/>
  <require Cclass="CMSIS"  Cgroup="CORE"/>
</condition>

<!-- Condition for SubFamily + CMSIS -->
<condition id="A31G21x CMSIS">
  <description> ABOV A31G21x Series Device and CMSIS-Core </description>
