<!-- Condition for Family + Compiler -->
<!-- Condition for SubFamily + Compiler is not needed because only ARMCC is required for PACK -->
<condition id="A31xxxx ARMCC">
  <description> ABOV A31xxxx Family with ARMCC Compiler </description>
  <require condition="A31xxxx"/>
  <require condition="ARMCC Compiler"/>
</condition>

<!-- Condition for common components -->
<condition id="A31xxxx CMSIS CStartup">
  <description> Common components for A31xxxx family </description>
  <require condition="A31xxxx CMSIS"/>
  <require Cbundle="Platform" Cclass="Device" Cgroup="Startup"/>
</condition>
<condition id="A31xxxx Serial">
  <description> Common debug for A31xxxx family </description>
  <require condition="A31xxxx CMSIS CStartup"/>
  <accept Cbundle="Platform" Cclass="Device" Cgroup="Driver" Csub="HAL"/>
</condition>
</conditions>


<!-- ############## Definitions of Components -->
<components>
  <bundle Cbundle="Platform" Cclass="Device" isDefaultVariant="true" Cversion="1.0.0">
    <description> ABOV Solutions delivered thru. "Platform" </description>
    <doc></doc>

<!-- Component : Startup -->
    <component Cgroup="Startup" condition="A31xxxx CMSIS">
      <description> System Startup for A31xxxx family </description>
      <RTE_Components_h>
        #define RTE_DEVICE_STARTUP_A31XXXX    /* Device Startup for A31XXXX */
      </RTE_Components_h>

      <files>
        <file category="include" name="Framework/CMSIS/Device/ABOV/Include/"/>
        <file category="header" name="Framework/CMSIS/Device/ABOV/Include/system_a31xxxx.h"/>
        <file category="source" condition="A31xxxx ARMCC" name="Framework/CMSIS/Device/ABOV/Source/startup_a31xxxx.c"/>
        <file category="source" condition="A31xxxx ARMCC" name="Framework/CMSIS/Device/ABOV/Source/system_a31xxxx.c"/>
      </files>
    </component>

<!-- Component : HAL -->
    <component Cgroup="Driver" Csub="HAL" condition="A31xxxx CMSIS CStartup">
      <description> HAL </description>
      <RTE_Components_h>
        #define RTE_DEVICE_DRIVER_HAL
      </RTE_Components_h>
      <files>
        <file category="include" name="Platform/HAL/Include/"/>
        <file category="include" name="Platform/HAL/HPL/Include/"/>

        <file category="source" name="Platform/HAL/SCU/hal_scu.c"/>
        <file category="source" name="Platform/HAL/SCU/hal_scu_clk.c"/>
        <file category="source" name="Platform/HAL/PCU/hal_pcu.c"/>
        <file category="source" name="Platform/HAL/UART/hal_uart.c"/>
        <file category="source" name="Platform/HAL/USART/hal_usart.c"/>
        <file category="source" name="Platform/HAL/HPL/DMA/hpl_dma.c"/>
        <file category="source" name="Platform/HAL/HPL/NMI/hpl_nmi.c"/>
      </files>
    </component>
  </bundle>

<!-- Component : Utility -->
  <component Cclass="Utility" Cgroup="Debug" Csub="Serial" Cversion="1.0.0" condition="A31xxxx Serial">
    <description> Utility Serial Debug Driver </description>
    <RTE_Components_h>
      #define RTE_UTILITY_DEBUG_COMMON
    </RTE_Components_h>
    <files>
      <file category="include" name="Platform/Library/ABOV/Debug/Include/"/>
      
      <file category="source" name="Platform/Library/ABOV/Debug/Source/debug.c"/>
      <file category="source" name="Platform/Library/ABOV/Debug/Source/debug_cmd.c"/>
      <file category="source" name="Platform/Library/ABOV/Debug/Source/debug_hardfault.c"/>
      <file category="source" name="Platform/Library/ABOV/Debug/Source/debug_log.c"/>
      <file category="source" name="Platform/Library/ABOV/Debug/Source/debug_retarget.c"/>
      <file category="source" name="Platform/Library/ABOV/Debug/Source/debug_serial.c"/>
    </files>
  </component>

<!-- Bundle : Product Configuration -->
  <bundle Cbundle="ProductConfig" Cclass="Config" isDefaultVariant="true" Cversion="1.0.0">
    <description> Global Configuration for a Product </description>
    <doc></doc>

<!-- Component : Device Common -->
    <component Cgroup="Device" Csub="Common">
      <description> Device Common Configuration </description>
      <RTE_Components_h>
        #define RTE_PRODUCT_CONFIG_COMMON
      </RTE_Components_h>
      <files>
        <file category="source" name="ProductConfig/Config/abov_config.h" attr="config"/>
        <file category="source" name="ProductConfig/Config/abov_module.h" attr="config"/>
        <file category="source" name="ProductConfig/Config/abov_example_config.h" attr="config"/>
        
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31g21x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31xxxx.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31g11x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31g12x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31l21x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31l12x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31l22x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31g33x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31s13x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31g34x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31c14x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31c12x.sct" condition="A31xxxx ARMCC" attr="config"/>
        <file category="linkerScript" name="Framework/CMSIS/Device/ABOV/Source/ARM/ac5_a31c11x.sct" condition="A31xxxx ARMCC" attr="config"/>
      </files>
    </component>

