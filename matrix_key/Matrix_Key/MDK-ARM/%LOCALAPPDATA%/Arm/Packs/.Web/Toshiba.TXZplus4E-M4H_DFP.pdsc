<?xml version="1.0" encoding="UTF-8"?>

<package schemaVersion="1.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <license>License/SOFTWARE_LICENSE_AGREEMENT.txt</license> 
  <vendor>Toshiba</vendor>
  <url>https://toshiba.semicon-storage.com/content/dam/toshiba-ss-v3/master/en/semiconductor/product/dl/device-family-pack</url>
  <name>TXZplus4E-M4H_DFP</name>
  <description>Toshiba TXZ+4E Series TMPM4H Group Device Support</description>
  <releases>
    <release version="1.0.0" date="2026-02-16">
      First Release version of TXZ+4E Series Device Family Pack.
    </release>
  </releases>

  <keywords>
    <!-- keywords for indexing -->
    <keyword>Toshiba</keyword>
    <keyword>Device Support</keyword>
    <keyword>Device Family Package Toshiba</keyword>
    <keyword>TMPM4H</keyword>
    <keyword>TXZ+4E</keyword>
  </keywords>

  <devices>
    <family Dfamily="TXZ+4E Series" Dvendor="Toshiba:92">
      <processor Dcore="Cortex-M4" DcoreVersion="r0p1" Dfpu="1" Dmpu="1" Dendian="Little-endian"/>
      <description>
The TXZ+4E microcontroller series embeds an ARM Cortex-M4 core, which provides high code density and fast interrupt response times required for real-time applications.
      </description>
      <!-- ************************  Subfamily 'TMPM4Hx'  **************************** -->
      <subFamily DsubFamily="M4H">
        <!-- ***********************  Device 'TMPM4H4FYUG'  ************************* -->
        <device Dname="TMPM4H4FYUG">
          <processor Dclock="120000000"/>
          <compile header="Device/Include/TMPM4H4.h" define="TMPM4H4"/>
          <debug svd="SVD/M4H4.svd"/>
          <memory id="IROM1"                           start="0x00000000" size="0x00040000" startup="1" default="1"/>
          <memory id="IRAM1"                           start="0x20000000" size="0x00004800" init   ="0" default="1"/>
          <algorithm name="Flash/TMPM4Hx_code_256.FLM" start="0x00000000" size="0x00040000"  RAMstart="0x20000000"  RAMsize="0x2000"  default="1"/>

          <!--book name=""/-->
          <feature type="IOs"           n="51"                          name="I/O Ports (PORT)"/>
          <feature type="ExtInt"        n="16"                          name="External interrupt (INT)"/>
          <feature type="CoreOther"     n="11"                          name="Digital Noise Filter (DNF)"/>
          <feature type="DMA"           n="32"                          name="Direct Memory Access Controllor (DMAC)"/>
          <feature type="Timer"         n="6"      m="32"               name="32bit Timer Event counter (T32A)"/>

          <feature type="UART"          n="4"                           name="Universal Asynchronous Receiver Transmitter (UART)"/>
          <feature type="I2C"           n="1"                           name="Inter-Integrated Circuit (I2C)"/>
          <feature type="I2C"           n="1"                           name="Inter-Integrated Circuit Version A(EI2C)"/>
          <feature type="SPI"           n="4"                           name="Toshiba Serial Peripheral Interface (TSPI/SIO)"/>

          <feature type="ADC"           n="12"     m="12"               name="Analog to Digital Converter (ADC)"/>

          <feature type="CoreOther"     n="1"                           name="Programmable Motor Driver Plus (PMD+)"/>

          <feature type="PowerOther"    n="1"                           name="Low-Voltage Detector (LVD)"/>
          <feature type="WDT"           n="1"                           name="Selectable clock Watch dog timer (SIWDT)"/>
          <feature type="Other"         n="1"                           name="Oscillation Frequency Detector (OFD)"/>
          <feature type="PowerOther"    n="1"                           name="Power-on Reset Circuit (POR)"/>

          <feature type="VCC"           n="2.70"   m="5.50"/>
          <feature type="Temp"          n="-40"    m="105"/>
          <feature type="QFP"           n="64"                          name="P-LQFP64-1010-0.50-003"/>
        </device>
        <!-- ********************************************************************************************* -->
        <!-- ***********************  Device 'TMPM4H2FYDUG'  ************************* -->
        <device Dname="TMPM4H2FYDUG">
          <processor Dclock="120000000"/>
          <compile header="Device/Include/TMPM4H2.h" define="TMPM4H2"/>
          <debug svd="SVD/M4H2.svd"/>
          <memory id="IROM1"                           start="0x00000000" size="0x00040000" startup="1" default="1"/>
          <memory id="IRAM1"                           start="0x20000000" size="0x00004800" init   ="0" default="1"/>
          <algorithm name="Flash/TMPM4Hx_code_256.FLM" start="0x00000000" size="0x00040000"  RAMstart="0x20000000"  RAMsize="0x2000"  default="1"/>

          <!--book name=""/-->
          <feature type="IOs"           n="37"                          name="I/O Ports (PORT)"/>
          <feature type="ExtInt"        n="12"                          name="External interrupt (INT)"/>
          <feature type="CoreOther"     n="10"                          name="Digital Noise Filter (DNF)"/>
          <feature type="DMA"           n="27"                          name="Direct Memory Access Controllor (DMAC)"/>
          <feature type="Timer"         n="6"      m="32"               name="32bit Timer Event counter (T32A)"/>

          <feature type="UART"          n="3"                           name="Universal Asynchronous Receiver Transmitter (UART)"/>
          <feature type="I2C"           n="1"                           name="Inter-Integrated Circuit (I2C)"/>
          <feature type="I2C"           n="1"                           name="Inter-Integrated Circuit Version A(EI2C)"/>
          <feature type="SPI"           n="2"                           name="Toshiba Serial Peripheral Interface (TSPI/SIO)"/>

          <feature type="ADC"           n="10"     m="12"               name="Analog to Digital Converter (ADC)"/>

          <feature type="CoreOther"     n="1"                           name="Programmable Motor Driver Plus (PMD+)"/>

          <feature type="PowerOther"    n="1"                           name="Low-Voltage Detector (LVD)"/>
          <feature type="WDT"           n="1"                           name="Selectable clock Watch dog timer (SIWDT)"/>
          <feature type="Other"         n="1"                           name="Oscillation Frequency Detector (OFD)"/>
          <feature type="PowerOther"    n="1"                           name="Power-on Reset Circuit (POR)"/>

          <feature type="VCC"           n="2.70"   m="5.50"/>
          <feature type="Temp"          n="-40"    m="105"/>
          <feature type="QFP"           n="48"                          name="P-LQFP48-0707-0.50-002"/>
        </device>
        <!-- ********************************************************************************************* -->
        <!-- ***********************  Device 'TMPM4H1FYUG'  ************************* -->
        <device Dname="TMPM4H1FYUG">
          <processor Dclock="120000000"/>
          <compile header="Device/Include/TMPM4H1.h" define="TMPM4H1"/>
          <debug svd="SVD/M4H1.svd"/>
          <memory id="IROM1"                           start="0x00000000" size="0x00040000" startup="1" default="1"/>
          <memory id="IRAM1"                           start="0x20000000" size="0x00004800" init   ="0" default="1"/>
          <algorithm name="Flash/TMPM4Hx_code_256.FLM" start="0x00000000" size="0x00040000"  RAMstart="0x20000000"  RAMsize="0x2000"  default="1"/>

          <!--book name=""/-->
          <feature type="IOs"           n="33"                          name="I/O Ports (PORT)"/>
          <feature type="ExtInt"        n="11"                          name="External interrupt (INT)"/>
          <feature type="CoreOther"     n="9"                           name="Digital Noise Filter (DNF)"/>
          <feature type="DMA"           n="27"                          name="Direct Memory Access Controllor (DMAC)"/>
          <feature type="Timer"         n="6"      m="32"               name="32bit Timer Event counter (T32A)"/>

          <feature type="UART"          n="3"                           name="Universal Asynchronous Receiver Transmitter (UART)"/>
          <feature type="I2C"           n="1"                           name="Inter-Integrated Circuit (I2C)"/>
          <feature type="I2C"           n="1"                           name="Inter-Integrated Circuit Version A(EI2C)"/>
          <feature type="SPI"           n="2"                           name="Toshiba Serial Peripheral Interface (TSPI/SIO)"/>

          <feature type="ADC"           n="9"      m="12"               name="Analog to Digital Converter (ADC)"/>

          <feature type="CoreOther"     n="1"                           name="Programmable Motor Driver Plus (PMD+)"/>

          <feature type="PowerOther"    n="1"                           name="Low-Voltage Detector (LVD)"/>
          <feature type="WDT"           n="1"                           name="Selectable clock Watch dog timer (SIWDT)"/>
          <feature type="Other"         n="1"                           name="Oscillation Frequency Detector (OFD)"/>
          <feature type="PowerOther"    n="1"                           name="Power-on Reset Circuit (POR)"/>

          <feature type="VCC"           n="2.70"   m="5.50"/>
          <feature type="Temp"          n="-40"    m="105"/>
          <feature type="QFP"           n="44"                          name="P-LQFP44-1010-0.80-003"/>
        </device>
        <!-- ********************************************************************************************* -->
      </subFamily>

    </family>
  </devices>

  <conditions>
    <!-- Compiler Conditions -->
    <condition id="TMPM4H Compiler">
      <accept condition="Compiler ARMCC"/>
    </condition>
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="TMPM4H4x CMSIS">
      <description>Toshiba TMPM4H4x Devices and CMSIS-CORE</description>
      <require Dvendor="Toshiba:92" Dname="TMPM4H4*"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
    <condition id="TMPM4H2x CMSIS">
      <description>Toshiba TMPM4H2x Devices and CMSIS-CORE</description>
      <require Dvendor="Toshiba:92" Dname="TMPM4H2*"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
    <condition id="TMPM4H1x CMSIS">
      <description>Toshiba TMPM4H1x Devices and CMSIS-CORE</description>
      <require Dvendor="Toshiba:92" Dname="TMPM4H1*"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
  </conditions>

  <components>
    <!-- Startup TMPM4H4x -->
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="TMPM4H4x CMSIS">
      <description>System Startup for Toshiba TMPM4H4x Devices</description>
      <files>
        <file category="include"      name="Device/Include/" condition="TMPM4H Compiler"/>
        <file category="source"       name="Device/Source/ARM/startup_TMPM4H4.s" attr="config" version="1.0.0" condition="Compiler ARMCC"/>
        <file category="source"       name="Device/Source/system_TMPM4Hx.c"      attr="config" version="1.0.0" condition="TMPM4H Compiler"/>
      </files>
    </component>

    <!-- Startup TMPM4H2x -->
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="TMPM4H2x CMSIS">
      <description>System Startup for Toshiba TMPM4H2x Devices</description>
      <files>
        <file category="include"      name="Device/Include/" condition="TMPM4H Compiler"/>
        <file category="source"       name="Device/Source/ARM/startup_TMPM4H2.s"  attr="config" version="1.0.0" condition="Compiler ARMCC"/>
        <file category="source"       name="Device/Source/system_TMPM4Hx.c"       attr="config" version="1.0.0" condition="TMPM4H Compiler"/>
      </files>
    </component>

    <!-- Startup TMPM4H1x -->
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="TMPM4H1x CMSIS">
      <description>System Startup for Toshiba TMPM4H1x Devices</description>
      <files>
        <file category="include"      name="Device/Include/" condition="TMPM4H Compiler"/>
        <file category="source"       name="Device/Source/ARM/startup_TMPM4H1.s" attr="config" version="1.0.0" condition="Compiler ARMCC"/>
        <file category="source"       name="Device/Source/system_TMPM4Hx.c"      attr="config" version="1.0.0" condition="TMPM4H Compiler"/>
      </files>
    </component>
  </components>

</package>
