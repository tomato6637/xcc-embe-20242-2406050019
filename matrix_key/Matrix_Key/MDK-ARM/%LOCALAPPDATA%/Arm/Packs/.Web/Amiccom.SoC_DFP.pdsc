    </family>

    <!-- ************************  Family 'BLE Series'  **************************** -->
    <family Dfamily="BLE Series"     Dvendor="Amiccom:147">
      <description>The BLE SoC Series 32-bit microcontroller</description>
      <device Dname="A8107M0">
        <processor  Dcore="Cortex-M0" Dclock="16000000"/>
        <compile    header="Device/A8107M0/Device/include/A8107M0.h"/>
        <!--debug      svd="SVD/A8107M.svd"/-->
        <description>
          A8107M0 is a high performance and low cost 2.4GHz FSK/GFSK system-on-chip (SoC) wireless transceiver. With on chip fraction-N synthesizer, it is designed for Bluetooth Low Energy (Bluetooth 5.0/5.1/5.2/5.3/5.4 Single mode). Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x40000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x08000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/AMC1_F8.FLM"     start="0x00000000"  size="0x40000"                   default="1"/>
        <book       name="Documents\A8107M0 Datasheet v1.9.pdf"            title="A8107M0 Datasheet"/>
        <feature    type="IOs"      n="31"/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="3"		m="8"/>
        <feature    type="SPI"  	n="1"		m="4-16"/>
        <feature	type="I2C"  	n="1"/>
        <feature    type="PWM"  	n="4"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="48"/>
      </device>
	  
	  <device Dname="A3107M0">
        <processor  Dcore="Cortex-M0" Dclock="16000000"/>
        <compile    header="Device/A3107M0/Device/include/A3107M0.h"/>
        <!--debug      svd="SVD/A3107M.svd"/-->
        <description>
          A3107M0 is a high performance and low cost 2.4GHz FSK/GFSK system-on-chip (SoC) wireless transceiver. With on chip fraction-N synthesizer, it is designed for Bluetooth Low Energy (Bluetooth 5.0 Single mode, master or slave role).Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x40000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x08000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/A3107M0.FLM"     start="0x00000000"  size="0x40000"                   default="1"/>
        <book       name="Documents\A3107M0 Datasheet v0.5(Preliminary).pdf"              title="A3107M0 Datasheet"/>
        <feature    type="IOs"      n="31"/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="3"		m="8"/>
        <feature    type="SPI"  	n="1"		m="4-16"/>
        <feature    type="I2C"  	n="1"/>
        <feature    type="PWM"  	n="4"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="48"/>
      </device>
	  
