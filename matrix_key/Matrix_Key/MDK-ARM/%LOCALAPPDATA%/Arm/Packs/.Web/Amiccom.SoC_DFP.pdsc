        <feature    type="UART"  	n="3"		m="8"/>
        <feature    type="SPI"  	n="3"		m="4-16"/>
        <feature    type="I2C"  	n="1"		/>
        <feature    type="PWM"  	n="7"		m="8"/>
        <feature    type="VCC"      n="2.2"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="40"/>
      </device>	
	  
