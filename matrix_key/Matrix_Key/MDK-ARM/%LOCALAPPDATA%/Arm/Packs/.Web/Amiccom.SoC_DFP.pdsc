<?xml version="1.0" encoding="utf-8"?>
<package schemaVersion="1.4" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>Amiccom</vendor>
  <url>http://www.amiccom.com.tw/download/Amiccom_DeviceFamilyPack/</url>
  <name>SoC_DFP</name>
  <description>Amiccom ARM Cortex-M0/Cortex-M4 Device Family Pack Support</description>

  <releases>
	<release version="0.2.4" date="2026-03-16">
      Update A3107M0, A3117M0, A8107M0, A8125M0, A8137M0.
	  Add A8106M0, A8131M0, A9129M0, A9136M4, A9139M0, A9146M4, A9159M0
    </release>
    <release version="0.2.3" date="2020-07-28">
      Rename A8125M0 FLM file
    </release>
	<release version="0.2.2" date="2019-04-09">
      Update A3107M0, A3117M0 FLM files
    </release>
		<release version="0.2.1" date="2019-01-17">
      Remove SVD
    </release>
		<release version="0.2.0" date="2019-01-15">
      Add A3107M0, A3117M0, A8125M0 devices
    </release>
		<release version="0.1.5" date="2018-02-26">
      Correct the A8137M0 include file
    </release>
    <release version="0.1.4" date="2018-01-12">
      Update A8137M0 files
    </release>
    <release version="0.1.3" date="2018-01-04">
      Update A8107M0 files
    </release>
    <release version="0.1.2" date="2017-12-07">
      First Release version of Amiccom Device Family Pack.
    </release>
  </releases>

  <keywords>
    <!-- keywords for indexing -->
    <keyword>Amiccom</keyword>
    <keyword>Device Support</keyword>
    <keyword>Device Family Package Amiccom</keyword>
    <keyword>2.4G</keyword>
    <keyword>BLE</keyword>
    <keyword>Sub1G</keyword>
    <keyword>A8137M0</keyword>
    <keyword>A8107M0</keyword>
	<keyword>A3107M0</keyword>
    <keyword>A3117M0</keyword>
	<keyword>A8125M0</keyword>
	<keyword>A8106M0</keyword>
	<keyword>A8131M0</keyword>
	<keyword>A9129M0</keyword>
	<keyword>A9136M4</keyword>
	<keyword>A9139M0</keyword>
	<keyword>A9146M4</keyword>
	<keyword>A9159M0</keyword>
  </keywords>

  <devices>
    <!-- ************************  Family '2.4GHz Series'  **************************** -->
    <family Dfamily="2.4GHz Series"  Dvendor="Amiccom:147">
      <description>The 2.4GGHz SoC Series 32-bit microcontroller</description>
      <device Dname="A8137M0">
        <processor  Dcore="Cortex-M0" Dclock="16000000"/>
        <compile    header="Device/A8137M0/Device/include/register_A8137M0.h"/>
        <!--debug      svd="SVD/A8137M.svd"/-->
        <description>
          A8137M0 is a high performance and low cost 2.4GHz ISM band FSK/DSSS wireless SoC. It integrates M0 micro controller,128/256/512KBytes flash memory and 32KBytes SRAM.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x80000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x08000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/A3137M0F9.FLM"  start="0x00000000"  size="0x10000"                   default="1"/>
        <book       name="Documents\A81C37M0 Datasheet v0.0 (Objective).pdf"           title="A8137M0 Datasheet"/>
        <feature    type="IOs"      n="23"		/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="3"		/>
        <feature    type="SPI"  	n="3"		/>
        <feature    type="I2C"  	n="1"		/>
        <feature    type="PWM"  	n="7"		m="8"/>
        <feature    type="VCC"      n="2.2"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="40"		/>
      </device>
	  
	  <device Dname="A8125M0">
        <processor  Dcore="Cortex-M0" Dclock="16000000"/>
        <compile    header="Device/A8125M0/Device/include/A8125M.h"/>
        <!--debug      svd="SVD/A8125M.svd"/-->
        <description>
          A8125M0 is a high performance and low cost 2.4GHz ISM band FSK/GFSK wireless SoC. It integrates M0 micro controller, 128KBytes flash memory and 32KBytes SRAM.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x20000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x08000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/A8125M0.FLM"     start="0x00000000"  size="0x10000"                   default="1"/>
        <book       name="Documents\A8125M0 Datasheet v1.0.pdf"           title="A8125M0 Datasheet"/>
        <feature    type="IOs"      n="24"		/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="3"		/>
        <feature    type="SPI"  	n="2"		/>
        <feature    type="I2C"  	n="1"		/>
        <feature    type="PWM"  	n="8"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="48"		/>
      </device>
	  
	  <device Dname="A8106M0">
        <processor  Dcore="Cortex-M0" Dclock="16000000"/>
        <compile    header="Device/A8106M0/Device/include/A8106M0.h"/>
		
        <description>
          A8106M0 is a high performance and low cost 2.4GHz ISM band FSK wireless SoC.It integrates M0 micro controller, 128/256KBytes flash memory and 32KBytes SRAM.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x40000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x08000"     init   ="0"   default="1"/>
