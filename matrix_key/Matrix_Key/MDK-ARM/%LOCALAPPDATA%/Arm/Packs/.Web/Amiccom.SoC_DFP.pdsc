	<!-- ************************  Family 'Sub1G Series'  **************************** -->
    <family Dfamily="Sub1G Series"     Dvendor="Amiccom:147">
      <description>The Sub1G Series 32-bit microcontroller</description>
      <device Dname="A9129M0">
	    <processor  Dcore="Cortex-M0" Dclock="19200000"/>
        <compile    header="Device/A9129M0/Device/include/A9129M0.h"/>
        <!--debug      svd="SVD/A8107M.svd"/-->
        <description>
          A9129M0 is a high performance and low cost Sub1GHz ISM band system-on-chip (SoC) wireless transceiver. This device integrates ARM Cortex M0 processor, 128KBytes In-system programmable flash memory, 16KB SRAM, various powerful functions and excellent performance of Sub1GHz GFSK/FSK transceiver. A9129M0 has various operating modes, making it highly suited for systems where ultra-low power consumption is required. A9129M0 has an 8bit ADC for RSSI and 8 channel 12bit ADC for general purpose. Three kinds of serial communication port (SPI, I2C and UART) can interact with other devices.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x20000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x04000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/A9129M0.FLM"     start="0x00000000"  size="0x20000"                   default="1"/>
        <book       name="Documents\A9129M0 Datasheet v0.8(Preliminary).pdf"            title="A9129M0 Datasheet"/>
        <feature    type="IOs"      n="22"/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="2"		m="8"/>
        <feature    type="SPI"  	n="1"		m="4-16"/>
        <feature	type="I2C"  	n="1"/>
        <feature    type="PWM"  	n="4"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="40"/>
      </device>
	  
      <device Dname="A9139M0">
	    <processor  Dcore="Cortex-M0" Dclock="19200000"/>
        <compile    header="Device/A9139M0/Device/include/A9139M0.h"/>
        <!--debug      svd="SVD/A8107M.svd"/-->
        <description>
          A9139M0 is a high performance and low cost Sub1GHz ISM band system-on-chip (SoC) wireless transceiver. This device integrates ARM Cortex M0 processor, 128KBytes In-system programmable flash memory, 16KB SRAM, various powerful functions and excellent performance of Sub1GHz GFSK/FSK transceiver. A9139M0 has various operating modes, making it highly suited for systems where ultra-low power consumption is required. A9139M0 has an 8bit ADC for RSSI and 8 channel 12bit ADC for general purpose. Three kinds of serial communication port (SPI, I2C and UART) can interact with other devices.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x20000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x04000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/A9139M0.FLM"     start="0x00000000"  size="0x20000"                   default="1"/>
        <book       name="Documents\A9139M0 Datasheet v0.5(Preliminary).pdf"            title="A9139M0 Datasheet"/>
        <feature    type="IOs"      n="22"/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="2"		m="8"/>
        <feature    type="SPI"  	n="1"		m="4-16"/>
        <feature	type="I2C"  	n="1"/>
        <feature    type="PWM"  	n="4"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="40"/>
      </device>	

      <device Dname="A9159M0">
	    <processor  Dcore="Cortex-M0" Dclock="19200000"/>
        <compile    header="Device/A9159M0/Device/include/A9139M0.h"/>
        <!--debug      svd="SVD/A8107M.svd"/-->
        <description>
          A9159M0 is a high performance and low cost Sub1GHz ISM band system-on-chip (SoC) wireless transceiver. This device integrates ARM Cortex M0 processor, 128KBytes In-system programmable flash memory, 16KB SRAM, various powerful functions and excellent performance of Sub1GHz GFSK/FSK/DSSS transceiver. A9159M0 has various operating modes, making it highly suited for systems where ultra-low power consumption is required. A9159M0 has an 8bit ADC for RSSI and 8 channel 12bit ADC for general purpose. Three kinds of serial communication port (SPI, I2C and UART) can interact with other devices.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x20000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x04000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/A9139M0.FLM"     start="0x00000000"  size="0x20000"                   default="1"/>
        <book       name="Documents\A9159M0 Datasheet v0.2(Preliminary).pdf"            title="A9159M0 Datasheet"/>
        <feature    type="IOs"      n="22"/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="2"		m="8"/>
        <feature    type="SPI"  	n="1"		m="4-16"/>
        <feature	type="I2C"  	n="1"/>
        <feature    type="PWM"  	n="4"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="40"/>
      </device>

      <device Dname="A9136M4">
	    <processor  Dcore="Cortex-M4" Dclock="32000000"/>
        <compile    header="Device/A9136M4/Device/include/AMS2502.h"/>
        <!--debug      svd="SVD/A8107M.svd"/-->
        <description>
          A9136M4 is a monolithic low-IF architecture CMOS FSK/4FSK/OOK SOC for wireless applications in the 315/433/868/915MHz ISM bands. It integrates M4F micro controller, 512KBytes/1536KBytes flash memory, 80KBytes SRAM, and various powerful functions. This device is especially suitable for battery-powered application and Wi-SUN application.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x80000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x14000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/M4_SoC_CODE_V100.FLM"     start="0x00000000"  size="0x58000"                   default="1"/>
		<algorithm  name="Flash/M4_SoC_DATA_V100.FLM"     start="0x00058000"  size="0x28000"                   default="1"/>
        <book       name="Documents\A9136M4 Datasheet v1.0.pdf"            title="A9136M4 Datasheet"/>
        <feature    type="IOs"      n="22"/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="2"		m="8"/>
        <feature    type="SPI"  	n="1"		m="4-16"/>
        <feature	type="I2C"  	n="1"/>
        <feature    type="PWM"  	n="4"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="40"/>
      </device>

      <device Dname="A9146M4">
	    <processor  Dcore="Cortex-M4" Dclock="32000000"/>
        <compile    header="Device/A9146M4/Device/include/AMS2502.h"/>
        <!--debug      svd="SVD/A8107M.svd"/-->
        <description>
          A9146M4 is a high performance and low cost Wi-SUN SoC. It integrates M4F micro controller, 512/1536KBytes flash memory, 80KBytes SRAM and various powerful functions.A9146M4 is a SoC contains low-IF architecture CMOS FSK/GFSK TRX for wireless applications in the 839~847/868/915MHz ISM bands. This device is especially suitable for battery-powered application and the 915MHz wireless AMR (Auto Meter Reading) and 868.3MHz wireless M-bus in Europe. For Wi-SUN and IEEE 802.15.4g applications, A9146M4 also built in HW 802.15.4g packet handling and HW-accelerated IEEE 802.15.4 compliant MAC features.Please contact AMICCOM’s FAE for more details.
        </description>
        <memory     id="IROM1"                   start="0x00000000"  size="0x80000"     startup="1"   default="1"/>
        <memory     id="IRAM1"                   start="0x20000000"  size="0x14000"     init   ="0"   default="1"/>
        <algorithm  name="Flash/M4_SoC_CODE_V100.FLM"     start="0x00000000"  size="0x58000"                   default="1"/>
		<algorithm  name="Flash/M4_SoC_DATA_V100.FLM"     start="0x00058000"  size="0x28000"                   default="1"/>
        <book       name="Documents\A9146M4 Datasheet v0.2(Preliminary).pdf"            title="A9146M4 Datasheet"/>
        <feature    type="IOs"      n="22"/>
        <feature    type="Timer"  	n="2"		m="32"/>
        <feature    type="UART"  	n="2"		m="8"/>
        <feature    type="SPI"  	n="1"		m="4-16"/>
        <feature	type="I2C"  	n="1"/>
        <feature    type="PWM"  	n="4"		m="8"/>
        <feature    type="VCC"      n="2.0"    	m="3.6"/>
        <feature    type="Temp"     n="-40"     m="85"/>
        <feature    type="QFN"      n="40"/>
      </device>
	  
    </family>
	
  </devices>

  <conditions>
    <condition id="Compiler ARM">
      <!-- conditions selecting ARM Compiler -->
      <require Tcompiler="ARMCC"/>
    </condition>
    <condition id="Amiccom CMSIS Device">
      <!-- conditions selecting Devices -->
      <description>Amiccom ARM Cortex-M0/Cortex-M4 Devices and CMSIS-CORE</description>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <accept Dvendor="Amiccom:147"  Dname="A8107M0"/>
      <accept Dvendor="Amiccom:147"  Dname="A8137M0"/>
			<accept Dvendor="Amiccom:147"  Dname="A3107M0"/>
			<accept Dvendor="Amiccom:147"  Dname="A3117M0"/>
			<accept Dvendor="Amiccom:147"  Dname="A8125M0"/>
			<accept Dvendor="Amiccom:147"  Dname="A8106M0"/>
			<accept Dvendor="Amiccom:147"  Dname="A8131M0"/>
			<accept Dvendor="Amiccom:147"  Dname="A9129M0"/>
			<accept Dvendor="Amiccom:147"  Dname="A9139M0"/>
