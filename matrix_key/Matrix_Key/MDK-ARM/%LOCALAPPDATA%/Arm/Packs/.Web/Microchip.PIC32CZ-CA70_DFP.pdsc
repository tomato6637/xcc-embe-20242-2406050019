         <algorithm name="keil/Flash/PIC32CZ_x70_GPNVM.FLM"
                    start="0x1FFFFFF0"
                    size="0x00000010"
                    RAMstart="0x20400000"
                    RAMsize="0x00040000"
                    default="1"
                    style="Keil"/>
