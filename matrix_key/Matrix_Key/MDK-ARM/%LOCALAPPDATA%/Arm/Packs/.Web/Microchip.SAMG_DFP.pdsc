                     <mchp:file name="samg55/hwtools/sdm/sdmCompilers.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmDebuggerMap.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmICD3.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmICD4.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmICD5.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmICE4.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmRealICE.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmRealICE4.xml"/>
                     <mchp:file name="samg55/hwtools/sdm/sdmSimulator.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="persfr">
                     <mchp:file name="samg55/hwtools/persfr/arm32.persfr"/>
                  </mchp:hwtool>
                  <mchp:prerequisite component="MPLAB X IDE" version="[5.40-"/>
                  <mchp:prerequisite component="MPLAB XC32" version="[4.10-"/>
               </mchp:extension>
            </environment>
            <description>Cortex-M4 Microcontroller, 512KB Flash, 160KB SRAM, 120 MHz</description>
            <book name="https://www.microchip.com/en-us/product/ATSAMG55J19"
                  title="Device page for ATSAMG55J19"/>
            <book name="https://www.microchip.com/en-us/product/ATSAMG55J19#Documentation"
                  title="Datasheet"/>
            <book name="https://developer.arm.com/documentation/dui0553"
                  title="Cortex-M4 Devices Generic User Guide"/>
            <feature type="NVIC" n="50"/>
            <feature type="WDT" n="1"/>
            <feature type="MPSerial" n="8"/>
            <feature type="SPI" n="8"/>
            <feature type="I2C" n="8"/>
            <feature type="USART" n="8"/>
            <feature type="RTC" n="1"/>
            <feature type="Timer" n="2"/>
            <feature type="Memory" n="524288" name="IFLASH"/>
            <feature type="Memory" n="163840" name="IRAM"/>
            <feature type="VCC" n="1.62" m="3.6"/>
            <feature type="Temp" n="-40" m="105"/>
            <feature type="QFN" n="64"/>
            <feature type="QFP" n="64"/>
         </device>
      </family>
   </devices>
