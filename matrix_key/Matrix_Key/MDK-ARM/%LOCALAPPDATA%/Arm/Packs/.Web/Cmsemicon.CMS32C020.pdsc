<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.4" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>Cmsemicon</vendor>
  <name>CMS32C020</name>
  <description>Cmsemicon CMS32C020 Device Family Pack</description>
  <url>http://www.mcu.com.cn/pack/</url>

  <releases>
    <release version="0.1.5">
      Modified dataflash code.
    </release>
    <release version="0.1.4">
      Modified SPI code for flash.
    </release>
    <release version="0.1.3">
      Modified ADC and ACMP code.
    </release>
    <release version="0.1.2">
      Added temperature demo
      Modified SCI IIC and FLASH code.
    </release>
    <release version="0.1.1">
      Modified the LVD detect voltage.
    </release>
    <release version="0.1.0">
      Initial Version
    </release>
  </releases>
  <keywords>
    <!-- keywords for indexing -->
    <keyword>Cmsemicon</keyword>
    <keyword>CMS32C020</keyword>
  </keywords>
  <!-- devices section (mandatory for Device Family Packs) -->
  <devices>
    <family Dfamily="M0+ Series" Dvendor="Cmsemicon:161">
      <!-- *************************  Sub Family 'CMS32C020'  ***************************** -->
      <subFamily DsubFamily="CMS32C020">
        <processor Dcore="Cortex-M0+" DcoreVersion="r0p1" Dfpu="0" Dmpu="1" Dendian="Little-endian" Dclock="48000000"/>
        <description>
          The CMS32C020 device family contains an ARM Cortex-M0+ processor, running up to 48 MHz with a versatile set of on-chip peripherals.
        </description>
        <compile  header="Device/Include/CMS32C020.h"/>
        <debug    svd="SVD/CMS32C020.svd"/>
        <algorithm  name="Flash/CMS32C020_DataFlash.FLM"    start="0x00500200"  size="0x00400"     default="1"/>
        <feature 	type="VCC"    		      n="1.8" 	      m="5.5"/>
        <feature 	type="Temp"          	  n="-40"     	  m="105"/>
        <feature 	type="DMA"          	  n="4"     	                    name="Enhanced DMA"/>
        <feature 	type="IntRC"            n="48000000"     	  name="Internal RC Oscillator with +/- 1% accuracy"/>
        <feature 	type="WDT"              n="1"/>
        <feature 	type="PowerMode"        n="2"                           name=" Sleep, Deep-Sleep"/>
        <feature 	type="PowerOther"       n="1"                           name="POR"/>
        <feature 	type="ADC"              n="22"          m="12"          name="High-Accuracy ADC"/>
        <feature 	type="I2C"              n="1"                           name="Full Function I2C"/>
        <feature 	type="I2C"              n="1"                           name="Simplified I2C"/>
        <feature 	type="SPI"              n="1"                           name="3-wire SPI"/>
        <feature 	type="UART"             n="1"/>
        <feature 	type="LIN"              n="1"/>
        <feature 	type="Timer"            n="5"           m="16"          name="General Purpose Timer (TIM4)"/>
        <feature 	type="ACMP"            n="2"                               name="ACMP"/>
        <feature 	type="WWDG"            n="1"                              name="General Purpose WWDG"/>
       <!-- *************************  Device 'CMS32C020DC20NB'  ***************************** -->
        <device Dname="CMS32C020DC20NB">
          <description>
            Code Flash: 32KB,  Data Flash: 1KB,  RAM: 4KB
            Package: 20-lead QFN(3x3mm, 0.4mm pitch)
          </description>
          <memory     name="IROM1"  access="rx"       start="0x00000000"  size="0x08000"     startup="1"   default="1"/>
          <memory     name="IRAM0"  access="rw"       start="0x20000000"  size="0x01000"     init   ="0"   default="1"/>
          <algorithm  name="Flash/CMS32C020.FLM"    start="0x00000000"  size="0x08000"     default="1"/>
	      <feature    type="QFN"            n="20"                        name="3x3mm, 0.4mm pitch QFN"/>
        </device>
        <!-- *************************  Device 'CMS32C020DC24SS'  ***************************** -->
        <device Dname="CMS32C020DC24SS">
          <description>
            Code Flash: 32KB,  Data Flash: 1KB,  RAM: 4KB
            Package: 24-lead SSOP(8.65x3.9mm, 0.635mm pitch)
          </description>
            <memory     name="IROM1"  access="rx"       start="0x00000000"  size="0x08000"     startup="1"   default="1"/>
          <memory     name="IRAM0"  access="rw"       start="0x20000000"  size="0x01000"     init   ="0"   default="1"/>
          <algorithm  name="Flash/CMS32C020.FLM"    start="0x00000000"  size="0x08000"     default="1"/>
	      <feature    type="SSOP"            n="24"                        name="8.65x3.9mm, 0.635mm pitch SSOP"/>
        </device>
       <!-- *************************  Device 'CMS32C020DC24NA'  ***************************** -->
        <device Dname="CMS32C020DC24NA">
          <description>
            Code Flash: 32KB,  Data Flash: 1KB,  RAM: 4KB
            Package: 24-lead QFN(4x4mm, 0.5mm pitch)
          </description>
          <memory     name="IROM1"  access="rx"       start="0x00000000"  size="0x08000"     startup="1"   default="1"/>
          <memory     name="IRAM0"  access="rw"       start="0x20000000"  size="0x01000"     init   ="0"   default="1"/>
          <algorithm  name="Flash/CMS32C020.FLM"    start="0x00000000"  size="0x08000"     default="1"/>
	      <feature    type="QFN"            n="24"                        name="4x4mm, 0.5mm pitch QFN"/>
        </device>
      </subFamily>
    </family>
  </devices>
  <!-- examples section (optional for all Software Packs)-->
  <examples>
    <example name="Blinky" doc="README" folder="Examples/Blinky/MDK">
      <description>Sample project</description>
      <board name="CMS32C020_EVB" vendor="Cmsemicon"/>
      <project>
        <environment name="uv" load="Blinky.uvprojx"/>
      </project>
      <attributes>
        <component Cclass="CMSIS" Cgroup="CORE"/>
        <component Cclass="Device" Cgroup="Startup"/>
        <component Cclass="Device" Cgroup="ISR"/>
      </attributes>
    </example>
  </examples>
  
  <!-- conditions section (optional for all Software Packs)-->
  <conditions>
    <condition id="CMS32C020 CMSIS-CORE">
      <!-- conditions selecting Devices -->
      <description>Cmsemicon CMS32C020 Series devices and CMSIS-CORE</description>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Dvendor="Cmsemicon:161" Dname="CMS32C020*"/>
    </condition>
    <condition id="Startup ARM">
      <description>Startup assembler file for ARMCC</description>
      <require Tcompiler="ARMCC"/>
    </condition>
    <condition id="Startup GCC">
      <description>Startup assembler file for GCC</description>
      <require Tcompiler="GCC"/>
    </condition>
    <condition id="Startup IAR">
      <description>Startup assembler file for IAR</description>
      <require Tcompiler="IAR"/>
    </condition>
  </conditions>
  
  <!-- component section (optional for all Software Packs)-->
  <components>
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="CMS32C020 CMSIS-CORE">
      <description>System Startup for Cmsemicon CMS32C020 Series</description>
      <files>
        <!--  include folder -->
        <file category="include" name="Device/Include/"/>
        <!--file category="header" name="Device/Source/userdefine.h"  attr="config" version="1.0.0"/-->

        <file category="source"  name="Device/Source/ARM/startup_CMS32C020.s" attr="config" condition="Startup ARM" version="1.0.0"/>
        <file category="source"  name="Device/Source/GCC/startup_CMS32C020.S" attr="config" condition="Startup GCC" version="1.0.0"/>
        <file category="source"  name="Device/Source/IAR/startup_CMS32C020.s" attr="config" condition="Startup IAR" version="1.0.0"/>

        <file category="source"  name="Device/Source/system_CMS32C020.c"  attr="config" version="1.0.0"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="ISR" Cversion="1.0.0" condition="CMS32C020 CMSIS-CORE">
      <description>Interrupt Server Handler for Cmsemicon CMS32C020 Series</description>
      <files>
        <!--  include folder -->
        <file category="source"  name="Device/Source/isr_CMS32C020.c"  attr="config" version="1.0.0"/>
      </files>
    </component>
  </components>
  
</package>
