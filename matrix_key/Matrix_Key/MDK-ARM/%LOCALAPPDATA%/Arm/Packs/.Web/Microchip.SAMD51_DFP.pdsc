            <compile header="samd51a/include/sam.h" define="__SAMD51P20A__"/>
            <debug svd="samd51a/svd/ATSAMD51P20A.svd"/>
            <memory name="FLASH"
                    start="0x00000000"
                    size="0x100000"
                    access="rx"
                    default="1"
                    startup="1"/>
            <memory name="HSRAM"
                    start="0x20000000"
                    size="0x40000"
                    default="1"
                    access="rwx"/>
            <memory name="SDHC1" start="0x46000000" size="0xC00" access="rwp"/>
            <trace>
               <serialwire/>
               <traceport width="0xB"/>
            </trace>
            <algorithm name="samd51a/keil/Flash/SAMD51_1024.FLM"
                       start="0x00000000"
                       size="0x100000"
                       RAMstart="0x20000000"
                       RAMsize="0x40000"
                       default="1"
                       style="Keil"/>
