         <memory name="HSRAM_ETB" start="0x20000000" size="0x8000" access="rwx"/>
         <memory name="HSRAM_RET1" start="0x20000000" size="0x8000" access="rwx"/>
         <memory name="BKUPRAM" start="0x47000000" size="0x2000" access="rwx"/>
         <memory name="CMCC" start="0x03000000" size="0x1000000" access="rwp"/>
         <memory name="CMCC_DATARAM"
                 start="0x3000000"
                 size="0x1000"
                 access="rwp"/>
         <memory name="CMCC_TAGRAM" start="0x3001000" size="0x400" access="rwp"/>
         <memory name="CMCC_VALIDRAM" start="0x3002000" size="0x40" access="rwp"/>
         <memory name="HPB0" start="0x40000000" size="0x4400" access="rwp"/>
         <memory name="HPB1" start="0x41000000" size="0x22000" access="rwp"/>
         <memory name="HPB2" start="0x42000000" size="0x3C00" access="rwp"/>
         <memory name="HPB3" start="0x43000000" size="0x3000" access="rwp"/>
         <memory name="SEEPROM" start="0x44000000" size="0x20000" access="rwp"/>
         <memory name="SDHC0" start="0x45000000" size="0xC00" access="rwp"/>
         <memory name="PPB" start="0xE0000000" size="0x100000" access="rwp"/>
         <memory name="SCS" start="0xE000E000" size="0x00001000" access="rwp"/>
         <debugport __dp="0">
            <swd/>
         </debugport>
         <feature type="NVIC" n="137"/>
         <feature type="DMA" n="32"/>
         <feature type="RNG" n="2"/>
         <feature type="ExtInt" n="16"/>
         <feature type="WDT" n="1"/>
         <feature type="USBD" n="1" name="Full-Speed USB Device"/>
         <feature type="USBH" n="1" name="Full-Speed USB Host"/>
         <feature type="RTC" n="1"/>
         <feature type="DAC" n="2" m="12"/>
         <feature type="Crypto" n="128.256" name="AES Hardware Accelerator"/>
         <feature type="PLL" n="2"/>
         <feature type="Memory" n="32768" name="HSRAM_ETB"/>
         <feature type="Memory" n="32768" name="HSRAM_RET1"/>
         <feature type="Memory" n="8192" name="BKUPRAM"/>
         <feature type="VCC" n="1.71" m="3.63"/>
         <feature type="Temp" n="-40" m="125"/>
         <feature type="AnalogOther" n="2" name="Analog Comparator"/>
         <feature type="USBD" n="1" name="Full Speed"/>
         <feature type="I2S" n="1"/>
         <feature type="TempSens" n="1"/>
         <feature type="ComOther" n="1" name="QSPI"/>
         <device Dname="ATSAMD51G18A">
            <processor Dcore="Cortex-M4"
                       Dendian="Little-endian"
                       Dmpu="MPU"
                       Dfpu="SP_FPU"
                       Ddsp="NO_DSP"
                       Dtz="NO_TZ"
                       Dmve="NO_MVE"
                       Dclock="120000000"
                       DcoreVersion="r0p1"/>
            <debugconfig default="swd" clock="2000000"/>
            <compile header="samd51a/include/sam.h" define="__SAMD51G18A__"/>
            <debug svd="samd51a/svd/ATSAMD51G18A.svd"/>
            <memory name="FLASH"
                    start="0x00000000"
                    size="0x40000"
                    access="rx"
                    default="1"
                    startup="1"/>
            <memory name="HSRAM"
                    start="0x20000000"
                    size="0x20000"
                    default="1"
                    access="rwx"/>
            <trace>
               <serialwire/>
            </trace>
            <algorithm name="samd51a/keil/Flash/SAMD51_256.FLM"
                       start="0x00000000"
                       size="0x40000"
                       RAMstart="0x20000000"
                       RAMsize="0x20000"
                       default="1"
                       style="Keil"/>
            <environment name="atmel">
               <at:extension xmlns:at="http://www.atmel.com/schemas/pack-device-atmel-extension"
                             schemaVersion="1.0"
                             xsi:schemaLocation="http://www.atmel.com/schemas/pack-device-atmel-extension PACK.DEVICE.ATMEL.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/at/1.0/PACK.DEVICE.ATMEL.EXTENSION.xsd-->
                  <at:atdf name="samd51a/atdf/ATSAMD51G18A.atdf"/>
                  <at:variant ordercode="SAMD51G18A-MU"
                              vccmin="1.71"
                              vccmax="3.63"
                              tempmin="-40"
                              tempmax="85"/>
                  <at:variant ordercode="SAMD51G18A-MF"
                              vccmin="1.71"
                              vccmax="3.63"
                              tempmin="-40"
                              tempmax="125"/>
                  <at:variant ordercode="SAMD51G18A-MZ"
                              vccmin="1.71"
                              vccmax="3.63"
                              tempmin="-40"
                              tempmax="125"/>
                  <at:memory name="FLASH"
                             start="0x00000000"
                             size="0x40000"
                             type="flash"
                             pagesize="512"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="SW0"
                             start="0x00800080"
                             size="0x10"
                             type="fuses"
                             rw="R"
