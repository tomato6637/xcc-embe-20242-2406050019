<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.57/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>SAMD51_DFP</name>
   <description overview="./OVERVIEW.md">Microchip SAMD51 Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="3.9.276" date="2026-06-11">
                - Added Apache 2.0 license file.
                - Added CMSIS flash loaders for Keil.
                - Added ARMCC scatter/linker files for all memory variants.
                - Added ARMCC startup files.
                - Added GCC linker variants for bkupram, hsram_etb, hsram_ret1, and qspi memory configurations.
                - Added IAR linker variants for bkupram, hsram_etb, hsram_ret1, and qspi memory configurations.
                - Added IAR device configuration files.
                - Added XC32 startup configuration files.
                - Updated all C headers with Apache 2.0 license.
                - Updated flash and sram linker scripts for GCC, IAR, and ARMCC.
                - Updated project templates with license headers.
                - Updated SVD files.
            </release>
      <release version="3.8.246" date="2024-04-18">CMCC_Configure() function added to startup code.</release>
      <release version="3.7.237" date="2023-04-18">
                - Fixed DSU_DID__FAMILY naming
                - Defined SMARTEEPROM and NOSMARTEEPROM values for NVMCTRL_PARAM__SEE
                - Fixed SISR registers initial value
                - Defined APSR register
                - Updated debugger scripts for EDBG, Atmel-ICE and JLink support
        </release>
      <release version="3.6.120" date="2022-03-17">
                - Headers minor version increased to v2.1.0.
                - Changed integer constant literal macros from _Ux_ to _UNITxx_ (where xx is 32, 16 or 8) (MISRA C2012:R12.2).
            </release>
      <release version="3.5.95" date="2021-04-26">Hold in reset supported for JLink. Updated MPLAB X debug scripts.</release>
      <release version="3.4.91" date="2021-02-08">Added instance headers. Added support for security bit in MPLAB X. Added multiplex value groups for PMUXE and PMUXO.</release>
      <release version="3.3.76" date="2020-10-09">Added read device ID. Updated MPLAB X debug scripts. Fix the program/debug error when chip is secured.</release>
      <release version="3.2.55" date="2020-02-12">Added value-groups for SERCOM module. Updated XC32 content. Updated MPLAB X debug scripts.</release>
      <release version="3.1.41" date="2019-10-03">Updated captions and registers in CCL. Added XC32 content. Updated programming and debugging scripts.</release>
      <release version="3.0.29" date="2019-04-09">Fixed bug EDBG/Atmel-ICE programming &gt;8kB flash. Removed legacy headers.</release>
      <release version="2.0.15" date="2019-02-12">Fix: Modes in SVD, Value-group for USER_FUSES, define in GCLK. Succeeds Atmel.SAMD51_DFP 1.1.96. Added python programming and debugging scripts for MPLAB X.</release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>SAMD51</keyword>
      <keyword>Microcontrollers and Processors</keyword>
      <keyword>32-bit Microcontrollers</keyword>
      <keyword>Automotive Recommended</keyword>
      <keyword>Functional Safety Ready</keyword>
   </keywords>
