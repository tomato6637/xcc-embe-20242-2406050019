                  title="AN_42728 - AT15004:Using SAM-BA for Linux on SAM Devices"/>
            <feature type="ADC" n="32" m="12"/>
            <feature type="SPI" n="8"/>
            <feature type="I2C" n="8"/>
            <feature type="USART" n="8"/>
