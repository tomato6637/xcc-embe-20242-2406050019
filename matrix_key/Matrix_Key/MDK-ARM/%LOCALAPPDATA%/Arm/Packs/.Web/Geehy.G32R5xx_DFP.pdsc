    </keywords>
    <devices>
        <family Dfamily="G32R5xx Series" Dvendor="Geehy:163">
            <description>Geehy Semiconductor G32R5xx Series Device Support. Arm Cortex-M52 based real-time control MCU with Zidian math extension and Helium/MVE.</description>
<!-- ************************  Subfamily 'G32R501'  **************************** -->
            <subFamily DsubFamily="G32R501">
                <debugconfig default="swd" clock="10000000"/>
                <sequences>
                    <sequence name="DebugCoreStart">
                        <block>
                            Write32(0xE0059004, DbgMCU_CTRL);            // Set DBGMCU_CTRL
                            Write32(0xE0059030, DbgMCU_APB1CFG0);        // Set DBGMCU_APB1CFG0
                            Write32(0xE0059034, DbgMCU_APB1CFG1);        // Set DBGMCU_APB1CFG1
                            Write32(0xE0059038, DbgMCU_APB2CFG0);        // Set DBGMCU_APB2CFG0
                            Write32(0xE005903C, DbgMCU_APB2CFG1);        // Set DBGMCU_APB2CFG1
                            Write32(0xE0059040, DbgMCU_AHB1CFG0);        // Set DBGMCU_AHB1CFG0
                            Write32(0xE0059044, DbgMCU_AHB1CFG1);        // Set DBGMCU_AHB1CFG1
                        </block>
                    </sequence>
                    <sequence name="ResetSystem">
                        <control if="(__ap == 0)">
                            <block>
                                // System Control Space (SCS) offset as defined in Armv6-M/Armv7-M.
                                __var SCS_Addr   = 0xE000E000;
                                __var AIRCR_Addr = SCS_Addr + 0xD0C;
                                __var DHCSR_Addr = SCS_Addr + 0xDF0;

                                // Execute SYSRESETREQ via AIRCR
                                Write32(AIRCR_Addr, 0x05FA0004);
                            </block>
                            <!-- Reset Recovery: Wait for DHCSR.S_RESET_ST bit to clear on read -->
                            <control while="(Read32(DHCSR_Addr) &amp; 0x02000000)" timeout="500000"/>
                        </control>
                    </sequence>
                </sequences>
                <!--*************************  Device 'G32R501DVY'  ***************************** -->
                <device Dname="G32R501DVY">
                    <processor Pname="CPU0" Dcore="Cortex-M52" DcoreVersion="r0p1" Dmpu="MPU" Dfpu="DP_FPU" Dmve="FP_MVE" Dpacbti="PACBTI" Ddsp="DSP" Dcdecp="0x01" Dtz="NO_TZ" Dendian="Configurable" Dclock="200000000"/>
                    <processor Pname="CPU1" Dcore="Cortex-M52" DcoreVersion="r0p1" Dmpu="MPU" Dfpu="DP_FPU" Dmve="FP_MVE" Dpacbti="PACBTI" Ddsp="DSP" Dcdecp="0x01" Dtz="NO_TZ" Dendian="Configurable" Dclock="200000000"/>
                    <debug Pname="CPU0" __ap="0" svd="SVD/G32R501.svd"/>
                    <debug Pname="CPU1" __ap="1" svd="SVD/G32R501.svd"/>
                    <debugvars configfile="Drivers/device_support/g32r501/common/Debug/g32r501.dbgconf">
                        __var DbgMCU_CTRL     = 0x00000000;
                        __var DbgMCU_APB1CFG0 = 0x00000000;
                        __var DbgMCU_APB1CFG1 = 0x00000000;
                        __var DbgMCU_APB2CFG0 = 0x00000000;
                        __var DbgMCU_APB2CFG1 = 0x00000000;
                        __var DbgMCU_AHB1CFG0 = 0x00000001;
                        __var DbgMCU_AHB1CFG1 = 0x00000001;
                    </debugvars>
                    <!-- *************************  Shared Flash Memory  ***************************** -->
                    <memory name="Flash" access="rx" start="0x08000000" size="0x000A0000" default="1" startup="1"/>
                    <!-- *************************  Shared SRAM Memory  ***************************** -->
                    <memory name="SRAM1" access="rwx" start="0x20100000" size="0x00002000" default="1" init="0"/>
                    <memory name="SRAM2" access="rwx" start="0x20200000" size="0x00002000" default="1" init="0"/>
                    <memory name="SRAM3" access="rwx" start="0x20300000" size="0x00008000" default="1" init="0"/>
                    <!-- *************************  CPU0 Specific Memory  ***************************** -->
                    <memory Pname="CPU0" name="ITCMRAM" access="rwx" start="0x00000000" size="0x0000C000" default="1" init="0"/>
                    <memory Pname="CPU0" name="DTCMRAM" access="rwx" start="0x20000000" size="0x00004000" default="1" init="0"/>
                    <!-- *************************  CPU1 Specific Memory  ***************************** -->
                    <memory Pname="CPU1" name="ITCMRAM" access="rwx" start="0x00000000" size="0x00002000" default="1" init="0"/>
                    <memory Pname="CPU1" name="DTCMRAM" access="rwx" start="0x20000000" size="0x00002000" default="1" init="0"/>
                    <algorithm name="Flash/G32R5xx_Program_Algorithm.FLM" start="0x00100000" size="0x07FA0000" default="1" RAMstart="0x20300000" RAMsize="0x4000"/>
                    <algorithm name="Flash/G32R5xx_OTP.FLM" start="0x0810A000" size="0x00002000" default="0" RAMstart="0x20300000" RAMsize="0x4000"/>
                    <feature type="QFP" n="100" name="LQFP100"/>
                </device>
