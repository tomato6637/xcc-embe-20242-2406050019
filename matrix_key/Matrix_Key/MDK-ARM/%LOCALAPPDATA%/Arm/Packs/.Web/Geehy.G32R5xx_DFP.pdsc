            </subFamily>
        </family>
    </devices>
    <!--G32R5xx conditions-->
    <conditions>
        <!-- Shared predicates (no Dname) -->
        <condition id="Compiler ARMCC">
            <description>Arm Compiler 6 (ARMCC AC6)</description>
            <require Tcompiler="ARMCC" Toptions="AC6"/>
        </condition>
        <condition id="CMSIS CORE">
            <description>Require CMSIS:CORE from ARM.CMSIS pack</description>
            <require Cclass="CMSIS" Cgroup="CORE"/>
        </condition>
        <condition id="STDPERIPH">
            <description>CMSIS CORE plus StdPeriph Framework</description>
            <require condition="CMSIS CORE"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="Framework"/>
        </condition>
        <condition id="STDPERIPH SYSCTL">
            <description>STDPERIPH plus SYSCTL driver</description>
            <require condition="STDPERIPH"/>
            <require Cclass="Device" Cgroup="StdPeriph Drivers" Csub="SYSCTL"/>
        </condition>
        <!-- Device -->
        <condition id="G32R501">
            <description>Geehy Semiconductor G32R501 Series devices</description>
            <require Dvendor="Geehy:163" Dname="G32R501*"/>
        </condition>
        <condition id="G32R502">
            <description>Geehy Semiconductor G32R502 Series devices</description>
            <require Dvendor="Geehy:163" Dname="G32R502*"/>
        </condition>
        <!-- Device wrappers (component condition= ids unchanged) -->
        <condition id="G32R501 CMSIS">
            <description>Geehy Semiconductor G32R501 Device with CMSIS</description>
            <require condition="G32R501"/>
            <require condition="CMSIS CORE"/>
        </condition>
        <condition id="G32R502 CMSIS">
            <description>Geehy Semiconductor G32R502 Device with CMSIS</description>
            <require condition="G32R502"/>
            <require condition="CMSIS CORE"/>
        </condition>
        <condition id="G32R501 STDPERIPH">
            <description>Geehy Semiconductor G32R501 with Standard Peripherals Drivers Framework</description>
            <require condition="G32R501"/>
            <require condition="STDPERIPH"/>
        </condition>
        <condition id="G32R502 STDPERIPH">
            <description>Geehy Semiconductor G32R502 with Standard Peripherals Drivers Framework</description>
            <require condition="G32R502"/>
            <require condition="STDPERIPH"/>
        </condition>
        <condition id="G32R501 STDPERIPH SYSCTL">
            <description>Geehy Semiconductor G32R501 with Standard Peripherals Drivers Framework and SYSCTL</description>
            <require condition="G32R501"/>
            <require condition="STDPERIPH SYSCTL"/>
        </condition>
        <condition id="G32R502 STDPERIPH SYSCTL">
            <description>Geehy Semiconductor G32R502 with Standard Peripherals Drivers Framework and SYSCTL</description>
            <require condition="G32R502"/>
            <require condition="STDPERIPH SYSCTL"/>
        </condition>
    </conditions>
    <!--G32R501 Standard Peripherals Drivers-->
    <components>
        <!--Startup-->
        <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="G32R501 CMSIS">
            <description>System Startup for Geehy Semiconductor G32R501 device series</description>
            <files>
                <!--  include folder -->
                <file category="include" name="Drivers/device_support/common/CMSIS/Core/Include/"/>
                <file category="include" name="Drivers/device_support/g32r501/common/device/Geehy/"/>
                <file category="include" name="Drivers/device_support/g32r501/common/device/Geehy/system_eval/include/"/>
                <file category="include" name="Drivers/device_support/common/device/Geehy/system_eval/include/"/>
                <file category="include" name="Drivers/device_support/g32r501/common/include/"/>
                <!-- startup files -->
                <file category="source" name="Drivers/device_support/g32r501/common/device/Geehy/startup/arm/startup_g32r501.c" attr="config" version="1.0.0" condition="Compiler ARMCC"/>
                <!-- system file -->
                <file category="source" name="Drivers/device_support/g32r501/common/device/Geehy/system_eval/system_g32r501.c" attr="config" version="1.0.0"/>
                <!-- device configuration required by drivers at the moment -->
                <file category="source" name="Drivers/device_support/g32r501/common/source/device.c" attr="config" version="1.0.0"/>
            </files>
        </component>
