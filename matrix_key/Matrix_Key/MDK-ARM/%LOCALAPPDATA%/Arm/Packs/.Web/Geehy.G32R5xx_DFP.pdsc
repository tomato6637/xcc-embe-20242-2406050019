                    <memory name="Flash" access="rx" start="0x08000000" size="0x00040000" default="1" startup="1"/>
                    <memory name="ITCMRAM" access="rwx" start="0x00000000" size="0x00010000" default="1" init="0"/>
                    <memory name="DTCMRAM" access="rwx" start="0x20000000" size="0x00004000" default="1" init="0"/>
                    <memory name="SRAM1" access="rwx" start="0x20100000" size="0x00002000" default="1" init="0"/>
                    <memory name="SRAM2" access="rwx" start="0x20200000" size="0x00002000" default="1" init="0"/>
                    <memory name="SRAM3" access="rwx" start="0x20300000" size="0x00008000" default="1" init="0"/>
                    <algorithm name="Flash/G32R5xx_Program_Algorithm.FLM" start="0x00100000" size="0x07FA0000" default="1" RAMstart="0x20300000" RAMsize="0x4000"/>
                    <algorithm name="Flash/G32R5xx_OTP.FLM" start="0x0810A000" size="0x00002000" default="0" RAMstart="0x20300000" RAMsize="0x4000"/>
                    <feature type="QFP" n="64" name="LQFP64"/>
                </device>
            </subFamily>
            <!-- ************************  Subfamily 'G32R502'  **************************** -->
            <subFamily DsubFamily="G32R502">
                <debugconfig default="swd" clock="10000000"/>
                <sequences>
                    <sequence name="DebugCoreStart">
                        <block>
                            Write32(0xE0059004, DBG_CFG);                // Set DBG_CFG
                            Write32(0xE0059030, DBG_CTRL1);              // Set DBG_CTRL1
                            Write32(0xE0059038, DBG_CTRL2);              // Set DBG_CTRL2
                            Write32(0xE0059040, DBG_CTRL3);              // Set DBG_CTRL3
                        </block>
                    </sequence>
                </sequences>
                <debug svd="SVD/G32R502.svd"/>
                <!--*************************  Device 'G32R502KC'  ***************************** -->
                <device Dname="G32R502KC">
                    <processor Dcore="Cortex-M52" DcoreVersion="r0p1" Dmpu="MPU" Dfpu="SP_FPU" Dmve="MVE" Dpacbti="PACBTI" Ddsp="DSP" Dcdecp="0x01" Dtz="NO_TZ" Dendian="Configurable" Dclock="200000000"/>
                    <debug svd="SVD/G32R502.svd"/>
                    <debugvars configfile="Drivers/device_support/g32r502/common/Debug/g32r502.dbgconf">
                        __var DBG_CFG         = 0x00000000;
                        __var DBG_CTRL1       = 0x00000000;
                        __var DBG_CTRL2       = 0x00000000;
                        __var DBG_CTRL3       = 0x00000001;
                    </debugvars>
                    <memory name="Flash" access="rx" start="0x08000000" size="0x00040000" default="1" startup="1"/>
                    <memory name="ITCMRAM" access="rwx" start="0x00000000" size="0x00004000" default="1" init="0"/>
                    <memory name="DTCMRAM" access="rwx" start="0x20000000" size="0x00006000" default="1" init="0"/>
                    <algorithm name="Flash/G32R502_Program_Algorithm.FLM" start="0x08000000" size="0x00040000" default="1" RAMstart="0x20000000" RAMsize="0x2000"/>
                    <algorithm name="Flash/G32R502_OTP.FLM" start="0x0810A000" size="0x00002000" default="0" RAMstart="0x20000000" RAMsize="0x2000"/>
                </device>
                <!--*************************  Device 'G32R502CC'  ***************************** -->
                <device Dname="G32R502CC">
                    <processor Dcore="Cortex-M52" DcoreVersion="r0p1" Dmpu="MPU" Dfpu="SP_FPU" Dmve="MVE" Dpacbti="PACBTI" Ddsp="DSP" Dcdecp="0x01" Dtz="NO_TZ" Dendian="Configurable" Dclock="200000000"/>
                    <debug svd="SVD/G32R502.svd"/>
                    <debugvars configfile="Drivers/device_support/g32r502/common/Debug/g32r502.dbgconf">
                        __var DBG_CFG         = 0x00000000;
                        __var DBG_CTRL1       = 0x00000000;
                        __var DBG_CTRL2       = 0x00000000;
                        __var DBG_CTRL3       = 0x00000001;
                    </debugvars>
                    <memory name="Flash" access="rx" start="0x08000000" size="0x00040000" default="1" startup="1"/>
                    <memory name="ITCMRAM" access="rwx" start="0x00000000" size="0x00004000" default="1" init="0"/>
                    <memory name="DTCMRAM" access="rwx" start="0x20000000" size="0x00006000" default="1" init="0"/>
                    <algorithm name="Flash/G32R502_Program_Algorithm.FLM" start="0x08000000" size="0x00040000" default="1" RAMstart="0x20000000" RAMsize="0x2000"/>
                    <algorithm name="Flash/G32R502_OTP.FLM" start="0x0810A000" size="0x00002000" default="0" RAMstart="0x20000000" RAMsize="0x2000"/>
                </device>
                <!--*************************  Device 'G32R502RC'  ***************************** -->
                <device Dname="G32R502RC">
                    <processor Dcore="Cortex-M52" DcoreVersion="r0p1" Dmpu="MPU" Dfpu="SP_FPU" Dmve="MVE" Dpacbti="PACBTI" Ddsp="DSP" Dcdecp="0x01" Dtz="NO_TZ" Dendian="Configurable" Dclock="200000000"/>
                    <debug svd="SVD/G32R502.svd"/>
                    <debugvars configfile="Drivers/device_support/g32r502/common/Debug/g32r502.dbgconf">
                        __var DBG_CFG         = 0x00000000;
