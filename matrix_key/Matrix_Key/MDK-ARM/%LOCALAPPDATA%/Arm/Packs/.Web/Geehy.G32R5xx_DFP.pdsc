<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.4.0" xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>Geehy</vendor>
    <name>G32R5xx_DFP</name>
    <description>Geehy Semiconductor G32R5xx Series Device Support, Drivers and Examples</description>
    <url>https://global.geehy.com/uploads/tool/</url>
    <supportContact>https://global.geehy.com/design/software</supportContact>
    <releases>
        <release version="1.0.3" date="2026-08-31">
          - Optimize G32R501 series MCU device support and SVD display
          - Add G32R502 series MCU support
        </release>
        <release version="1.0.2" date="2026-06-25">Update url.</release>
        <release version="1.0.1" date="2025-04-15">Update Library for 1.0.1.</release>
        <release version="1.0.0" date="2024-12-30">First Release version of G32R501 Device Family Pack.</release>
    </releases>
    <keywords>
        <!-- keywords for indexing -->
        <keyword>Geehy</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package Geehy Semiconductor</keyword>
        <keyword>G32R501</keyword>
        <keyword>G32R502</keyword>
