                     <mchp:file name="hwtools/sdm/sdmRealICE4.xml"/>
                     <mchp:file name="hwtools/sdm/sdmSimulator.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="persfr">
                     <mchp:file name="hwtools/persfr/arm32.persfr"/>
                  </mchp:hwtool>
                  <mchp:prerequisite component="MPLAB X IDE" version="[5.20-"/>
               </mchp:extension>
            </environment>
            <book name="https://www.microchip.com/en-us/product/ATSAMR34J16B"
                  title="Device page for ATSAMR34J16B"/>
            <book name="https://www.microchip.com/en-us/product/ATSAMR34J16B#Documentation"
                  title="Datasheet"/>
            <book name="https://developer.arm.com/documentation/dui0662"
                  title="Cortex-M0+ Devices Generic User Guide"/>
            <feature type="NVIC" n="29"/>
            <feature type="DMA" n="16"/>
            <feature type="RNG" n="1"/>
            <feature type="ExtInt" n="16"/>
            <feature type="ADC" n="19" m="16"/>
            <feature type="WDT" n="1"/>
            <feature type="MPSerial" n="6"/>
            <feature type="Memory" n="65536" name="FLASH"/>
            <feature type="Memory" n="2048" name="RWW"/>
            <feature type="Memory" n="8192" name="HSRAM"/>
            <feature type="Memory" n="4096" name="LPRAM"/>
            <feature type="VCC" n="1.62" m="3.63"/>
            <feature type="Temp" n="-40" m="85"/>
            <feature type="BGA" n="64"/>
         </device>
