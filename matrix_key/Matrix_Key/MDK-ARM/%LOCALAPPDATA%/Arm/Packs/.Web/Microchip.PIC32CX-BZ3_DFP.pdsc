                             type="rom"
                             rw="R"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="ROM_SECURE_BOOT_PATCH"
                             start="0x18000"
                             size="0x00000800"
                             type="rom"
                             rw="R"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="FCR_PFM"
                             start="0x1000000"
                             size="0x80000"
                             type="flash"
                             pagesize="4096"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="FCR_BFM"
                             start="0x800000"
                             size="0x5000"
                             type="flash"
                             pagesize="4096"
