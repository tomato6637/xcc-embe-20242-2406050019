<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.57/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>PIC32CX-BZ3_DFP</name>
   <description overview="./OVERVIEW.md">Microchip PIC32CX-BZ3 Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="1.4.259" date="2026-06-09">
                - CMSIS System Initialization is now included as default. Define DISABLE_CMSIS_INIT to not include.
                - Added CMSIS Keil flash loaders.
                - Added ARMCC scatter/linker scripts.
                - Added FCR PFM and QSPI linker script variants for GCC, IAR, and ARMCC.
                - Added per-device system header files.
                - Renamed SVCall_Handler to SVC_Handler. SVCall_Handler retained as alias for backward compatibility.
                - Added Apache 2.0 license file.
            </release>
      <release version="1.3.216" date="2025-03-06">
                - Supported: PIC32CX5109BZ361032, PIC32CX5109BZ361048, PIC32WM_BZ3601, PIC32WM_BZ3602, PIC32CX5109BZ31032_SL3, PIC32CX5109BZ31048_SL3, PIC32CX5109BZ36032_SL3, PIC32CX5109BZ36048_SL3, PIC32WM_BZ3601_SL3, PIC32WM_BZ3602_SL3, WBZ350_SL3, WBZ351_SL3.
                - OPT Memory property modified to RW.
                - Enabled SecureBoot efuse register.
            </release>
      <release version="1.2.183" date="2024-05-21">TCC peripheral register corrections</release>
      <release version="1.1.171" date="2023-11-09">
                - Updated MPLAB X UI.
            </release>
      <release version="1.0.161" date="2023-08-21">
                - Initial release.
                - Headers minor version increased to v2.1.0.
                - Changed integer constant literal macros from _Ux_ to _UNITxx_ (where xx is 32, 16 or 8) (MISRA C2012:R12.2).
                </release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>PIC32CX-BZ3</keyword>
      <keyword>Wireless</keyword>
      <keyword>Wireless Modules</keyword>
      <keyword>Functional Safety Ready</keyword>
      <keyword>Connectivity</keyword>
      <keyword>Graphics</keyword>
      <keyword>Touch</keyword>
      <keyword>Modules</keyword>
   </keywords>
   <requirements>
      <packages>
         <package vendor="ARM" name="CMSIS"/>
      </packages>
   </requirements>
   <devices>
      <family Dfamily="PIC32CX-BZ3" Dvendor="Microchip:3">
         <debugvars version="1.0.0" configfile="debug/PIC32CX-BZ3.dbgconf">
            __var DSU_BASE_ADDR = 0x41000100;
            __var DSU_STATUSA_ADDR = DSU_BASE_ADDR + 0x1;
            __var DSU_STATUSB_ADDR = DSU_BASE_ADDR + 0x2;
            __var DSU_STATUSA_DONE = 0x1;
            __var DSU_STATUSA_CRSTEXT = 0x2;
            __var DSU_STATUSA_BEER = 0x4;
            __var DSU_STATUSA_FAIL = 0x8;
            __var DSU_STATUSA_PEER = 0x10;

            __var DHCSR_Addr = 0xE000EDF0;
            __var DEMCR_Addr = 0xE000EDFC;
            __var AIRCR_Addr = 0xE000ED0C;
            
            __var CFG_BASE_ADDR = 0x44000000;
            __var CFG_CFGCON1_Addr = CFG_BASE_ADDR + 0x10;

            __var NVM_CON_ADDR = 0x44000600;
            __var NVM_CONCLR_ADDR = 0x44000604;
            __var NVM_CONSET_ADDR = 0x44000608;
            __var NVM_KEY_ADDR = 0x44000620;
            __var NVM_ADDR_ADDR = 0x44000630;
            __var NVM_SRCADDR_ADDR = 0x440006C0;
            __var NVM_LBWP_ADDR = 0x440006F0;
            __var NVM_PWPLT_ADDR = 0x440006D0;
            __var NVM_PWPGTE_ADDR = 0x440006E0;

            __var PCHE_CHECON_ADDR = 0x44012400;

            __var RAM_BUFFER = 0x20010000;
            __var ROW_SIZE = 1024;
        </debugvars>
         <sequences>
            <sequence name="ResetSystem">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetHardware">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetProcessor">
               <block>
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="ResetAndHalt">
               <block>
                    Write32(DHCSR_Addr, 0xA05F0003); // DBGKEY | C_DEBUGEN | C_HALT
                    Write32(DEMCR_Addr, 0x01000001); // TRCENA  | VC_CORERESET
                    Write32(AIRCR_Addr, 0x05FA0004); // VECTKEY | SYSRESETREQ
                </block>
               <control while="(Read32(DHCSR_Addr) &amp; 0x02000000) == 0"
                        timeout="1000000"/>
               <block>
                    Write32(DHCSR_Addr, 0xA05F0003); // DBGKEY | C_DEBUGEN | C_HALT
                    Write8(DSU_STATUSA_ADDR, DSU_STATUSA_CRSTEXT); // release CPU STATUSA.CRSTEXT
                </block>
               <control if="(Read32(DHCSR_Addr) &amp; 0x20000) == 0">
                  <block>
                        Message(0, "The device did not halt");
                        __Result = -1;
                    </block>
               </control>
               <block>
                    Write32(DEMCR_Addr, 0x01000000); // TRCENA
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="DebugPortSetup">
               <block>
                    __var isSWJ    = ((__protocol &amp; 0x00010000) != 0);
                    __var protType = __protocol &amp; 0x0000FFFF;
                </block>
               <!-- JTAG Protocol -->
               <control if="protType == 1">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                        
                            // Execute SWJ-DP Switch Sequence SWD to JTAG (0xE73C)
                            // Change if SWJ-DP uses deprecated switch code (0xAEAE)
                            DAP_SWJ_Sequence(16, 0xE73C);
                        
                            // Ensure JTAG interface is reset
                            DAP_SWJ_Sequence(6, 0x3F);
                        </block>
                  </control>
                  <block>
                        // JTAG "Soft" Reset
                        DAP_JTAG_Sequence(6, 1, 0x3F);
                        DAP_JTAG_Sequence(1, 0, 0x01);
                    </block>
               </control>
               <!-- SWD Protocol -->
               <control if="protType == 2">
                  <control if="isSWJ">
                     <block>
                            // Ensure current debug interface is in reset state
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);
                        
                            // Execute SWJ-DP Switch Sequence JTAG to SWD (0xE79E)
                            // Change if SWJ-DP uses deprecated switch code (0xEDB6)
                            DAP_SWJ_Sequence(16, 0xE79E);
                        
                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3,  0x00);                // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <control if="!isSWJ">
                     <block>
                            // Enter SWD Line Reset State
                            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  // &gt; 50 cycles SWDIO/TMS High
                            DAP_SWJ_Sequence(3,  0x00);                // At least 2 idle cycles (SWDIO/TMS Low)
                        </block>
                  </control>
                  <block>
                        // Read DPIDR to enable SWD interface (SW-DPv1 and SW-DPv2)
                        ReadDP(0x0);
                    </block>
               </control>
            </sequence>
            <sequence name="DebugPortStart">
               <block>
                    Sequence("DebugPortConnect");
                    Sequence("ResetExtension");
                    Sequence("ResetAndHalt");
                </block>
            </sequence>
            <sequence name="DebugPortConnect">
               <block>
                    __var SW_DP_ABORT  = 0x0;
                    __var DP_CTRL_STAT = 0x4;
                    __var DP_SELECT    = 0x8;
                    __var powered_down = 0;

                    // Switch to DP Register Bank 
                    WriteDP(DP_SELECT, 0x00000000);
                    
                    // Read DP CTRL/STAT Register and check if CSYSPWRUPACK and CDBGPWRUPACK bits are set
                    powered_down = ((ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000);
                </block>
               <control if="powered_down">
                  <block>
                        // Request Debug/System Power-Up
                        WriteDP(DP_CTRL_STAT, 0x50000000);
                    </block>
                  <!-- Wait for Power-Up Request to be acknowledged -->
                  <control while="(ReadDP(DP_CTRL_STAT) &amp; 0xA0000000) != 0xA0000000"
                           timeout="1000000"/>
                  <!-- JTAG Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 1">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            // Additionally clear STICKYORUN, STICKYCMP, and STICKYERR bits by writing '1'
                            WriteDP(DP_CTRL_STAT, 0x50000F32);
                        </block>
                  </control>
                  <!-- SWD Specific Part of sequence -->
                  <control if="(__protocol &amp; 0xFFFF) == 2">
                     <block>
                            // Init AP Transfer Mode, Transaction Counter, and Lane Mask (Normal Transfer Mode, Include all Byte Lanes)
                            WriteDP(DP_CTRL_STAT, 0x50000F00);
                        
                            // Clear WDATAERR, STICKYORUN, STICKYCMP, and STICKYERR bits of CTRL/STAT Register by write to ABORT register
                            WriteDP(SW_DP_ABORT, 0x0000001E);
                        </block>
                  </control>
                  <block>
                        // clear AP register cache
                        ReadAP(0);
                    </block>
               </control>
            </sequence>
            <sequence name="DebugCoreStop">
               <block>
                    Sequence("ResetExtension");
                    Sequence("ResetAndHalt");
                    Write32(DHCSR_Addr, 0xa05f0001); // run target
                </block>
            </sequence>
            <sequence name="DebugDeviceUnlock">
               <block>
                    Write32(NVM_KEY_ADDR, 0x0);
                    Write32(NVM_KEY_ADDR, 0xAA996655);
                    Write32(NVM_KEY_ADDR, 0x556699AA);
                    Write32(NVM_LBWP_ADDR, 0x80000000);
                    Write32(NVM_PWPLT_ADDR, 0x80000000);
                    Write32(NVM_PWPGTE_ADDR, 0x80FFFFFF);
                </block>
            </sequence>
            <sequence name="ResetExtension1">
               <block>
                    __var nReset      = 0x80;
                    __var SWCLK_TCK   = 0x01;
                    DAP_SWJ_Pins(0, nReset, 1000);
                    DAP_SWJ_Pins(nReset, nReset, 1000);
                    DAP_SWJ_Pins(0, nReset, 1000);
                    DAP_SWJ_Pins(0, SWCLK_TCK, 1000);
                    DAP_SWJ_Pins(nReset, nReset, 1000);

                    Sequence("DebugPortSetup");
                    Sequence("DebugPortConnect"); // ensure connect after reset extension
                </block>
               <control if="(__connection &amp; 0xF) == 0">
                  <block>
                        Message(0, "Failed to connect debugger after reset extension");
                    </block>
               </control>
            </sequence>
            <sequence name="ResetExtension">
               <block>
                    Sequence("ResetExtension1");
                    __var cfgcon1 = Read32(CFG_CFGCON1_Addr);
                    Write32(CFG_CFGCON1_Addr, cfgcon1 &amp; 0xFFFFBFFF);
                    Sequence("ResetExtension1");
                </block>
            </sequence>
            <sequence name="ExecuteCMD_RW">
               <block>
                    __var nvmcon0 = Read32(NVM_CON_ADDR);
                    Write32(NVM_CON_ADDR, (nvmcon0 | 0x4000 | 0x3)); // row write command
                    Sequence("PostExecuteCMD");
                    Write32(NVM_CON_ADDR, nvmcon0);
                </block>
            </sequence>
            <sequence name="ExecuteCMD_PE">
               <block>
                    __var nvmcon0 = Read32(NVM_CON_ADDR);
                    Write32(NVM_CON_ADDR, (nvmcon0 | 0x4000 | 0x4)); // page erase command
                    Sequence("PostExecuteCMD");
                    Write32(NVM_CON_ADDR, nvmcon0);
                </block>
            </sequence>
            <sequence name="PostExecuteCMD">
               <block>
                    Write32(NVM_KEY_ADDR, 0x0);
                    Write32(NVM_KEY_ADDR, 0xAA996655);
                    Write32(NVM_KEY_ADDR, 0x556699AA);
                    Write32(NVM_CONSET_ADDR, 0x8000);
                </block>
               <control while="(Read32(NVM_CON_ADDR) &amp; 0x8000) != 0" timeout="1000000"/>
               <block>
                    Write32(NVM_CONCLR_ADDR, 0x4000);
                    __var nvmcon0 = Read32(NVM_CON_ADDR);
                </block>
               <control if="nvmcon0 &amp; 0x3000">
                  <block>
                        Message(0, "Execute NVM command error: 0x%08x", nvmcon0);
                        __Result = -1;
                    </block>
               </control>
               <block>
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashInit"/>
            <sequence name="FlashUninit"/>
            <sequence name="FlashEraseSector">
               <control if="!(0x805000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x806000)">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);

                        Write32(NVM_ADDR_ADDR, __FlashAddr);
                        Sequence("ExecuteCMD_PE");
                    </block>
               </control>
            </sequence>
            <sequence name="FlashEraseChip"/>
            <sequence name="FlashEraseDone"/>
            <sequence name="FlashProgramPage">
               <block>
                    __var write_size = __FlashLen;
                    __var offset = 0;
                    Message(0, "Program Page: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);
                    write_size = (__FlashLen + 3) &amp; ~3;
                </block>
               <control if="0x805000 &lt;= __FlashAddr &amp;&amp; __FlashAddr &lt;= 0x806000">
                  <block>
                        Message(0, "Erase sector: 0x%08X..., size: 0x%08X...", __FlashAddr, __FlashLen);

                        Write32(NVM_ADDR_ADDR, __FlashAddr);
                        Sequence("ExecuteCMD_PE");
                    </block>
               </control>
               <block>
                    __var cache_flags = Read32(PCHE_CHECON_ADDR);
                    Write32(PCHE_CHECON_ADDR, 0x7);
                    Write8(RAM_BUFFER, 0);
                    FlashWriteBuffer(RAM_BUFFER, 0, write_size, (32 | 1));
                </block>
               <control while="offset &lt; write_size">
                  <block>
                        Write32(NVM_ADDR_ADDR, __FlashAddr + offset);
                        Write32(NVM_SRCADDR_ADDR, RAM_BUFFER + offset);
                        Sequence("ExecuteCMD_RW");
                        offset = offset + ROW_SIZE;
                    </block>
               </control>
               <block>
                    Write32(PCHE_CHECON_ADDR, cache_flags);
                    __Result = 0;
                </block>
            </sequence>
            <sequence name="FlashProgramDone"/>
         </sequences>
         <environment name="microchip">
            <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                            schemaVersion="1.0"
                            xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
               <mchp:prerequisite component="MPLAB X IDE" version="[5.10-"/>
               <mchp:prerequisite component="MPLAB X IPE" version="[5.10-"/>
            </mchp:extension>
         </environment>
         <book name="https://developer.arm.com/documentation/dui0553"
               title="Cortex-M4 Devices Generic User Guide"/>
         <memory name="FCR_PFM"
                 start="0x1000000"
                 size="0x80000"
                 access="rx"
                 default="1"
                 startup="1"/>
         <memory name="FCR_BFM" start="0x800000" size="0x5000" access="rx"/>
         <memory name="FCR_OTP_PAGE"
                 start="0x806000"
                 size="0x00001000"
                 access="rx"/>
         <memory name="RAM_SYSTEM_RAM"
                 start="0x20000000"
                 size="0x18000"
                 default="1"
                 access="rwx"/>
         <memory name="PBA_BRIDGE"
                 start="0x40000000"
                 size="0x00004000"
                 access="rwp"/>
         <memory name="PBB_BRIDGE"
                 start="0x41000000"
                 size="0x00017000"
                 access="rwp"/>
         <memory name="PBC_BRIDGE"
                 start="0x42000000"
                 size="0x00012000"
                 access="rwp"/>
         <memory name="SILEX_SFR" start="0x43000000" size="0x20000" access="rwp"/>
         <memory name="PBPIC_BRIDGE"
                 start="0x44000000"
                 size="0x00014000"
                 access="rwp"/>
         <memory name="SYSTEM_CM4F_SYSTEM_REGISTERS"
                 start="0xE0000000"
                 size="0x1fff4000"
                 access="rwp"/>
         <debugport __dp="0">
            <swd/>
         </debugport>
         <trace>
            <serialwire/>
         </trace>
         <algorithm name="keil/Flash/PIC32CX-BZ3_BFM.FLM"
                    start="0x800000"
                    size="0x5000"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <algorithm name="keil/Flash/PIC32CX-BZ3_CFM.FLM"
                    start="0x805000"
                    size="0x1000"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <algorithm name="keil/Flash/PIC32CX-BZ3_PFM.FLM"
                    start="0x1000000"
                    size="0x80000"
                    RAMstart="0x20000000"
                    RAMsize="0x2000"
                    default="1"
                    style="Keil"/>
         <feature type="NVIC" n="43"/>
         <feature type="WDT" n="1"/>
         <feature type="RTC" n="1"/>
         <feature type="Timer" n="8"/>
         <feature type="PWM" n="3"/>
         <feature type="Memory" n="524288" name="FCR_PFM"/>
         <feature type="Memory" n="20480" name="FCR_BFM"/>
         <feature type="Memory" n="4096" name="FCR_OTP_PAGE"/>
         <feature type="Memory" n="98304" name="RAM_SYSTEM_RAM"/>
         <device Dname="PIC32CX5109BZ31032">
            <processor Dcore="Cortex-M4"
                       Dendian="Little-endian"
                       Dmpu="MPU"
                       Dfpu="SP_FPU"
                       Ddsp="NO_DSP"
                       Dtz="NO_TZ"
                       Dmve="NO_MVE"
                       Dclock="64000000"
                       DcoreVersion="r0p1"/>
            <debugconfig default="swd" clock="2000000"/>
            <compile header="BZ3/include/pic32c.h" define="__PIC32CX5109BZ31032__"/>
            <debug svd="BZ3/svd/PIC32CX5109BZ31032.svd"/>
            <flashinfo name="BFM"
                       start="0x800000"
                       blankval="0xFFFFFFFF"
                       pagesize="0x1000"
                       ptime="1000000"
                       etime="1000000">
               <block count="0x1" size="0x5000"/>
            </flashinfo>
            <flashinfo name="CFM"
                       start="0x805000"
                       blankval="0xFFFFFFFF"
                       pagesize="0x1000"
                       ptime="1000000"
                       etime="1000000">
               <block count="0x1" size="0x1000"/>
            </flashinfo>
            <flashinfo name="PFM"
                       start="0x1000000"
                       blankval="0xFFFFFFFF"
                       pagesize="0x1000"
                       ptime="1000000"
                       etime="1000000">
               <block count="0x1" size="0x80000"/>
            </flashinfo>
            <environment name="atmel">
               <at:extension xmlns:at="http://www.atmel.com/schemas/pack-device-atmel-extension"
                             schemaVersion="1.0"
                             xsi:schemaLocation="http://www.atmel.com/schemas/pack-device-atmel-extension PACK.DEVICE.ATMEL.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/at/1.0/PACK.DEVICE.ATMEL.EXTENSION.xsd-->
                  <at:atdf name="BZ3/atdf/PIC32CX5109BZ31032.atdf"/>
                  <at:variant ordercode="PIC32CX5109BZ31032-I/M"
                              vccmin="1.90"
                              vccmax="3.60"
                              tempmin="-40"
                              tempmax="105"/>
                  <at:memory name="ROM_SECURE_BOOT_ROM"
