<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.57/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>SAMRH707_DFP</name>
   <description overview="./OVERVIEW.md">Microchip SAMRH707 Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="1.4.194" date="2026-06-23">
        - Added alternate linker script variants (DTCM, ITCM, SRAM, EBI_CSHEMC) for GCC, IAR, and ARM compilers.
        - Added CMSIS csolution project templates.
        - Added MISRA-C:2023 compliance deviation documentation.
        - Fixed CoreDebug module SVD validation errors.
        - Updated C headers and SVD files.
      </release>
      <release version="1.3.181" date="2026-02-13">
				- CMSIS System Initialization is now included as default. Define DISABLE_CMSIS_INIT to not include.
				- Adds ARMCC scatter/linker script.
				- Updated CMSIS flash loaders.
				- DEVXML-7483 Interrupt handler in startup_(device).c changed: SVCall_Handler changed -&gt; SVC_Handler and NonMaskableInt_Handler -&gt; NMI_Handler.
			</release>
      <release version="1.2.156" date="2023-05-26">
                    - Defined RAM descriptor in device xml
                    - Defined ITM support in device xml
                    - Updated debug and programming scripts
            </release>
      <release version="1.1.43" date="2022-03-17">
                - Headers minor version increased to v2.1.0.
                - Changed integer constant literal macros from _Ux_ to _UNITxx_ (where xx is 32, 16 or 8) (MISRA C2012:R12.2).
            </release>
      <release version="1.0.28" date="2021-05-19">Initial release.</release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>SAMRH707</keyword>
   </keywords>
   <requirements>
      <packages>
         <package vendor="ARM" name="CMSIS"/>
      </packages>
   </requirements>
   <devices>
      <family Dfamily="SAMRH707" Dvendor="Microchip:3">
         <environment name="microchip">
            <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                            schemaVersion="1.0"
                            xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
               <mchp:prerequisite component="MPLAB X IDE" version="[5.50-"/>
               <mchp:prerequisite component="MPLAB X IPE" version="[5.10-"/>
            </mchp:extension>
         </environment>
         <book name="https://www.microchip.com/en-us/product/ATSAMRH707F18A"
               title="Device page for ATSAMRH707F18A"/>
         <book name="https://www.microchip.com/en-us/product/ATSAMRH707F18A#Documentation"
               title="Datasheet"/>
         <book name="https://developer.arm.com/documentation/dui0646"
               title="Arm Cortex-M7 Devices Generic User Guide"/>
         <compile header="include/sam.h" define="__SAMRH707F18A__"/>
         <memory name="IFLASH"
                 start="0x10000000"
                 size="0x00020000"
                 access="rx"
                 default="1"
                 startup="1"/>
         <memory name="ITCM"
                 start="0x00000000"
                 size="0x00010000"
                 default="1"
                 access="rwx"/>
         <memory name="DTCM" start="0x20000000" size="0x00020000" access="rwx"/>
         <memory name="FlexRAM"
                 start="0x21000000"
                 size="0x00020000"
                 access="rwx"/>
         <memory name="PERIPHERALS"
                 start="0x40000000"
                 size="0x20000000"
                 access="rwp"/>
         <memory name="SYSTEM" start="0xE0000000" size="0x10000000" access="rwp"/>
         <debugport __dp="0">
            <swd/>
         </debugport>
         <trace>
            <serialwire/>
            <traceport width="0xB"/>
         </trace>
         <algorithm name="keil/Flash/ATSAMRH707_FLASH.FLM"
                    start="0x10000000"
                    size="0x00020000"
                    RAMstart="0x21000000"
                    RAMsize="0x00020000"
                    default="1"
                    style="Keil"/>
         <feature type="NVIC" n="69"/>
         <feature type="RNG" n="1"/>
         <feature type="WDT" n="1"/>
         <feature type="RTC" n="1"/>
         <feature type="Timer" n="3"/>
         <feature type="Memory" n="65536" name="ITCM"/>
         <feature type="Memory" n="131072" name="IFLASH"/>
         <feature type="Memory" n="131072" name="DTCM"/>
         <feature type="Memory" n="131072" name="FlexRAM"/>
         <feature type="VCC" n="1.62" m="3.6"/>
         <feature type="Temp" n="25" m="25"/>
         <feature type="QFP" n="164"/>
         <device Dname="ATSAMRH707F18A">
            <processor Dcore="Cortex-M7"
                       Dendian="Little-endian"
                       Dmpu="MPU"
                       Dfpu="DP_FPU"
                       Ddsp="NO_DSP"
                       Dtz="NO_TZ"
                       Dmve="NO_MVE"
                       Dclock="50000000"
                       DcoreVersion="r1p1"/>
            <debugconfig default="swd" clock="2000000"/>
            <debug svd="svd/ATSAMRH707F18A.svd"/>
            <environment name="atmel">
               <at:extension xmlns:at="http://www.atmel.com/schemas/pack-device-atmel-extension"
                             schemaVersion="1.0"
                             xsi:schemaLocation="http://www.atmel.com/schemas/pack-device-atmel-extension PACK.DEVICE.ATMEL.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/at/1.0/PACK.DEVICE.ATMEL.EXTENSION.xsd-->
                  <at:atdf name="atdf/ATSAMRH707F18A.atdf"/>
                  <at:variant ordercode="SAMRH707F18A-DRB-E"
                              vccmin="1.62"
                              vccmax="3.6"
                              tempmin="+25"
                              tempmax="+25"/>
                  <at:memory name="PERIPHERALS"
                             start="0x40000000"
                             size="0x20000000"
                             type="io"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="SYSTEM"
                             start="0xE0000000"
                             size="0x10000000"
                             type="io"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="AXIMX"
                             start="0x22000000"
                             size="0x00100000"
                             type="other"
                             rw="RW"
                             address-space="base"/>
                  <at:memory name="ITCM"
                             start="0x00000000"
                             size="0x00010000"
                             type="ram"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="IFLASH"
                             start="0x10000000"
                             size="0x00020000"
                             type="flash"
                             pagesize="256"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="IROM"
                             start="0x11000000"
                             size="0x00020000"
                             type="rom"
                             rw="R"
                             address-space="base"/>
                  <at:memory name="DTCM"
                             start="0x20000000"
                             size="0x00020000"
                             type="ram"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="FlexRAM"
                             start="0x21000000"
                             size="0x00020000"
                             type="ram"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:memory name="EBI_CSHEMC"
                             start="0x60000000"
                             size="0x00200000"
                             type="other"
                             rw="RW"
                             exec="true"
                             address-space="base"/>
                  <at:interface type="swd" name="SWD"/>
                  <at:tool id="com.atmel.avrdbg.tool.atmelice"/>
                  <at:tool id="com.atmel.avrdbg.tool.edbg"/>
                  <at:tool id="com.atmel.avrdbg.tool.edbgc"/>
                  <at:tool id="com.atmel.avrdbg.tool.ice4"/>
                  <at:tool id="com.atmel.avrdbg.tool.jtagice3plus"/>
                  <at:tool id="com.atmel.avrdbg.tool.jtagicemk3"/>
                  <at:tool id="com.atmel.avrdbg.tool.medbg"/>
                  <at:tool id="com.atmel.avrdbg.tool.nedbg"/>
                  <at:tool id="com.atmel.avrdbg.tool.pickit4"/>
                  <at:tool id="com.atmel.avrdbg.tool.powerdebugger"/>
                  <at:tool id="com.atmel.avrdbg.tool.samice"/>
                  <at:tool id="com.atmel.avrdbg.tool.snap"/>
                  <at:project name="Barebone C Project">
                     <at:component Cvendor="ARM" Cclass="CMSIS" Cgroup="CORE"/>
                     <at:component Cvendor="Microchip" Cclass="Device" Cgroup="Startup">
                        <at:template select="Main file (.c)"/>
                     </at:component>
                  </at:project>
                  <at:project name="Barebone Cpp Project">
                     <at:component Cvendor="ARM" Cclass="CMSIS" Cgroup="CORE"/>
                     <at:component Cvendor="Microchip" Cclass="Device" Cgroup="Startup">
                        <at:template select="Main file (.cpp)"/>
                     </at:component>
                  </at:project>
                  <at:prerequisite context="compiling" Tcompiler="GCC" component="ARM-GCC"/>
                  <at:prerequisite context="compiling" Tcompiler="IAR" component="ARM-IAR"/>
                  <at:prerequisite context="compiling" Tcompiler="ARMCC" component="ARMCC"/>
               </at:extension>
            </environment>
            <environment name="microchip">
               <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                               schemaVersion="1.0"
                               xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
                  <mchp:pic name="edc/ATSAMRH707F18A.PIC"/>
                  <mchp:xc32 name="xc32"/>
                  <mchp:hwtool type="mplab.nmmrs">
                     <mchp:file name="hwtools/mplab/16bit.NMMRs.xml"/>
                     <mchp:file name="hwtools/mplab/32bit.NMMRs.xml"/>
                     <mchp:file name="hwtools/mplab/8bit.NMMRs.xml"/>
                     <mchp:file name="hwtools/mplab/arm.32bit.NMMRs.xml"/>
                     <mchp:file name="hwtools/mplab/avr.8bit.NMMRs.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="mplab.mpheader">
                     <mchp:file name="hwtools/mplab/MPHeader.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="mplab.pluginboardsupport">
                     <mchp:file name="hwtools/mplab/PluginBoardSupport.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="persfr">
                     <mchp:file name="hwtools/persfr/arm32.persfr"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="per">
                     <mchp:file name="hwtools/per/armcm7.per"/>
                     <mchp:file name="hwtools/per/avr8.per"/>
                     <mchp:file name="hwtools/per/dspic.per"/>
                     <mchp:file name="hwtools/per/dspic33a.per"/>
                     <mchp:file name="hwtools/per/pic12.per"/>
                     <mchp:file name="hwtools/per/pic16.per"/>
                     <mchp:file name="hwtools/per/pic18.per"/>
                     <mchp:file name="hwtools/per/pic32.per"/>
                     <mchp:file name="hwtools/per/usart.ispPeripheral.xml"/>
                     <mchp:file name="hwtools/per/usart.plibgen.xml"/>
                  </mchp:hwtool>
                  <mchp:prerequisite component="MPLAB X IDE" version="[5.50-"/>
               </mchp:extension>
            </environment>
            <description>Cortex-M7 Microcontroller, 128KB Flash, 320KB SRAM, 50 MHz</description>
         </device>
      </family>
   </devices>
   <conditions>
      <condition id="ARMCC">
         <accept Tcompiler="ARMCC"/>
      </condition>
      <condition id="ARMCC Exe">
         <require condition="ARMCC"/>
         <accept Toutput="exe"/>
      </condition>
      <condition id="ARMCC Lib">
         <require condition="ARMCC"/>
         <accept Toutput="lib"/>
      </condition>
      <condition id="GCC+CLANG">
         <accept Tcompiler="GCC"/>
         <accept Tcompiler="CLANG"/>
      </condition>
      <condition id="GCC+CLANG Exe">
         <require condition="GCC+CLANG"/>
         <accept Toutput="exe"/>
      </condition>
      <condition id="GCC+CLANG Lib">
         <require condition="GCC+CLANG"/>
         <accept Toutput="lib"/>
      </condition>
      <condition id="IAR">
         <accept Tcompiler="IAR"/>
      </condition>
      <condition id="IAR Exe">
         <require condition="IAR"/>
         <accept Toutput="exe"/>
      </condition>
      <condition id="IAR Lib">
         <require condition="IAR"/>
         <accept Toutput="lib"/>
      </condition>
      <condition id="XC">
         <accept Tcompiler="XC"/>
      </condition>
      <condition id="XC Exe">
         <require condition="XC"/>
         <accept Toutput="exe"/>
      </condition>
      <condition id="XC Lib">
         <require condition="XC"/>
         <accept Toutput="lib"/>
      </condition>
      <condition id="C">
         <accept condition="ARMCC"/>
         <accept condition="GCC+CLANG"/>
         <accept condition="IAR"/>
         <accept condition="XC"/>
      </condition>
      <condition id="C Exe">
         <accept condition="ARMCC Exe"/>
         <accept condition="GCC+CLANG Exe"/>
         <accept condition="IAR Exe"/>
         <accept condition="XC Exe"/>
      </condition>
      <condition id="C Lib">
         <accept condition="ARMCC Lib"/>
         <accept condition="GCC+CLANG Lib"/>
         <accept condition="IAR Lib"/>
         <accept condition="XC Lib"/>
      </condition>
      <condition id="ATSAMRH707F18A">
         <require Dvendor="Microchip:3" Dname="ATSAMRH707F18A"/>
         <require Cclass="CMSIS" Cgroup="CORE"/>
      </condition>
   </conditions>
   <components>
      <component Cvendor="Microchip"
                 Cclass="Device"
                 Cgroup="Startup"
                 Cversion="1.4.0"
                 condition="ATSAMRH707F18A">
         <description>Headers and startup code for Microchip ATSAMRH707F18A</description>
         <files>
            <file condition="C" category="include" name="include/"/>
            <file condition="C" category="header" name="include/sam.h"/>
            <file condition="C Exe"
                  category="source"
                  name="templates/main.c"
                  attr="template"
                  select="Main file (.c)"/>
            <file condition="C Exe"
                  category="source"
                  name="templates/main.cpp"
                  attr="template"
                  select="Main file (.cpp)"/>
            <file condition="C Lib"
                  category="source"
                  name="templates/library.c"
                  attr="template"
                  select="Main file (.c)"/>
            <file condition="C Lib"
                  category="source"
                  name="templates/library.cpp"
                  attr="template"
                  select="Main file (.cpp)"/>
            <file condition="GCC+CLANG Exe"
                  category="source"
                  name="gcc/gcc/startup_samrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="GCC+CLANG Exe"
                  category="source"
                  name="gcc/system_samrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="GCC+CLANG Exe"
                  category="linkerScript"
                  name="gcc/gcc/samrh707f18a_flash.ld"
                  version="1.4.0"
                  attr="config"/>
            <file condition="GCC+CLANG Exe"
                  category="linkerScript"
                  name="gcc/gcc/samrh707f18a_sram.ld"
                  version="1.4.0"
                  attr="template"
                  select="SRAM linker script"/>
            <file condition="GCC+CLANG Exe"
                  category="linkerScript"
                  name="gcc/gcc/samrh707f18a_itcm.ld"
                  version="1.4.0"
                  attr="template"
                  select="samrh707f18a_itcm"/>
            <file condition="GCC+CLANG Exe"
                  category="linkerScript"
                  name="gcc/gcc/samrh707f18a_dtcm.ld"
                  version="1.4.0"
                  attr="template"
                  select="samrh707f18a_dtcm"/>
            <file condition="GCC+CLANG Exe"
                  category="linkerScript"
                  name="gcc/gcc/samrh707f18a_ebi_cshemc.ld"
                  version="1.4.0"
                  attr="template"
                  select="samrh707f18a_ebi_cshemc"/>
            <file condition="ARMCC Exe"
                  category="source"
                  name="armcc/armcc/startup_samrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="ARMCC Exe"
                  category="source"
                  name="armcc/system_samrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="ARMCC Exe"
                  category="linkerScript"
                  name="armcc/armcc/samrh707f18a_flash.sct"
                  version="1.4.0"
                  attr="config"/>
            <file condition="ARMCC Exe"
                  category="linkerScript"
                  name="armcc/armcc/samrh707f18a_sram.sct"
                  version="1.4.0"
                  attr="template"
                  select="SRAM linker script"/>
            <file condition="ARMCC Exe"
                  category="linkerScript"
                  name="armcc/armcc/samrh707f18a_itcm.sct"
                  version="1.4.0"
                  attr="template"
                  select="samrh707f18a_itcm"/>
            <file condition="ARMCC Exe"
                  category="linkerScript"
                  name="armcc/armcc/samrh707f18a_dtcm.sct"
                  version="1.4.0"
                  attr="template"
                  select="samrh707f18a_dtcm"/>
            <file condition="ARMCC Exe"
                  category="linkerScript"
                  name="armcc/armcc/samrh707f18a_ebi_cshemc.sct"
                  version="1.4.0"
                  attr="template"
                  select="samrh707f18a_ebi_cshemc"/>
            <file condition="IAR Exe"
                  category="source"
                  name="iar/iar/startup_samrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="IAR Exe"
                  category="source"
                  name="iar/system_samrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="IAR Exe"
                  category="linkerScript"
                  name="iar/config/linker/Microchip/atsamrh707f18a/sram.icf"
                  version="1.4.0"
                  attr="template"
                  select="SRAM linker script"/>
            <file condition="IAR Exe"
                  category="linkerScript"
                  name="iar/config/linker/Microchip/atsamrh707f18a/flash.icf"
                  version="1.4.0"
                  attr="config"/>
            <file condition="IAR Exe"
                  category="linkerScript"
                  name="iar/config/linker/Microchip/atsamrh707f18a/itcm.icf"
                  version="1.4.0"
                  attr="template"
                  select="itcm"/>
            <file condition="IAR Exe"
                  category="linkerScript"
                  name="iar/config/linker/Microchip/atsamrh707f18a/dtcm.icf"
                  version="1.4.0"
                  attr="template"
                  select="dtcm"/>
            <file condition="IAR Exe"
                  category="linkerScript"
                  name="iar/config/linker/Microchip/atsamrh707f18a/ebi_cshemc.icf"
                  version="1.4.0"
                  attr="template"
                  select="ebi_cshemc"/>
            <file condition="XC Exe"
                  category="source"
                  name="xc32/ATSAMRH707F18A/startup_atsamrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="XC Exe"
                  category="source"
                  name="gcc/system_samrh707f18a.c"
                  version="1.4.0"
                  attr="config"/>
            <file condition="XC Exe"
                  category="linkerScript"
                  name="xc32/ATSAMRH707F18A/ATSAMRH707F18A.ld"
                  version="1.4.0"
                  attr="config"/>
         </files>
      </component>
   </components>
   <csolution>
      <template name="Blank Solution"
                path="templates/csolution/ATSAMRH707F18A"
                file="Blank.csolution.yml"
                copy-to="blank"
                condition="ATSAMRH707F18A">
         <description>Create a basic project with empty main function</description>
      </template>
   </csolution>
   <taxonomy>
      <description Cclass="Device" Cgroup="Startup">Device specific startup components</description>
   </taxonomy>
</package>
