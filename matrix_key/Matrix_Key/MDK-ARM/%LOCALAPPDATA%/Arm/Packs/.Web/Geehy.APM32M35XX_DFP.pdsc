<?xml version="1.0" encoding="utf-8"?>
<package schemaVersion="1.0"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>Geehy</vendor>
    <url>https://global.geehy.com/uploads/tool/</url>
    <supportContact>https://global.geehy.com/design/software</supportContact>
    <name>APM32M35XX_DFP</name>
    <description>Geehy Semiconductor APM32M35XX Series Device Support</description>
    <releases>
        <release version="1.0.1" date="2026-10-09">Update url.</release>
        <release version="1.0.0" date="2024-05-30">
            First Release version of APM32M35XX Device Family Pack.
        </release>
    </releases>
    <keywords>
        <!-- keywords for indexing -->
        <keyword>Geehy</keyword>
        <keyword>Device Support</keyword>
        <keyword>Device Family Package Geehy Semiconductor</keyword>
        <keyword>APM32M35XX</keyword>
        <keyword>APM32</keyword>
    </keywords>
    <devices>
        <family Dfamily="APM32M35XX Series"
            Dvendor="Geehy:163">
            <processor Dcore="Cortex-M0+"
                DcoreVersion="r0p1"
                Dfpu="0"
                Dmpu="0"
                Dendian="Little-endian" />
            <book name="Documents/DUI0662B_cortex_m0p_r0p1_dgug.pdf"
                title="Cortex-M0+ Generic User Guide" />
            <description>

                Geehy Semiconductor' APM32M35XX series of mainstream MCUs are 32-bit microprocessors based on ARM Cortex'-M0+ core, with a maximum operating frequency of 72MHz.

                Core

                - ARM 32-bit Cortex-M0+ CPU (72 MHz max)

                Memories

                - 64 Kbytes of Flash memory

                - 8 Kbytes of SRAM with HW parity checking

                M0CP coprocessor unit

                CRC calculation unit

                Reset and power management

                - Voltage range: 2.0 V to 3.6 V

                - Power-on/Power down reset (POR/PDR)

                - Low power modes: Sleep, Stop, Standby

                Clock management

                - 4 to 32 MHz crystal oscillator

                - 32 kHz oscillator for RTC with calibration

                - Internal 8 MHz RC with x6 PLL option

                - Internal 40 kHz RC oscillator
            </description>
            <!-- ******************************  APM32M3514  ****************************** -->
            <subFamily DsubFamily="APM32M3514">
                <feature type="WDT" n="2" />
                <feature type="RTC" n="32768" />
                <feature type="VCC" n="2.00" m="3.60" />
                <feature type="Temp" n="-40" m="105" />
                <feature type="CAN" n="1" />
                <!-- ******************************  APM32M3514C8  ****************************** -->
                <device Dname="APM32M3514C8">
                    <processor Dclock="72000000" />
                    <!-- <compile header="Device/Device/Geehy/APM32M35XX/Include/APM32M35XX.h" define="APM32M3514" /> -->
                    <debug svd="SVD/APM32M35XX.svd" />
                    <memory id="IROM1" start="0x08000000" size="0x10000" startup="1" default="1" />
                    <memory id="IRAM1" start="0x20000000" size="0x2000" init="0" default="1" />
                    <algorithm name="Flash/APM32M35xx_64.FLM" start="0x08000000" size="0x10000" default="1" />
                    <book name="Documents/DATASHEET.pdf" title="APM32M35XX Data Sheet" />
                    <feature type="Timer"
                        count="5"
                        name="16-Bit Timer with Input Capture, Output Compare and PWM" />
                    <feature type="Timer"
                        count="1"
                        name="32-Bit Timer with Input Capture, Output Compare and PWM" />
                    <feature type="Timer"
                        count="2"
                        name="Watchdog" />
                    <feature type="Timer"
                        count="1"
                        name="RTC" />
                    <feature type="A/D"
                        count="1"
                        name="12-bit Analog to Digital Converter" />
                    <feature type="I/O"
                        count="39"
                        name="Input and Output Ports" />
                    <feature type="D/A"
                        count="0"
                        name="12-bit Digital to Analog Converter" />
                    <feature type="Com"
                        count="1"
                        name="SPI Interface" />
                    <feature type="Com"
                        count="1"
                        name="I2S Interface" />
                    <feature type="Com"
                        count="1"
                        name="I2C Interface" />
                    <feature type="Com"
                        count="2"
                        name="USART Interface" />
                </device>
            </subFamily>
        </family>
    </devices>
    <conditions>
        <!-- conditions are dependecy rules that can apply to a component or an individual file -->
        <condition id="Compiler ARMCC">
            <require Tcompiler="ARMCC" />
        </condition>
        <condition id="APM32M3514">
            <description>Geehy Semiconductor APM32M35XX Series devices</description>
            <require Dname="APM32M3514??" />
        </condition>
        <condition id="APM32M35XX ARMCC">
            <description>filter for APM32M35XX Device and the ARM compiler</description>
            <require condition="APM32M3514" />
            <require Tcompiler="ARMCC" />
        </condition>
        <condition id="APM32M35XX CMSIS">
            <description>Geehy Semiconductor APM32M35XX Device with CMSIS</description>
            <require condition="APM32M3514" />
            <require Cclass="CMSIS"
                Cgroup="CORE" />
            <require Dvendor="Geehy:163"
                Dname="APM32M3514??" />
        </condition>
        <condition id="APM32M35XX STDPERIPH">
            <description>Geehy Semiconductor APM32M35XX with Standard Peripherals Drivers Framework</description>
            <require condition="APM32M35XX CMSIS" />
            <require Cclass="Device"
                Cgroup="APM32M35XX StdPeriph Drivers"
                Csub="Framework" />
        </condition>
        <condition id="APM32M35XX STDPERIPH RCM">
            <description>Geehy Semiconductor APM32M35XX with Standard Peripherals Drivers Framework and RCM</description>
            <require condition="APM32M35XX CMSIS" />
            <require Cclass="Device"
                Cgroup="APM32M35XX StdPeriph Drivers"
                Csub="Framework" />
            <require Cclass="Device"
                Cgroup="APM32M35XX StdPeriph Drivers"
                Csub="RCM" />
        </condition>
    </conditions>
    <components>
        <component Cclass="Device"
            Cgroup="APM32M35XX Startup"
            Cversion="1.0.0"
            condition="APM32M35XX CMSIS">
            <!-- Cversion is necessary -->
            <description>System Startup for Geehy Semiconductor APM32M35XX Series</description>
            <files>
                <!-- include folder -->
                <file category="include"
                    name="Device/CMSIS/Include/" />
                <file category="include"
                    name="Device/Device/Geehy/APM32M35XX/Include/" />
                <!-- startup files -->
                <file category="source"
                    name="Device/Device/Geehy/APM32M35XX/Source/arm/startup_apm32m35xx.s"
                    attr="config"
                    version="1.0.0"
                    condition="APM32M3514" />
                <!-- system file -->
                <file category="source"
                    name="Device/Device/Geehy/APM32M35XX/Source/system_apm32m35xx.c"
                    attr="config"
                    version="1.0.0" />
            </files>
        </component>
        <!-- START: Geehy Semiconductor Standard Peripherals Drivers -->
        <component Cclass="Device"
            Cgroup="APM32M35XX StdPeriph Drivers"
            Csub="Framework"
            Cversion="1.0.0"
            condition="APM32M35XX STDPERIPH">
