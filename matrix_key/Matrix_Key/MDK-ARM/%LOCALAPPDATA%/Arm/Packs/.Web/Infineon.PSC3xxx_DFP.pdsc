      <!-- PSC3x8F, dual PPCA cores, 256K of Main Flash -->
      <subFamily DsubFamily="PSC3x8F">
        <processor Pname="Cortex-M33-PPCA1" Dcore="Cortex-M33" DcoreVersion="r1p0" Dfpu="SP_FPU" Dmpu="NO_MPU" Dtz="NO_TZ" Ddsp="DSP" Dendian="Little-endian" Dclock="180000000" />
        <debug Pname="Cortex-M33-PPCA1" __apid="3" defaultResetSequence="ResetProcessor" svd="SVD/psc3_p8_ppca.svd" />
        <accessportV2 __apid="3" address="0xF0008000" />
        <memory name="IROM1" access="rxn" start="0x22000000" size="0x40000" default="1" />
        <memory name="IROM2" access="rxs" start="0x32000000" size="0x40000" default="1" alias="IROM1" startup="1" />
        <memory name="IROM3" access="rxn" start="0x22800000" size="0x20000" default="0" />
        <memory name="IROM4" access="rxs" start="0x32800000" size="0x20000" default="0" alias="IROM3" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF.FLM" start="0x22000000" size="0x40000" RAMstart="0x34000000" RAMsize="0x3000" default="1" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF_S.FLM" start="0x32000000" size="0x40000" default="1" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF_DBM1.FLM" start="0x22800000" size="0x20000" default="0" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF_S_DBM1.FLM" start="0x32800000" size="0x20000" default="0" style="Keil" />
        <sequences>
          <!-- Enable PPCA cores and debug over main M33 AP -->
          <sequence name="EnablePpca">
            <block>
            Sequence("EnablePpcaPeriGr");
            Sequence("EnablePpca0");
            Sequence("EnablePpca1");
            Sequence("EnablePpcaDebug");
          </block>
          </sequence>
          <!-- Enable PPCA CORE1 over main M33 AP -->
          <sequence name="EnablePpca1">
            <block>
            // Switch to main M33 AP and enable PPCA1
            __apid = 1;
            __var domainSecure = Read32(DSCSR) &amp; 0x00010000;
            // Initialise a minimal vector table with MSP and PC to start PPCA CORE1 in an endless loop in SRAM from the main M33 core
            __var addr = (domainSecure != 0) ? (PPCA1_CODE | 0x10000000) : PPCA1_CODE; // PPCA1 code address
            Write32(addr, PPCAx_LOCAL_DATA + PPCAx_STACK_TOP_OFFSET); // MSP
            Write32(addr + 4, (PPCAx_LOCAL_DATA + PPCAx_LOOP_OFFSET) | 1); // PC
            addr = (domainSecure != 0) ? (PPCA1_DATA | 0x10000000) : PPCA1_DATA; // PPCA1 data address
            Write32(addr + PPCAx_LOOP_OFFSET, LOOP_CODE); // ENDLESS LOOP CODE
            // START PPCA CORE 1
            addr = (domainSecure != 0) ? (PPCA_PPCA_CNFG_CNFG_CPU_CTRL | 0x10000000) : PPCA_PPCA_CNFG_CNFG_CPU_CTRL;
            __var v = Read32(addr);
          </block>
            <control if="(v &amp; 0x2) == 0">
              <block>
              Write32(addr, v | 0x2);
            </block>
            </control>
            <block>
            addr = (domainSecure != 0) ? (PPCA_PPCA_CNFG_CNFG_RST_CTRL | 0x10000000) : PPCA_PPCA_CNFG_CNFG_RST_CTRL;
            v = Read32(addr);
          </block>
            <control if="(v &amp; 0x2) == 0">
              <block>
              Write32(addr, v | 0x2);
            </block>
            </control>
            <block>
            addr = (domainSecure != 0) ? (PPCA_CPUSS_CNFG_PPCA_MXCM331_CM33_CTL | 0x10000000) : PPCA_CPUSS_CNFG_PPCA_MXCM331_CM33_CTL;
            Write32(addr, 0x0);
          </block>
          </sequence>
          <sequence name="ResetSystem" Pname="Cortex-M33-PPCA1" disable="true" />
          <sequence name="ResetHardware" Pname="Cortex-M33-PPCA1" disable="true" />
          <sequence name="ResetProcessor" Pname="Cortex-M33-PPCA1">
            <block>
            __var Saved_ApId = __apid;
            __apid = 1;
            __var domainSecure = Read32(DSCSR) &amp; 0x00010000;
            // Execute core reset via PPCA_PPCA_CNFG_CNFG_RST_CTRL
            __var addr = (domainSecure != 0) ? (PPCA_PPCA_CNFG_CNFG_RST_CTRL | 0x10000000) : PPCA_PPCA_CNFG_CNFG_RST_CTRL;
            __var v = Read32(addr);
            v = v &amp; 0xFFFFFFFD; // Clear bits 1
            Write32(addr, v); // Assert reset
            v = v | 0x2;          // Set bit 1
            Write32(addr, v); // De-assert reset
            __apid = Saved_ApId;
            // Capture VC_CORERESET bit of DEMCR register
            __var VC_CORERESET = (Read32(DEMCR) &amp; 1);
            Write32(DEMCR, 0x01000001); // Set TRCENA and VC_CORERESET bits
            Write32(DHCSR, 0xA05F0001); // Set C_DEBUGEN bit
            __apid = 1;
            addr = (domainSecure != 0) ? (PPCA_CPUSS_CNFG_PPCA_MXCM331_CM33_CTL | 0x10000000) : PPCA_CPUSS_CNFG_PPCA_MXCM331_CM33_CTL;
            Write32(addr, 0x0); // Deassert wait state
            __apid = Saved_ApId;
          </block>
            <!-- Reset Recovery: Wait for DHCSR.S_RESET_ST bit to clear on read -->
            <control while="(Read32(DHCSR) &amp; 0x02000000)" timeout="500000" />
            <!-- Check against halt was requested by VC_CORERESET bit -->
            <control if="VC_CORERESET == 0">
              <block>
              // Clear VC_CORERESET bit of DEMCR register
              Write32(DEMCR, 0x01000000);
              // Clear C_HALT if halt isn't requested.
              Write32(DHCSR, 0xA05F0001);
            </block>
            </control>
          </sequence>
        </sequences>
        <device Dname="PSC3M8FES2PLGQ1">
          <compile define="PSC3M8FES2PLGQ1" />
        </device>
        <device Dname="PSC3M8FES2PLHQ1">
          <compile define="PSC3M8FES2PLHQ1" />
