          <block>
            addr = (HSIOM_BASE + (HSIOM_PRT_SECTION_SIZE * portNum) + ((pinNum &lt; GPIO_PRT_HALF) ? 0 : HSIOM_PRT_PORT_SEL1_OFFSET)) | ((domainSecure != 0) ? 0x10000000 : 0);
            regOld = Read32(addr);
            pos = ((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_HSIOM_OFFSET;
            mask = GPIO_HSIOM_MASK &lt;&lt; (((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_HSIOM_OFFSET);
            v = ioSelVal;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <block>
            addr = (GPIO_BASE + (GPIO_PRT_SECTION_SIZE * portNum) + GPIO_PRT_SLEW_EXT_OFFSET) | ((domainSecure != 0) ? 0x10000000 : 0);
            regOld = Read32(addr);
            pos = pinNum &lt;&lt; GPIO_CFG_SLEW_EXT_OFFSET;
            mask = GPIO_CFG_SLEW_EXT_MASK &lt;&lt; (pinNum &lt;&lt; GPIO_CFG_SLEW_EXT_OFFSET);
            v = slewRate;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <block>
            addr = (GPIO_BASE + (GPIO_PRT_SECTION_SIZE * portNum) + ((pinNum &lt; GPIO_PRT_HALF) ? GPIO_PRT_DRIVE_EXT0_OFFSET : GPIO_PRT_DRIVE_EXT1_OFFSET)) | ((domainSecure != 0) ? 0x10000000 : 0);
            pos = ((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_CFG_DRIVE_SEL_EXT_OFFSET;
            mask = GPIO_CFG_DRIVE_SEL_EXT_MASK &lt;&lt; (((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_CFG_DRIVE_SEL_EXT_OFFSET);
            v = driveSel;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <control if="confChanged != 0">
            <block>
              Message(0, "Set TRACEDATA[2] to P8_2");
            </block>
          </control>
        </sequence>
        <!-- Setup Trace Pin P8_3 as TRACEDATA[3]  -->
        <sequence name="SetupTracePin_P8_3" Pname="Cortex-M33">
          <block>
            __var portNum = 8;   // Port number
            __var pinNum = 3;    // Pin number
            __var regOld;        // Old register value
            __var regNew;        // New register value
            __var confChanged = 0; // Pin's configuration change flag
            __var domainSecure = Read32(DSCSR) &amp; 0x00010000;
            __var v = (domainSecure != 0) ? 0 : 1 ; // 0 - Secure transaction, 1 - Non-Secure transaction
            __var addr = (HSIOM_SECURE_BASE + (HSIOM_SECURE_PRT_SECTION_SIZE * portNum)) | 0x10000000; // Always use a secure alias.
            regOld = Read32(addr);
            __var pos = pinNum;
            __var mask = GPIO_HSIOM_SEC_MASK &lt;&lt; pinNum;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <block>
            addr = (GPIO_BASE + (GPIO_PRT_SECTION_SIZE * portNum) + GPIO_PRT_CFG_OFFSET) | ((domainSecure != 0) ? 0x10000000 : 0);
            regOld = Read32(addr);
            pos = pinNum &lt;&lt; GPIO_DRIVE_MODE_OFFSET;
            mask = GPIO_CFG_DM_MASK &lt;&lt; (pinNum &lt;&lt; GPIO_DRIVE_MODE_OFFSET);
            v = driveMode;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <block>
            addr = (GPIO_BASE + (GPIO_PRT_SECTION_SIZE * portNum) + GPIO_PRT_CFG_OUT3_OFFSET) | ((domainSecure != 0) ? 0x10000000 : 0);
            regOld = Read32(addr);
            pos = pinNum &lt;&lt; GPIO_DRIVE_MODE_OFFSET;
            mask = GPIO_CFG_DM_MASK &lt;&lt; (pinNum &lt;&lt; GPIO_DRIVE_MODE_OFFSET);
            v = 0;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <block>
            addr = (HSIOM_BASE + (HSIOM_PRT_SECTION_SIZE * portNum) + ((pinNum &lt; GPIO_PRT_HALF) ? 0 : HSIOM_PRT_PORT_SEL1_OFFSET)) | ((domainSecure != 0) ? 0x10000000 : 0);
            regOld = Read32(addr);
            pos = ((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_HSIOM_OFFSET;
            mask = GPIO_HSIOM_MASK &lt;&lt; (((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_HSIOM_OFFSET);
            v = ioSelVal;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <block>
            addr = (GPIO_BASE + (GPIO_PRT_SECTION_SIZE * portNum) + GPIO_PRT_SLEW_EXT_OFFSET) | ((domainSecure != 0) ? 0x10000000 : 0);
            regOld = Read32(addr);
            pos = pinNum &lt;&lt; GPIO_CFG_SLEW_EXT_OFFSET;
            mask = GPIO_CFG_SLEW_EXT_MASK &lt;&lt; (pinNum &lt;&lt; GPIO_CFG_SLEW_EXT_OFFSET);
            v = slewRate;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <block>
            addr = (GPIO_BASE + (GPIO_PRT_SECTION_SIZE * portNum) + ((pinNum &lt; GPIO_PRT_HALF) ? GPIO_PRT_DRIVE_EXT0_OFFSET : GPIO_PRT_DRIVE_EXT1_OFFSET)) | ((domainSecure != 0) ? 0x10000000 : 0);
            pos = ((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_CFG_DRIVE_SEL_EXT_OFFSET;
            mask = GPIO_CFG_DRIVE_SEL_EXT_MASK &lt;&lt; (((pinNum &lt; GPIO_PRT_HALF) ? pinNum : pinNum - GPIO_PRT_HALF) &lt;&lt; GPIO_CFG_DRIVE_SEL_EXT_OFFSET);
            v = driveSel;
            regNew = (regOld &amp; (~(mask))) | ((v &lt;&lt; pos) &amp; mask);
          </block>
          <control if="regOld != regNew">
            <block>
              Write32(addr, regNew);
              confChanged = 1;
            </block>
          </control>
          <control if="confChanged != 0">
            <block>
              Message(0, "Set TRACEDATA[3] to P8_3");
            </block>
          </control>
        </sequence>
      </sequences>
      <!-- PSC3x6F, 256K of Main Flash -->
      <subFamily DsubFamily="PSC3x6F">
        <memory name="IROM1" access="rxn" start="0x22000000" size="0x40000" default="1" />
        <memory name="IROM2" access="rxs" start="0x32000000" size="0x40000" default="1" alias="IROM1" startup="1" />
        <memory name="IROM3" access="rxn" start="0x22800000" size="0x20000" default="0" />
        <memory name="IROM4" access="rxs" start="0x32800000" size="0x20000" default="0" alias="IROM3" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF.FLM" start="0x22000000" size="0x40000" RAMstart="0x34000000" RAMsize="0x3000" default="1" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF_S.FLM" start="0x32000000" size="0x40000" default="1" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF_DBM1.FLM" start="0x22800000" size="0x20000" default="0" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxF_S_DBM1.FLM" start="0x32800000" size="0x20000" default="0" style="Keil" />
        <device Dname="PSC3M6FDS2ACQ1">
          <compile define="PSC3M6FDS2ACQ1" />
        </device>
        <device Dname="PSC3M6FDS2AFQ1">
          <compile define="PSC3M6FDS2AFQ1" />
        </device>
        <device Dname="PSC3M6FDS2AHQ1">
          <compile define="PSC3M6FDS2AHQ1" />
        </device>
        <device Dname="PSC3P6FDS2ACQ1">
          <compile define="PSC3P6FDS2ACQ1" />
        </device>
        <device Dname="PSC3P6FDS2AFQ1">
          <compile define="PSC3P6FDS2AFQ1" />
        </device>
        <device Dname="PSC3P6FDS2AHQ1">
          <compile define="PSC3P6FDS2AHQ1" />
        </device>
      </subFamily>
      <!-- PSC3x6G, 512K of Main Flash -->
      <subFamily DsubFamily="PSC3x6G">
        <memory name="IROM1" access="rxn" start="0x22000000" size="0x80000" default="1" />
        <memory name="IROM2" access="rxs" start="0x32000000" size="0x80000" default="1" alias="IROM1" startup="1" />
        <memory name="IROM3" access="rxn" start="0x22800000" size="0x40000" default="0" />
        <memory name="IROM4" access="rxs" start="0x32800000" size="0x40000" default="0" alias="IROM3" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxG.FLM" start="0x22000000" size="0x80000" RAMstart="0x34000000" RAMsize="0x3000" default="1" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxG_S.FLM" start="0x32000000" size="0x80000" default="1" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxG_DBM1.FLM" start="0x22800000" size="0x40000" default="0" style="Keil" />
        <algorithm Pname="Cortex-M33" name="Flash/PSC3xxG_S_DBM1.FLM" start="0x32800000" size="0x40000" default="0" style="Keil" />
        <device Dname="PSC3M6GES3ACQ1">
          <compile define="PSC3M6GES3ACQ1" />
        </device>
        <device Dname="PSC3M6GES3AFQ1">
          <compile define="PSC3M6GES3AFQ1" />
        </device>
        <device Dname="PSC3M6GES3AHQ1">
          <compile define="PSC3M6GES3AHQ1" />
        </device>
        <device Dname="PSC3P6GES3ACQ1">
          <compile define="PSC3P6GES3ACQ1" />
        </device>
        <device Dname="PSC3P6GES3AFQ1">
          <compile define="PSC3P6GES3AFQ1" />
        </device>
        <device Dname="PSC3P6GES3AHQ1">
          <compile define="PSC3P6GES3AHQ1" />
        </device>
      </subFamily>
    </family>
  </devices>
