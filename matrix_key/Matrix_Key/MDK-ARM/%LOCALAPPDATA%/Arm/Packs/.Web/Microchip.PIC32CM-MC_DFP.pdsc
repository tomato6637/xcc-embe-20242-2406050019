      <keyword>PWM Timers</keyword>
      <keyword>uQFN</keyword>
      <keyword>small packaging</keyword>
      <keyword>5V ARM device</keyword>
      <keyword>Microcontrollers and Processors</keyword>
      <keyword>32-bit Microcontrollers</keyword>
      <keyword>Automotive Recommended</keyword>
      <keyword>Functional Safety Ready</keyword>
   </keywords>
