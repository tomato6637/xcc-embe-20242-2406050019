<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.57/schema/PACK.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>PIC32CM-MC_DFP</name>
   <description overview="./OVERVIEW.md">Microchip PIC32CM-MC Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="1.5.244" date="2026-06-12">
				- CMSIS System Initialization is now included as default. Define DISABLE_CMSIS_INIT to not include.
				- Removed deprecated compatibility header.
				- Added ARMCC scatter/linker scripts.
				- Added dataflash linker scripts for GCC, IAR, and ARMCC toolchains.
				- Renamed SVCall_Handler to SVC_Handler in startup files for CMSIS 6 compliance.
				- Improved startup code for MISRA C compliance.
				- Added Keil uVision csolution project templates.
			</release>
      <release version="1.4.67" date="2022-03-17">
                - Headers minor version increased to v2.1.0.
                - Changed integer constant literal macros from _Ux_ to _UNITxx_ (where xx is 32, 16 or 8) (MISRA C2012:R12.2).
            </release>
      <release version="1.3.58" date="2021-09-15">Hold in reset supported for J32 probes. Included fuse description (component\fuses.h). Support for board file.</release>
      <release version="1.2.52" date="2021-02-08">Added security bit programming for MPLAB X. Added instance headers.</release>
      <release version="1.1.47" date="2020-11-06">Updated MPLAB X debug scripts. Split content in per device trees. Add compatibility.h.</release>
      <release version="1.0.36" date="2020-08-29">Added read device ID. Initial release.</release>
   </releases>
