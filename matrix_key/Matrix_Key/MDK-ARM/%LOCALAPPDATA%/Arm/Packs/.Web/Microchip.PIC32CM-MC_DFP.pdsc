                       Dtz="NO_TZ"
                       Dmve="NO_MVE"
                       Dclock="48000000"
                       DcoreVersion="r0p0"/>
            <debugconfig default="swd" clock="2000000"/>
            <compile header="PIC32CM1216MC00032/include/pic32c.h"
                     define="__PIC32CM1216MC00032__"/>
            <debug svd="PIC32CM1216MC00032/svd/PIC32CM1216MC00032.svd"/>
            <memory name="FLASH"
                    start="0x00000000"
                    size="0x20000"
                    access="rx"
                    default="1"
                    startup="1"/>
            <memory name="DATAFLASH" start="0x00400000" size="0x1000" access="rx"/>
            <memory name="HSRAM"
                    start="0x20000000"
                    size="0x4000"
                    default="1"
                    access="rwx"/>
            <algorithm name="PIC32CM1216MC00032/keil/Flash/PIC32CM-MC_128_FLASH.FLM"
