<?xml version="1.0" encoding="utf-8"?>

<package schemaVersion="1.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>Toshiba</vendor>
  <url>https://toshiba.semicon-storage.com/content/dam/toshiba-ss-v3/master/en/semiconductor/product/dl/device-family-pack/</url>
  <name>SmartMCD-TB9M040_DFP</name>
  <description>Toshiba SmartMCD Series Device Support</description>

  <releases>
    <release version="1.0.0" date="2026-02-25">
      Initial Release of TOSHIBA SmartMCD Series Device Family Pack.
    </release>
  </releases>
  <license>License/SOFTWARE_LICENSE_AGREEMENT.txt</license>

  <keywords>
    <!-- keywords for indexing -->
    <keyword>TOSHIBA</keyword>
    <keyword>Device Support</keyword>
    <keyword>Device Family Package TOSHIBA</keyword>
    <keyword>SmartMCD</keyword>
    <keyword>SmartMCD-TB9M040</keyword>
    <keyword>TB9M040</keyword>
    <keyword>TB9M040FTG</keyword>
  </keywords>

  <devices>
    <family Dfamily="SmartMCD Series" Dvendor="Toshiba:92">
      <processor Dcore="Cortex-M23" DcoreVersion="r0p0" Dfpu="NO_FPU" Dmpu="NO_MPU" Dendian="Little-endian"/>
      <description>
      TOSHIBA SmartMCD Series, Sensorless Control Gate Driver IC for 3-Phase Brushless DC Motors with 32-bit MCU (Built-in Motor driver Circuit).
      </description>
      <!-- *************************  Device 'TB9M040FTG'  ***************************** -->
        <device Dname="TB9M040FTG">
          <processor Dcore="Cortex-M23" Dclock="40000000"/>
          <debug svd="SVD/TB9M040.svd"/>
          <memory id="IROM1"                         start="0x00000000" size="0x00014000" startup="1" default="1"/>
          <memory id="IRAM1"                         start="0x20000000" size="0x00001000" init   ="0" default="1"/>
          <algorithm name="Flash/TB9M040_code_80.FLM" start="0x00000000" size="0x00014000" RAMstart="0x20000000"  RAMsize="0x1000"  default="1"/>

          <!--book name=""/-->
          <feature type="IOs"           n="10"                          name="I/O Ports (PORT)"/>
          <feature type="Timer"         n="32"                          name="32-bit Compare Timers (DTIMER)"/>
          <feature type="Timer"         n="28"     m="2"                name="28-bit Capture Timer (8 inputs, 6 measurement)"/>
          <feature type="WDT"           n="1"                           name="Watchdog Timer(WATCHDOG)"/>

          <feature type="UART"          n="1"                           name="Universal Asynchronous Receiver Transmitter (UART)"/>
          <feature type="SPI"           n="1"                           name="Serial Peripheral Interface (SPI)"/>
          <feature type="ADC"           n="14"     m="12"               name="Analog Digital Converter(MADC)"/>

          <feature type="CoreOther"     n="2"                           name="Programmable Motor Driver(PMD)"/>
          <feature type="VCC"           n="6.0"    m="18"/>
          <feature type="Temp"          n="-40"    m="175"/>
          <feature type="QFN"           n="36"                          name="P-VQFN36-0606-0.50"/>
        </device>
    </family>
  </devices>

  <!-- Device + CMSIS Conditions -->
  <!-- Compiler Conditions -->
  <!-- Startup TB9M040 -->

</package>
